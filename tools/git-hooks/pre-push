#!/bin/sh

command -v git-lfs >/dev/null 2>&1 || {
  printf >&2 "\n%s\n\n" "Dieses Projekt verwendet Git LFS, aber git-lfs wurde nicht gefunden."
  exit 2
}
git lfs pre-push "$@" || exit $?

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

printf "\nSewerStudio Schnelltest vor Push...\n"
dotnet test tests/AuswertungPro.Next.Infrastructure.Tests/AuswertungPro.Next.Infrastructure.Tests.csproj -v minimal --no-restore --filter "Category!=Integration&Category!=Endurance" || {
  printf >&2 "\nPush abgebrochen: Infrastructure-Tests sind rot.\n"
  exit 1
}

dotnet test tests/AuswertungPro.Next.Pipeline.Tests/AuswertungPro.Next.Pipeline.Tests.csproj -v minimal --no-restore --filter "Category!=Integration&Category!=Endurance" || {
  printf >&2 "\nPush abgebrochen: Pipeline-Tests sind rot.\n"
  exit 1
}

dotnet test tests/AuswertungPro.Next.UI.Tests/AuswertungPro.Next.UI.Tests.csproj -v minimal --no-restore --filter "Category!=Integration&Category!=Endurance" || {
  printf >&2 "\nPush abgebrochen: UI-Tests sind rot.\n"
  exit 1
}

printf "\nSewerStudio Schnelltest bestanden.\n"
