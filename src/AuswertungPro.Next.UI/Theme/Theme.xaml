<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════
         SCI-FI ENGINEERING — Sharp contrast, subtle futuristic tint
         High-readability. Blue-steel surfaces. No neon.
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── ACCENT — Confident professional blue ── -->
    <Color x:Key="ColorAccent">#FF2563EB</Color>
    <Color x:Key="ColorAccentHover">#FF1D4ED8</Color>
    <Color x:Key="ColorAccentLight">#FF7CC4FF</Color>
    <Color x:Key="ColorAccentSubtle">#247CC4FF</Color>

    <!-- Nova-Etappe 2: Akzent nur als Text (Prototyp accent-text), gedaempfter Text (faint), Glasrand -->
    <Color x:Key="ColorAccentText">#FF9AD3FF</Color>
    <Color x:Key="ColorTextFaint">#FFA5B3C8</Color>
    <Color x:Key="ColorGlassBorder">#298CBEFF</Color>

    <!-- Sichtbare Auswahl: eigene Flaeche, lesbarer Text und deutliche Kontur. -->
    <Color x:Key="ColorSelection">#FF30587A</Color>
    <Color x:Key="ColorSelectionText">#FFE6EDF3</Color>
    <Color x:Key="ColorSelectionBorder">#FF6CB6FF</Color>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource ColorSelection}"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource ColorSelectionText}"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource ColorSelectionBorder}"/>

    <!-- ── SURFACES — Layered depth: BgMid < BgLight < Card < Header ── -->
    <Color x:Key="ColorBgLight">#FF101B2E</Color>
    <Color x:Key="ColorBgMid">#FF0C1524</Color>
    <Color x:Key="ColorCard">#FF16223A</Color>
    <Color x:Key="ColorCardGlass">#FF16223A</Color>
    <Color x:Key="ColorHeader">#FF1B2940</Color>
    <Color x:Key="ColorBorder">#FF2B3A55</Color>
    <Color x:Key="ColorBorderLight">#FF22304A</Color>
    <!-- F7: Der Kartenrand bleibt bewusst hell (Glas-Look). Eingabefelder und
         Knopf-Umrisse brauchen dagegen eine erkennbare Kontur: mindestens 3:1
         gegen die Kartenflaeche (WCAG 1.4.11, Bedienelement-Umriss). -->
    <Color x:Key="ColorInputBorder">#FF64769C</Color>

    <!-- ── TEXT — WCAG AAA on #16223A card surface ── -->
    <Color x:Key="ColorTextPrimary">#FFEAF0FA</Color>
    <Color x:Key="ColorTextSecondary">#FFB4C1D6</Color>
    <Color x:Key="ColorTextMuted">#FFA5B3C8</Color>

    <!-- ── SEMANTIC — Brighter tones for dark backgrounds ── -->
    <Color x:Key="ColorSuccess">#FF15803D</Color>
    <Color x:Key="ColorDanger">#FFF85149</Color>
    <Color x:Key="ColorWarning">#FFD29922</Color>
    <Color x:Key="ColorInfo">#FF539BF5</Color>
    <!-- KI: eigene Farbe getrennt vom Akzent, damit KI-Vorschlag und Bedienelement unterscheidbar sind -->
    <Color x:Key="ColorKi">#FF3FD6C6</Color>
    <Color x:Key="ColorKiSubtle">#FF1E3A44</Color>
    <Color x:Key="ColorKiText">#FF7FE6DA</Color>

    <!-- ── SOLID BRUSHES ── -->
    <SolidColorBrush x:Key="BgLightBrush" Color="{StaticResource ColorBgLight}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}"/>
    <!-- Fix-Runde 1 (Aufgabe 13, 29.09.2026): ExportPage/DossierPageSelectionWindow/
         DossierParcelLookupWindow/DossierPlanWindow/DossierPreviewWindow banden bereits vorher
         "SurfaceBrush" als Panel-Hintergrund - der Schluessel existierte aber nirgends
         (DynamicResource auf einen fehlenden Schluessel wirft nicht, laesst die Flaeche aber
         unsichtbar/durchsichtig). Vom automatisierten Hochkontrast-Abdeckungstest gefunden;
         gleiche Farbe wie CardBrush, weil die Fundstellen dieselbe Panel-Optik erwarten. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorCard}"/>
    <SolidColorBrush x:Key="CardGlassBrush" Color="{StaticResource ColorCardGlass}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource ColorHeader}"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource ColorAccentSubtle}"/>
    <!-- Fix-Runde 3 (Aufgabe 13, MINOR/IMPORTANT): Farbe fuer Text/Symbole, die DIREKT auf einer
         akzentgefuellten Flaeche sitzen (PrimaryButton, ToolbarButtonAccent, Haken-/Griff-Umriss).
         Weiss in beiden normalen Themes (unveraenderte Optik); unter Hochkontrast auf
         HighlightTextColor ueberlagert (ThemeHighContrast.xaml), weil AccentBrush selbst dort auf
         SystemColors.Highlight faellt - ein je nach Hochkontrast-Schema helles/farbiges Highlight,
         auf dem hartcodiertes Weiss unlesbar werden kann (Befund Fix-Runde 3). -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>
    <!-- ToolbarButtonAccent-Druckzustand: bisher ein hartcodiertes "#FF3570C6" direkt in der
         ControlTemplate.Triggers-Vorlage (folgte weder einem Themewechsel noch Hochkontrast, weil
         nicht einmal auf AccentBrush verwiesen wurde). Gleicher Wert, jetzt als eigener Schluessel;
         Hochkontrast bildet ihn wie AccentBrush/AccentHoverBrush auf Highlight ab. -->
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF3570C6"/>
    <!-- Fix-Runde 4 (Aufgabe 13): Ruheflaeche von ToolbarButtonAccent. Im dunklen Theme dieselbe Farbe
         wie AccentBrush, im hellen der bisherige Verlauf (AccentBarBrush-Werte). Eigener Schluessel,
         damit Hochkontrast ihn wie AccentBrush auf Highlight abbilden kann, ohne AccentBarBrush
         (Balken/Unterstreichungen) mitzuziehen. -->
    <SolidColorBrush x:Key="ToolbarAccentFillBrush" Color="{StaticResource ColorAccent}"/>
    <!-- Fix-Runde 4 (Aufgabe 13, Befund A): Fuellung von SuccessButton in Ruhe/Hover/Druck. Ruhe =
         SuccessBrush-Wert; unter Hochkontrast alle drei auf Highlight (Schrift OnAccentBrush). -->
    <SolidColorBrush x:Key="SuccessFillBrush" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="SuccessFillHoverBrush" Color="#FF166534"/>
    <SolidColorBrush x:Key="SuccessFillPressedBrush" Color="#FF14532D"/>
    <!-- Fix-Runde 4 (Aufgabe 13, Befund D): Auswahlrahmen, der NUR unter Hochkontrast sichtbar ist
         (Highlight). In den normalen Themes transparent - Auswahl zeigt dort weiter nur die Fuellung,
         nichts verschiebt sich (der Rahmen liegt auf einer eigenen, layoutneutralen Ebene). -->
    <SolidColorBrush x:Key="HcAuswahlRahmenBrush" Color="Transparent"/>
    <!-- Fix-Runde 4: Zaehler im GEWAEHLTEN Spalten-Chip - normal derselbe Ton wie MutedBrush (keine
         sichtbare Aenderung), unter Hochkontrast HighlightText (der Chip ist dann Highlight). -->
    <SolidColorBrush x:Key="ChipZaehlerAktivBrush" Color="{StaticResource ColorTextMuted}"/>
    <!-- Hover-/Druck-Tönung des impliziten Button-Stils und von ActionCardButton: bisher je ein
         "<SolidColorBrush Color="{StaticResource ColorAccent}" Opacity="…"/>" direkt im
         Setter.Value - ein StaticResource-Schnappschuss, der weder einem Designwechsel zur
         Laufzeit noch Hochkontrast folgte (derselbe Fehlertyp wie ColorHeader/ColorWarning in
         Fix-Runde 2). Beide Fundstellen in diesem Theme nutzen dieselben zwei Werte (0,08/0,15),
         deshalb genuegt je ein gemeinsamer Schluessel. Unter Hochkontrast auf WindowColor
         (dieselbe "subtile Flaeche wird neutral"-Regel wie bei SuccessSubtleBrush &amp; Co. in
         Fix-Runde 2), weil normaler TextBrush-Text (WindowText unter Hochkontrast) auf dieser
         Flaeche liegt. -->
    <SolidColorBrush x:Key="AccentHoverTintBrush" Color="{StaticResource ColorAccent}" Opacity="0.08"/>
    <SolidColorBrush x:Key="AccentPressedTintBrush" Color="{StaticResource ColorAccent}" Opacity="0.15"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource ColorBorderLight}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource ColorInputBorder}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource ColorAccentText}"/>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource ColorTextFaint}"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource ColorGlassBorder}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#FF2D3440"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#FF2D3440"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#FF3A424D"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#DD161B22"/>
    <!-- Halbtransparente Abdunkelung hinter Wartefeldern (BusyOverlay). -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#99050810"/>
    <!-- Schrift auf farbigen Zustandsklassen-Abzeichen (Z0-Z4): deren Farben sind in beiden Designs gleich. -->
    <SolidColorBrush x:Key="StatusBadgeTextBrush" Color="#FF0A0F1A"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource ColorInfo}"/>
    <!-- Fix-Runde 2 (Aufgabe 13, 29.09.2026): ersetzt die fruehere rohe
         "<SolidColorBrush Color="{DynamicResource ColorWarning}" Opacity="0.15"/>" im VSA-Explorer
         (Q2-„OPTIONAL"-Abzeichen). Ein roher Color-Schluessel kann in einer ResourceDictionary NICHT
         per DynamicResource ueberlagert werden (Color ist kein Freezable/DependencyObject - anders
         als SolidColorBrush.Color oben, das ueber eine DependencyProperty dynamisch nachgezogen
         werden kann). Die Deckkraft steckt deshalb jetzt in der Brush selbst, damit die Ueberlagerung
         in ThemeHighContrast.xaml einen normalen Brush-Schluessel ueberschreiben kann. -->
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource ColorWarning}" Opacity="0.15"/>

    <!-- Textfarben sind von den kraeftigeren Flaechenfarben getrennt. -->
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF56D364"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFF7B72"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFD29922"/>
    <!-- Schrift DIREKT AUF der gesaettigten DangerBrush/WarningBrush-Flaeche (z. B. ein Zaehler-
         Abzeichen), nicht zu verwechseln mit StatusBadgeTextBrush (nur fuer die theme-gleichen
         Zustandsklassen-Abzeichen Z0-Z4 gedacht). Weder StatusBadgeTextBrush noch "White" erreichen
         in beiden Themes 4,5:1 auf DangerBrush/WarningBrush (Review 29.09.2026: 3,97/3,82 bzw.
         3,35/2,52): dunkel nahezu schwarz, hell weiss, je nachdem wie hell die Flaeche im
         jeweiligen Theme ist. -->
    <SolidColorBrush x:Key="DangerBadgeTextBrush" Color="#FF0A0F1A"/>
    <SolidColorBrush x:Key="WarningBadgeTextBrush" Color="#FF0A0F1A"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="#FF79C0FF"/>
    <SolidColorBrush x:Key="KiBrush" Color="{StaticResource ColorKi}"/>
    <SolidColorBrush x:Key="KiSubtleBrush" Color="{StaticResource ColorKiSubtle}"/>
    <SolidColorBrush x:Key="KiTextBrush" Color="{StaticResource ColorKiText}"/>

    <!-- Subtle-Hintergruende fuer Erfolg-/Fehler-Abzeichen (Badges) — dunkel abgestimmt -->
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#FF14432A"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FF4A1A1A"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FF493719"/>
    <!-- Feldmarkierung in der Objektakte (11.09.2026): dunkle Tints, damit weisse Tinte lesbar bleibt. -->
    <SolidColorBrush x:Key="MarkierungGelbBrush" Color="#FF4D4318"/>
    <SolidColorBrush x:Key="MarkierungOrangeBrush" Color="#FF4D3118"/>
    <SolidColorBrush x:Key="MarkierungRotBrush" Color="#FF4D1F1F"/>
    <SolidColorBrush x:Key="MarkierungGruenBrush" Color="#FF1A4224"/>
    <SolidColorBrush x:Key="MarkierungBlauBrush" Color="#FF1A324D"/>

    <!-- ── DESIGNSTUDIE: Zweit-Akzent (Teal), Severity-Skala, Akzent-Verlauf — dunkel abgestimmt ── -->
    <Color x:Key="ColorSecondaryAccent">#FF22D3EE</Color>
    <Color x:Key="ColorSecondaryAccentHover">#FF67E8F9</Color>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource ColorSecondaryAccent}"/>
    <SolidColorBrush x:Key="SecondaryAccentHoverBrush" Color="{StaticResource ColorSecondaryAccentHover}"/>
    <SolidColorBrush x:Key="SecondaryAccentSubtleBrush" Color="#FF164E5C"/>
    <SolidColorBrush x:Key="Severity1Brush" Color="#FF3FB950"/>
    <SolidColorBrush x:Key="Severity2Brush" Color="#FF84CC16"/>
    <SolidColorBrush x:Key="Severity3Brush" Color="#FFD29922"/>
    <SolidColorBrush x:Key="Severity4Brush" Color="#FFF0883E"/>
    <SolidColorBrush x:Key="Severity5Brush" Color="#FFF85149"/>
    <LinearGradientBrush x:Key="AccentBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF539BF5" Offset="0"/>
        <GradientStop Color="#FF22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <!-- Titel-Unterstreichung: wie im Hellthema, aber in den helleren Toenen des Dunkelthemas —
         das kraeftige Blau des Hellthemas verschwindet auf dunklem Grund. -->
    <LinearGradientBrush x:Key="NeuralUnderlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF539BF5" Offset="0"/>
        <GradientStop Color="#FF22D3EE" Offset="0.45"/>
        <GradientStop Color="#0022D3EE" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── STATUSFARBEN-TOKENS (eine Farbsprache; C#-Quelle: StatusColorService) ── -->
    <!-- QualityGate-Ampel: semantisch getrennt von Severity, Werte = Success/Warning/Danger. -->
    <SolidColorBrush x:Key="GateOkBrush" Color="#FF3FB950"/>
    <SolidColorBrush x:Key="GateReviewBrush" Color="#FFD29922"/>
    <SolidColorBrush x:Key="GateFailBrush" Color="#FFF85149"/>
    <SolidColorBrush x:Key="ConfidenceHighBrush" Color="#FF3FB950"/>
    <SolidColorBrush x:Key="ConfidenceMidBrush" Color="#FFD29922"/>
    <SolidColorBrush x:Key="ConfidenceLowBrush" Color="#FFF85149"/>
    <!-- WinCan-Erbe: warme Eingabefeld-Toenung (Wiedererkennung ohne Billig-Gelb). -->
    <SolidColorBrush x:Key="InputWarmBrush" Color="#FF3A3526"/>
    <SolidColorBrush x:Key="InputWarmBorderBrush" Color="#FF6B5D33"/>
    <!-- VSA-Eingabefelder (Distanz, Uhrzeit, Quantifizierung ...): warme Hervorhebung
         wie in WinCan. Dunkler Warmton analog InputWarmBrush, damit Text lesbar bleibt. -->
    <SolidColorBrush x:Key="VsaInputHighlightBrush" Color="#FF3A3526"/>
    <SolidColorBrush x:Key="VsaInputHighlightBorderBrush" Color="#FF6B5D33"/>
    <!-- VSA-Hauptgruppen (BA/BB/BC/BD...): eigene Hues, bewusst KEINE Ampelfarben. -->
    <SolidColorBrush x:Key="CodeGroupStrukturBrush" Color="#FF8B7CF6"/>
    <SolidColorBrush x:Key="CodeGroupStrukturSubtleBrush" Color="#FF2E2A4D"/>
    <SolidColorBrush x:Key="CodeGroupBetriebBrush" Color="#FF22D3EE"/>
    <SolidColorBrush x:Key="CodeGroupBetriebSubtleBrush" Color="#FF16404C"/>
    <SolidColorBrush x:Key="CodeGroupBestandBrush" Color="#FF539BF5"/>
    <SolidColorBrush x:Key="CodeGroupBestandSubtleBrush" Color="#FF1C3050"/>
    <SolidColorBrush x:Key="CodeGroupSonstigBrush" Color="#FF8891A0"/>
    <SolidColorBrush x:Key="CodeGroupSonstigSubtleBrush" Color="#FF32383F"/>
    <!-- Glow-Farbe fuer Premium-Akzente (DropShadow-Glows, Puls-Ringe); Quelle fuer AccentGlow
         in Theme/Controls.xaml. Heller als im Hellthema, sonst bliebe der Schein auf dunklen
         Flaechen unsichtbar. Volldeckend halten: DropShadowEffect ignoriert den Alpha-Anteil
         von Color und regelt die Staerke ausschliesslich ueber Opacity. -->
    <Color x:Key="GlowAccentColor">#FF539BF5</Color>

    <!-- ── GRADIENT BRUSHES ── -->
    <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0E1828" Offset="0"/>
        <GradientStop Color="#FF0C1524" Offset="0.5"/>
        <GradientStop Color="#FF0B1220" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassBrush" Color="Transparent"/>

    <!-- Deckende Seitenleiste: gleiche Farben auch ohne Windows-Mica-Hintergrund. -->
    <SolidColorBrush x:Key="NavPanelBrush" Color="#FF101B30"/>
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFFFF"/>

    <!-- ═══════════════════════════════════════════════════════════
         WINDOW
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Aptos, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Aptos, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CARD — Clean white surface with subtle shadow
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <!-- Akzentlinie unter dem Titel: als TextDecoration, damit jede Seite sie automatisch
             bekommt — auch kuenftige. PenOffset haelt Abstand zur Grundlinie, sonst wirkt es
             wie ein Link statt wie eine Linie. -->
        <Setter Property="TextDecorations">
            <Setter.Value>
                <TextDecorationCollection>
                    <TextDecoration Location="Underline" PenOffset="7" PenThicknessUnit="Pixel">
                        <TextDecoration.Pen>
                            <Pen Thickness="2" Brush="{StaticResource NeuralUnderlineBrush}"/>
                        </TextDecoration.Pen>
                    </TextDecoration>
                </TextDecorationCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KeyboardFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource InfoTextBrush}"
                            BorderThickness="2"
                            CornerRadius="7"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         BUTTON — Clean, no glow
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="MainScale"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        RecognizesAccessKey="True">
                        <!-- B7: Der implizite TextBlock-Stil setzt Foreground selbst und schlaegt
                             damit die Vererbung. Ein Knopfinhalt aus eigenen TextBlocks bekaeme sonst
                             die normale Textfarbe statt der Knopffarbe. Deshalb hier eine engere
                             Fassung, die die Tinte vom Knopf uebernimmt. -->
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <!-- Fix-Runde 3 (Aufgabe 13, MINOR): war ein StaticResource-Schnappschuss
                                 (ColorAccent), folgte weder Designwechsel noch Hochkontrast. -->
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource AccentHoverTintBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource AccentPressedTintBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fix-Runde 4 (Aufgabe 13, Befund A): Vorlage fuer GEFUELLTE Knoepfe (PrimaryButton,
         SuccessButton, SeverityXButton). Dieselbe Form wie die Vorlage des impliziten Button-Stils,
         aber OHNE deren Hover-/Druck-Toenung: die stellte "MainBorder" per TargetName auf eine 4 %
         (hell) bzw. 8 % (dunkel) Akzent-Toenung um - bei weisser Schrift war ein gefuellter Knopf
         unter der Maus im hellen Theme praktisch unlesbar, unter Hochkontrast (Toenung = Window,
         Schrift = HighlightText) ebenso. Hier bleibt die Flaeche immer die Knopffarbe
         (TemplateBinding); den Hover-/Druckton setzt der jeweilige Style ueber Style.Triggers auf
         seine eigene VOLLE Farbe, die Rangfolge ist dabei Style-Trigger vor Style-Setter. -->
    <ControlTemplate x:Key="FilledButtonTemplate" TargetType="Button">
        <Border Name="MainBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                Padding="{TemplateBinding Padding}"
                RenderTransformOrigin="0.5,0.5"
                SnapsToDevicePixels="True">
            <Border.RenderTransform>
                <ScaleTransform x:Name="MainScale"/>
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True">
                <!-- B7: Text-Inhalt (Content als String) bekommt sonst den impliziten TextBlock-Stil
                     (TextBrush) statt der Knopfschrift. Eigene TextBlocks im Inhalt erreicht dieser
                     Block NICHT (zur Laufzeit belegt, Fix-Runde 4) - dafuer tragen die gefuellten
                     Stile denselben Stil zusaetzlich in ihren Style.Resources. -->
                <ContentPresenter.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Style>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Fix-Runde 4 (Aufgabe 13, Befund A): impliziter TextBlock-Stil fuer den INHALT gefuellter
         Knoepfe. Ein eigener TextBlock im Knopfinhalt (<StackPanel><FluentIcon/><TextBlock/>) sucht
         seinen impliziten Stil im logischen Baum (Knopf, Fenster, App) - der B7-Block im
         ContentPresenter liegt nur im visuellen Baum und erreicht ihn nicht. Zur Laufzeit belegt:
         ohne diesen Stil war solche Beschriftung TextBrush (dunkles Marineblau auf Akzentblau im
         hellen Theme). Ueber Style.Resources gilt er fuer den Inhalt jedes Knopfs mit diesem Stil,
         auch ueber BasedOn. -->
    <Style x:Key="FilledButtonInhaltTextBlock" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

    <!-- Primary Button — Blue filled -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource FilledButtonInhaltTextBlock}"/>
        </Style.Resources>
        <!-- Fix-Runde 2 (Aufgabe 13, MINOR): war "SolidColorBrush Color="{StaticResource ColorAccent}""
             - ColorAccent hat je Theme einen anderen Wert, ein StaticResource-Snapshot ueberlebte
             einen Designwechsel zur Laufzeit deshalb nicht (der Knopf blieb bis zum Neuaufbau der
             Vorlage auf der Farbe des Themes, in dem das Fenster geoeffnet wurde). AccentBrush ist
             exakt derselbe Wert, aber ein normaler DynamicResource-Token wie ueberall sonst. -->
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <!-- Fix-Runde 3 (Aufgabe 13, IMPORTANT): war hartcodiert "White" - AccentBrush faellt unter
             Hochkontrast auf SystemColors.Highlight, das in manchen Hochkontrast-Schemata hell ist
             (z. B. Cyan); hartes Weiss ergab dort ~1,3-1,5:1 statt lesbar. OnAccentBrush ist in
             beiden normalen Themes Weiss (keine sichtbare Aenderung), unter Hochkontrast
             HighlightTextColor. -->
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- Fix-Runde 4 (Befund A): eigene Vorlage ohne Toenung, eigener Hover-/Druckton in voller
             Akzentfarbe - Schrift OnAccentBrush bleibt damit in jedem Zustand auf einer Flaeche, die
             unter Hochkontrast auf Highlight faellt. -->
        <Setter Property="Template" Value="{StaticResource FilledButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Success Button - gruene Bestaetigung -->
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <!-- Fix-Runde 4 (Befund A): eigene Fuelltokens statt SuccessBrush. SuccessBrush bleibt unter
             Hochkontrast bewusst gruen (Rand/Symbol-Bedeutung), die Schrift OnAccentBrush faellt dort
             aber auf HighlightText - SuccessFillBrush faellt deshalb wie AccentBrush auf Highlight.
             Normale Themes: gleicher Wert wie SuccessBrush, Hover/Druck neu in voller Farbe (vorher
             erbte der Knopf die fast unsichtbare Akzent-Toenung, weisse Schrift darauf). -->
        <Setter Property="Background" Value="{DynamicResource SuccessFillBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SuccessFillHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SuccessFillPressedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary Button - Subtle surface -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TOOLBAR BUTTON — Compact, transparent background
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                        <!-- B7: Der implizite TextBlock-Stil setzt Foreground selbst und schlaegt
                             damit die Vererbung. Ein Knopfinhalt aus eigenen TextBlocks bekaeme sonst
                             die normale Textfarbe statt der Knopffarbe. Deshalb hier eine engere
                             Fassung, die die Tinte vom Knopf uebernimmt. -->
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF2D3440"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF4F5864"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF3A424D"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar Accent Button — Blue accent for primary actions -->
    <Style x:Key="ToolbarButtonAccent" TargetType="Button">
        <Style.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource FilledButtonInhaltTextBlock}"/>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <!-- Fix-Runde 3 (Aufgabe 13, IMPORTANT): siehe PrimaryButton-Kommentar - AccentBrush faellt
             unter Hochkontrast auf ein moeglicherweise helles Highlight, hartes Weiss war dort
             potenziell unlesbar. -->
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Fix-Runde 3 (Aufgabe 13, MINOR): Background war ein
                         "SolidColorBrush Color="{StaticResource ColorAccent}"" direkt im
                         Property-Element - ein Schnappschuss, der weder Designwechsel noch
                         Hochkontrast folgte (AccentBrush wurde dabei gar nicht nachgeschlagen).
                         Jetzt ein normales DynamicResource-Attribut wie ueberall sonst. -->
                    <Border Name="bd"
                            Background="{DynamicResource ToolbarAccentFillBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                        <!-- B7: Der implizite TextBlock-Stil setzt Foreground selbst und schlaegt
                             damit die Vererbung. Ein Knopfinhalt aus eigenen TextBlocks bekaeme sonst
                             die normale Textfarbe statt der Knopffarbe. Deshalb hier eine engere
                             Fassung, die die Tinte vom Knopf uebernimmt. -->
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar Danger Button -->
    <Style x:Key="ToolbarButtonDanger" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- Action Card Button -->
    <Style x:Key="ActionCardButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Fix-Runde 3 (Aufgabe 13, MINOR): beide Toenungen waren StaticResource-
                             Schnappschuesse, siehe Kommentar bei AccentHoverTintBrush oben. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverTintBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressedTintBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Button — Round, icon-only -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF2D3440"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF3A424D"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Optik und Bedienung professionell, 28.09.2026, Aufgabe 3: angeglichen an die bisherige
         lokale Doppeldefinition in DataPage.xaml (dort entfernt) - kompakter Sekundaerknopf statt
         der Toolbar-Pillenform. -->
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="{DynamicResource TextS}"/>
    </Style>

    <Style x:Key="CompactToggleButton" TargetType="ToggleButton">
        <!-- Fix-Runde 4 (Aufgabe 13): eigene TextBlocks im Chip-Inhalt (Titel) suchen ihren impliziten
             Stil im logischen Baum und bekamen TextBrush - auch im gewaehlten Zustand auf
             SelectionBackgroundBrush (unter Hochkontrast WindowText auf Highlight). Gewaehlt jetzt
             SelectionTextBrush (normal praktisch derselbe Ton wie TextBrush), sonst unveraendert TextBrush. -->
        <Style.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="{DynamicResource TextS}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SelectionSurface" CornerRadius="15"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                        <!-- B7: Der implizite TextBlock-Stil setzt Foreground selbst und schlaegt
                             damit die Vererbung. Ein Knopfinhalt aus eigenen TextBlocks bekaeme sonst
                             die normale Textfarbe statt der Knopffarbe. Deshalb hier eine engere
                             Fassung, die die Tinte vom Knopf uebernimmt. -->
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="9,3"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TEXTBOX — Clean input with blue focus border
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <!-- Fokus-Schein: ruht unsichtbar (Opacity 0) und wird nur im Fokus
                             eingeblendet. Hier im Template statt ueber die AccentGlow-Ressource,
                             weil Controls.xaml erst NACH diesem Woerterbuch gemergt wird und
                             StaticResource es darum nicht erreicht. Eigene Instanz je Feld —
                             geteilte Effekte liessen sich nicht einzeln animieren. -->
                        <Border.Effect>
                            <DropShadowEffect x:Name="FocusGlow"
                                              Color="{StaticResource GlowAccentColor}"
                                              Opacity="0"
                                              BlurRadius="12"
                                              ShadowDepth="0"/>
                        </Border.Effect>
                        <ScrollViewer x:Name="PART_ContentHost"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF4F5864"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            <!-- Dauern hart geschrieben: die Anim-Tokens liegen in Controls.xaml und
                                 sind von hier aus per StaticResource nicht erreichbar (Merge-Reihenfolge).
                                 Werte entsprechen AnimDurationFast bzw. AnimDurationNormal. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.45" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         DATAGRID — Clean engineering grid
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderLightBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="RowBackground" Value="{DynamicResource CardBrush}"/>
        <Setter Property="AlternatingRowBackground">
            <Setter.Value>
                <SolidColorBrush Color="#FF252C34"/>
            </Setter.Value>
        </Setter>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

    <!-- DataGrid Header — Steel-blue tinted -->
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- Fixwelle F4: Der Kopf traegt seine Groesse als Setter, damit die Vorlage sie erben
             kann. Der Wert ist derselbe wie bisher im Template (TextXS). -->
        <Setter Property="FontSize" Value="{DynamicResource TextXS}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <ControlTemplate.Resources>
                        <!-- Nova-Etappe 2b: Nur String-Koepfe schreiben gross (Kapitaelchen greifen mit
                             der Programmschrift nicht). Ein eigener Kopf-Inhalt (kein String) durchlaeuft
                             diese Vorlage nicht und behaelt den bisherigen Presenter. Die Umwandlung
                             selbst passiert NICHT hier (kein Konverter-Objektelement, siehe
                             GrossbuchstabenConverter-Doku: PageTitleUnderlineTests laedt diese Datei roh
                             per XamlReader.Load, wo ein eigener Klassenverweis mit "unbekannter Typ"
                             scheitert), sondern schon beim Erzeugen der Spalte
                             (DataGridColumnFactory.Create / SchaechtePage.RebuildColumns rufen
                             GrossbuchstabenConverter.Anwenden auf). Diese Vorlage bindet den bereits
                             fertigen String nur noch unveraendert. -->
                        <DataTemplate DataType="{x:Type sys:String}">
                            <!-- Nova-Fixwelle 2b (F4): Groesse und Tinte kommen vom Kopf selbst,
                                 nicht fest aus dieser Vorlage. Vorher gewann die Vorlage gegen
                                 jeden Setter des Kopfstils — auch gegen einen abgeleiteten
                                 ColumnHeaderStyle, der eine Spalte einfaerben will. Es ist eine
                                 RelativeSource-Bindung und kein TemplateBinding: Diese
                                 DataTemplate liegt in ControlTemplate.Resources und gehoert
                                 damit nicht zum Vorlagenbaum. -->
                            <TextBlock Text="{Binding}"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                        <!-- Nova-Fixwelle 2b (P4): Die Ziehgriffe zwischen den Kopfzellen hatten
                             keine eigene Vorlage und trugen deshalb die Standardoptik von WPF —
                             im dunklen Theme fast weiss und damit kontrastreicher als der
                             Kopftext selbst. Jetzt zeichnet nur der rechte Griff eine 1 px
                             schmale Trennlinie in der Rahmenfarbe des Themes; der linke Griff
                             bleibt unsichtbar, sonst staende an jeder Grenze eine doppelte
                             Linie. Der Ziehbereich (6 px, Cursor) bleibt unveraendert. -->
                        <Style x:Key="KopfGriffOhneLinie" TargetType="{x:Type Thumb}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="KopfGriffTrennlinie" TargetType="{x:Type Thumb}" BasedOn="{StaticResource KopfGriffOhneLinie}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Background="Transparent">
                                            <Rectangle Width="1" HorizontalAlignment="Right"
                                                       Fill="{DynamicResource BorderBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource KopfGriffOhneLinie}"
                               HorizontalAlignment="Left" Width="6" Cursor="SizeWE"/>
                        <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource KopfGriffTrennlinie}"
                               HorizontalAlignment="Right" Width="6" Cursor="SizeWE"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         LISTBOX
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="10,8"
                            BorderThickness="0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Fix-Runde 3 (Aufgabe 13, MINOR): war ein StaticResource-Schnappschuss,
                             folgte weder Designwechsel noch Hochkontrast; AccentSubtleBrush ist der
                             seit Fix-Runde 2 korrekt ueberlagerte Schluessel dafuer. Foreground bleibt
                             in diesem Style unveraendert TextBrush (kein eigener Setter hier), das
                             passt zu AccentSubtleBrush -> WindowColor unter Hochkontrast. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF2D3440"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         GROUPBOX — Clean panel
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="12,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF323940" Offset="0"/>
                                    <GradientStop Color="#FF2D3440" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter ContentSource="Header"
                                            TextElement.Foreground="{DynamicResource TextBrush}"
                                            TextElement.FontWeight="Bold"
                                            TextElement.FontSize="13"/>
                        </Border>
                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,6,6"
                                Padding="16">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         MENU
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SCROLLBAR — Slim, neutral
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

