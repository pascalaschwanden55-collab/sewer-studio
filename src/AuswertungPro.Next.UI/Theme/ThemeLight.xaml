<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         SCI-FI ENGINEERING — Sharp contrast, subtle futuristic tint
         High-readability. Blue-steel surfaces. No neon.
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── ACCENT ── -->
    <Color x:Key="ColorAccent">#FF2563EB</Color>
    <Color x:Key="ColorAccentHover">#FF1D4ED8</Color>
    <Color x:Key="ColorAccentLight">#FF3B82F6</Color>
    <Color x:Key="ColorAccentSubtle">#FFD6E4F7</Color>

    <!-- ── SURFACES — Subtle blue-steel tint ── -->
    <Color x:Key="ColorBgLight">#FFF0F3F8</Color>
    <Color x:Key="ColorBgMid">#FFE6EBF3</Color>
    <Color x:Key="ColorCard">#FFFCFDFF</Color>
    <Color x:Key="ColorCardGlass">#FFFCFDFF</Color>
    <Color x:Key="ColorHeader">#FFE8EDF5</Color>
    <Color x:Key="ColorBorder">#FF9EAEC4</Color>
    <Color x:Key="ColorBorderLight">#FFCDD6E4</Color>

    <!-- ── TEXT — WCAG AAA contrast ── -->
    <Color x:Key="ColorTextPrimary">#FF0A0F1A</Color>
    <Color x:Key="ColorTextSecondary">#FF1C2536</Color>
    <Color x:Key="ColorTextMuted">#FF3D4D63</Color>

    <!-- ── SEMANTIC ── -->
    <Color x:Key="ColorSuccess">#FF16A34A</Color>
    <Color x:Key="ColorDanger">#FFDC2626</Color>
    <Color x:Key="ColorWarning">#FFF59E0B</Color>
    <Color x:Key="ColorInfo">#FF0EA5E9</Color>

    <!-- ── SOLID BRUSHES ── -->
    <SolidColorBrush x:Key="BgLightBrush" Color="{StaticResource ColorBgLight}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}"/>
    <SolidColorBrush x:Key="CardGlassBrush" Color="{StaticResource ColorCardGlass}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource ColorHeader}"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource ColorAccentSubtle}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource ColorBorderLight}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#FFE8EDF5"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#FFE8EDF5"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#FFDAE1ED"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#F0F8FAFC"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource ColorInfo}"/>

    <!-- Subtle-Hintergruende fuer Erfolg-/Fehler-Abzeichen (Badges) — hell abgestimmt -->
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#FFDCFCE7"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FFFEE2E2"/>

    <!-- ── DESIGNSTUDIE: Zweit-Akzent (Teal), Severity-Skala, Akzent-Verlauf ── -->
    <Color x:Key="ColorSecondaryAccent">#FF0891B2</Color>
    <Color x:Key="ColorSecondaryAccentHover">#FF0E7490</Color>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource ColorSecondaryAccent}"/>
    <SolidColorBrush x:Key="SecondaryAccentHoverBrush" Color="{StaticResource ColorSecondaryAccentHover}"/>
    <SolidColorBrush x:Key="SecondaryAccentSubtleBrush" Color="#FFCFFAFE"/>
    <SolidColorBrush x:Key="Severity1Brush" Color="#FF16A34A"/>
    <SolidColorBrush x:Key="Severity2Brush" Color="#FF65A30D"/>
    <SolidColorBrush x:Key="Severity3Brush" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="Severity4Brush" Color="#FFEA580C"/>
    <SolidColorBrush x:Key="Severity5Brush" Color="#FFDC2626"/>
    <LinearGradientBrush x:Key="AccentBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2563EB" Offset="0"/>
        <GradientStop Color="#FF0891B2" Offset="1"/>
    </LinearGradientBrush>
    <!-- Titel-Unterstreichung: Blau nach Teal, laeuft nach rechts ins Transparente aus
         (wie die Logo-Linie in der Sidebar). Je Theme eigene Stops, weil GradientStops
         keine DynamicResource aufnehmen koennen. -->
    <LinearGradientBrush x:Key="NeuralUnderlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2563EB" Offset="0"/>
        <GradientStop Color="#FF0891B2" Offset="0.45"/>
        <GradientStop Color="#000891B2" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── STATUSFARBEN-TOKENS (eine Farbsprache; C#-Quelle: StatusColorService) ── -->
    <!-- QualityGate-Ampel: semantisch getrennt von Severity, Werte = Success/Warning/Danger. -->
    <SolidColorBrush x:Key="GateOkBrush" Color="#FF16A34A"/>
    <SolidColorBrush x:Key="GateReviewBrush" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="GateFailBrush" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="ConfidenceHighBrush" Color="#FF16A34A"/>
    <SolidColorBrush x:Key="ConfidenceMidBrush" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="ConfidenceLowBrush" Color="#FFDC2626"/>
    <!-- WinCan-Erbe: warme Eingabefeld-Toenung (Wiedererkennung ohne Billig-Gelb). -->
    <SolidColorBrush x:Key="InputWarmBrush" Color="#FFFDF4D7"/>
    <SolidColorBrush x:Key="InputWarmBorderBrush" Color="#FFDCC98A"/>
    <!-- VSA-Hauptgruppen (BA/BB/BC/BD...): eigene Hues, bewusst KEINE Ampelfarben. -->
    <SolidColorBrush x:Key="CodeGroupStrukturBrush" Color="#FF7C3AED"/>
    <SolidColorBrush x:Key="CodeGroupStrukturSubtleBrush" Color="#FFEDE9FE"/>
    <SolidColorBrush x:Key="CodeGroupBetriebBrush" Color="#FF0891B2"/>
    <SolidColorBrush x:Key="CodeGroupBetriebSubtleBrush" Color="#FFCFFAFE"/>
    <SolidColorBrush x:Key="CodeGroupBestandBrush" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="CodeGroupBestandSubtleBrush" Color="#FFD6E4F7"/>
    <SolidColorBrush x:Key="CodeGroupSonstigBrush" Color="#FF64748B"/>
    <SolidColorBrush x:Key="CodeGroupSonstigSubtleBrush" Color="#FFE9EDF3"/>
    <!-- Glow-Farbe fuer Premium-Akzente (DropShadow-Glows, Puls-Ringe); Quelle fuer AccentGlow
         in Theme/Controls.xaml. Volldeckend halten: DropShadowEffect ignoriert den Alpha-Anteil
         von Color und regelt die Staerke ausschliesslich ueber Opacity. -->
    <Color x:Key="GlowAccentColor">#FF2563EB</Color>

    <!-- ── GRADIENT BRUSHES ── -->
    <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF0F3F8" Offset="0"/>
        <GradientStop Color="#FFEAEFF6" Offset="0.5"/>
        <GradientStop Color="#FFE5EBF4" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassBrush" Color="Transparent"/>

    <!-- Nav sidebar: blue-steel tinted panel -->
    <LinearGradientBrush x:Key="NavPanelBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFF3F5FA" Offset="0"/>
        <GradientStop Color="#FFEDF0F7" Offset="0.5"/>
        <GradientStop Color="#FFE7ECF4" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════
         WINDOW
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Aptos, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Aptos, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CARD — Clean white surface with subtle shadow
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <!-- Akzentlinie unter dem Titel: als TextDecoration, damit jede Seite sie automatisch
             bekommt — auch kuenftige. PenOffset haelt Abstand zur Grundlinie, sonst wirkt es
             wie ein Link statt wie eine Linie. -->
        <Setter Property="TextDecorations">
            <Setter.Value>
                <TextDecorationCollection>
                    <TextDecoration Location="Underline" PenOffset="7" PenThicknessUnit="Pixel">
                        <TextDecoration.Pen>
                            <Pen Thickness="2" Brush="{StaticResource NeuralUnderlineBrush}"/>
                        </TextDecoration.Pen>
                    </TextDecoration>
                </TextDecorationCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#161E3050" BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         BUTTON — Clean, no glow
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="MainScale"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="MainBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource ColorAccent}" Opacity="0.04"/>
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource ColorAccent}" Opacity="0.1"/>
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button — Blue filled -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource ColorAccent}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Success Button - gruene Bestaetigung -->
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <!-- Secondary Button - Subtle surface -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TOOLBAR BUTTON — Compact, transparent background
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFE8EDF5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFCDD6E4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFCDD6E4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar Accent Button — Blue accent for primary actions -->
    <Style x:Key="ToolbarButtonAccent" TargetType="Button">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="bd"
                            Background="{StaticResource AccentBarBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource ColorAccentHover}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF1E40AF"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar Danger Button -->
    <Style x:Key="ToolbarButtonDanger" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- Action Card Button -->
    <Style x:Key="ActionCardButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource ColorAccent}" Opacity="0.04"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource ColorAccent}" Opacity="0.08"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Button — Round, icon-only -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFE8EDF5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFCDD6E4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}"/>

    <Style x:Key="CompactToggleButton" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
                <Setter Property="Background" Value="{DynamicResource SecondaryAccentSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TEXTBOX — Clean input with blue focus border
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <!-- Fokus-Schein: ruht unsichtbar (Opacity 0) und wird nur im Fokus
                             eingeblendet. Hier im Template statt ueber die AccentGlow-Ressource,
                             weil Controls.xaml erst NACH diesem Woerterbuch gemergt wird und
                             StaticResource es darum nicht erreicht. Eigene Instanz je Feld —
                             geteilte Effekte liessen sich nicht einzeln animieren. -->
                        <Border.Effect>
                            <DropShadowEffect x:Name="FocusGlow"
                                              Color="{StaticResource GlowAccentColor}"
                                              Opacity="0"
                                              BlurRadius="12"
                                              ShadowDepth="0"/>
                        </Border.Effect>
                        <ScrollViewer x:Name="PART_ContentHost"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF94A3B8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            <!-- Dauern hart geschrieben: die Anim-Tokens liegen in Controls.xaml und
                                 sind von hier aus per StaticResource nicht erreichbar (Merge-Reihenfolge).
                                 Werte entsprechen AnimDurationFast bzw. AnimDurationNormal. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.45" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         DATAGRID — Clean engineering grid
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush">
            <Setter.Value>
                <SolidColorBrush Color="#FFCDD6E4"/>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="RowBackground" Value="{DynamicResource CardBrush}"/>
        <Setter Property="AlternatingRowBackground">
            <Setter.Value>
                <SolidColorBrush Color="#FFF3F5FA"/>
            </Setter.Value>
        </Setter>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

    <!-- DataGrid Header — Steel-blue tinted -->
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#FFE4EAF4"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#FFCDD6E4"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper"
                               HorizontalAlignment="Left" Width="6"
                               Background="Transparent" Cursor="SizeWE"/>
                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right" Width="6"
                               Background="Transparent" Cursor="SizeWE"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource ColorAccentSubtle}"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource ColorAccentSubtle}"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         LISTBOX
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="10,8"
                            BorderThickness="0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource ColorAccentSubtle}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFE8EDF5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         GROUPBOX — Clean panel
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="12,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFE4EAF4" Offset="0"/>
                                    <GradientStop Color="#FFEDF1F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter ContentSource="Header"
                                            TextElement.Foreground="{DynamicResource TextBrush}"
                                            TextElement.FontWeight="Bold"
                                            TextElement.FontSize="13"/>
                        </Border>
                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,6,6"
                                Padding="16">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         MENU
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SCROLLBAR — Slim, neutral
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
