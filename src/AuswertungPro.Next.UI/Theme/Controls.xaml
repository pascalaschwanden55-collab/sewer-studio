            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="AccentBar"
                    Width="3"
                    Height="14"
                    CornerRadius="1.5"
                    Background="{DynamicResource AccentBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="1,0,0,0"
                    Opacity="0"/>
            <Border x:Name="Outer"
                    Grid.ColumnSpan="3"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="IconSlot"
                                      Grid.Column="0"
                                      ContentSource="Icon"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Glyph"
                               Grid.Column="0"
                               Text="&#xE73E;"
                               FontFamily="{DynamicResource FontIcon}"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="&#xE76C;"
                               FontFamily="{DynamicResource FontIcon}"
                               FontSize="10"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   Placement="Right"
                   HorizontalOffset="-2"
                   AllowsTransparency="True"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Focusable="False"
                   PopupAnimation="None">
                <Border x:Name="PopupBorder"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PopupShift"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#30000000"
                                          BlurRadius="18"
                                          ShadowDepth="4"
                                          Direction="270"/>
                    </Border.Effect>
                    <ScrollViewer CanContentScroll="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                <Setter TargetName="IconSlot" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="AccentBar"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource AnimDurationFast}"
                                             EasingFunction="{StaticResource AnimEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="AccentBar"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource AnimDurationFast}"
                                             EasingFunction="{StaticResource AnimEaseIn}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PopupBorder"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1"
                                             Duration="{StaticResource AnimDurationNormal}"
                                             EasingFunction="{StaticResource AnimEaseOut}"/>
                            <DoubleAnimation Storyboard.TargetName="PopupShift"
                                             Storyboard.TargetProperty="X"
                                             From="-6" To="0"
                                             Duration="{StaticResource AnimDurationNormal}"
                                             EasingFunction="{StaticResource AnimEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

