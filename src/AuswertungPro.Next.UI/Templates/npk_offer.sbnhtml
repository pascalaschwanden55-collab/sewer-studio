<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <style>
    @page { size: A4; }
    * { box-sizing: border-box; }
    body { font-family: 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 10pt; margin: 0; color: #1a1a1a; line-height: 1.38; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 12px; border-bottom: 2px solid #0b5e7a; margin-bottom: 18px; }
    .brand { display: flex; align-items: flex-start; gap: 12px; }
    .logo { height: 54px; width: auto; }
    .sender { white-space: pre-line; font-size: 9.5pt; line-height: 1.3; }
    .doc-meta { text-align: right; font-size: 9.5pt; line-height: 1.35; }
    .doc-meta .doc-label { font-size: 12pt; font-weight: 700; color: #0b5e7a; text-transform: uppercase; }
    .title { font-size: 18pt; color: #0b5e7a; font-weight: 700; margin: 0 0 4px; }
    .subtitle { margin: 0 0 18px; color: #444; font-size: 11pt; }
    .info-row { display: flex; gap: 14px; margin-bottom: 14px; }
    .info-card { flex: 1; border: 1px solid #d4d8dc; border-radius: 8px; background: #fafbfc; padding: 10px 12px; min-height: 72px; }
    .info-card h4 { margin: 0 0 6px; font-size: 9pt; text-transform: uppercase; color: #0b5e7a; letter-spacing: 0.04em; }
    .content { white-space: pre-line; }
    .intro { margin: 18px 0; }
    .intro p { margin: 0 0 8px; }
    .sum-box { margin: 22px 0 18px auto; width: 360px; border: 2px solid #0b5e7a; border-radius: 8px; padding: 12px 14px; background: #f4f8fa; }
    .sum-label { color: #0b5e7a; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 9pt; }
    .sum-value { font-size: 20pt; font-weight: 800; margin-top: 4px; text-align: right; }
    .page-break { break-before: page; page-break-before: always; }
    h2.section { margin: 18px 0 8px; font-size: 11pt; color: #0b5e7a; text-transform: uppercase; letter-spacing: 0.04em; }
    table { width: 100%; border-collapse: collapse; margin-top: 4px; }
    th, td { padding: 6px 7px; vertical-align: top; }
    thead { display: table-header-group; }
    tr, .info-card, .sum-box, .conditions { break-inside: avoid; page-break-inside: avoid; }
    thead th { background: #0b5e7a; color: #fff; font-size: 8.8pt; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; }
    tbody td { border-bottom: 1px solid #e8eaec; }
    .right { text-align: right; }
    .muted { color: #666; font-size: 9pt; }
    .filter-chip { margin: 0 0 12px; border-left: 4px solid #0b5e7a; background: #f3f7f9; padding: 6px 10px; font-size: 9.5pt; color: #234; }
    .totals { margin-top: 16px; display: flex; justify-content: flex-end; }
    .totals table { width: 390px; }
    .totals td { border-bottom: 1px solid #eee; }
    .totals tr.final td { border-top: 2px solid #0b5e7a; border-bottom: none; font-weight: 800; background: #f4f8fa; font-size: 11pt; }
    .conditions { margin-top: 16px; border: 1px solid #d4d8dc; border-radius: 8px; padding: 10px 12px; background: #fafbfc; }
    .conditions-row { display: grid; grid-template-columns: 150px 1fr; gap: 12px; margin: 3px 0; }
    .conditions-label { color: #0b5e7a; font-weight: 700; }
    .footnotes { margin-top: 14px; font-size: 9pt; color: #5a4a20; }
    .footnotes li { margin-bottom: 4px; }
  </style>
</head>
<body>
  <div class="header">
    <div class="brand">
      {{ if LogoDataUri != "" }}
        <img class="logo" src="{{ LogoDataUri }}" />
      {{ end }}
      <div class="sender">{{ SenderBlock }}</div>
    </div>
    <div class="doc-meta">
      <div class="doc-label">{{ DocumentKindLabel }}</div>
      <div>Nr.: {{ OfferNo }}</div>
      <div>Datum: {{ DateText }}</div>
      <div>Gueltig: {{ ValidityText }}</div>
    </div>
  </div>

  <h1 class="title">{{ ProjectTitle }}</h1>
  {{ if VariantTitle != "" }}
    <p class="subtitle">{{ VariantTitle }}</p>
  {{ end }}
  {{ if FilterSummaryText != "" }}
    <div class="filter-chip">{{ FilterSummaryText }}</div>
  {{ end }}

  <div class="info-row">
    <div class="info-card">
      <h4>Auftraggeber</h4>
      <div class="content">{{ CustomerBlock }}</div>
    </div>
    <div class="info-card">
      <h4>Objekt</h4>
      <div class="content">{{ ObjectBlock }}</div>
    </div>
  </div>

  {{ if ReferenceBlock != "" }}
    <div class="info-card">
      <h4>Referenzen</h4>
      <div class="content">{{ ReferenceBlock }}</div>
    </div>
  {{ end }}

  <div class="intro">
    {{ for block in IntroBlocks }}
      <p>{{ block }}</p>
    {{ end }}
  </div>

  <div class="sum-box">
    <div class="sum-label">Offertsumme inkl. MwSt.</div>
    <div class="sum-value">{{ Totals.TotalInclVatText }}</div>
  </div>

  <div class="conditions">
    {{ for line in ConditionLines }}
      <div class="conditions-row">
        <div class="conditions-label">{{ line.Label }}</div>
        <div>{{ line.ValueText }}</div>
      </div>
    {{ end }}
  </div>

  <div class="page-break"></div>

  <h2 class="section">Kapiteluebersicht</h2>
  <table>
    <thead>
      <tr>
        <th style="width: 18%;">Kapitel</th>
        <th>Arbeitsgattung</th>
        <th class="right" style="width: 24%;">Betrag exkl. MwSt.</th>
      </tr>
    </thead>
    <tbody>
      {{ for line in ChapterSummaryLines }}
        <tr>
          <td>{{ line.Chapter }}</td>
          <td>{{ line.Title }}</td>
          <td class="right">{{ line.TotalText }}</td>
        </tr>
      {{ end }}
    </tbody>
  </table>

  <div class="totals">
    <table>
      <tr><td>Total brutto exkl. MwSt.</td><td class="right">{{ Totals.GrossNetText }}</td></tr>
      <tr><td>Rabatt</td><td class="right">{{ Totals.DiscountText }}</td></tr>
      <tr><td>Skonto</td><td class="right">{{ Totals.SkontoText }}</td></tr>
      <tr><td>Total netto exkl. MwSt.</td><td class="right">{{ Totals.NetText }}</td></tr>
      <tr><td>Mehrwertsteuer</td><td class="right">{{ Totals.VatText }}</td></tr>
      <tr class="final"><td>Total inkl. MwSt.</td><td class="right">{{ Totals.TotalInclVatText }}</td></tr>
    </table>
  </div>

  <h2 class="section">NPK-135-Leistungsverzeichnis</h2>
  <table>
    <thead>
      <tr>
        <th style="width: 11%;">NPK</th>
        <th style="width: 13%;">Kapitel</th>
        <th>Beschreibung</th>
        <th class="right" style="width: 7%;">DN</th>
        <th class="right" style="width: 9%;">Menge</th>
        <th style="width: 7%;">EH</th>
        <th class="right" style="width: 13%;">EP</th>
        <th class="right" style="width: 14%;">Betrag</th>
      </tr>
    </thead>
    <tbody>
      {{ for line in PositionLines }}
        <tr>
          <td>{{ line.NpkCode }}</td>
          <td class="muted">{{ line.ChapterTitle }}</td>
          <td>{{ line.Text }}<br /><span class="muted">{{ line.HoldingCountText }} Haltung(en)</span></td>
          <td class="right">{{ line.DnText }}</td>
          <td class="right">{{ line.QtyText }}</td>
          <td>{{ line.Unit }}</td>
          <td class="right">{{ line.UnitPriceText }}</td>
          <td class="right">{{ line.TotalText }}</td>
        </tr>
      {{ end }}
    </tbody>
  </table>

  {{ if Footnotes.size > 0 }}
    <ul class="footnotes">
      {{ for note in Footnotes }}
        <li>{{ note }}</li>
      {{ end }}
    </ul>
  {{ end }}
</body>
</html>
