<Window x:Class="AuswertungPro.Next.UI.Views.ProtocolObservationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        xmlns:behaviors="clr-namespace:AuswertungPro.Next.UI.Behaviors"
        xmlns:protocol="clr-namespace:AuswertungPro.Next.UI.Views.Protocol"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        Title="SewerStudio — Beobachtungen / Schäden"
        MinWidth="900"
        MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <protocol:CodeGroupBrushConverter x:Key="CodeGroupBrush"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource CardBrush}"
                CornerRadius="{DynamicResource RadiusL}"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:NovaDialogHeader Grid.Row="0" x:Name="Kopf"/>

                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="StartNachprotokollButton" Content="Nachprotokoll starten" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0"/>
                    <Button x:Name="StartNeuButton" Content="Neu-Protokoll" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0"/>
                    <Button x:Name="RestoreOriginalButton" Content="Original wiederherstellen" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0"/>
                    <Button x:Name="HistoryButton" Content="Historie..." Style="{StaticResource ToolbarButton}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusL}"
                Background="{DynamicResource CardBrush}">
            <DataGrid x:Name="EntriesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      behaviors:PhotoHoverPreviewBehavior.IsEnabled="True"
                      MouseDoubleClick="EntriesGrid_MouseDoubleClick"
                      PreviewKeyDown="EntriesGrid_PreviewKeyDown"
                      AlternationCount="2"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      MinRowHeight="30">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Code als Gruppen-Badge: Farbe zeigt die VSA-Hauptgruppe (Struktur/Betrieb/Bestand) -->
                    <DataGridTemplateColumn Header="Code" Width="110" SortMemberPath="Code">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Code, Converter={StaticResource CodeGroupBrush}, ConverterParameter=subtle}"
                                        CornerRadius="{DynamicResource RadiusS}" Padding="7,2" Margin="2,3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontFamily="Consolas"
                                               FontWeight="SemiBold" FontSize="{DynamicResource TextS}"
                                               Foreground="{Binding Code, Converter={StaticResource CodeGroupBrush}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Bedeutung" Binding="{Binding Code, Converter={StaticResource VsaCodeToLabel}}" Width="160"/>
                    <DataGridTextColumn Header="m+" Binding="{Binding MeterStart, StringFormat=F2}" Width="90" ElementStyle="{StaticResource MonoCellStyle}"/>
                    <DataGridTextColumn Header="m-" Binding="{Binding MeterEnd, StringFormat=F2}" Width="90" ElementStyle="{StaticResource MonoCellStyle}"/>
                    <DataGridCheckBoxColumn Header="Strecke" Binding="{Binding IsStreckenschaden}" Width="80"/>
                    <DataGridTextColumn Header="Zustand / Beschreibung" Binding="{Binding Beschreibung}" Width="*"/>
                    <DataGridTextColumn Header="Zeit" Binding="{Binding Zeit, StringFormat={}{0:hh\\:mm\\:ss}}" Width="110"/>
                    <DataGridTextColumn Header="MPEG" Binding="{Binding Mpeg}" Width="110"/>
                    <DataGridTextColumn Header="Fotos" Binding="{Binding FotoPaths.Count}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DialogButtonBar}" Margin="0,10,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="NewButton" Content="Neu" Width="100" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="CopyButton" Content="Kopieren" Width="110" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="DeleteButton" Content="Löschen" Width="100" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="OverlayButton" Content="Im Video einblenden" Width="160" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="TrainButton" Content="Als Training speichern" Width="160" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="ExportPdfButton" Content="Haltungsprotokoll PDF" Width="180" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="Schliessen" Width="110" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
