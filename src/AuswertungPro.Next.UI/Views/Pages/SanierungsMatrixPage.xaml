<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.SanierungsMatrixPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding PageTitle}"
                               Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding PageSubtitle}"
                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GesamtTotal, StringFormat='Total: {0:N2} CHF'}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding BelegteHaltungen, StringFormat='{}{0} Haltungen mit Massnahme'}"
                                   Opacity="0.7" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Preise / Katalog" Command="{Binding KatalogBearbeitenCommand}" Margin="0,0,8,0"
                            ToolTip="Den (einen) Preis-Katalog bearbeiten — Preise pro m / Stk / DN. Wird nach dem Schliessen sofort angewendet."/>
                    <Button Content="Neu laden" Command="{Binding ReloadCommand}" Margin="0,0,8,0"/>
                    <Button Content="Speichern" Command="{Binding SpeichernCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Matrix -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False"
                      GridLinesVisibility="All" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Haltung" Binding="{Binding Holding}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="DN" Binding="{Binding Dn}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Laenge m" Binding="{Binding Laenge}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Anschl." Binding="{Binding Anschluesse}" IsReadOnly="True" Width="70"/>

                    <DataGridTemplateColumn Header="Massnahmen" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding MeasuresSummary}"
                                               Margin="6,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMultipleStoredMeasures}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding DataContext.MeasureOptions,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedMeasure, Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsMatrixEditable}"
                                              IsSynchronizedWithCurrentItem="False"
                                              PreviewMouseLeftButtonDown="MeasureComboBox_PreviewMouseLeftButtonDown"
                                              Margin="2">
                                        <ComboBox.Style>
                                            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMultipleStoredMeasures}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Menge: bei Liner = Laenge (gesperrt), bei Reparatur Stueckzahl eingebbar -->
                    <DataGridTemplateColumn Header="Menge" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Menge, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                         IsReadOnly="{Binding IsMengeReadOnly}"
                                         IsEnabled="{Binding IsMatrixEditable}"
                                         BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridCheckBoxColumn Header="VD" Width="44"
                                            Binding="{Binding OptVerkehrsdienst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridCheckBoxColumn Header="Wasser" Width="60"
                                            Binding="{Binding OptWasserhaltung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridCheckBoxColumn Header="Fraesen" Width="62"
                                            Binding="{Binding OptFraesen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridCheckBoxColumn Header="Dicht." Width="52"
                                            Binding="{Binding OptDichtheit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridCheckBoxColumn Header="Doku" Width="48"
                                            Binding="{Binding OptDokumentation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsMatrixEditable}"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>

                    <DataGridTextColumn Header="Total CHF" Binding="{Binding Total, StringFormat=N2}"
                                        IsReadOnly="True" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Hinweis" Binding="{Binding Hinweis}" IsReadOnly="True" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding DetailSubtitle}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding DetailTotal}" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Uebernehmen"
                                    Command="{Binding DetailUebernehmenCommand}"
                                    IsEnabled="{Binding IsDetailDirty}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,6,0"/>
                            <Button Content="Verwerfen"
                                    Command="{Binding DetailVerwerfenCommand}"
                                    IsEnabled="{Binding IsDetailDirty}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DetailEditStatus}"
                               Style="{StaticResource Caption}"
                               Margin="0,10,0,4"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedDetailMeasures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderLightBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} CHF'}"
                                                           DockPanel.Dock="Right"
                                                           Style="{StaticResource Caption}"
                                                           Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding MeasureName}"
                                                           Style="{StaticResource Body}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="82"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="Position" Style="{StaticResource Caption}"/>
                                                <TextBlock Grid.Column="2" Text="Menge" Style="{StaticResource Caption}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="EH" Style="{StaticResource Caption}" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="EP" Style="{StaticResource Caption}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="Total" Style="{StaticResource Caption}" TextAlignment="Right"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="44"/>
                                                                <ColumnDefinition Width="76"/>
                                                                <ColumnDefinition Width="82"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Text}"
                                                                       Grid.Column="1"
                                                                       Style="{StaticResource Caption}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                                                     HorizontalContentAlignment="Right"
                                                                     MinWidth="54"
                                                                     Margin="4,0,0,0"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Unit}"
                                                                       Style="{StaticResource Caption}"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="4"
                                                                     Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                                                     HorizontalContentAlignment="Right"
                                                                     MinWidth="66"
                                                                     Margin="4,0,0,0"/>
                                                            <TextBlock Grid.Column="5"
                                                                       Text="{Binding LineTotal, StringFormat='{}{0:N2}'}"
                                                                       Style="{StaticResource Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Opacity="0.7" Margin="2,8,0,0"/>
    </Grid>
</UserControl>
