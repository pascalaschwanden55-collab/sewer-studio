<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.DossiersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Pages"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:dossiers="clr-namespace:AuswertungPro.Next.Domain.Models.Dossiers;assembly=AuswertungPro.Next.Domain">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:CollapseGlyphConverter x:Key="CollapseGlyph"/>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardGlassBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Eigentümerdossiers"
                           Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Gebietsangaben" Padding="12,7" Margin="0,0,8,0"
                            ToolTip="Angaben, die für ALLE Dossiers dieses Projekts gelten: Gebietstitel, Ansprechpartner, Unternehmer, örtliche Bauleitung, Ausführungstermin, Fusszeile und die Standardthemen. Ein einzelnes Dossier darf jedes Feld überschreiben."
                            Command="{Binding EditAreaCommand}"/>
                    <Button Content="Word-Vorlage" Padding="12,7" Margin="0,0,8,0"
                            ToolTip="Die ausgelieferte Vorlage in Word öffnen und anpassen"
                            Command="{Binding OpenTemplateCommand}"/>
                    <Button Content="Speichern" Padding="12,7" Margin="0,0,8,0"
                            ToolTip="Schreibt den aktuellen Stand der Dossiers auf die Platte"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Aktualisieren" Padding="12,7"
                            ToolTip="Liest die Dossierdatei und die Kostendateien neu von der Platte. Nötig, wenn Sie inzwischen woanders Kosten geändert haben."
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Aus Projekt erzeugen" Padding="12,7" Margin="8,0,0,0"
                            ToolTip="Legt für alle Parzellen des Projekts auf einmal Dossiers an. Die Parzellen kommen aus den Leitungsnamen, die Eigentümer aus dem Grundbuch. Sie sehen die Vorschläge vorher und wählen aus."
                            Command="{Binding CreateFromProjectCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inhalt -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste der Liegenschaften -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardGlassBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+  Neue Liegenschaft"
                            ToolTip="Legt EINE Liegenschaft an. Fragt zuerst Gemeinde und Parzelle ab und füllt daraus vor, was die öffentlichen Dienste hergeben: Eigentümer, Adresse und die Leitungen auf der Parzelle."
                            HorizontalAlignment="Stretch" Padding="10,8" Margin="0,0,0,10"
                            Command="{Binding NewDossierCommand}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="↑  Nach oben"
                                Padding="8,5"
                                ToolTip="Verschiebt die gewählte Liegenschaft eine Stelle nach oben und speichert die Reihenfolge."
                                Command="{Binding MoveDossierUpCommand}"/>
                        <Button Grid.Column="2" Content="↓  Nach unten"
                                Padding="8,5"
                                ToolTip="Verschiebt die gewählte Liegenschaft eine Stelle nach unten und speichert die Reihenfolge."
                                Command="{Binding MoveDossierDownCommand}"/>
                    </Grid>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Dossiers}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Owner}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10"/>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                    Visibility="{Binding HasMissingParts,
                                                        Converter={StaticResource BoolToVis}}">
                                            <ui:FluentIcon Glyph="&#xE7BA;" FontSize="10" Foreground="{DynamicResource DangerBrush}" Margin="0,0,3,0"/>
                                            <TextBlock Text="Bauteil fehlt"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Cockpit der gewählten Liegenschaft -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardGlassBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="18">

                <Grid>
                    <!-- Leerzustand -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelection,
                                    Converter={StaticResource InverseBoolToVis}}"
                                x:Name="EmptyState">
                        <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource FontIcon}"
                                   FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="Keine Liegenschaft gewählt"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="15" Margin="0,10,0,0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Links eine Liegenschaft wählen — oder eine neue anlegen."
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Leitungen und Schaechte teilen sich die Hoehe;
                                 der Trenner dazwischen ist verschiebbar. -->
                            <RowDefinition Height="3*" MinHeight="90"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="90"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titel -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DetailTitle}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DetailSubtitle}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,2,0,0"/>

                                <!-- Zugeklappt bleibt der Zusammenzug stehen: die
                                     Zahlen sollen nicht verschwinden, nur ihr Platz. -->
                                <TextBlock Text="{Binding SummaryLine}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding IsSummaryCollapsed,
                                               Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Top"
                                          Padding="10,5"
                                          IsChecked="{Binding IsSummaryCollapsed, Mode=TwoWay}"
                                          ToolTip="Klappt Kennzahlen, Zustand und Schadensliste zu. Der gewonnene Platz geht an die Tabellen der Leitungen und Schächte; der Zusammenzug bleibt als Zeile stehen."
>
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="{Binding IsSummaryCollapsed, Converter={StaticResource CollapseGlyph}}"
                                                   FontSize="11" Margin="0,1,6,0"/>
                                    <TextBlock Text="Kennzahlen"/>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>

                        <!-- Warnung fehlende Leitungen -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource DangerSubtleBrush}"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                Visibility="{Binding HasMissingWarning,
                                    Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding MissingWarning}"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Kennzahlen -->
                        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,0,14"
                                     Visibility="{Binding IsSummaryCollapsed,
                                         Converter={StaticResource InverseBoolToVis}}">
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding HoldingCountText}"
                                               Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="Leitungen"
                                               Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LengthText}"
                                               Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="Gesamtlänge"
                                               Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CostText}"
                                               Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="Sanierungskosten CHF (ohne MWST)"
                                               Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{Binding UrgentText}"
                                               Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="Dringend (Z0/Z1)"
                                               Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Zustand und Schäden -->
                        <Grid Grid.Row="3" Margin="0,0,0,12"
                              Visibility="{Binding IsSummaryCollapsed,
                                  Converter={StaticResource InverseBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Zustand"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding ConditionRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="12"/>
                                                <ProgressBar Grid.Column="1"
                                                             Value="{Binding Percent, Mode=OneWay}"
                                                             Maximum="100" Height="8"
                                                             VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Häufigste Schäden"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding TopDamages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="12" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- Leitungen -->
                        <Border Grid.Row="4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                          <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal"
                                        Margin="12,8,12,4">
                                <TextBlock Text="Leitungen"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"/>
                                <TextBlock Text="{Binding HoldingCountText}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      x:Name="HoldingGrid"
                                      ItemsSource="{Binding HoldingRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      PreviewMouseLeftButtonDown="HoldingGrid_QgisReselectOnClick"
                                      PreviewMouseRightButtonDown="HoldingGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Video abspielen"
                                                  ToolTip="Öffnet den Player mit dem Video dieser Leitung."
                                                  Command="{Binding PlacementTarget.DataContext.PlayHoldingVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                            <MenuItem.Icon>
                                                <ui:FluentIcon Glyph="&#xE768;" Foreground="{DynamicResource MutedBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Haltungsprotokoll (PDF) öffnen…"
                                                  ToolTip="Öffnet das TV-Protokoll dieser Leitung — bevorzugt das unveränderte Original des Kanalunternehmers."
                                                  Command="{Binding PlacementTarget.DataContext.OpenHoldingProtocolCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                            <MenuItem.Icon>
                                                <ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource MutedBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Zur Haltung"
                                                  ToolTip="Wechselt ins Menü Haltungen und wählt dort genau diese Leitung aus — zum Nachsehen oder Bearbeiten der Daten."
                                                  Command="{Binding PlacementTarget.DataContext.NavigateToHoldingCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                            <MenuItem.Icon>
                                                <ui:FluentIcon Glyph="&#xE72A;" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="HoldingNameColumn"
                                                        Header="Leitung" Width="200"
                                                        Binding="{Binding Holding}"/>
                                    <DataGridTextColumn Header="Länge" Width="90"
                                                        Binding="{Binding Length}"/>
                                    <DataGridTextColumn Header="Zustand" Width="140"
                                                        Binding="{Binding Condition}"/>
                                    <DataGridTextColumn x:Name="HoldingMeasureColumn"
                                                        Header="Empfohlene Massnahme" Width="*"
                                                        Binding="{Binding Measures}"/>
                                    <DataGridTextColumn Header="Kosten CHF" Width="110"
                                                        Binding="{Binding Cost}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                          </Grid>
                        </Border>

                        <!-- Trenner: die Aufteilung zwischen Leitungen und
                             Schaechten haengt von der Liegenschaft ab. -->
                        <GridSplitter Grid.Row="5"
                                      Height="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Rows"
                                      Cursor="SizeNS"/>

                        <!-- Schächte -->
                        <Border Grid.Row="6"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal"
                                            Margin="12,8,12,4">
                                    <TextBlock Text="Schächte"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding ShaftCountText}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" Margin="6,0,0,0"/>
                                </StackPanel>

                                <DataGrid Grid.Row="1"
                                          x:Name="ShaftGrid"
                                          ItemsSource="{Binding ShaftRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          PreviewMouseLeftButtonDown="ShaftGrid_QgisReselectOnClick"
                                          PreviewMouseRightButtonDown="ShaftGrid_PreviewMouseRightButtonDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Schachtprotokoll (PDF) öffnen…"
                                                      ToolTip="Öffnet das Protokoll dieses Schachts über denselben sicheren Weg wie im Menü Schächte."
                                                      Command="{Binding PlacementTarget.DataContext.OpenShaftProtocolCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                                <MenuItem.Icon>
                                                    <ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource MutedBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Zum Schacht"
                                                      ToolTip="Wechselt ins Menü Schächte und wählt dort genau diesen Schacht aus — zum Nachsehen oder Bearbeiten der Daten."
                                                      Command="{Binding PlacementTarget.DataContext.NavigateToShaftCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                                <MenuItem.Icon>
                                                    <ui:FluentIcon Glyph="&#xE72A;" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ShaftNameColumn"
                                                            Header="Schacht" Width="200"
                                                            Binding="{Binding Shaft}"/>
                                        <DataGridTextColumn Header="Funktion" Width="160"
                                                            Binding="{Binding Funktion}"/>
                                        <DataGridTextColumn x:Name="ShaftMeasureColumn"
                                                            Header="Empfohlene Massnahme" Width="*"
                                                            Binding="{Binding Measures}"/>
                                        <DataGridTextColumn Header="Kosten CHF" Width="110"
                                                            Binding="{Binding Cost}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Aktionen -->
                        <WrapPanel Grid.Row="7" Margin="0,14,0,0">
                            <Button Content="Leitungen wählen…" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Ankreuzliste aller Leitungen des Projekts. Eine Leitung darf auch in mehreren Dossiers stehen."
                                    Command="{Binding EditHoldingsCommand}"/>
                            <Button Content="Schächte wählen…" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Ankreuzliste aller Schächte des Projekts. Ein Schacht darf auch in mehreren Dossiers stehen."
                                    Command="{Binding EditShaftsCommand}"/>
                            <Button Content="Nachführen" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Ergänzt Leitungen und Schächte, die das Projekt inzwischen kennt. Entfernt nie etwas."
                                    Command="{Binding RefreshDossierCommand}"/>
                            <Button Content="Stammdaten…" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Adresse, Eigentümerzeilen, Werkleitungsplan und die Themen dieses Dossiers bearbeiten."
                                    Command="{Binding EditDossierCommand}"/>
                            <Button Content="Vorschau" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Seite für Seite ansehen und ausfüllen"
                                    Command="{Binding PreviewCommand}"/>
                            <Button Content="Word erzeugen" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Erzeugt die Word-Datei im Dossier-Ordner. Eine vorhandene wird NIE überschrieben — es entsteht ein freier Name, damit Ihre Ergänzungen von Hand erhalten bleiben."
                                    Command="{Binding CreateWordCommand}"/>
                            <Button Content="Haltungsliste erstellen" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Erst nach den Korrekturen erzeugen. Erstellt die Haltungsliste aus dem aktuellen Dossierstand. Eine vorhandene Liste wird nicht überschrieben — es entsteht ein freier Dateiname."
                                    Command="{Binding CreateHoldingListCommand}"/>
                            <Button Content="Schachtliste erstellen" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Erst nach den Korrekturen erzeugen. Erstellt die Schachtliste aus dem aktuellen Dossierstand. Eine vorhandene Liste wird nicht überschrieben — es entsteht ein freier Dateiname."
                                    Command="{Binding CreateShaftListCommand}"/>
                            <Button Content="Beilagen sammeln" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Legt die TV-Protokolle der Leitungen und die Schachtprotokolle in den Beilagen-Ordner. Zuerst das Original des Kanalunternehmers, sonst ein selbst erzeugtes. Von Hand hinzugelegte Beilagen bleiben unangetastet."
                                    Command="{Binding CollectAttachmentsCommand}"/>
                            <Button Content="Alles zu einem PDF" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Sammelt automatisch die Originalprotokolle aller ausgewählten Haltungen und Schächte; bei einer Haltung ohne Original ersatzweise das SewerStudio-Protokoll. Danach wird die Word-Datei mit Microsoft Word oder LibreOffice umgewandelt und mit allen Beilagen zu einem Gesamt-PDF verbunden. Fehlt ein ausgewähltes Protokoll, wird kein unvollständiges Gesamt-PDF erstellt."
                                    Command="{Binding AssemblePdfCommand}"/>
                            <Button Content="Ordner öffnen" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Zeigt den Ordner dieser Liegenschaft im Explorer — mit Word-Datei, Beilagen und Gesamt-PDF."
                                    Command="{Binding OpenFolderCommand}"/>
                            <Button Content="Entfernen" Padding="12,7" Margin="0,0,8,8"
                                    ToolTip="Nimmt die Liegenschaft aus der Liste. Der Ordner mit Word-Datei und Beilagen bleibt erhalten und wird nicht gelöscht."
                                    Command="{Binding DeleteDossierCommand}"/>

                            <ComboBox Width="190" Margin="16,0,0,8" Padding="8,6"
                                      x:Name="StatusCombo"
                                      SelectionChanged="OnStatusChanged">
                                <ComboBoxItem Content="Stand: offen"
                                              Tag="{x:Static dossiers:DossierStatus.Offen}"/>
                                <ComboBoxItem Content="Stand: Word erzeugt"
                                              Tag="{x:Static dossiers:DossierStatus.WordErzeugt}"/>
                                <ComboBoxItem Content="Stand: versendet"
                                              Tag="{x:Static dossiers:DossierStatus.Versendet}"/>
                                <ComboBoxItem Content="Stand: zurück / unterschrieben"
                                              Tag="{x:Static dossiers:DossierStatus.Zurueck}"/>
                            </ComboBox>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Fusszeile -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,8"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Arbeitet…"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
