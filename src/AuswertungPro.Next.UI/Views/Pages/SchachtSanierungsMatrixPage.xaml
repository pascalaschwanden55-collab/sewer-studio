<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.SchachtSanierungsMatrixPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AuswertungPro.Next.UI.Behaviors"
             xmlns:uc="clr-namespace:AuswertungPro.Next.UI.Controls">
    <UserControl.Resources>
        <uc:KostenBalkenBreiteConverter x:Key="KostenBalkenConv"/>
    </UserControl.Resources>
    <Grid behaviors:ViewPersonalization.ViewKey="SchachtMatrix">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GesamtTotal, StringFormat='Total (exkl. MwSt): {0:N2} CHF'}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding BelegteSchaechte, StringFormat='{}{0} Schächte mit Maßnahme'}"
                                   Opacity="0.7" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Neu laden" Command="{Binding ReloadCommand}" Margin="0,0,8,0"/>
                    <Button Content="Speichern" Command="{Binding SpeichernCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Matrix -->
        <DataGrid Grid.Row="1"
                  x:Name="SchachtRowsGrid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  behaviors:GridPersonalization.IsEnabled="True"
                  behaviors:GridPersonalization.GridKey="SchachtMatrix"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False"
                  CanUserReorderColumns="True"
                  GridLinesVisibility="All" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Schacht" Binding="{Binding Schachtnummer}" IsReadOnly="True" Width="1.4*"/>
                <DataGridTextColumn Header="Funktion" Binding="{Binding Funktion}" IsReadOnly="True" Width="1.2*"/>
                <DataGridTextColumn Header="Resultat" Binding="{Binding Resultat}" IsReadOnly="True" Width="1.4*"/>

                <DataGridTemplateColumn Header="Maßnahme" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.MeasureOptions,
                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedMeasure, Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                                      IsSynchronizedWithCurrentItem="False"
                                      Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Menge: Schächte haben keine Auto-Länge -> immer manuell (Stk / Std / m) -->
                <DataGridTemplateColumn Header="Menge" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Menge, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridCheckBoxColumn Header="Reinig." Width="58"
                                        Binding="{Binding OptReinigung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridCheckBoxColumn Header="VD" Width="44"
                                        Binding="{Binding OptVd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridCheckBoxColumn Header="Wasser" Width="60"
                                        Binding="{Binding OptWasserhaltung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridCheckBoxColumn Header="Doku" Width="48"
                                        Binding="{Binding OptDokumentation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <DataGridTextColumn Header="Total CHF" Binding="{Binding Total, StringFormat=N2}"
                                    IsReadOnly="True" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Kostenbalken proportional zum teuersten Zeilen-Total -->
                <DataGridTemplateColumn Header="" Width="120" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid x:Name="BalkenHost" Margin="4,6">
                                <Border HorizontalAlignment="Left" CornerRadius="{DynamicResource RadiusS}"
                                        Background="{DynamicResource AccentBrush}" Opacity="0.35"
                                        ToolTip="{Binding Total, StringFormat='{}{0:N2} CHF'}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource KostenBalkenConv}">
                                            <Binding Path="Total"/>
                                            <Binding Path="DataContext.MaxRowTotal"
                                                     RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                            <Binding Path="ActualWidth" ElementName="BalkenHost"/>
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Hinweis" Binding="{Binding Hinweis}" IsReadOnly="True" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Opacity="0.7" Margin="2,8,0,0"/>
    </Grid>
</UserControl>
