<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.KartePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf">
    <Grid x:Name="MapRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ KARTE ═══ -->
        <mapsui:MapControl x:Name="MapControl" Grid.Row="0"/>

        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520"
                Padding="8"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNetworkGeometry}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <controls:EmptyStateControl Icon="&#xE707;"
                                        Title="Kein Kataster geladen"
                                        Message="Hinterlege eine XTF-Netzdatei in den Einstellungen, damit Haltungen in der Karte erscheinen."/>
        </Border>

        <Border Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Padding="6"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0.72"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=MapRoot}" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Button Width="34" Height="30" MinWidth="34" Padding="0" Margin="0,0,0,4"
                        Style="{StaticResource SecondaryButton}"
                        Click="ZoomIn_Click"
                        ToolTip="Karte vergroessern">
                    <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FontIcon}" FontSize="12"/>
                </Button>
                <Button Width="34" Height="30" MinWidth="34" Padding="0" Margin="0,0,0,4"
                        Style="{StaticResource SecondaryButton}"
                        Click="ZoomOut_Click"
                        ToolTip="Karte verkleinern">
                    <TextBlock Text="&#xE738;" FontFamily="{DynamicResource FontIcon}" FontSize="12"/>
                </Button>
                <Button Width="34" Height="30" MinWidth="34" Padding="0" Margin="0,0,0,4"
                        Style="{StaticResource SecondaryButton}"
                        Click="ZoomToNetwork_Click"
                        ToolTip="Ganzes Netz anzeigen">
                    <TextBlock Text="&#xE9A6;" FontFamily="{DynamicResource FontIcon}" FontSize="12"/>
                </Button>
                <Button Width="34" Height="30" MinWidth="34" Padding="0" Margin="0,0,0,4"
                        Style="{StaticResource SecondaryButton}"
                        Click="ToggleBasemap_Click"
                        ToolTip="Hintergrundkarte umschalten: Satellit → AV-Karte → OpenStreetMap">
                    <TextBlock Text="&#xE909;" FontFamily="{DynamicResource FontIcon}" FontSize="12"/>
                </Button>
                <Button Width="34" Height="30" MinWidth="34" Padding="0"
                        Style="{StaticResource SecondaryButton}"
                        Click="ToggleSchaechte_Click"
                        ToolTip="Schächte (Kreise) ein-/ausblenden — sichtbar erst beim Reinzoomen">
                    <ui:FluentIcon Glyph="&#xE91F;" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Aktive Hintergrundkarte (unten links) -->
        <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,16" Padding="8,3"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Opacity="0.85" IsHitTestVisible="False">
            <TextBlock FontSize="11" Foreground="{DynamicResource TextBrush}">
                <Run Text="Hintergrund: " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding BasemapAnzeige}"/>
            </TextBlock>
        </Border>

        <!-- ═══ INFOPANEL: Stammdaten der angeklickten Haltung (oben rechts) ═══ -->
        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0" Padding="14" Width="250"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedInfo}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Width="22" Height="22" Padding="0"
                            FontSize="11" Command="{Binding SchliesseInfoCommand}"
                            Style="{StaticResource SecondaryButton}" ToolTip="Schließen">
                        <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontIcon}" FontSize="10"/>
                    </Button>
                    <TextBlock Text="{Binding SelectedInfo.Name}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <TextBlock Text="Nennweite" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedInfo.Dn}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Material" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedInfo.Material}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Länge" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedInfo.Laenge}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Zustandsklasse" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedInfo.Zustandsklasse}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </UniformGrid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Video" Command="{Binding OpenInspektionCommand}"
                            IsEnabled="{Binding SelectedInfo.HatVideo}"
                            Style="{StaticResource PrimaryButton}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Detail öffnen" Command="{Binding OpenDetailCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ LEGENDE + STATUSLEISTE ═══ -->
        <Border Grid.Row="1" Padding="10,6" Background="{DynamicResource CardBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderLightBrush}">
            <DockPanel>

                <!-- Legende links: 5 Zustandsklassen (EZ-Skala) aus der Excel-Palette.
                     Feste Hex wie die Netzlinien selbst — Mapsui rendert nicht theme-abhaengig. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zustand: " FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>

                    <Border Width="14" Height="14" Background="#FF0000" CornerRadius="2" Margin="4,0,2,0"/>
                    <TextBlock Text="0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" ToolTip="Zustandsklasse 0 — Sofortmassnahme"/>

                    <Border Width="14" Height="14" Background="#FF6600" CornerRadius="2" Margin="0,0,2,0"/>
                    <TextBlock Text="1" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" ToolTip="Zustandsklasse 1 — kurzfristig"/>

                    <Border Width="14" Height="14" Background="#FFFF00" CornerRadius="2" Margin="0,0,2,0"/>
                    <TextBlock Text="2" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" ToolTip="Zustandsklasse 2 — mittelfristig"/>

                    <Border Width="14" Height="14" Background="#AEB135" CornerRadius="2" Margin="0,0,2,0"/>
                    <TextBlock Text="3" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" ToolTip="Zustandsklasse 3 — langfristig"/>

                    <Border Width="14" Height="14" Background="#92D050" CornerRadius="2" Margin="0,0,2,0"/>
                    <TextBlock Text="4" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" ToolTip="Zustandsklasse 4 — kein Handlungsbedarf"/>

                    <Border Width="14" Height="14" Background="#3D4D63" CornerRadius="2" Margin="6,0,2,0"/>
                    <TextBlock Text="Unbekannt" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,16,0"/>
                </StackPanel>

                <!-- Gewählte Haltung + Schaltfläche Mitte -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ausgewählt: " FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding SelectedHaltungsname, TargetNullValue=—}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="4,0,12,0"/>
                    <Button Content="Inspektion öffnen"
                            Command="{Binding OpenInspektionCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,4"/>
                </StackPanel>

                <!-- Statustext rechts -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                           MaxWidth="400" Margin="16,0,0,0"/>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
