<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.ImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <!-- Import Toolbar Card -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="6,4" CornerRadius="8">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding ImportKanalProjektCommand}"
                            Style="{StaticResource ToolbarButtonAccent}" Margin="0,0,8,0"
                            ToolTip="Quellordner der Kanalfernsehdaten wählen — erkennt WinCan/IKAS automatisch, importiert massgebliche Quelle + Pro-Beobachtung-Fotos, archiviert Rohdaten, verteilt Filme/PDFs, alles relativ verlinkt">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Import Kanalfernseh-Projekt" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ProtokollNeuGenerierenCommand}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,8,0"
                            ToolTip="Am Ende der Bearbeitung: erzeugt je Haltung das programm-eigene Protokoll (mit Fotos, Suffix _E) in die Verteilung. Das Original-Protokoll bleibt unberuehrt.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource FontIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Protokoll neu generieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4"/>

                    <TextBlock Text="Manuell:" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.7" FontSize="11"/>

                    <Button Command="{Binding ImportPdfCommand}"
                            Style="{StaticResource ToolbarButtonAccent}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" FontFamily="{DynamicResource FontIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Import PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportSchachtPdfsFolderCommand}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                            ToolTip="Verteil-Ordner wählen: verteilt Protokolle name-basiert auf Haltungen UND Schächte (rekursiv, legt fehlende Schächte an)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" FontFamily="{DynamicResource FontIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Protokolle verteilen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4"/>

                    <Button Click="DropdownButton_Click"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                            ToolTip="XTF/M150/MDB, WinCan, IBAK, KINS, SchachtPro importieren">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Weitere Quellen" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource FontIcon}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="XTF / M150 / MDB" Command="{Binding ImportXtfCommand}">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE968;" Foreground="{DynamicResource MutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="WinCan-Projekte" Command="{Binding ImportWinCanCommand}">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE8F1;" Foreground="{DynamicResource MutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="IBAK-Projekte" Command="{Binding ImportIbakCommand}">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE714;" Foreground="{DynamicResource MutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="KINS-Projekte" Command="{Binding ImportKinsCommand}">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE8A7;" Foreground="{DynamicResource MutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="SchachtPro-Archiv (.spro)" Command="{Binding ImportSchachtProCommand}">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE8F1;" Foreground="{DynamicResource MutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4"/>

                    <Button Command="{Binding ExportImportSummaryCommand}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Import-Report" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenLastReportCommand}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                            ToolTip="Letzten Import-Bericht öffnen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Letzter Bericht" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenReportFolderCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Bericht-Ordner öffnen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Berichte" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4"/>

                    <Button Command="{Binding MakeProjectPortableCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Alle Medienpfade relativ machen + Fotos ins Projekt holen → Projektordner 1:1 auf anderen PC kopierbar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Projekt portabel machen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AssignPhotosFromFolderCommand}"
                            Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                            ToolTip="Fotos aus einem Quellordner (IKAS/WinCan) den Beobachtungen zuordnen + ins Projekt holen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE91B;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Fotos zuordnen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Nur fehlende Felder ergänzen (vorhandene Daten nicht überschreiben)"
                          IsChecked="{Binding FillMissingOnly}"
                          Foreground="{DynamicResource TextBrush}"
                          ToolTip="Beim Re-Import werden nur leere Felder aufgefüllt. Bereits vorhandene Werte bleiben unverändert."/>

                <CheckBox Content="Erst Vorschau anzeigen"
                          IsChecked="{Binding ShowPreviewFirst}"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="16,0,0,0"
                          ToolTip="Führt einen Dry-Run durch und zeigt die erwarteten Änderungen, bevor der eigentliche Import startet."/>
            </StackPanel>

            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Command="{Binding ReloadCatalogCommand}"
                        Content="Katalog neu laden"
                        Style="{StaticResource ToolbarButton}"
                        Padding="10,3"
                        ToolTip="Liest den VSA-Codekatalog erneut von der eingestellten Quelle."/>
                <TextBlock Text="{Binding CatalogStatus}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="8" Margin="0,0,0,8" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImportInProgress}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Command="{Binding CancelImportCommand}"
                            Content="Abbrechen" Margin="8,0,0,0" Padding="12,2"
                            IsEnabled="{Binding CanCancel}"
                            Style="{StaticResource ToolbarButton}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="{DynamicResource FontIcon}" FontSize="14" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ImportPhase}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ImportProgress}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar Height="6" Maximum="100" Value="{Binding ImportProgressPercent}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Zusammenfassung" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding SummaryText}" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     MinHeight="120"/>
            <Expander Header="Details" Margin="0,8,0,0">
                <TextBox Text="{Binding DetailsText}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         MinHeight="160"/>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
