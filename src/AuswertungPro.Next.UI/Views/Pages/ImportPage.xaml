<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.ImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls">

    <!-- Aufbau (28.09.2026): oben der Normalfall (ganzer Kanalfernseh-Export), darunter
         Sonderfaelle (einzelne Quellen, Nacharbeiten). Nur Anordnung und Texte; alle Befehle
         sind dieselben wie vorher. Die ganze Seite liegt in einem ScrollViewer, damit auf
         Full HD bei 150 Prozent nichts abgeschnitten wird. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <ctrl:NovaPageHeader Title="Import" Subtitle="Daten ins Projekt holen. Oben der Normalfall, darunter Sonderfälle.">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding OpenLastReportCommand}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                            ToolTip="Letzten Import-Bericht öffnen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Letzter Bericht" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenReportFolderCommand}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                            ToolTip="Ordner mit allen Import-Berichten öffnen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Alle Berichte" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportImportSummaryCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Zusammenfassung des aktuellen Projektstands als neuen Bericht (CSV) speichern">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Bericht erstellen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ctrl:NovaPageHeader>

            <!-- Karte 1: Normalfall, ganzer Kanalfernseh-Export -->
            <Border x:Name="AbschnittNormalfall" Style="{DynamicResource Card}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource RadiusXL}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Projekt importieren" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Ganzen Kanalfernseh-Export übernehmen" FontSize="{DynamicResource TextXL}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Ordner wählen – das Format wird erkannt (WinCan, IKAS, KINS). Haltungen, Protokolle, Filme, Fotos, Dichtheits- und Schachtprotokolle werden in einem Lauf übernommen und im Projekt abgelegt. Am Ende gibt es einen Bericht."
                               FontSize="{DynamicResource TextM}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,12"/>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox Content="Nur leere Felder füllen"
                                  IsChecked="{Binding FillMissingOnly}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,20,4"
                                  ToolTip="Beim erneuten Import werden nur leere Felder aufgefüllt. Bereits vorhandene Werte bleiben unverändert."/>
                        <CheckBox Content="Erst Probelauf zeigen"
                                  IsChecked="{Binding ShowPreviewFirst}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,20,4"
                                  ToolTip="Macht zuerst einen Probelauf und zeigt die erwarteten Änderungen, bevor der eigentliche Import startet."/>
                    </WrapPanel>

                    <Button Command="{Binding ImportKanalProjektCommand}"
                            Style="{StaticResource ToolbarButtonAccent}" HorizontalAlignment="Left"
                            ToolTip="Quellordner der Kanalfernsehdaten wählen — erkennt das Format automatisch, importiert die massgebliche Quelle samt Fotos je Beobachtung, archiviert Rohdaten, verteilt Filme und PDFs, alles relativ verlinkt">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextL}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Ordner wählen und importieren" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Sonderfaelle: zwei Karten nebeneinander -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="AbschnittEinzelneQuellen" Grid.Column="0" Style="{DynamicResource Card}" CornerRadius="{DynamicResource RadiusXL}">
                    <StackPanel>
                        <TextBlock Text="Einzelne Quellen" FontSize="{DynamicResource TextL}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Nur wenn nicht der ganze Export vorliegt." FontSize="{DynamicResource TextS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,12"/>

                        <Button Command="{Binding ImportPdfCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Einzelne PDF-Protokolle einlesen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="PDF-Protokolle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportXtfCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="XTF-, M150- oder MDB-Datei einlesen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="XTF / M150 / MDB" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportWinCanCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Ein einzelnes WinCan-Projekt einlesen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="WinCan-Projekt" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportIbakCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Ein einzelnes IBAK-Projekt einlesen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="IBAK-Projekt" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportKinsCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Ein einzelnes KINS-Projekt einlesen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="KINS-Projekt" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportSchachtProCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Archiv aus der SchachtPro-App einlesen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="SchachtPro-Archiv (.spro)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportSchachtProQrCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left"
                                ToolTip="QR-Code eines SchachtPro-Protokolls aus einem Bild (PNG/JPG) lesen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED14;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="SchachtPro-QR aus Bild" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="AbschnittNacharbeiten" Grid.Column="2" Style="{DynamicResource Card}" CornerRadius="{DynamicResource RadiusXL}">
                    <StackPanel>
                        <TextBlock Text="Nacharbeiten" FontSize="{DynamicResource TextL}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Am bestehenden Projekt, nach einem Import." FontSize="{DynamicResource TextS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,12"/>

                        <Button Command="{Binding ImportSchachtPdfsFolderCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Ordner wählen: legt Protokolle nach ihrem Namen zu Haltungen und Schächten (rekursiv, legt fehlende Schächte an)">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8B5;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextL}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Protokolle aus einem Ordner zuordnen" TextWrapping="Wrap"/>
                                    <TextBlock Text="PDFs nach Namen zu Haltungen und Schächten legen" FontSize="{DynamicResource TextXS}"
                                               FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Command="{Binding AssignPhotosFromFolderCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Fotos aus einem Quellordner (IKAS/WinCan) den Beobachtungen zuordnen und ins Projekt holen">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE91B;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextL}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Fotos zuordnen" TextWrapping="Wrap"/>
                                    <TextBlock Text="Fotos aus einem Quellordner den Beobachtungen zuordnen" FontSize="{DynamicResource TextXS}"
                                               FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Command="{Binding ProtokollNeuGenerierenCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Am Ende der Bearbeitung: erzeugt je Haltung das programmeigene Protokoll (mit Fotos, Suffix _E) in die Verteilung. Das Original-Protokoll bleibt unberührt.">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE72C;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextL}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Eigene Protokolle neu erzeugen" TextWrapping="Wrap"/>
                                    <TextBlock Text="SewerStudio-Protokolle mit Fotos für alle Haltungen" FontSize="{DynamicResource TextXS}"
                                               FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Command="{Binding MakeProjectPortableCommand}" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left"
                                ToolTip="Alle Medienpfade relativ machen und Fotos ins Projekt holen, damit der Projektordner 1:1 auf einen anderen PC kopiert werden kann">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8C8;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextL}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Projekt portabel machen" TextWrapping="Wrap"/>
                                    <TextBlock Text="Projektordner auf einen anderen PC kopierbar machen" FontSize="{DynamicResource TextXS}"
                                               FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Fusszeile: Katalogstatus -->
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Command="{Binding ReloadCatalogCommand}"
                        Content="Katalog neu laden"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Liest den VSA-Codekatalog erneut von der eingestellten Quelle."/>
                <TextBlock Text="{Binding CatalogStatusKurz}" ToolTip="{Binding CatalogStatus}"
                           VerticalAlignment="Center" FontSize="{DynamicResource TextS}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,8,0"/>
            </DockPanel>

            <!-- Fortschritt des laufenden Imports -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="{DynamicResource ImportCardPadding}" Margin="0,0,0,12" CornerRadius="{DynamicResource RadiusL}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsImportInProgress}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="{DynamicResource ImportRowGap}">
                        <Button DockPanel.Dock="Right" Command="{Binding CancelImportCommand}"
                                Content="Abbrechen" Margin="{DynamicResource ImportItemGap}"
                                IsEnabled="{Binding CanCancel}"
                                Style="{StaticResource ToolbarButton}"/>
                        <ctrl:NeuralPulseDot DockPanel.Dock="Left" IsActive="{Binding IsImportInProgress}"
                                             Width="{DynamicResource ImportPulseSize}" Height="{DynamicResource ImportPulseSize}"
                                             DotBrush="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding ImportPhase}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="{DynamicResource TextM}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="{DynamicResource ImportItemGap}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <DockPanel Margin="{DynamicResource ImportRowGap}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ImportCounter}" Margin="{DynamicResource ImportItemGap}"
                                   FontSize="{DynamicResource TextS}" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding ImportProgress}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource TextS}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ImportProgress}"/>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource ImportProgressBar}" Maximum="100" Value="{Binding ImportProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding ImportIsIndeterminate}" AutomationProperties.Name="Fortschritt im laufenden Importschritt"/>
                    <TextBlock Text="{Binding ImportRemaining}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource TextS}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Ergebnis -->
            <StackPanel>
                <TextBlock Text="Zusammenfassung" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding SummaryText}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         MinHeight="120" MaxHeight="480"/>
                <Expander Header="Technische Details" IsExpanded="False" Margin="0,8,0,0"
                          ToolTip="Nur bei einem Fehler wichtig: vollständige technische Meldung fürs Nachfragen beim Support.">
                    <TextBox Text="{Binding DetailsText}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             MinHeight="160" MaxHeight="480"/>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
