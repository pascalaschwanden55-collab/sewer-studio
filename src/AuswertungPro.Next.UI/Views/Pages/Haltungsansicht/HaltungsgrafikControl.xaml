<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.Haltungsansicht.HaltungsgrafikControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             AutomationProperties.Name="Haltungsgrafik des Protokolls"
             ToolTip="Haltungsgrafik des Protokolls: Rohr in Aufnahmerichtung, Schadenssymbole, Meter-Skala und Schachtknoten">
    <Grid ClipToBounds="True">
        <!-- Die Grafik behaelt ihr Seitenverhaeltnis; die Viewbox passt sie in die Spalte ein. -->
        <Viewbox x:Name="Buehne" Stretch="Uniform" StretchDirection="Both"/>
        <TextBlock x:Name="Hinweis" Visibility="Collapsed" TextWrapping="Wrap"
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                   FontSize="{DynamicResource TextS}" Foreground="{DynamicResource MutedBrush}"/>
    </Grid>
</UserControl>
