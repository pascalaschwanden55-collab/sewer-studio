<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.Haltungsansicht.HaltungsansichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Views.Controls"
             xmlns:uc="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Pages.Haltungsansicht"
             xmlns:behaviors="clr-namespace:AuswertungPro.Next.UI.Behaviors"
             xmlns:pages="clr-namespace:AuswertungPro.Next.UI.Views.Pages"
             x:Name="Root">
    <UserControl.Resources>
        <local:HaltungSummaryConverter x:Key="SummaryConv"/>
        <local:ZustandsklasseBrushConverter x:Key="ZkBrushConv"/>
        <local:SchadenMeterConverter x:Key="SchadenMeterConv"/>
        <local:SchadenKlartextConverter x:Key="SchadenKlartextConv"/>
        <local:SchadenKategorieConverter x:Key="SchadenKategorieConv"/>
        <pages:GegenVideoVorhandenConverter x:Key="GegenVideoVis"/>

        <Style x:Key="HaltungListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Liste links (virtualisiert) -->
        <ListBox Grid.Column="0"
                 x:Name="HaltungList"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Records}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource HaltungListItemStyle}"
                 SelectionChanged="HaltungList_SelectionChanged"
                 PreviewMouseLeftButtonUp="HaltungList_PreviewMouseLeftButtonUp"
                 PreviewMouseRightButtonDown="HaltungList_PreviewMouseRightButtonDown"
                 Background="{DynamicResource CardBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Position nach oben" Click="CtxMoveUp_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74A;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Position nach unten" Click="CtxMoveDown_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74B;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Beobachtungen..." Click="CtxBeobachtungen_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE890;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Play" Click="CtxPlay_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE768;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Play (Gegeninspektion)" Click="CtxPlayGegen_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE768;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Haltungsprotokoll AWU drucken..." Click="CtxPrintAwu_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE749;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Haltungsprotokoll Original (PDF) öffnen..." Click="CtxOpenPdf_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Gehe zu Ordner" Click="CtxOpenFolder_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sanierungsmaßnahmen..." Click="CtxCosts_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE90F;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Haltung löschen" Click="CtxDelete_Click" Foreground="{DynamicResource DangerBrush}">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74D;" Foreground="{DynamicResource DangerBrush}"/></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <!-- Laufende Nummer = Feld NR (automatisch = Position, siehe HaltungRunningNumberService) -->
                                <TextBlock Text="{Binding Fields[NR]}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,8,0" MinWidth="16" TextAlignment="Right"/>
                                <TextBlock Text="{Binding Fields[Haltungsname]}" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <!-- Marker: Gegeninspektion (2. Video Link_G) vorhanden. -->
                                <ui:FluentIcon Glyph="&#xE8AB;" FontSize="12" Margin="6,0,0,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               ToolTip="Diese Haltung hat 2 Videos / Inspektionen">
                                    <ui:FluentIcon.Visibility>
                                        <MultiBinding Converter="{StaticResource GegenVideoVis}">
                                            <Binding Path="Fields[Link_G]"/>
                                            <Binding ElementName="Root" Path="HaltungLastProjectPath"/>
                                            <Binding Path="Fields[Haltungsname]"/>
                                            <Binding ElementName="Root" Path="MehrfachInspektionsBasen"/>
                                        </MultiBinding>
                                    </ui:FluentIcon.Visibility>
                                </ui:FluentIcon>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SummaryConv}">
                                        <Binding Path="Fields[DN_mm]"/>
                                        <Binding Path="Fields[Haltungslaenge_m]"/>
                                        <Binding Path="Fields[Nutzungsart]"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="22" CornerRadius="4" VerticalAlignment="Center" Margin="8,0,4,0"
                                Background="{Binding Fields[Zustandsklasse], Converter={StaticResource ZkBrushConv}}">
                            <TextBlock Text="{Binding Fields[Zustandsklasse]}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#000000" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"/>

        <!-- Detail rechts: Feld-Karten oben, Primaere-Schaeden-Tabelle unten (per Splitter hoehenverstellbar) -->
        <Grid Grid.Column="2" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="SchadenRowDef" Height="240" MinHeight="80"/>
            </Grid.RowDefinitions>

            <controls:RecordDetailsView Grid.Row="0" x:Name="Detail" IsCompactLayout="True"/>

            <!-- Ziehbarer Splitter: stellt die Hoehe des Schaeden-Panels ein; Hoehe wird gespeichert. -->
            <GridSplitter Grid.Row="1" Height="6" Margin="0,4,0,0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderBrush}"
                          DragCompleted="SchadenSplitter_DragCompleted"
                          ToolTip="Ziehen, um die Höhe von &quot;Primäre Schäden&quot; einzustellen"/>

            <Border Grid.Row="2" Margin="0,4,0,0" Padding="12"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Primäre Schäden" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" x:Name="SchadenAddButton"
                                Width="28" Height="24" FontSize="16" Padding="0"
                                Click="SchadenAdd_Click" ToolTip="Neue Beobachtung codieren">
                            <ui:FluentIcon Glyph="&#xE710;" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </DockPanel>

                    <!-- Foto-Galerie: alle Schadensfotos der Haltung, aufklappbar. -->
                    <Expander x:Name="FotoExpander" DockPanel.Dock="Top" Margin="0,0,0,8"
                              Visibility="Collapsed" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock x:Name="FotoExpanderHeader" Text="Fotos" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Expander.Header>
                        <uc:PhotoGalleryPanel x:Name="FotoGalerie" Margin="0,4,0,0"/>
                    </Expander>

                    <ListBox x:Name="SchadenList"
                             ItemsSource="{Binding SelectedProtocolEntries}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             behaviors:PhotoHoverPreviewBehavior.IsEnabled="True"
                             MouseDoubleClick="SchadenList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8,5"
                                        Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Text="{Binding Converter={StaticResource SchadenMeterConv}}"/>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Padding="6,2"
                                                CornerRadius="4" Background="#1E3A8A">
                                            <TextBlock Text="{Binding Code}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="6,0" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"
                                                   Text="{Binding Converter={StaticResource SchadenKlartextConv}}"/>
                                        <Border Grid.Column="3" VerticalAlignment="Center" Padding="6,2" CornerRadius="4"
                                                Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Converter={StaticResource SchadenKategorieConv}}"
                                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
