<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.Haltungsansicht.HaltungAufklappListe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:uc="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Views.Controls"
             xmlns:pages="clr-namespace:AuswertungPro.Next.UI.Views.Pages"
             xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Pages.Haltungsansicht"
             xmlns:dp="clr-namespace:AuswertungPro.Next.UI.DataPage"
             xmlns:na="clr-namespace:AuswertungPro.Next.Application.UseCases.NaechsteAufgabe;assembly=AuswertungPro.Next.Application"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Spaltenbreiten: EINMAL hier. Kopfzeile, Zeile und die Statusgruppe lesen dieselben
             Werte. SharedSizeGroup waere der uebliche Weg, misst bei Virtualisierung aber nur
             die gerade erzeugten Zeilen und laesst die Kopfzeile springen. -->
        <GridLength x:Key="SpaltePfeil">28</GridLength>
        <GridLength x:Key="SpalteName">170</GridLength>
        <GridLength x:Key="SpalteStrasse">140</GridLength>
        <GridLength x:Key="SpalteMaterial">110</GridLength>
        <GridLength x:Key="SpalteDn">70</GridLength>
        <GridLength x:Key="SpalteLaenge">80</GridLength>
        <GridLength x:Key="SpalteZustand">60</GridLength>
        <GridLength x:Key="SpalteKi">130</GridLength>
        <GridLength x:Key="SpaltePruefung">190</GridLength>
        <GridLength x:Key="SpalteVideo">48</GridLength>
        <GridLength x:Key="SpalteProtokoll">56</GridLength>
        <GridLength x:Key="SpalteRest">*</GridLength>

        <BooleanToVisibilityConverter x:Key="BoolSichtbar"/>
        <pages:InverseBooleanToVisibilityConverter x:Key="BoolSichtbarUmgekehrt"/>
        <pages:StringNotEmptyToVisibilityConverter x:Key="TextSichtbar"/>
        <uc:GrossbuchstabenConverter x:Key="Grossbuchstaben"/>
        <local:HaltungAufgeklapptConverter x:Key="IstAufgeklappt"/>
        <local:SchmaleBreiteConverter x:Key="IstSchmal"/>
        <local:PfeilBeschriftungConverter x:Key="PfeilBeschriftung"/>
        <!-- Leerer Wert wird zum Gedankenstrich, nie zu einer nackten Einheit. -->
        <local:FaktWertConverter x:Key="FaktWert"/>
        <dp:HaltungZeilenStatusConverter x:Key="ZeilenStatus"/>
        <dp:AufzaehlungSichtbarkeitConverter x:Key="Aufzaehlung"/>
        <dp:ZustandsklasseChipTextConverter x:Key="ZkChipText"/>
        <dp:ZustandsklasseChipHintergrundConverter x:Key="ZkChipGrund"/>
        <dp:ZustandsklasseChipSichtbarkeitConverter x:Key="ZkChipSichtbar"/>
        <dp:ZustandsklasseInkConverter x:Key="ZkInk"/>

        <!-- Die Tinte jeder Zelle folgt der Zeile: Der implizite TextBlock-Stil setzt Foreground
             selbst und schlaegt die Vererbung (Befund B7). Ein eigener Stil pro Zelle ist der
             belegte Weg, damit eine gewaehlte Zeile lesbar bleibt. -->
        <Style x:Key="ZellenText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="{DynamicResource TextS}"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        </Style>
        <Style x:Key="ZellenTextMono" TargetType="TextBlock" BasedOn="{StaticResource ZellenText}">
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        </Style>
        <Style x:Key="ZellenTextMonoRechts" TargetType="TextBlock" BasedOn="{StaticResource ZellenTextMono}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="KopfText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="{DynamicResource TextXS}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style x:Key="KopfTextRechts" TargetType="TextBlock" BasedOn="{StaticResource KopfText}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Der Pfeil: ein Chevron nach rechts, der beim Aufklappen um 90 Grad dreht (Prototyp v2).
             Foreground wird ausdruecklich gesetzt, weil ein eigener Stil den impliziten
             TextBlock-Stil ersetzt und das Zeichen sonst die geerbte Tinte bekaeme. -->
        <Style x:Key="ChevronStil" TargetType="ui:FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IstAufgeklappt}">
                            <Binding/>
                            <Binding Path="Aufgeklappt" RelativeSource="{RelativeSource AncestorType=local:HaltungAufklappListe}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Eine Zeile: Kopfzeile immer, Formular nur fuer die aufgeklappte Haltung. -->
        <Style x:Key="ZeilenStil" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ZeilenRahmen"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ZeilenRahmen" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ZeilenRahmen" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                <Setter TargetName="ZeilenRahmen" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Die vier Statusspalten: der Zeilenstatus wird EINMAL je Zeile gerechnet und als
             Inhalt weitergereicht (dieselbe Regel wie in der Tabelle). -->
        <DataTemplate x:Key="StatusVorlage">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource SpalteKi}"/>
                    <ColumnDefinition Width="{StaticResource SpaltePruefung}"/>
                    <ColumnDefinition Width="{StaticResource SpalteVideo}"/>
                    <ColumnDefinition Width="{StaticResource SpalteProtokoll}"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource MutedBrush}" Visibility="{Binding Ampel, Converter={StaticResource Aufzaehlung}, ConverterParameter=KeineAnalyse}"/>
                        <Ellipse Fill="{DynamicResource WarningBrush}" Visibility="{Binding Ampel, Converter={StaticResource Aufzaehlung}, ConverterParameter=Offen}"/>
                        <Ellipse Fill="{DynamicResource SuccessBrush}" Visibility="{Binding Ampel, Converter={StaticResource Aufzaehlung}, ConverterParameter=Bestaetigt}"/>
                        <Ellipse Fill="{DynamicResource SuccessBrush}" Visibility="{Binding Ampel, Converter={StaticResource Aufzaehlung}, ConverterParameter=Geprueft}"/>
                        <Ellipse Fill="{DynamicResource DangerBrush}" Visibility="{Binding Ampel, Converter={StaticResource Aufzaehlung}, ConverterParameter=Kritisch}"/>
                    </Grid>
                    <TextBlock Text="{Binding AmpelText}" Style="{StaticResource ZellenText}"/>
                </StackPanel>

                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SuccessSubtleBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusPill}" Padding="8,1"
                            Visibility="{Binding Pruefstand, Converter={StaticResource Aufzaehlung}, ConverterParameter=Abgeschlossen}">
                        <TextBlock Text="{Binding PruefungText}" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="{DynamicResource TextXS}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border Background="{DynamicResource KiSubtleBrush}" BorderBrush="{DynamicResource KiTextBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusPill}" Padding="8,1"
                            Visibility="{Binding Pruefstand, Converter={StaticResource Aufzaehlung}, ConverterParameter=KiAnalysiert}">
                        <TextBlock Text="{Binding PruefungText}" Foreground="{DynamicResource KiTextBrush}"
                                   FontSize="{DynamicResource TextXS}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusPill}" Padding="8,1"
                            Visibility="{Binding Pruefstand, Converter={StaticResource Aufzaehlung}, ConverterParameter=Offen}">
                        <TextBlock Text="{Binding PruefungText}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="{DynamicResource TextXS}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>

                <!-- Video und Protokoll rufen die vorhandenen Befehle der Seite mit dem Datensatz
                     der Zeile. Ein Knopf erscheint nur bei HINTERLEGTEM Pfad; ob die Datei noch
                     da ist, sagt erst der Oeffner (Fixwelle 2b, F1). -->
                <Grid Grid.Column="2">
                    <Button Style="{DynamicResource IconButton}" Width="24" Height="24" MinHeight="24"
                            Command="{Binding VideoCommand, RelativeSource={RelativeSource AncestorType=local:HaltungAufklappListe}}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                            Visibility="{Binding HatVideo, Converter={StaticResource BoolSichtbar}}"
                            ToolTip="Video abspielen"
                            AutomationProperties.Name="{Binding DataContext.Fields[Haltungsname], RelativeSource={RelativeSource AncestorType=ListBoxItem}, StringFormat='Video {0} abspielen'}">
                        <ui:FluentIcon Glyph="&#xE768;"/>
                    </Button>
                    <TextBlock Text="–" Style="{StaticResource ZellenText}" HorizontalAlignment="Center"
                               ToolTip="{x:Static na:HaltungProtokollQuelle.OhneVideoHinweis}"
                               Visibility="{Binding HatVideo, Converter={StaticResource BoolSichtbarUmgekehrt}}"/>
                </Grid>

                <Grid Grid.Column="3">
                    <Button Style="{DynamicResource IconButton}" Width="36" Height="24" MinHeight="24"
                            Command="{Binding ProtokollCommand, RelativeSource={RelativeSource AncestorType=local:HaltungAufklappListe}}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                            Visibility="{Binding HatProtokoll, Converter={StaticResource BoolSichtbar}}"
                            ToolTip="Protokoll öffnen"
                            AutomationProperties.Name="{Binding DataContext.Fields[Haltungsname], RelativeSource={RelativeSource AncestorType=ListBoxItem}, StringFormat='Protokoll {0} öffnen'}">
                        <TextBlock Text="PDF" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold"/>
                    </Button>
                    <TextBlock Text="–" Style="{StaticResource ZellenText}" HorizontalAlignment="Center"
                               ToolTip="{x:Static na:HaltungProtokollQuelle.OhneProtokollHinweis}"
                               Visibility="{Binding HatProtokoll, Converter={StaticResource BoolSichtbarUmgekehrt}}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Die Themen nebeneinander; auf schmalen Bildschirmen in zwei Spalten. -->
        <ItemsPanelTemplate x:Key="ThemenPanelBreit">
            <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ThemenPanelSchmal">
            <UniformGrid Columns="2"/>
        </ItemsPanelTemplate>
        <Style x:Key="ThemenListStil" TargetType="ItemsControl">
            <Setter Property="ItemsPanel" Value="{StaticResource ThemenPanelBreit}"/>
            <Style.Triggers>
                <DataTrigger Value="True"
                             Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:HaltungAufklappListe}, Converter={StaticResource IstSchmal}}">
                    <Setter Property="ItemsPanel" Value="{StaticResource ThemenPanelSchmal}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Das Formular der EINEN aufgeklappten Haltung. Es steht ausschliesslich hier; jede
             andere Zeile traegt einen ContentControl ohne Inhalt. -->
        <DataTemplate x:Key="FormularVorlage">
            <Border x:Name="FormularWurzel" Margin="8,2,8,10" Padding="10,8"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusM}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Text="{Binding Aufgeklappt.Fields[Haltungsname], RelativeSource={RelativeSource AncestorType=local:HaltungAufklappListe}}"
                                   FontFamily="{DynamicResource FontMono}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <!-- Konflikthinweis (W01): verworfene Eingabe nach einer neueren Korrektur -->
                        <TextBlock DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Hinweis, RelativeSource={RelativeSource AncestorType=local:HaltungAufklappListe}}"
                                   FontSize="{DynamicResource TextS}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   ToolTip="{Binding Hinweis, RelativeSource={RelativeSource AncestorType=local:HaltungAufklappListe}}"
                                   Visibility="{Binding Hinweis, RelativeSource={RelativeSource AncestorType=local:HaltungAufklappListe}, Converter={StaticResource TextSichtbar}}"/>
                        <Button DockPanel.Dock="Right" Content="Alle zu" Click="AlleZu_Click"
                                Style="{DynamicResource ToolbarButton}" Margin="6,0,0,0"
                                ToolTip="Alle Themen zuklappen" AutomationProperties.Name="Alle Themen zuklappen"/>
                        <Button DockPanel.Dock="Right" Content="Alle auf" Click="AlleAuf_Click"
                                Style="{DynamicResource ToolbarButton}"
                                ToolTip="Alle Themen aufklappen" AutomationProperties.Name="Alle Themen aufklappen"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding}" Style="{StaticResource ThemenListStil}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- TwoWay: Der Zustand gehoert dem Thema, nicht dem Expander. Beim Scrollen und beim
                                     Wechsel der Anordnung an der 1100-px-Schwelle wird der Expander neu gebaut. -->
                                <Expander IsExpanded="{Binding IstAufgeklappt, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="{DynamicResource RadiusChip}"
                                                    Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Anzahl}" FontFamily="{DynamicResource FontMono}"
                                                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource MutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <controls:RecordDetailsView IsCompactLayout="True" IsHeaderVisible="False" Groups="{Binding EinzelGruppe}"/>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!-- ENDE FormularVorlage -->

        <!-- Der Traeger des Formulars. Vorlage UND Inhalt werden NUR im Trigger gesetzt: Ein
             ContentPresenter rendert seine ContentTemplate auch bei Content=null — mit der
             Vorlage als Grundzustand haette jede der 300 Zeilen den leeren Formularrahmen samt
             Kopfzeile getragen (gemessen: 8 sichtbare Zeilen, 8 Rahmen). -->
        <Style x:Key="FormularTraeger" TargetType="ContentControl">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IstAufgeklappt}">
                            <Binding/>
                            <Binding Path="Aufgeklappt" RelativeSource="{RelativeSource AncestorType=local:HaltungAufklappListe}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="ContentTemplate" Value="{StaticResource FormularVorlage}"/>
                    <Setter Property="Content" Value="{Binding Themen, RelativeSource={RelativeSource AncestorType=local:HaltungAufklappListe}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusL}">
        <DockPanel>
            <!-- Beschriftungszeile ueber der Liste, in Grossbuchstaben wie der Tabellenkopf. -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource SpaltePfeil}"/>
                        <ColumnDefinition Width="{StaticResource SpalteName}"/>
                        <ColumnDefinition Width="{StaticResource SpalteStrasse}"/>
                        <ColumnDefinition Width="{StaticResource SpalteMaterial}"/>
                        <ColumnDefinition Width="{StaticResource SpalteDn}"/>
                        <ColumnDefinition Width="{StaticResource SpalteLaenge}"/>
                        <ColumnDefinition Width="{StaticResource SpalteZustand}"/>
                        <ColumnDefinition Width="{StaticResource SpalteKi}"/>
                        <ColumnDefinition Width="{StaticResource SpaltePruefung}"/>
                        <ColumnDefinition Width="{StaticResource SpalteVideo}"/>
                        <ColumnDefinition Width="{StaticResource SpalteProtokoll}"/>
                        <ColumnDefinition Width="{StaticResource SpalteRest}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource KopfText}" Text="{Binding Source=Haltung, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource KopfText}" Text="{Binding Source=Strasse, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource KopfText}" Text="{Binding Source=Material, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource KopfTextRechts}" Text="{Binding Source=DN, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="5" Style="{StaticResource KopfTextRechts}" Text="{Binding Source=Länge, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="6" Style="{StaticResource KopfText}" TextAlignment="Center" Text="{Binding Source=Zustand, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="7" Style="{StaticResource KopfText}" Text="{Binding Source=KI, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="8" Style="{StaticResource KopfText}" Text="{Binding Source=Prüfung, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="9" Style="{StaticResource KopfText}" TextAlignment="Center" Text="{Binding Source=Video, Converter={StaticResource Grossbuchstaben}}"/>
                    <TextBlock Grid.Column="10" Style="{StaticResource KopfText}" TextAlignment="Center" Text="{Binding Source=Protokoll, Converter={StaticResource Grossbuchstaben}}"/>
                </Grid>
            </Border>

            <!-- CacheLength 1 ITEM statt der Vorgabe "eine Seite": Der Cache haelt Zeilen
                 ausserhalb des Bildes am Leben. Bei einer normalen Liste ist das guenstig, hier
                 haengen davon dutzende Eingabefelder der aufgeklappten Haltung ab. -->
            <ListBox x:Name="Liste"
                     ItemsSource="{Binding ItemsSource, ElementName=Root}"
                     SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ZeilenStil}"
                     HorizontalContentAlignment="Stretch"
                     Background="Transparent" BorderThickness="0"
                     KeyDown="Liste_KeyDown"
                     MouseDoubleClick="Liste_MouseDoubleClick"
                     AutomationProperties.Name="Haltungen"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Standard"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="1"
                     VirtualizingPanel.CacheLengthUnit="Item">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid MinHeight="{DynamicResource RowHeightCompact}" Margin="8,0">
                                <!-- Ist DIESE Zeile die aufgeklappte? Einmal je Zeile gerechnet und
                                     im Tag abgelegt, damit Beschriftung und vorlesbarer Name des
                                     Pfeils als normale Attribute daran binden koennen. -->
                                <Grid.Tag>
                                    <MultiBinding Converter="{StaticResource IstAufgeklappt}">
                                        <Binding/>
                                        <Binding Path="Aufgeklappt" RelativeSource="{RelativeSource AncestorType=local:HaltungAufklappListe}"/>
                                    </MultiBinding>
                                </Grid.Tag>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource SpaltePfeil}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteName}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteStrasse}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteMaterial}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteDn}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteLaenge}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteZustand}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteKi}"/>
                                    <ColumnDefinition Width="{StaticResource SpaltePruefung}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteVideo}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteProtokoll}"/>
                                    <ColumnDefinition Width="{StaticResource SpalteRest}"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Click="Pfeil_Click" Style="{DynamicResource IconButton}"
                                        Width="24" Height="24" MinHeight="24"
                                        ToolTip="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource PfeilBeschriftung}}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource PfeilBeschriftung}}">
                                    <ui:FluentIcon Glyph="&#xE76C;" Style="{StaticResource ChevronStil}"/>
                                </Button>

                                <TextBlock Grid.Column="1" Style="{StaticResource ZellenTextMono}" FontWeight="SemiBold"
                                           Text="{Binding Fields[Haltungsname], Converter={StaticResource FaktWert}}"
                                           ToolTip="{Binding Fields[Haltungsname], Converter={StaticResource FaktWert}}"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource ZellenText}"
                                           Text="{Binding Fields[Strasse], Converter={StaticResource FaktWert}}"
                                           ToolTip="{Binding Fields[Strasse], Converter={StaticResource FaktWert}}"/>
                                <TextBlock Grid.Column="3" Style="{StaticResource ZellenText}"
                                           Text="{Binding Fields[Rohrmaterial], Converter={StaticResource FaktWert}}"
                                           ToolTip="{Binding Fields[Rohrmaterial], Converter={StaticResource FaktWert}}"/>
                                <TextBlock Grid.Column="4" Style="{StaticResource ZellenTextMonoRechts}"
                                           Text="{Binding Fields[DN_mm], Converter={StaticResource FaktWert}}"
                                           ToolTip="{Binding Fields[DN_mm], Converter={StaticResource FaktWert}}"/>
                                <TextBlock Grid.Column="5" Style="{StaticResource ZellenTextMonoRechts}"
                                           Text="{Binding Fields[Haltungslaenge_m], Converter={StaticResource FaktWert}}"
                                           ToolTip="{Binding Fields[Haltungslaenge_m], Converter={StaticResource FaktWert}}"/>

                                <!-- Zustandsklasse als Marke; ein Strich ist der getrennte Zustand
                                     "nicht berechnet" und darf nie als Z4 gelesen werden. -->
                                <Grid Grid.Column="6">
                                    <Border Width="{DynamicResource ZustandsklasseChipBreite}" Height="{DynamicResource ZustandsklasseChipHoehe}"
                                            CornerRadius="{DynamicResource RadiusS}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding Fields[Zustandsklasse], Converter={StaticResource ZkChipGrund}}"
                                            ToolTip="Zustandsklasse"
                                            Visibility="{Binding Fields[Zustandsklasse], Converter={StaticResource ZkChipSichtbar}, ConverterParameter=Gefuellt}">
                                        <TextBlock Text="{Binding Fields[Zustandsklasse], Converter={StaticResource ZkChipText}}"
                                                   Foreground="{Binding Fields[Zustandsklasse], Converter={StaticResource ZkInk}}"
                                                   FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource TextS}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Width="{DynamicResource ZustandsklasseChipBreite}" Height="{DynamicResource ZustandsklasseChipHoehe}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="nicht berechnet"
                                          Visibility="{Binding Fields[Zustandsklasse], Converter={StaticResource ZkChipSichtbar}, ConverterParameter=Leer}">
                                        <!-- RadiusX/RadiusY sind Doubles, das Token RadiusS ein CornerRadius;
                                             deshalb hier dieselbe Ecke als Zahl wie in der Tabellenmarke. -->
                                        <Rectangle Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" StrokeDashArray="2 2" RadiusX="4" RadiusY="4"/>
                                        <TextBlock Text="–" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <ContentControl Grid.Column="7" Grid.ColumnSpan="4" VerticalAlignment="Center"
                                                ContentTemplate="{StaticResource StatusVorlage}">
                                    <ContentControl.Content>
                                        <MultiBinding Converter="{StaticResource ZeilenStatus}">
                                            <Binding Path="."/>
                                            <Binding Path="Fields[Offen_abgeschlossen]"/>
                                            <Binding Path="Protocol"/>
                                        </MultiBinding>
                                    </ContentControl.Content>
                                </ContentControl>
                            </Grid>

                            <ContentControl Style="{StaticResource FormularTraeger}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
