<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctrl:NovaPageHeader Grid.Row="0" Title="Diagnose" Subtitle="Protokoll des laufenden Programms">
            <StackPanel Orientation="Horizontal">
                <Button Content="Log aktualisieren" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Log-Ordner öffnen" Command="{Binding OpenLogFolderCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                <Button Content="Diagnosepaket erstellen" Command="{Binding CreatePackageCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </ctrl:NovaPageHeader>

        <TextBlock Grid.Row="1" Text="{Binding PackageStatus}" TextWrapping="Wrap"
                   Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <TextBox Grid.Row="2" Text="{Binding LogTail}" AcceptsReturn="True" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
