<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.SchattenauswertungPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:ZustandsklasseToBrushConverter x:Key="ZustandsklasseBrush"/>

        <!-- Abweichungs-Ampel: Gruen=deckt sich, Gelb=Massnahme/Kosten, Rot=Klasse, Grau=kein Vergleich -->
        <Style x:Key="AmpelPunkt" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AbweichungKey}" Value="Gleich">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AbweichungKey}" Value="Leicht">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AbweichungKey}" Value="Stark">
                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kopf: Titel + Lauf-Steuerung -->
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Schattenauswertung" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Eigenständige KI-Auswertung aus der Codierung — nur lesend, deine Auswertung bleibt unberührt."/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="mit KI-Empfehlung"
                          IsChecked="{Binding MitKi}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Foreground="{DynamicResource TextBrush}"
                          ToolTip="Zusätzlich zur Regelrechnung je Haltung eine KI-Sanierungsempfehlung mit Begründung einholen (Ollama).">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox"
                               BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Style.Triggers>
                                <!-- Waehrend des Laufs nicht umschaltbar -->
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <Button Content="Neu laden"
                        Command="{Binding NeuLadenCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Margin="0,0,6,0"/>
                <Button Content="Abbrechen"
                        Command="{Binding AbbrechenCommand}"
                        Style="{StaticResource ToolbarButtonDanger}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,6,0"/>
                <Button Content="Schattenlauf starten"
                        Command="{Binding StartenCommand}"
                        Style="{StaticResource ToolbarButtonAccent}"/>
            </StackPanel>
        </DockPanel>

        <!-- Status / Warnung / Fortschritt -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Border Background="{DynamicResource HeaderBrush}" CornerRadius="6" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Zusammenfassung}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="6" Padding="12,8" Margin="0,6,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding FortschrittText}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource TextS}"/>
                    <ProgressBar Height="4" Margin="0,6,0,0"
                                 Minimum="0"
                                 Maximum="{Binding FortschrittMax}"
                                 Value="{Binding FortschrittWert, Mode=OneWay}"
                                 Background="{DynamicResource BorderLightBrush}"
                                 Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,6,0,0"
                    Visibility="{Binding StoreWarnung, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding StoreWarnung}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Vergleichstabelle + Detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <DataGrid ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          FontSize="{DynamicResource TextM}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Haltung" Binding="{Binding Haltung}" Width="150"/>
                        <DataGridTemplateColumn Header="ZK (Ich)" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MenschKlasse}" HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding MenschKlasse, Converter={StaticResource ZustandsklasseBrush}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ZK (Schatten)" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SchattenKlasse}" HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               ToolTip="{Binding SchattenNotenTooltip}"
                                               Foreground="{Binding SchattenKlasse, Converter={StaticResource ZustandsklasseBrush}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Massnahme (Ich)" Binding="{Binding MenschMassnahme}" Width="*"/>
                        <DataGridTextColumn Header="Massnahme (Schatten)" Binding="{Binding SchattenMassnahme}" Width="*"/>
                        <DataGridTextColumn Header="Kosten (Ich)" Binding="{Binding MenschKosten}" Width="90"/>
                        <DataGridTextColumn Header="Kosten (Schatten)" Binding="{Binding SchattenKosten}" Width="110"/>
                        <DataGridTemplateColumn Header="Vergleich" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Style="{StaticResource AmpelPunkt}"
                                             HorizontalAlignment="Center"
                                             ToolTip="{Binding AbweichungTooltip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text=" · veraltet"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontWeight="SemiBold"
                                                   Visibility="{Binding IstVeraltet, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detail: KI-Begründung der gewählten Haltung -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Begründung der Schatten-KI" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding SelectedRow.Haltung, FallbackValue='Haltung in der Tabelle wählen.'}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}" Margin="0,4,0,10"/>

                        <TextBlock Text="{Binding SelectedRow.KostenbandText, FallbackValue=''}"
                                   Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedRow.KiConfidenceText, FallbackValue='', StringFormat='KI-Sicherheit: {0}'}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}" Margin="0,2,0,8"/>

                        <TextBlock Text="{Binding SelectedRow.KiBegruendung, FallbackValue=''}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding SelectedRow.RisikoFlagsText, FallbackValue=''}"
                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding SelectedRow.KiFehler, FallbackValue=''}"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
