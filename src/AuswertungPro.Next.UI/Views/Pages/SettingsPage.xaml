<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:AuswertungPro.Next.UI.Settings"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SettingsSectionGroupBox" TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        </Style>
        <Style x:Key="SettingsTabScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="CanContentScroll" Value="True"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SettingsFormGrid" TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SettingsFieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="0,0,14,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsTextInput" TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsComboInput" TargetType="{x:Type ComboBox}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
        <Style x:Key="SettingsBrowseButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Margin" Value="8,0,0,8"/>
        </Style>
        <Style x:Key="SettingsActionButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="8,0,0,8"/>
        </Style>
        <Style x:Key="SettingsWideActionButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Margin" Value="8,0,0,8"/>
        </Style>
        <Style x:Key="SettingsFieldCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsNavigationTabs" TargetType="{x:Type TabControl}">
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="NavigationPane"
                                    Grid.Column="0"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,10,0,10">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="Einstellungsbereiche"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="4,0,10,10"/>
                                    <TabPanel x:Name="HeaderPanel"
                                              IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Background="Transparent"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ContentPane"
                                    Grid.Column="1"
                                    Margin="14,0,0,0"
                                    Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsMenuHeader" TargetType="{x:Type Grid}">
            <Setter Property="MinWidth" Value="188"/>
        </Style>
        <Style x:Key="SettingsMenuIndexBadge" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,1,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="SettingsMenuHeaderTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingsMenuHeaderHint" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingsMenuSectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingsNavigationMenuItem" TargetType="{x:Type TabItem}">
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Style="{StaticResource SettingsMenuHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsMenuIndexBadge}">
                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Index)}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SectionLabel"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Group)}"
                                           Style="{StaticResource SettingsMenuSectionLabel}"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource SettingsMenuHeaderTitle}"/>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Hint)}"
                                           Style="{StaticResource SettingsMenuHeaderHint}"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.IsGroupStart)}" Value="False">
                                <Setter TargetName="SectionLabel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Group)}" Value="{x:Null}">
                                <Setter TargetName="SectionLabel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Group)}" Value="">
                                <Setter TargetName="SectionLabel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="GroupDivider"
                                    Grid.Row="0"
                                    Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    Opacity="0.75"
                                    Visibility="Collapsed"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentStrip"
                                        Grid.Column="0"
                                        Background="{DynamicResource AccentBarBrush}"
                                        CornerRadius="1.5"
                                        Margin="0,6"
                                        Opacity="0"/>
                                <Border x:Name="HeaderChrome"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="4,0,0,0">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="settings:SettingsNavigation.HasGroupDivider" Value="True">
                                <Setter TargetName="GroupDivider" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="GroupDivider" Property="Margin" Value="0,6,10,8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="AccentStrip" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Content="Speichern"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="140"
                        ToolTip="Alle geaenderten Einstellungen dauerhaft speichern."/>
                <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}" Margin="0,0,12,0"/>
            </DockPanel>

            <TabControl Grid.Row="1"
                        Style="{StaticResource SettingsNavigationTabs}"
                        ItemContainerStyle="{StaticResource SettingsNavigationMenuItem}">
                <TabItem Header="Allgemein"
                         settings:SettingsNavigation.Index="01"
                         settings:SettingsNavigation.Group="Basis"
                         settings:SettingsNavigation.Hint="Design, Diagnose, Speichern"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="False"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="Darstellung und Diagnose" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Design" Style="{StaticResource SettingsFieldLabel}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="Hell" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                        <ToggleButton IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" Width="64" Height="30">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Track"
                                                            Background="{DynamicResource SurfaceSubtleBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="15">
                                                        <Grid>
                                                            <Ellipse x:Name="Thumb"
                                                                     Width="24"
                                                                     Height="24"
                                                                     Margin="3"
                                                                     HorizontalAlignment="Left"
                                                                     Fill="{DynamicResource CardBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <TextBlock Text="Dunkel" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="Anwenden"
                                        Command="{Binding ApplyThemeCommand}"
                                        Style="{StaticResource SettingsActionButton}"
                                        ToolTip="Hell-/Dunkel-Design anwenden."/>
                                <TextBlock Text="Hinweis: für volle Umstellung ist ein Neustart nötig."
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,-2,0,8"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Diagnose" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="Fehlercodes anzeigen"
                                          IsChecked="{Binding EnableDiagnostics}"
                                          Style="{StaticResource SettingsFieldCheckBox}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Speichern" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Automatisch speichern" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AutoSaveModeOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding DataAutoSaveMode, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Dateien und Ordner"
                         settings:SettingsNavigation.Index="02"
                         settings:SettingsNavigation.Group="Daten"
                         settings:SettingsNavigation.Hint="Projekte, Logs, Wiederherstellung"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="True"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="Projektdateien" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Projektpfad (*.json)" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding ProjectPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="..."
                                        Command="{Binding BrowseProjectPathCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        ToolTip="Projektdatei auswaehlen."/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Projekte-Verzeichnis" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding ProjectsRootDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Content="..."
                                        Command="{Binding BrowseProjectsRootCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        ToolTip="Standardordner fuer Projekte auswaehlen."/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kataster-XTF (*.xtf)" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding AbwasserkatasterXtfPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="2" Grid.Column="2"
                                        Content="..."
                                        Command="{Binding BrowseAbwasserkatasterXtfPathCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        ToolTip="Abwasserkataster-XTF fuer die Kartenansicht auswaehlen."/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Datenordner und Logs" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Datenordner" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding DataFolderPath}"
                                         IsReadOnly="True"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="Ordner &#xF6;ffnen"
                                        Command="{Binding OpenDataFolderCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Lokalen SewerStudio-Datenordner im Explorer oeffnen."/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Logs" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding LogsFolderPath}"
                                         IsReadOnly="True"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Content="Logs &#xF6;ffnen"
                                        Command="{Binding OpenLogsFolderCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Log-Ordner im Explorer oeffnen."/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Programmbereinigung" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Zwischendaten"
                                           Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding ProgramCleanupStatusText}"
                                           Margin="0,0,12,8"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Command="{Binding CleanProgramDataCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Bekannte temporaere SewerStudio-Daten pruefen und nach Bestaetigung entfernen.">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="{DynamicResource FontIcon}"
                                                   Text="&#xE74D;"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Pruefen und bereinigen"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Codex-Agenten-Daten"
                                           Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding CodexArtifactCleanupStatusText}"
                                           Margin="0,0,12,8"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Command="{Binding CleanCodexArtifactsCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Nur alte, rein erzeugte Codex-Baukopien nach Vorschau und Bestaetigung entfernen.">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="{DynamicResource FontIcon}"
                                                   Text="&#xE74D;"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Agenten-Daten pruefen"/>
                                    </StackPanel>
                                </Button>

                                <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                             Height="4"
                                             Margin="0,0,0,8"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsProgramCleanupRunning, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Wiederherstellung" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Schutzkopien" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="Wiederherstellungspunkte vor dem Speichern erstellen"
                                          IsChecked="{Binding EnableRestorePoints}"
                                          Style="{StaticResource SettingsFieldCheckBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ablage" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding RestorePointsFolderPath}"
                                         IsReadOnly="True"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Content="Ablage &#xF6;ffnen"
                                        Command="{Binding OpenRestorePointsFolderCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Ordner mit Wiederherstellungspunkten oeffnen."/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Import und Referenzdaten"
                         settings:SettingsNavigation.Index="03"
                         settings:SettingsNavigation.Group="Daten"
                         settings:SettingsNavigation.Hint="Videos, PDF, XTF"
                         settings:SettingsNavigation.IsGroupStart="False"
                         settings:SettingsNavigation.HasGroupDivider="False"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="Importquellen" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Video-Ordner" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding VideoFolder}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Column="2"
                                        Content="..."
                                        Command="{Binding BrowseVideoFolderCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Werkzeuge" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="pdftotext.exe" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding PdfToTextPath}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Column="2"
                                        Content="..."
                                        Command="{Binding BrowsePdfToTextCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Referenzdaten" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="XTF Kanton Uri" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding KantonUriXtfDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="..."
                                        Command="{Binding BrowseKantonUriXtfDirectoryCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,-4,0,8"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"
                                           Text="Gesamter XTF-Datenbestand Kanton Uri: Leitungen und Sch&#xE4;chte."/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Video und KI"
                          settings:SettingsNavigation.Index="04"
                          settings:SettingsNavigation.Group="Betrieb"
                          settings:SettingsNavigation.Hint="Wiedergabe, KI-Start, Schwellen"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="True"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="Video-Player" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Wiedergabe" Style="{StaticResource SettingsFieldLabel}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                                    <CheckBox Content="Hardware-Decoding aktiv" IsChecked="{Binding VideoHwDecoding}" Style="{StaticResource SettingsFieldCheckBox}"/>
                                    <CheckBox Content="Drop late frames" IsChecked="{Binding VideoDropLateFrames}" Style="{StaticResource SettingsFieldCheckBox}"/>
                                    <CheckBox Content="Skip frames" IsChecked="{Binding VideoSkipFrames}" Style="{StaticResource SettingsFieldCheckBox}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Video-Ausgabe" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          Width="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding VideoOutputOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding VideoOutput, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Datei-Cache" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          Width="140"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding VideoCacheOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding VideoFileCachingMs, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Netzwerk-Cache" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          Width="140"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding VideoCacheOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding VideoNetworkCachingMs, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Codec-Threads" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Row="4" Grid.Column="1"
                                          Width="140"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding VideoCodecThreadOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding VideoCodecThreads, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="KI-Laufzeit" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Autostart" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="KI beim Programmstart starten"
                                          IsChecked="{Binding StartAiOnProgramStart}"
                                          Style="{StaticResource SettingsFieldCheckBox}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Start" Style="{StaticResource SettingsFieldLabel}"/>
                                <Button Grid.Row="1" Grid.Column="1"
                                        Content="KI jetzt starten"
                                        Command="{Binding StartAiCommand}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource SettingsActionButton}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding AiStartupStatusText}"
                                           Margin="10,0,0,8"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                             Height="4"
                                             Margin="0,0,0,8"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsAiStarting, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="KI-Schwellwerte" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="YOLO-Konfidenz" Style="{StaticResource SettingsFieldLabel}"/>
                                <Slider Grid.Row="0" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding PipelineYoloConfidence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        Margin="0,0,10,8"
                                        ToolTip="Mindest-Konfidenz fuer YOLO-Detektionen."/>
                                <Border Grid.Row="0" Grid.Column="2"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PipelineYoloConfidence, StringFormat={}{0:P0}}"
                                               FontFamily="Consolas, Cascadia Mono"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="0" Grid.Column="3"
                                        Content="Reset"
                                        Command="{Binding ResetYoloConfidenceCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        Width="64"
                                        ToolTip="YOLO-Konfidenz auf Standardwert 25 Prozent setzen."/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="DINO Box" Style="{StaticResource SettingsFieldLabel}"/>
                                <Slider Grid.Row="1" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding PipelineDinoBoxThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        Margin="0,0,10,8"
                                        ToolTip="Mindestwert fuer DINO-Box-Erkennung."/>
                                <Border Grid.Row="1" Grid.Column="2"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PipelineDinoBoxThreshold, StringFormat={}{0:P0}}"
                                               FontFamily="Consolas, Cascadia Mono"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="1" Grid.Column="3"
                                        Content="Reset"
                                        Command="{Binding ResetDinoBoxThresholdCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        Width="64"
                                        ToolTip="DINO-Box-Schwellwert auf Standardwert 25 Prozent setzen."/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="DINO Text" Style="{StaticResource SettingsFieldLabel}"/>
                                <Slider Grid.Row="2" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding PipelineDinoTextThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        Margin="0,0,10,8"
                                        ToolTip="Mindestwert fuer DINO-Text-Matching."/>
                                <Border Grid.Row="2" Grid.Column="2"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PipelineDinoTextThreshold, StringFormat={}{0:P0}}"
                                               FontFamily="Consolas, Cascadia Mono"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="2" Grid.Column="3"
                                        Content="Reset"
                                        Command="{Binding ResetDinoTextThresholdCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        Width="64"
                                        ToolTip="DINO-Text-Schwellwert auf Standardwert 20 Prozent setzen."/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Datensicherung"
                         settings:SettingsNavigation.Index="05"
                         settings:SettingsNavigation.Group="Sicherung"
                         settings:SettingsNavigation.Hint="KI-Wissen, PC-Schutz"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="True"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="KI-Wissen" Style="{StaticResource SettingsSectionGroupBox}">
                            <StackPanel>
                                <TextBlock Text="KI-Wissen Backup" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="Exportiert alle KI-Lerndaten, Trainingssamples, Einstellungen und Frames als ZIP. Für Backup oder PC-Migration."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="KI-Wissen exportieren" Command="{Binding ExportBackupCommand}" Width="180"
                                            ToolTip="KI-Wissen, Trainingsdaten und zugehoerige Einstellungen als ZIP sichern."/>
                                    <Button Content="KI-Wissen importieren" Command="{Binding ImportBackupCommand}" Margin="8,0,0,0" Width="180"
                                            ToolTip="Gesichertes KI-Wissen aus einer ZIP-Datei wiederherstellen."/>
                                </StackPanel>
                                <TextBlock Text="{Binding BackupStatusText}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="PC-Ausfall-Schutz" Style="{StaticResource SettingsSectionGroupBox}">
                            <StackPanel>
                                <TextBlock Text="Datensicherung (kompletter PC-Ausfall-Schutz)" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="Spiegelt Programm, Git-Verlauf, Projekte, KI-Gehirn, Einstellungen und Logs in einen gewählten Ordner. Projektvideos sind standardmässig aus Platzgründen ausgeschaltet."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox Content="Projektvideos ebenfalls sichern"
                                          IsChecked="{Binding IncludeProjectVideosInFullBackup}"
                                          Margin="0,0,0,8"
                                          ToolTip="Kann die Sicherung je nach Videobestand stark vergrössern."/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Datensicherung erstellen..."
                                                Command="{Binding CreateFullBackupCommand}"
                                                Width="210"
                                                ToolTip="Programmdaten, Git-Verlauf, KI-Wissen, Einstellungen und Logs in einen Sicherungsordner spiegeln."/>
                                        <TextBlock Text="{Binding FullBackupOperation.LastBackupInfo}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding FullBackupOperation.IsRunning, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Height="10"
                                                         Value="{Binding FullBackupOperation.Percent}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FullBackupOperation.Percent, StringFormat={}{0:0}%}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                            <Button Grid.Column="2"
                                                    Content="Abbrechen"
                                                    Command="{Binding CancelFullBackupCommand}"
                                                    Margin="8,0,0,0"
                                                    Width="110"
                                                    ToolTip="Laufende Datensicherung abbrechen."/>
                                        </Grid>
                                        <TextBlock Text="{Binding FullBackupOperation.CurrentFile}"
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding FullBackupOperation.StatusText}" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Hilfe"
                         settings:SettingsNavigation.Index="06"
                         settings:SettingsNavigation.Group="Hilfe"
                         settings:SettingsNavigation.Hint="Handbuch, Kurzbefehle"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="True"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
        <!-- ═══════════════════════════════════════════════════════════════════
             PROGRAMM-ANLEITUNG
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Margin="0,0,0,0" Padding="0,0,0,4"
                BorderThickness="0,0,0,2" BorderBrush="{DynamicResource AccentBrush}">
            <TextBlock Text="Programm-Anleitung  SewerStudio"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
        </Border>

        <TextBlock Text="Vollständige Dokumentation aller Funktionen, KI-Module und Workflows."
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,20" FontSize="12"/>

        <!-- ── 1. Uebersicht ──────────────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="1. Programmüberblick" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" LineHeight="20">
                    SewerStudio ist eine professionelle Anwendung für die Kanalinspektion und
                    Zustandsbewertung nach dem Schweizer Standard SN EN 13508-2 (bzw. DIN EN 13508-2).
                    Die Software vereint Datenerfassung, Videoanalyse, KI-gestützte Schadenserkennung,
                    VSA-Zustandsbewertung und Sanierungskostenberechnung in einer einzigen Plattform.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" LineHeight="20" Margin="0,8,0,0">
                    Der typische Arbeitsablauf: Projekt erstellen, Inspektionsdaten importieren (PDF/XTF/WinCan/IBAK),
                    Videos verknüpfen, KI-Analyse durchführen, VSA-Bewertung berechnen, Sanierungsmaßnahmen
                    vorschlagen und Ergebnisse als Excel/PDF exportieren.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── 2. Seitennavigation ────────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="2. Seiten und Navigation" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Übersicht" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Startseite mit Projektverwaltung. Zeigt alle gespeicherten Projekte, ermöglicht das Erstellen
                    neuer Projekte und das Öffnen vorhandener *.json-Projektdateien. Das zuletzt geöffnete Projekt
                    kann per Schnellzugriff fortgesetzt werden.
                </TextBlock>

                <TextBlock Text="Projekt" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Metadaten des aktuellen Projekts: Name, Beschreibung, Auftraggeber, Gemeinde, Inspektionsdatum,
                    Firma und Kontaktperson. Diese Angaben erscheinen auf allen exportierten Berichten und Protokollen.
                </TextBlock>

                <TextBlock Text="Haltungen" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Zentrale Datenseite für alle Kanalsegmente (Haltungen). Bearbeitbares DataGrid mit Suche,
                    Zoom, Zeilenhöhe, Spaltenausrichtung und Multi-Monitor-Support (Abdocken auf zweiten Bildschirm).
                    Kontextmenü bietet Zugriff auf Protokolle, Videoanalyse, Sanierungsmaßnahmen und Kostenrechner.
                    Toolbar-Dropdowns: Sanierungsmaßnahmen (Kostenrechner, Vorschlag aus Schadenscodes, Alle Maßnahmen vorschlagen)
                    und Medien suchen (automatische Video/PDF-Verknüpfung).
                </TextBlock>

                <TextBlock Text="Schächte" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Verwaltung der Schacht-Inspektionspunkte. Gleiche Funktionen wie Haltungen: Hinzufügen,
                    Löschen, Verschieben, Suchen, Spaltenbearbeitung und Detailansicht.
                    Unterstützt PDF-Protokollgenerierung und Foto-Verwaltung.
                </TextBlock>

                <TextBlock Text="Import" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Importiert Inspektionsdaten aus verschiedenen Quellen:
                    PDF (OCR via pdftotext oder Formularfelder), XTF/M150/MDB (Austauschformat für Kanalinspektion),
                    WinCan (TV-Inspektionssoftware), IBAK (Roboter-Inspektionssystem) und KINS (Kombinationsformat).
                    Option "Nur fehlende Felder auffüllen" ergänzt Daten ohne vorhandene zu überschreiben.
                </TextBlock>

                <TextBlock Text="Export" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Exportiert Haltungen und Schächte als Excel-Dateien mit konfigurierbaren Vorlagen.
                    Verteilungsfunktion sortiert exportierte Dateien in Ordnerstrukturen
                    nach Haltung, Schacht oder Prüfstatus.
                </TextBlock>

                <TextBlock Text="Medienkonflikte" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Zeigt mehrdeutige oder fehlende Zuordnungen zwischen Videos/PDFs und Haltungen an.
                    Ermöglicht das manuelle Auflösen von Konflikten bei der automatischen Medienverknüpfung.
                </TextBlock>

                <TextBlock Text="Druckcenter" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Filterbare Druckansicht mit Kosten-, Eigentümer- und Positionszusammenfassung.
                    Komplexe Filteroptionen (Suche, Eigentümer, Material, Status, Jahr) mit
                    Statistiken zu Rehabilitationsquoten und Kostenverteilung. Export als PDF möglich.
                </TextBlock>

                <TextBlock Text="VSA" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Berechnet die VSA-Zustandsbewertung (Klassen 0-4) für alle Haltungen und Schächte
                    basierend auf den erfassten Schadencodes. Verwendet den Klassifikationskatalog nach
                    SN EN 13508-2 mit separaten Regeln für Kanäle und Schächte.
                </TextBlock>

                <TextBlock Text="Diagnose" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Live-Protokoll mit Anwendungsmeldungen, Fehlern und KI-Diagnosen. Nützlich für
                    Fehlersuche und Überwachung der KI-Pipeline-Ausführung.
                </TextBlock>

                <TextBlock Text="Einstellungen" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                    Diese Seite. Konfiguration aller Anwendungsparameter: Dateipfade, Autospeicherung,
                    Wiederherstellungspunkte, Video-Player-Tuning und Datenordner.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── 3. Fenster und Dialoge ─────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="3. Fenster und Dialoge" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Videoplayer" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    VLC-basierter Player für Inspektionsvideos. Unterstützt variable Geschwindigkeit (0.5x-8x),
                    Live-Scrubbing (Schieberegler ziehen zeigt Bild in Echtzeit), Tastatursteuerung
                    (Leertaste=Pause, Pfeile=+/-5s, +/-=Geschwindigkeit) und Schadenscode-Marker auf der Zeitleiste.
                    Klick auf einen Code-Marker springt direkt zur Schadenstelle im Video.
                </TextBlock>

                <TextBlock Text="Sanierungsmaßnahmen" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Vereinheitlichtes Fenster für Kostenberechnung und KI-Optimierung.
                    Linkes Panel: Haltungskontext (DN, Material, Länge, Zustandsklasse), regelbasierte
                    Empfehlung, KI-Optimierung mit Konfidenz und Kostenband, Risikobewertung.
                    Rechtes Panel: Vollständiger Kostenrechner mit 5-Spalten-Layout (Maßnahmen, Kalkulation,
                    Katalogpositionen). Drag-and-Drop von Katalogpositionen in Maßnahmen-Blöcke.
                    Footer: Netto/MWST/Total-Summen, Übernehmen, PDF-Export, Speichern.
                </TextBlock>

                <TextBlock Text="Videoanalyse-Pipeline (KI)" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Orchestriert die Multi-Model KI-Pipeline zur automatischen Schadenserkennung in Videos.
                    Zeigt Fortschritt der einzelnen Phasen (Frame-Extraktion, YOLO-Detektion, DINO-Beschreibung,
                    SAM-Segmentierung, Qwen Vision-LLM), detektierte Schäden mit Konfidenzwerten und
                    generiert automatisch VSA-konforme Schadencodes. Quality-Gate filtert unsichere Ergebnisse.
                </TextBlock>

                <TextBlock Text="Medien-Suchprogramm" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Batch-Suche für Videos und PDFs mit automatischer Verknüpfung zu Haltungen.
                    Durchsucht rekursiv Ordner, erkennt Haltungsnamen in Dateinamen und verknüpft
                    gefundene Medien. Filtermodus: Gefunden, Mehrdeutig, Nicht gefunden.
                </TextBlock>

                <TextBlock Text="Training Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Verwaltung der KI-Trainingsdaten. Scannt PDF/Video-Ordner, generiert Ground-Truth-Samples
                    aus bestehenden Inspektionsergebnissen, führt Batch-Import durch und indexiert die
                    Knowledge Base mit Embeddings. Auto-Approval-Funktion für hochkonfidente Ergebnisse.
                </TextBlock>

                <TextBlock Text="Beobachtungen" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Detailansicht für Inspektionsergebnisse einer Haltung mit Foto-Galerie (bis 3 Fotos),
                    Beobachtungsliste und Kontext-Informationen. Direkter Zugang zur Bearbeitung und
                    Verwaltung von Schadenfeststellungen.
                </TextBlock>

                <TextBlock Text="Haltungsdetails" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Kompakte Detailansicht einer einzelnen Haltung mit allen Feldern gruppiert nach
                    Kategorie (Stammdaten, Inspektion, VSA, Kosten). Direktlink zu Sanierungsmaßnahmen.
                </TextBlock>

                <TextBlock Text="Beobachtungskatalog" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Nachschlagewerk aller definierten Schadencodes mit VSA-Klassifizierung.
                    Suchfunktion, Filterung nach Kategorien und Detailansicht mit Beschreibung,
                    Quantifizierung und Zustandsklassen-Auswirkung.
                </TextBlock>

                <TextBlock Text="Abgedocktes DataGrid" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                    Separates Fenster für das DataGrid bei Multi-Monitor-Setups. Das Grid wird aus der
                    Hauptansicht herausgelöst und kann auf einem zweiten Bildschirm platziert werden.
                    Alle Bearbeitungsfunktionen bleiben erhalten.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── 4. KI-Module ───────────────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="4. KI-Module und Pipeline" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" LineHeight="20" Margin="0,0,0,12">
                    SewerStudio verwendet eine Multi-Model KI-Pipeline, die vollständig lokal läuft
                    (keine Cloud-Anbindung nötig). Die KI-Funktionen erfordern einen laufenden
                    Ollama-Service und optional den Python-Sidecar-Service für die Vision-Pipeline.
                </TextBlock>

                <TextBlock Text="4.1 Multi-Model Vision-Pipeline" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4">
                    Die Pipeline verarbeitet Inspektionsvideos in mehreren Stufen:
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2">
                    1. Frame-Extraktion: FFmpeg extrahiert Einzelbilder aus dem Video in konfigurierbaren Intervallen.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2">
                    2. YOLO-Detektion: Erkennt und lokalisiert Schäden in jedem Frame (Bounding Boxes).
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2">
                    3. DINO-Beschreibung: Beschreibungsbasierte Erkennung mit natürlichsprachlichen Prompts
                    (z.B. "Riss", "Wurzeleinwuchs", "Rohrbruch") für präzisere Klassifikation.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2">
                    4. SAM-Segmentierung: Pixel-genaue Segmentierung der erkannten Schäden für
                    Flächenberechnung und Quantifizierung.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2">
                    5. Qwen Vision-LLM: Multimodales Sprachmodell bewertet jeden Befund im Kontext
                    (Material, Uhrzeit, Position) und ordnet VSA-konforme Schadencodes zu.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,10">
                    6. Quality-Gate: Kalman-Filter-basierte Fusion aller Modellergebnisse mit
                    Unsicherheitsschätzung und automatischer Filterung unplausibler Detektionen.
                </TextBlock>

                <TextBlock Text="4.2 Ollama-Integration (Lokales LLM)" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Ollama läuft als lokaler Service und stellt Vision- und Text-Modelle bereit.
                    Konfigurierbar über Umgebungsvariablen: SEWERSTUDIO_AI_ENABLED (0/1),
                    SEWERSTUDIO_OLLAMA_URL (Standard: http://localhost:11434), SEWERSTUDIO_AI_VISION_MODEL,
                    SEWERSTUDIO_AI_TEXT_MODEL und SEWERSTUDIO_AI_EMBED_MODEL. Timeout und Keep-Alive sind einstellbar.
                    Wird verwendet für: Protokolltexte, Schadensbeschreibungen, Code-Zuordnung und Embeddings.
                </TextBlock>

                <TextBlock Text="4.3 Knowledge Base (Wissensbank)" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    SQLite-basierter Speicher mit Vektor-Embeddings für semantische Suche.
                    Indexiert Trainingsbeispiele, Best Practices und historische Inspektionsergebnisse.
                    Retrieval-Augmented Generation (RAG): Bei neuen Inspektionen werden ähnliche
                    früherer Fälle als Kontext für die KI-Bewertung herangezogen.
                    Der Knowledge-Base-Manager führt Batch-Indexing und Wartung durch.
                </TextBlock>

                <TextBlock Text="4.4 Quality-Gate (Qualitätssicherung)" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Mehrstufige Qualitätsprüfung der KI-Ergebnisse:
                    Evidence-Fusion kombiniert Konfidenzwerte aller Modelle mittels Kalman-Filter.
                    Monte-Carlo-Dropout schätzt Unsicherheit durch mehrfache Inferenz.
                    Adaptive Gewichtung lernt automatisch, welchen Modellen bei welchen Schadenstypen
                    am meisten vertraut werden kann. Kalibrierungsmetriken überwachen die Zuverlässigkeit.
                    Ergebnisse werden mit Ampelsystem (grün/gelb/rot) klassifiziert.
                </TextBlock>

                <TextBlock Text="4.5 Selbstlernende Pipeline" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Auto-Approval: Hochkonfidente Ergebnisse (grüne Ampel) werden automatisch validiert
                    und in die Knowledge Base aufgenommen.
                    Review-Queue: Unsichere Ergebnisse (gelb/rot) werden zur manuellen Prüfung vorgelegt.
                    Feedback-Ingestion: Nutzerkorrekturen werden als Trainingsbeispiele erfasst.
                    KB-Quality: Automatische Bereinigung und Validierung der Wissensbank-Einträge.
                </TextBlock>

                <TextBlock Text="4.6 KI-Sanierungsoptimierung" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10">
                    Kombiniert regelbasierte und KI-gestützte Empfehlungen für Sanierungsmaßnahmen.
                    Regelbasiert: Ableitung aus Schadenscodes, Zustandsklasse, Material und DN.
                    KI-Optimierung: Lokales LLM bewertet Kontext und empfiehlt kostenoptimale Maßnahmen
                    mit Konfidenzwert und Kostenband (Min/Erwartet/Max).
                    Validierung: Jeder KI-Vorschlag wird gegen VSA-Regelwerk geprüft.
                    Fallback: Bei Regelverstößen wird der KI-Vorschlag verworfen und die
                    regelbasierte Empfehlung verwendet.
                </TextBlock>

                <TextBlock Text="4.7 Monitoring und Modellverwaltung" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                    Accuracy-Dashboard: Echtzeit-Metriken für die Modell-Performance.
                    Konfidenzverteilung: Histogramm der Vorhersage-Konfidenzwerte zur Drift-Erkennung.
                    Modell-Registry: Versionierung und Tracking aller eingesetzten KI-Modelle.
                    Pipeline-Telemetrie: Latenz, Durchsatz und Ressourcenverbrauch der KI-Pipeline.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── 5. Import-Formate ──────────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="5. Unterstützte Import-Formate" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="PDF-Import" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Inspektionsprotokolle aus PDF-Dateien. Verwendet pdftotext für OCR-Extraktion
                    oder liest strukturierte Formularfelder direkt. Automatisches Feldmapping erkennt
                    Haltungsnamen, DN, Material, Länge und Schadencodes aus dem PDF-Text.
                </TextBlock>

                <TextBlock Text="XTF / M150 / MDB" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Standard-Austauschformat für Kanalinspektion (eXtensible Transport Format).
                    Unterstützt auch Legacy-Formate: M150-Standard und Microsoft Access MDB-Datenbanken
                    älterer Inspektionssysteme.
                </TextBlock>

                <TextBlock Text="WinCan" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Import kompletter WinCan-Projekte (Windows-basiertes TV-Inspektionssystem)
                    mit allen Haltungen, Schächten, Schadencodes und Medienverknüpfungen.
                </TextBlock>

                <TextBlock Text="IBAK" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Import von IBAK-Projekten (deutsches Roboter-Inspektionssystem) mit
                    strukturierten Exporten inklusive Schadensdokumentation.
                </TextBlock>

                <TextBlock Text="KINS" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Kombinationsformat das WinCan- und IBAK-Import-Services zusammenführt.
                </TextBlock>

                <TextBlock Text="Merge-Engine" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                    Alle Importformate verwenden die gleiche Merge-Engine: Importierte Daten werden
                    intelligent mit lokalen Daten zusammengeführt. Option "Nur fehlende Felder auffüllen"
                    ergänzt leere Felder ohne vorhandene Werte zu überschreiben.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── 6. Export und Berichte ─────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="6. Export und Berichte" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Excel-Export" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Template-basierter Export aller Haltungen und Schächte nach Excel.
                    Benutzerdefinierte Vorlagen steuern Spaltenzuordnung und Formatierung.
                </TextBlock>

                <TextBlock Text="Inspektionsprotokoll PDF" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Generiert professionelle PDF-Inspektionsprotokolle mit VSA-Codes, Fotos,
                    Beobachtungen und KI-generierten Beschreibungen.
                </TextBlock>

                <TextBlock Text="Kostenzusammenstellung PDF" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Exportiert die Sanierungskostenberechnung als PDF mit Positionsaufstellung,
                    Einzelpreisen, Mengen und Gesamtkosten inkl. MWST.
                </TextBlock>

                <TextBlock Text="KI-Dokumentation PDF" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8">
                    Detaillierte Dokumentation der KI-Erkennung mit Evidence-Vektoren,
                    Quality-Gate-Metriken und Modellkonfidenz für Nachvollziehbarkeit.
                </TextBlock>

                <TextBlock Text="Verteilung" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                    Verteilt exportierte Dateien in Ordnerstrukturen sortiert nach Haltung,
                    Schacht oder Prüfstatus für organisierte Archivierung.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── 7. VSA-Zustandsbewertung ───────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="7. VSA-Zustandsbewertung" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" LineHeight="20">
                    Die VSA-Bewertung klassifiziert den baulichen und betrieblichen Zustand von
                    Kanälen und Schächten in 5 Klassen (0-4) gemäß SN EN 13508-2:
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,8,0,2">
                    Klasse 0: Kein Schaden - Kein Handlungsbedarf
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2">
                    Klasse 1: Leichter Schaden - Langfristiger Handlungsbedarf
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2">
                    Klasse 2: Mittlerer Schaden - Mittelfristiger Handlungsbedarf
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2">
                    Klasse 3: Schwerer Schaden - Kurzfristiger Handlungsbedarf
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,10">
                    Klasse 4: Sehr schwerer Schaden - Sofortiger Handlungsbedarf
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" LineHeight="20">
                    Die Berechnung basiert auf dem Klassifikationskatalog mit separaten Regelwerken
                    für Kanäle (classification_channels.json) und Schächte (classification_manholes.json).
                    Jeder erfasste Schadencode wird anhand seines Schweregrad-Faktors, der Quantifizierung
                    und des Rohr-Materials/DN bewertet. Der schlechteste Einzelwert bestimmt die Gesamtklasse.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── 8. Kostenrechner ───────────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="8. Kostenrechner und Sanierung" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" LineHeight="20">
                    Der integrierte Kostenrechner kalkuliert Sanierungskosten auf Basis eines
                    konfigurierbaren Katalogs mit Einheitspreisen.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,2">
                    Maßnahmen-Vorlagen: Vordefinierte Sanierungsverfahren (z.B. Inliner GFK, Inliner Nadelfilz,
                    Kurzliner, Manschetten, Robotersanierung) mit voreingestellten Positionen.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,2">
                    Katalogpositionen: Einzelne Leistungspositionen mit Einheit und Preis.
                    Per Drag-and-Drop in Maßnahmen-Blöcke ziehbar.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,2">
                    Automatische Preisberechnung: DN-abhängige Preise, längenabhängige Mengen
                    und Anschluss-Zuschläge werden automatisch berechnet.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,2">
                    Vorlagen speichern: Angepasste Positionen können als neue Vorlage gespeichert werden.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0">
                    Transfer-Markierung: Rechtsklick auf Positionen markiert sie grün für den
                    selektiven Übertrag in andere Systeme.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── 9. Tastaturkuerzel ─────────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="9. Tastaturkürzel" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Allgemein" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2"
                           FontFamily="Consolas" Text="F11          Fokusmodus ein/aus"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,8"
                           FontFamily="Consolas" Text="Doppelklick  Protokoll/KI öffnen (auf Haltung)"/>

                <TextBlock Text="Videoplayer" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2"
                           FontFamily="Consolas" Text="Leertaste    Play/Pause umschalten"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2"
                           FontFamily="Consolas" Text="Pfeil rechts +5 Sekunden vorspulen"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2"
                           FontFamily="Consolas" Text="Pfeil links  -5 Sekunden zurückspulen"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2"
                           FontFamily="Consolas" Text="+            Geschwindigkeit erhöhen (+0.25x)"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2"
                           FontFamily="Consolas" Text="-            Geschwindigkeit verringern (-0.25x)"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2"
                           FontFamily="Consolas" Text="S            Video stoppen"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,2"
                           FontFamily="Consolas" Text="P            Video pausieren"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,0"
                           FontFamily="Consolas" Text="R            Video fortsetzen"/>
            </StackPanel>
        </Border>

        <!-- ── 10. Umgebungsvariablen ─────────────────────────────────── -->
        <Border Margin="0,0,0,16" Padding="14,12"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="10. KI-Konfiguration (Umgebungsvariablen)" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" LineHeight="20" Margin="0,0,0,8">
                    Die KI-Module werden über Umgebungsvariablen konfiguriert.
                    Alle Variablen sind optional - Standardwerte werden verwendet wenn nicht gesetzt.
                </TextBlock>

                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" FontFamily="Consolas"
                           Text="SEWERSTUDIO_AI_ENABLED=1"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,0,8"
                           Text="KI-Funktionen aktivieren (0=deaktiviert, 1=aktiviert)"/>

                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" FontFamily="Consolas"
                           Text="SEWERSTUDIO_OLLAMA_URL=http://localhost:11434"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,0,8"
                           Text="Adresse des Ollama-Service"/>

                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" FontFamily="Consolas"
                           Text="SEWERSTUDIO_AI_VISION_MODEL=qwen3.5:27b"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,0,8"
                           Text="Vision-Modell für Bildanalyse (Multimodal)"/>

                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" FontFamily="Consolas"
                           Text="SEWERSTUDIO_AI_TEXT_MODEL=qwen3.5:27b"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,0,8"
                           Text="Text-Modell für Protokolle und Beschreibungen"/>

                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" FontFamily="Consolas"
                           Text="SEWERSTUDIO_AI_EMBED_MODEL=nomic-embed-text"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,0,8"
                           Text="Embedding-Modell für Knowledge Base (Semantische Suche)"/>

                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" FontFamily="Consolas"
                           Text="SEWERSTUDIO_SIDECAR_URL=http://localhost:8100"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,0,8"
                           Text="Python-Sidecar für YOLO/DINO/SAM Vision-Pipeline"/>

                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" FontFamily="Consolas"
                           Text="SEWERSTUDIO_FFMPEG=ffmpeg"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,0,0"
                           Text="Pfad zu FFmpeg für Video-Frame-Extraktion"/>
            </StackPanel>
        </Border>

        <!-- ── Version ────────────────────────────────────────────────── -->
        <Border Margin="0,0,0,20" Padding="14,10"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"
                           TextAlignment="Center"
                           Text="{x:Static ui:AppIdentity.DisplayVersion}"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" TextAlignment="Center" Margin="0,2,0,0">
                    SewerStudio - Professionelle Kanalinspektion und KI-Analyse
                </TextBlock>
            </StackPanel>
        </Border>

                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
    </Grid>
</UserControl>
