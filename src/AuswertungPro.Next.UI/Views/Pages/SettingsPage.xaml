<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:AuswertungPro.Next.UI.Settings"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SettingsSectionGroupBox" TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        </Style>
        <Style x:Key="SettingsTabScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="CanContentScroll" Value="True"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SettingsFormGrid" TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SettingsFieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="0,0,14,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsTextInput"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsComboInput"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
        <Style x:Key="SettingsBrowseButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Margin" Value="8,0,0,8"/>
        </Style>
        <Style x:Key="SettingsActionButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="8,0,0,8"/>
        </Style>
        <Style x:Key="SettingsWideActionButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Margin" Value="8,0,0,8"/>
        </Style>
        <Style x:Key="SettingsFieldCheckBox"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsNavigationTabs" TargetType="{x:Type TabControl}">
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="NavigationPane"
                                    Grid.Column="0"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusM}"
                                    Padding="10,10,0,10">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="Einstellungsbereiche"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="{DynamicResource TextXS}"
                                               FontWeight="SemiBold"
                                               Margin="4,0,10,10"/>
                                    <TabPanel x:Name="HeaderPanel"
                                              IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Background="Transparent"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ContentPane"
                                    Grid.Column="1"
                                    Margin="14,0,0,0"
                                    Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsMenuHeader" TargetType="{x:Type Grid}">
            <Setter Property="MinWidth" Value="188"/>
        </Style>
        <Style x:Key="SettingsMenuIndexBadge" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,1,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="SettingsMenuHeaderTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource TextM}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingsMenuHeaderHint" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="FontSize" Value="{DynamicResource TextXS}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingsMenuSectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="{DynamicResource TextXS}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingsNavigationMenuItem" TargetType="{x:Type TabItem}">
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource TextM}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- B8: TabControl uebertraegt die Inhaltsausrichtung des GEWAEHLTEN Reiters auf den
                 Inhaltsbereich. Mit "Center" stand der Seiteninhalt mittig und liess ueber der
                 ersten Gruppe rund 200 px leer. Die Kopfzeile des Reiters richtet sich in ihrer
                 eigenen Vorlage aus und bleibt davon unberuehrt. -->
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Style="{StaticResource SettingsMenuHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsMenuIndexBadge}">
                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Index)}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource TextXS}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SectionLabel"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Group)}"
                                           Style="{StaticResource SettingsMenuSectionLabel}"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource SettingsMenuHeaderTitle}"/>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Hint)}"
                                           Style="{StaticResource SettingsMenuHeaderHint}"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.IsGroupStart)}" Value="False">
                                <Setter TargetName="SectionLabel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Group)}" Value="{x:Null}">
                                <Setter TargetName="SectionLabel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=(settings:SettingsNavigation.Group)}" Value="">
                                <Setter TargetName="SectionLabel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="GroupDivider"
                                    Grid.Row="0"
                                    Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    Opacity="0.75"
                                    Visibility="Collapsed"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentStrip"
                                        Grid.Column="0"
                                        Background="{DynamicResource AccentBarBrush}"
                                        CornerRadius="{DynamicResource RadiusS}"
                                        Margin="0,6"
                                        Opacity="0"/>
                                <Border x:Name="HeaderChrome"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusM}"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="4,0,0,0">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="settings:SettingsNavigation.HasGroupDivider" Value="True">
                                <Setter TargetName="GroupDivider" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="GroupDivider" Property="Margin" Value="0,6,10,8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="AccentStrip" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <ctrl:NovaPageHeader Grid.Row="0" Title="Einstellungen" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Filtert die Gruppen ueber alle Reiter; Umlaute und ae/oe/ue gelten gleich. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ui:FluentIcon Glyph="&#xE721;"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,6,0"/>
                        <Grid Width="260">
                            <TextBox x:Name="SucheBox"
                                     TextChanged="SucheBox_TextChanged"
                                     AutomationProperties.Name="Einstellung suchen"
                                     ToolTip="Einstellung suchen — zeigt nur passende Gruppen und springt zum ersten Reiter mit Treffer."/>
                            <TextBlock Text="Einstellung suchen…" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                       FontSize="{DynamicResource TextS}" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SucheBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="SucheTreffer"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource TextXS}"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Button Content="Speichern"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Width="140"
                            ToolTip="Alle geänderten Einstellungen dauerhaft speichern."/>
                </StackPanel>
            </ctrl:NovaPageHeader>

            <TabControl Grid.Row="1"
                        x:Name="EinstellungsReiter"
                        Style="{StaticResource SettingsNavigationTabs}"
                        ItemContainerStyle="{StaticResource SettingsNavigationMenuItem}">
                <TabItem Header="Allgemein"
                         settings:SettingsNavigation.Index="01"
                         settings:SettingsNavigation.Group="Basis"
                         settings:SettingsNavigation.Hint="Design, Diagnose, Speichern"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="False"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="Darstellung und Diagnose" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Design" Style="{StaticResource SettingsFieldLabel}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="Hell · Glas" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                        <ToggleButton IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" Width="64" Height="30">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Track"
                                                            Background="{DynamicResource SurfaceSubtleBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource RadiusXXL}">
                                                        <Grid>
                                                            <Ellipse x:Name="Thumb"
                                                                     Width="24"
                                                                     Height="24"
                                                                     Margin="3"
                                                                     HorizontalAlignment="Left"
                                                                     Fill="{DynamicResource CardBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <TextBlock Text="Dunkel · Cockpit" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="Anwenden"
                                        Command="{Binding ApplyThemeCommand}"
                                        Style="{StaticResource SettingsActionButton}"
                                        ToolTip="Hell-/Dunkel-Design anwenden."/>
                                <TextBlock Text="Hinweis: für volle Umstellung ist ein Neustart nötig."
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,-2,0,8"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="{DynamicResource TextXS}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bewegung" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="Dauer-Animationen reduzieren (Puls- und Leuchteffekte aus)"
                                          IsChecked="{Binding ReduceMotion}"
                                          Style="{StaticResource SettingsFieldCheckBox}"
                                          ToolTip="Schaltet dauerhafte Puls- und Leuchteffekte ab. Rückmeldung beim Zeigen und Klicken bleibt erhalten. Wirkt ab dem nächsten Fensteraufbau. Nicht angehakt: SewerStudio folgt der Windows-Einstellung für Animationen."/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hintergrund" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="Hintergrund-Engine (Leitungsnetz im Hintergrund, nur Optik)"
                                          IsChecked="{Binding HintergrundEngine}"
                                          Style="{StaticResource SettingsFieldCheckBox}"
                                          ToolTip="Zeichnet ein leises, sich bewegendes Leitungsnetz hinter der Oberfläche. Reine Optik, reagiert nicht auf Eingaben. Pausiert automatisch bei reduzierter Bewegung und wenn ein Dialog im Vordergrund steht."/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Diagnose" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="Fehlercodes anzeigen"
                                          IsChecked="{Binding EnableDiagnostics}"
                                          Style="{StaticResource SettingsFieldCheckBox}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Optikanalyse 28.09.2026, Aufgabe 8: Die frueheren Menuepunkte "Alte
                             Haltungsansicht", "Alte Schachtansicht" (je Seite unter Weitere Aktionen ->
                             Ansicht) und "Klassische Übersicht" (Menü Ansicht) sind entfernt und stehen
                             jetzt hier. Jedes Häkchen setzt denselben AppSettings-Schalter wie zuvor der
                             Menüpunkt und speichert sofort. -->
                        <GroupBox Header="Frühere Ansichten" Style="{StaticResource SettingsSectionGroupBox}">
                            <StackPanel>
                                <CheckBox Content="Alte Haltungsansicht verwenden"
                                          IsChecked="{Binding AlteHaltungsansicht}"
                                          Style="{StaticResource SettingsFieldCheckBox}"
                                          ToolTip="Zeigt auf der Haltungen-Seite wieder die frühere Ansicht mit Liste links und Formularkarten statt der Tabelle mit Übersicht und Eingabefeldern. Wirkt beim nächsten Öffnen der Haltungen-Seite."/>
                                <CheckBox Content="Alte Schachtansicht verwenden"
                                          IsChecked="{Binding AlteSchachtansicht}"
                                          Style="{StaticResource SettingsFieldCheckBox}"
                                          ToolTip="Zeigt auf der Schächte-Seite wieder die frühere Ansicht statt der Tabelle mit Übersicht und Eingabefeldern. Wirkt beim nächsten Öffnen der Schächte-Seite."/>
                                <CheckBox Content="Klassische Projektübersicht verwenden"
                                          IsChecked="{Binding KlassischeProjektuebersicht}"
                                          Style="{StaticResource SettingsFieldCheckBox}"
                                          ToolTip="Zeigt bei offenem Projekt wieder die bisherige Übersicht mit Projektliste, Vorschau und Vorschau-PDF. Wirkt beim nächsten Öffnen der Übersicht-Seite."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Speichern" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Automatisch speichern" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AutoSaveModeOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding DataAutoSaveMode, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Haltungsprotokoll (PDF)" Style="{StaticResource SettingsSectionGroupBox}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsFormGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fotos pro Seite" Style="{StaticResource SettingsFieldLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ProtocolPhotosPerPageOptions}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Label"
                                              SelectedValue="{Binding ProtocolPhotosPerPage, Mode=TwoWay}"
                                              Style="{StaticResource SettingsComboInput}"/>
                                </Grid>
                                <TextBlock Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource TextS}"
                                           Text="Gilt für selbst erzeugte Haltungsprotokolle und die Fotoseiten im Haltungsdossier. Bereits gespeicherte PDF-Dateien ändern sich nicht - dafür die Protokolle neu erzeugen."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Dateien und Ordner"
                         settings:SettingsNavigation.Index="02"
                         settings:SettingsNavigation.Group="Daten"
                         settings:SettingsNavigation.Hint="Projekte, Logs, Wiederherstellung"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="True"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="Projektdateien" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Projektpfad (*.json)" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding ProjectPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Command="{Binding BrowseProjectPathCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        ToolTip="Projektdatei auswählen."
                                        AutomationProperties.Name="Projektdatei auswählen">
                                    <ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/>
                                </Button>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Projekte-Verzeichnis" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding ProjectsRootDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Command="{Binding BrowseProjectsRootCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        ToolTip="Standardordner für Projekte auswählen."
                                        AutomationProperties.Name="Standardordner für Projekte auswählen">
                                    <ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/>
                                </Button>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kataster-XTF (*.xtf)" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding AbwasserkatasterXtfPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="2" Grid.Column="2"
                                        Command="{Binding BrowseAbwasserkatasterXtfPathCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        ToolTip="Abwasserkataster-XTF für die Kartenansicht auswählen."
                                        AutomationProperties.Name="Abwasserkataster-XTF für die Kartenansicht auswählen">
                                    <ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Datenordner und Logs" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Datenordner" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding DataFolderPath}"
                                         IsReadOnly="True"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="Ordner &#xF6;ffnen"
                                        Command="{Binding OpenDataFolderCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Lokalen SewerStudio-Datenordner im Explorer öffnen."/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Logs" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding LogsFolderPath}"
                                         IsReadOnly="True"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Content="Logs &#xF6;ffnen"
                                        Command="{Binding OpenLogsFolderCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Log-Ordner im Explorer öffnen."/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Programmbereinigung" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Zwischendaten"
                                           Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding ProgramCleanupStatusText}"
                                           Margin="0,0,12,8"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Command="{Binding CleanProgramDataCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Bekannte temporäre SewerStudio-Daten prüfen und nach Bestätigung entfernen.">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:FluentIcon
                                                   Glyph="&#xE74D;"
                                                   FontSize="{DynamicResource TextL}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Prüfen und bereinigen"/>
                                    </StackPanel>
                                </Button>

                                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                             Style="{StaticResource ProgressBarThin}"
                                             Margin="0,0,0,8"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsProgramCleanupRunning, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Wiederherstellung" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Schutzkopien" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="Wiederherstellungspunkte vor dem Speichern erstellen"
                                          IsChecked="{Binding EnableRestorePoints}"
                                          Style="{StaticResource SettingsFieldCheckBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ablage" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding RestorePointsFolderPath}"
                                         IsReadOnly="True"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Content="Ablage &#xF6;ffnen"
                                        Command="{Binding OpenRestorePointsFolderCommand}"
                                        Style="{StaticResource SettingsWideActionButton}"
                                        ToolTip="Ordner mit Wiederherstellungspunkten öffnen."/>
                            </Grid>
                        </GroupBox>

                        <!-- Optikanalyse 28.09.2026, Aufgabe 10a: Codex-Agenten-Daten sind
                             Entwicklerwerkzeug-Zwischendaten (Coding-Agent-Baukopien), keine
                             normale Programmbereinigung. -->
                        <Expander Header="Erweitert (für Fachleute)" IsExpanded="False" Margin="0,4,0,0">
                            <GroupBox Header="Codex-Agenten-Daten" Style="{StaticResource SettingsSectionGroupBox}">
                                <Grid Style="{StaticResource SettingsFormGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Codex-Agenten-Daten"
                                               Style="{StaticResource SettingsFieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding CodexArtifactCleanupStatusText}"
                                               Margin="0,0,12,8"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Command="{Binding CleanCodexArtifactsCommand}"
                                            Style="{StaticResource SettingsWideActionButton}"
                                            ToolTip="Nur alte, rein erzeugte Codex-Baukopien nach Vorschau und Bestätigung entfernen.">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ui:FluentIcon
                                                       Glyph="&#xE74D;"
                                                       FontSize="{DynamicResource TextL}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="Agenten-Daten prüfen"/>
                                        </StackPanel>
                                    </Button>

                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Style="{StaticResource ProgressBarThin}"
                                                 Margin="0,0,0,8"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsProgramCleanupRunning, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </GroupBox>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Import und Referenzdaten"
                         settings:SettingsNavigation.Index="03"
                         settings:SettingsNavigation.Group="Daten"
                         settings:SettingsNavigation.Hint="Videos, PDF, XTF"
                         settings:SettingsNavigation.IsGroupStart="False"
                         settings:SettingsNavigation.HasGroupDivider="False"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="Importquellen" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Video-Ordner" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding VideoFolder}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Column="2"
                                        Command="{Binding BrowseVideoFolderCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        ToolTip="Video-Ordner wählen"
                                        AutomationProperties.Name="Video-Ordner wählen">
                                    <ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Telefonsuche (search.ch)" Style="{StaticResource SettingsSectionGroupBox}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="{DynamicResource TextXS}" Margin="0,0,0,8"
                                           Text="Mit einem Schlüssel von search.ch füllt „Neue Liegenschaft“ Telefon und Mail der Eigentümer vor. Den Schlüssel gibt localsearch auf Antrag heraus; er gilt für search.ch und local.ch gleichermassen — es sind dieselbe Stelle und dieselben Daten. Das Kontingent beträgt 1000 Abfragen im Monat. Ohne Schlüssel bleibt die Suche aus: die Bedingungen erlauben nur die offizielle Schnittstelle und untersagen Massenabfragen ausdrücklich. Quellenangabe im Dossier: Swisscom Directories AG."/>
                                <Grid Style="{StaticResource SettingsFormGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="API-Schlüssel"
                                               Style="{StaticResource SettingsFieldLabel}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchChApiKey}"
                                             Style="{StaticResource SettingsTextInput}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Referenzdaten" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="XTF Kanton Uri" Style="{StaticResource SettingsFieldLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding KantonUriXtfDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextInput}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Command="{Binding BrowseKantonUriXtfDirectoryCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        ToolTip="XTF-Ordner Kanton Uri auswählen"
                                        AutomationProperties.Name="XTF-Ordner Kanton Uri auswählen">
                                    <ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/>
                                </Button>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,-4,0,8"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="{DynamicResource TextXS}"
                                           Text="Gesamter XTF-Datenbestand Kanton Uri: Leitungen und Sch&#xE4;chte."/>
                            </Grid>
                        </GroupBox>

                        <!-- Optikanalyse 28.09.2026, Aufgabe 10a: pdftotext.exe ist ein
                             Entwickler-/Support-Werkzeug (siehe CLAUDE.md «Der PDF-Textleser
                             wird geprueft gewaehlt»), keine normale Importquelle. -->
                        <Expander Header="Erweitert (für Fachleute)" IsExpanded="False" Margin="0,4,0,0">
                            <GroupBox Header="Werkzeuge" Style="{StaticResource SettingsSectionGroupBox}">
                                <Grid Style="{StaticResource SettingsFormGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="pdftotext.exe" Style="{StaticResource SettingsFieldLabel}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding PdfToTextPath}"
                                             Style="{StaticResource SettingsTextInput}"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding BrowsePdfToTextCommand}"
                                            Style="{StaticResource SettingsBrowseButton}"
                                            ToolTip="pdftotext.exe auswählen"
                                            AutomationProperties.Name="pdftotext.exe auswählen">
                                        <ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/>
                                    </Button>
                                </Grid>
                            </GroupBox>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Video und KI"
                          settings:SettingsNavigation.Index="04"
                          settings:SettingsNavigation.Group="Betrieb"
                          settings:SettingsNavigation.Hint="Wiedergabe, KI-Start, Schwellen"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="True"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="Video-Player" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Wiedergabe" Style="{StaticResource SettingsFieldLabel}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                                    <CheckBox Content="Hardware-Decoding aktiv" IsChecked="{Binding VideoHwDecoding}" Style="{StaticResource SettingsFieldCheckBox}"/>
                                    <CheckBox Content="Verspätete Bilder verwerfen" IsChecked="{Binding VideoDropLateFrames}" Style="{StaticResource SettingsFieldCheckBox}"
                                              ToolTip="Bilder, die zu spät zum Anzeigen kommen, werden übersprungen statt die Wiedergabe zu verzögern."/>
                                    <CheckBox Content="Bilder bei Rückstand überspringen" IsChecked="{Binding VideoSkipFrames}" Style="{StaticResource SettingsFieldCheckBox}"
                                              ToolTip="Hält bei Rückstand die Wiedergabegeschwindigkeit, statt jedes einzelne Bild zu zeigen."/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Video-Ausgabe" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          Width="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding VideoOutputOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding VideoOutput, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Datei-Cache" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          Width="140"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding VideoCacheOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding VideoFileCachingMs, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Netzwerk-Cache" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          Width="140"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding VideoCacheOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding VideoNetworkCachingMs, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="KI-Laufzeit" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Autostart" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="KI beim Programmstart starten"
                                          IsChecked="{Binding StartAiOnProgramStart}"
                                          Style="{StaticResource SettingsFieldCheckBox}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Codiermodus" Style="{StaticResource SettingsFieldLabel}"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                          Content="KI-Vorschläge beim Codieren (Bogen, Rohranfang, Rohrende)"
                                          IsChecked="{Binding CodingSuggestionsEnabled}"
                                          ToolTip="Beim Öffnen des Codiermodus prüft die KI das Video im Hintergrund und schlägt Bogen, Rohranfang und Rohrende zum Bestätigen vor."
                                          Style="{StaticResource SettingsFieldCheckBox}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Start" Style="{StaticResource SettingsFieldLabel}"/>
                                <Button Grid.Row="2" Grid.Column="1"
                                        Content="KI jetzt starten"
                                        Command="{Binding StartAiCommand}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource SettingsActionButton}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="{Binding AiStartupStatusText}"
                                           Margin="10,0,0,8"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                             Style="{StaticResource ProgressBarThin}"
                                             Margin="0,0,0,8"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsAiStarting, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Optikanalyse 28.09.2026, Aufgabe 10a: Codec-Wahl und Modell-Schwellwerte
                             sind Entwicklereinstellungen, keine Wiedergabe-/Betriebseinstellungen. -->
                        <Expander Header="Erweitert (für Fachleute)" IsExpanded="False" Margin="0,4,0,0">
                            <StackPanel>
                        <GroupBox Header="Video-Codec" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Codec-Threads" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Width="140"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding VideoCodecThreadOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding VideoCodecThreads, Mode=TwoWay}"
                                          Style="{StaticResource SettingsComboInput}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="KI-Schwellwerte" Style="{StaticResource SettingsSectionGroupBox}">
                            <Grid Style="{StaticResource SettingsFormGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="YOLO-Konfidenz" Style="{StaticResource SettingsFieldLabel}"/>
                                <Slider Grid.Row="0" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding PipelineYoloConfidence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        Margin="0,0,10,8"
                                        ToolTip="Mindest-Konfidenz für YOLO-Detektionen."/>
                                <Border Grid.Row="0" Grid.Column="2"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusS}"
                                        Padding="8,4"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PipelineYoloConfidence, StringFormat={}{0:P0}}"
                                               FontFamily="{DynamicResource FontMono}"
                                               FontSize="{DynamicResource TextXS}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="0" Grid.Column="3"
                                        Content="Standard"
                                        Command="{Binding ResetYoloConfidenceCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        Width="84"
                                        ToolTip="YOLO-Konfidenz auf Standardwert 25 Prozent setzen."/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="DINO Box" Style="{StaticResource SettingsFieldLabel}"/>
                                <Slider Grid.Row="1" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding PipelineDinoBoxThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        Margin="0,0,10,8"
                                        ToolTip="Mindestwert für DINO-Box-Erkennung."/>
                                <Border Grid.Row="1" Grid.Column="2"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusS}"
                                        Padding="8,4"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PipelineDinoBoxThreshold, StringFormat={}{0:P0}}"
                                               FontFamily="{DynamicResource FontMono}"
                                               FontSize="{DynamicResource TextXS}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="1" Grid.Column="3"
                                        Content="Standard"
                                        Command="{Binding ResetDinoBoxThresholdCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        Width="84"
                                        ToolTip="DINO-Box-Schwellwert auf Standardwert 25 Prozent setzen."/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="DINO Text" Style="{StaticResource SettingsFieldLabel}"/>
                                <Slider Grid.Row="2" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding PipelineDinoTextThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        Margin="0,0,10,8"
                                        ToolTip="Mindestwert für DINO-Text-Matching."/>
                                <Border Grid.Row="2" Grid.Column="2"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusS}"
                                        Padding="8,4"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PipelineDinoTextThreshold, StringFormat={}{0:P0}}"
                                               FontFamily="{DynamicResource FontMono}"
                                               FontSize="{DynamicResource TextXS}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="2" Grid.Column="3"
                                        Content="Standard"
                                        Command="{Binding ResetDinoTextThresholdCommand}"
                                        Style="{StaticResource SettingsBrowseButton}"
                                        Width="84"
                                        ToolTip="DINO-Text-Schwellwert auf Standardwert 20 Prozent setzen."/>
                            </Grid>
                        </GroupBox>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Datensicherung"
                         settings:SettingsNavigation.Index="05"
                         settings:SettingsNavigation.Group="Sicherung"
                         settings:SettingsNavigation.Hint="KI-Wissen, PC-Schutz"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="True"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <GroupBox Header="KI-Wissen" Style="{StaticResource SettingsSectionGroupBox}">
                            <StackPanel>
                                <TextBlock Text="KI-Wissen Backup" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="Exportiert alle KI-Lerndaten, Trainingssamples, Einstellungen und Frames als ZIP. Für Backup oder PC-Migration."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextXS}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="KI-Wissen exportieren" Command="{Binding ExportBackupCommand}" Width="180"
                                            ToolTip="KI-Wissen, Trainingsdaten und zugehörige Einstellungen als ZIP sichern."/>
                                    <Button Content="KI-Wissen importieren" Command="{Binding ImportBackupCommand}" Margin="8,0,0,0" Width="180"
                                            ToolTip="Gesichertes KI-Wissen aus einer ZIP-Datei wiederherstellen."/>
                                </StackPanel>
                                <TextBlock Text="{Binding BackupStatusText}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextXS}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="PC-Ausfall-Schutz" Style="{StaticResource SettingsSectionGroupBox}">
                            <StackPanel>
                                <TextBlock Text="Datensicherung für einen PC-Ausfall" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="Sichert Programm, Git-Verlauf, Projekte, verknüpfte Dateien, KI-Gehirn und Einstellungen. Videos sind standardmässig eingeschaltet. Eine Wiederherstellung benötigt zusätzlich die Programminstallation."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextXS}" Margin="0,0,0,8"/>
                                <CheckBox Content="Projektvideos ebenfalls sichern"
                                          IsChecked="{Binding IncludeProjectVideosInFullBackup}"
                                          Margin="0,0,0,8"
                                          ToolTip="Kann die Sicherung je nach Videobestand stark vergrössern."/>
                                <TextBlock Text="Weitere Sicherungsordner (ein vollständiger Pfad pro Zeile, z. B. Ihre GeoShop-Ablage)"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AdditionalBackupFoldersText, UpdateSourceTrigger=LostFocus}"
                                         AcceptsReturn="True" MinHeight="55" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Datensicherung erstellen..."
                                                Command="{Binding CreateFullBackupCommand}"
                                                Width="210"
                                                ToolTip="Programmdaten, Git-Verlauf, KI-Wissen, Einstellungen und Logs in einen Sicherungsordner spiegeln."/>
                                        <TextBlock Text="{Binding FullBackupOperation.LastBackupInfo}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="{DynamicResource TextXS}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding FullBackupOperation.IsRunning, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Style="{StaticResource ProgressBarStandard}"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding FullBackupOperation.Percent}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FullBackupOperation.Percent, StringFormat={}{0:0}%}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="{DynamicResource TextXS}"/>
                                            <Button Grid.Column="2"
                                                    Content="Abbrechen"
                                                    Command="{Binding CancelFullBackupCommand}"
                                                    Margin="8,0,0,0"
                                                    Width="110"
                                                    ToolTip="Laufende Datensicherung abbrechen."/>
                                        </Grid>
                                        <TextBlock Text="{Binding FullBackupOperation.CurrentFile}"
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="{DynamicResource TextXS}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding FullBackupOperation.StatusText}" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextXS}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Optikanalyse 28.09.2026, Aufgabe 10a: Programmsicherung mit Quellcode
                             ist ein Entwickler-Werkzeug, keine normale Datensicherung. -->
                        <Expander Header="Erweitert (für Fachleute)" IsExpanded="False" Margin="0,4,0,0">
                            <GroupBox Header="Programmsicherung" Style="{StaticResource SettingsSectionGroupBox}">
                                <StackPanel>
                                    <TextBlock Text="Programm mit Quellcode sichern" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="Nur für Entwicklung/Support: Sichert Quellcode, kompletten Git-Verlauf und Modellgewichte als eine ZIP-Datei — ohne Build-Ausgabe, Python-Umgebung und Kartenkacheln."
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextXS}" Margin="0,0,0,8"/>
                                    <Button Content="Programm sichern" Command="{Binding CreateProgramSnapshotCommand}" Width="180"
                                            HorizontalAlignment="Left"
                                            ToolTip="Quellcode, kompletten Git-Verlauf und Modellgewichte als eine ZIP-Datei sichern — ohne Build-Ausgabe, Python-Umgebung und Kartenkacheln."/>
                                </StackPanel>
                            </GroupBox>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Hilfe"
                         settings:SettingsNavigation.Index="06"
                         settings:SettingsNavigation.Group="Hilfe"
                         settings:SettingsNavigation.Hint="Handbuch, Kurzbefehle"
                         settings:SettingsNavigation.IsGroupStart="True"
                         settings:SettingsNavigation.HasGroupDivider="True"
                         Padding="12,8">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                    <StackPanel Margin="0,12,0,0">
                        <!-- Optikanalyse 28.09.2026, Aufgabe 6: Handbuch und Tastenkuerzel sind
                             eigene, nicht-modale Fenster geworden (HandbuchWindow/
                             TastenkuerzelWindow). Dieser Reiter verweist nur noch darauf, statt
                             die ganze Anleitung hier zu duplizieren (Quelle: HandbuchInhalt). -->
                        <Border Margin="0,0,0,16" Padding="16,14"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}">
                            <StackPanel>
                                <TextBlock Text="Handbuch" FontSize="{DynamicResource TextL}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource TextS}" Margin="0,0,0,12">
                                    Eine kurze Anleitung zu jeder Seite von SewerStudio - Zweck und
                                    wichtigste Abläufe. Öffnet auch über F1 (beim Abschnitt der
                                    gerade gewählten Seite) oder das Menü Hilfe.
                                </TextBlock>
                                <Button Content="Handbuch öffnen" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButton}" Click="HandbuchOeffnen_Click"
                                        ToolTip="Das Handbuch in einem eigenen Fenster öffnen (wie F1)."/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,16" Padding="16,14"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}">
                            <StackPanel>
                                <TextBlock Text="Tastenkürzel" FontSize="{DynamicResource TextL}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource TextS}" Margin="0,0,0,12">
                                    Alle globalen Tastenkürzel und die Kürzel des Videoplayers an
                                    einem Ort. Öffnet auch über Strg+F1 oder das Menü Hilfe.
                                </TextBlock>
                                <Button Content="Tastenkürzel anzeigen" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButton}" Click="TastenkuerzelAnzeigen_Click"
                                        ToolTip="Die Tastenkürzel-Übersicht öffnen (wie Strg+F1)."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="14,10"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextM}" FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Text="{x:Static ui:AppIdentity.DisplayVersion}"/>
                                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextXS}" TextAlignment="Center" Margin="0,2,0,0">
                                    SewerStudio - Professionelle Kanalinspektion und KI-Analyse
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
    </Grid>
</UserControl>
