<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.BuilderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:pages="clr-namespace:AuswertungPro.Next.UI.Views.Pages"
             xmlns:behaviors="clr-namespace:AuswertungPro.Next.UI.Behaviors">
    <UserControl.Resources>
        <pages:DruckcenterRowKindToBoolConverter x:Key="BereichToBool"/>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid behaviors:ViewPersonalization.ViewKey="BuilderPage"
          MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="14"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Druckcenter"
                               Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Filterbarer Ausdruck mit Kosten-, Eigentümer- und Positionszusammenfassung"
                               Style="{StaticResource Caption}"/>

                    <!-- Bereichsumschalter: wechselt Datenquelle und Kostendatei gemeinsam. -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Bereich:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <RadioButton Content="Haltungen"
                                     GroupName="DruckcenterBereich"
                                     Padding="14,4"
                                     Margin="0,0,6,0"
                                     ToolTip="Haltungen mit Kosten aus der Sanierungs-Matrix (costs.json)."
                                     IsChecked="{Binding Bereich, Converter={StaticResource BereichToBool}, ConverterParameter=Haltung, Mode=TwoWay}"/>
                        <RadioButton Content="Schächte"
                                     GroupName="DruckcenterBereich"
                                     Padding="14,4"
                                     ToolTip="Schächte mit Kosten aus der Schacht-Matrix (schacht_costs.json)."
                                     IsChecked="{Binding Bereich, Converter={StaticResource BereichToBool}, ConverterParameter=Schacht, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Ansicht:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <ComboBox x:Name="SavedViewsBox"
                              IsEditable="True"
                              Width="160"
                              Margin="0,0,6,0"
                              SelectionChanged="SavedViewsBox_SelectionChanged"
                              ToolTip="Benannte Ansicht (Filter + Spalten + Sortierung): Name eintippen und Speichern, oder eine gespeicherte Ansicht auswählen."/>
                    <Button Content="Ansicht speichern"
                            Click="SaveViewButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,6,0"/>
                    <Button Content="Löschen"
                            Click="DeleteViewButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,14,0"/>
                    <Button Content="Aktualisieren"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Spalten…"
                            Click="SpaltenButton_Click"
                            ToolTip="Spalten ein-/ausblenden. Breite und Reihenfolge lassen sich direkt in der Tabelle ziehen; alles wird pro Ansicht gemerkt."
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Filter zurücksetzen"
                            Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="14"
                Margin="0,0,0,10">
            <!-- Zugeklappt als Standard: Die Filter werden selten geändert, brauchten aber
                 ein Drittel der Seitenhöhe. Der Kopf zeigt jederzeit, was aktiv ist. -->
            <Expander IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Filter"
                                   FontWeight="SemiBold"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ActiveFilterText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="640"/>
                    </StackPanel>
                </Expander.Header>
            <StackPanel Margin="0,10,0,0">
                <WrapPanel Margin="0,0,0,8">
                    <StackPanel Width="260"
                                Margin="0,0,10,8">
                        <TextBlock Text="Suche"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Width="180"
                                Margin="0,0,10,8">
                        <TextBlock Text="Eigentümer"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding OwnerFilterOptions}"
                                  SelectedItem="{Binding SelectedOwnerFilter, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Width="180"
                                Margin="0,0,10,8">
                        <TextBlock Text="Ausgeführt durch"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ExecutedByFilterOptions}"
                                  SelectedItem="{Binding SelectedExecutedByFilter, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Width="150"
                                Margin="0,0,10,8">
                        <TextBlock Text="Sanieren"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding SanierenFilterOptions}"
                                  SelectedItem="{Binding SelectedSanierenFilter, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Width="170"
                                Margin="0,0,10,8">
                        <TextBlock Text="Material"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding MaterialFilterOptions}"
                                  SelectedItem="{Binding SelectedMaterialFilter, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Width="160"
                                Margin="0,0,10,8">
                        <TextBlock Text="Status"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Width="120"
                                Margin="0,0,10,8">
                        <TextBlock Text="Jahr"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding YearFilterOptions}"
                                  SelectedItem="{Binding SelectedYearFilter, Mode=TwoWay}"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel>
                    <CheckBox Content="Nur mit Kosten"
                              IsChecked="{Binding OnlyWithCost, Mode=TwoWay}"
                              Margin="0,0,16,0"/>
                    <CheckBox Content="Nur mit Maßnahmen"
                              IsChecked="{Binding OnlyWithMeasures, Mode=TwoWay}"/>
                </WrapPanel>
            </StackPanel>
            </Expander>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,10">

            <!-- Vier Kennzahlen in einer Reihe: Anzahl, Auswahl, Netto, Lücken.
                 Die früheren sechs Kacheln standen zweizeilig und drängten die Tabelle nach unten. -->
            <Border Style="{StaticResource Card}"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding BauteilLabelPlural, StringFormat={}{0} (gesamt)}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalRows}"
                                   FontSize="{DynamicResource TextXL}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Im Ausdruck"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding FilteredRowsCount}"
                                   FontSize="{DynamicResource TextXL}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Netto total"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding NetTotalText}"
                                   FontSize="{DynamicResource TextXL}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                ToolTip="Fehlende Kosten und fehlende Eigentümer — beides hält Positionen aus dem Leistungsverzeichnis heraus.">
                        <TextBlock Text="Ohne Kosten / ohne Eigentümer"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RowsWithoutCosts}"
                                       FontSize="{DynamicResource TextXL}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text=" / "
                                       FontSize="{DynamicResource TextXL}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RowsWithoutOwner}"
                                       FontSize="{DynamicResource TextXL}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Spezialstatistik ist Spezialwissen und belegte dauerhaft ein Drittel der
                 Breite. Jetzt zugeklappt über der Tabelle, die dafür volle Breite bekommt. -->
            <Border Style="{StaticResource Card}"
                    Padding="14">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="Spezialstatistik und Auswertungen"
                                   FontWeight="SemiBold"/>
                    </Expander.Header>
                <StackPanel Margin="0,10,0,0"
                            MaxWidth="640"
                            HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Inliner GFK"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatsInlinerGfkText}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Inliner Nadelfilz"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatsInlinerNadelfilzText}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Manschetten"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatsManschettenText}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Linerendmanschetten (LEM)"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatsLemText}" FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock Text="Sanierungsquote (alle Haltungen)"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding RehabilitationShareChart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,2">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding ValueText}"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar Height="8"
                                                 Margin="0,2,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding RehabilitationShareHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="Kosten nach Ausgeführt durch"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding CostByExecutorChart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,2">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding ValueText}"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar Height="8"
                                                 Margin="0,2,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding CostByExecutorHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="{Binding SpecialStatsHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SpecialPositionStatsHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,4"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusM}"
                            Padding="6">
                        <ScrollViewer MaxHeight="180"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SpecialPositionStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Category}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Position}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding QtyText}"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding HoldingCountText}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                </Expander>
            </Border>
        </StackPanel>

        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Padding="8"
                Margin="0,0,0,10">
            <DataGrid x:Name="RowsGrid"
                      ItemsSource="{Binding Rows}"
                      MinHeight="280"
                      MaxHeight="{Binding ViewportHeight, ElementName=PageScroll}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      SelectionMode="Single"
                      PreviewMouseRightButtonDown="RowsGrid_PreviewMouseRightButtonDown"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="True"
                      behaviors:GridPersonalization.IsEnabled="True"
                      behaviors:GridPersonalization.GridKey="Grid"
                      GridLinesVisibility="All"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      MinRowHeight="{Binding ViewOptions.GridMinRowHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <DataGrid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ViewOptions.GridZoom, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    ScaleY="{Binding ViewOptions.GridZoom, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                </DataGrid.LayoutTransform>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding PlacementTarget.DataContext.BauteilLabel, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, StringFormat=Kostenblatt (dieser {0})}"
                                  Command="{Binding PlacementTarget.DataContext.PrintSingleKostenblattCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE749;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <!-- Ein volles Dossier gibt es nur fuer Haltungen; bei Schaechten gesperrt. -->
                        <MenuItem Header="Volles Dossier (diese Haltung)"
                                  IsEnabled="{Binding PlacementTarget.DataContext.SelectedRow.CanPrintDossier, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, FallbackValue=False}"
                                  Command="{Binding PlacementTarget.DataContext.PrintSingleDossierCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE749;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Zeilenhöhe:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="92"/>
                                    <Slider Width="130" Minimum="24" Maximum="240" SmallChange="2" LargeChange="10"
                                            Value="{Binding GridMinRowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GridMinRowHeight, StringFormat={}{0:0}px}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Zoom:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="92"/>
                                    <Slider Width="130" Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                            Value="{Binding GridZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GridZoom, StringFormat={}{0:0%}}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <!-- Kopf folgt dem Bereich; DataGridColumn liegt ausserhalb des VisualTree
                         und kann darum nicht binden — wird im Code-Behind gesetzt. -->
                    <DataGridTextColumn x:Name="BauteilColumn" Header="Haltung" SortMemberPath="Holding" Binding="{Binding Holding}" Width="170"/>
                    <DataGridTextColumn Header="Straße" SortMemberPath="Street" Binding="{Binding Street}" Width="170"/>
                    <DataGridTextColumn Header="Eigentümer" SortMemberPath="Owner" Binding="{Binding Owner}" Width="160"/>
                    <DataGridTextColumn Header="Ausgeführt durch" SortMemberPath="ExecutedBy" Binding="{Binding ExecutedBy}" Width="160"/>
                    <DataGridTextColumn Header="Sanieren" SortMemberPath="Sanieren" Binding="{Binding Sanieren}" Width="90"/>
                    <DataGridTextColumn Header="Material" SortMemberPath="Material" Binding="{Binding Material}" Width="130"/>
                    <DataGridTextColumn Header="Status" SortMemberPath="Status" Binding="{Binding Status}" Width="130"/>
                    <DataGridTextColumn Header="Jahr" SortMemberPath="Year" Binding="{Binding Year}" Width="80"/>
                    <DataGridTextColumn Header="Zustand" SortMemberPath="Zustand" Binding="{Binding Zustand}" Width="90"/>
                    <DataGridTextColumn Header="Maßnahmen (Vorschau)" SortMemberPath="MeasuresPreview" Binding="{Binding MeasuresPreview}" Width="2*"/>
                    <DataGridTextColumn Header="Kostenquelle" SortMemberPath="CostSource" Binding="{Binding CostSource}" Width="140"/>
                    <DataGridTextColumn Header="Netto" SortMemberPath="NetCost" Binding="{Binding NetCostText}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="14">
            <StackPanel>
                <!-- Abschnitte des PDF. Zugeklappt, weil der Standard schlank ist und
                     nur selten geändert wird. -->
                <Expander Header="Was soll ins PDF?"
                          IsExpanded="False"
                          Margin="0,0,0,8">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Gedruckt wird der oben gewählte Bereich — Haltungen und Schächte ergeben zwei getrennte PDFs. Standard ist die kurze Zusammenstellung; die grossen Abschnitte lassen sich zuschalten."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <WrapPanel>
                            <CheckBox Content="Detailliste je Bauteil"
                                      ToolTip="Pro Haltung bzw. Schacht eine Zeile mit Total, darunter die Massnahmen mit Menge und Betrag."
                                      IsChecked="{Binding IncludeDetailListSection, Mode=TwoWay}"
                                      Margin="0,0,20,6"/>
                            <CheckBox Content="Eigentümer-Zusammenfassung"
                                      IsChecked="{Binding IncludeOwnerSummarySection, Mode=TwoWay}"
                                      Margin="0,0,20,6"/>
                            <CheckBox Content="Kosten je Massnahme"
                                      IsChecked="{Binding IncludeMeasureSummarySection, Mode=TwoWay}"
                                      Margin="0,0,20,6"/>
                            <CheckBox Content="Positions-Zusammenfassung"
                                      IsChecked="{Binding IncludePositionSummarySection, Mode=TwoWay}"
                                      Margin="0,0,20,6"/>
                            <CheckBox Content="Spezialstatistik"
                                      ToolTip="Inliner GFK, Nadelfilz, Manschetten, Linerendmanschetten."
                                      IsChecked="{Binding IncludeSpecialStatsSection, Mode=TwoWay}"
                                      Margin="0,0,20,6"/>
                            <CheckBox Content="Kosten nach Ausgeführt durch"
                                      IsChecked="{Binding IncludeExecutorStatsSection, Mode=TwoWay}"
                                      Margin="0,0,20,6"/>
                        </WrapPanel>
                        <Separator Margin="0,4,0,8"/>
                        <TextBlock Text="Umfangreiche Abschnitte — machen den Ausdruck deutlich länger:"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <WrapPanel>
                            <CheckBox Content="Datenübersicht (eine Zeile je Bauteil)"
                                      IsChecked="{Binding IncludeDataSection, Mode=TwoWay}"
                                      Margin="0,0,20,4"/>
                            <CheckBox Content="Komplette Aufstellung aller Einzelpositionen"
                                      ToolTip="Jede einzelne Kostenzeile jedes Bauteils. Bei einem mittleren Projekt sind das rund 20 zusätzliche Seiten."
                                      IsChecked="{Binding IncludeFullPositionListSection, Mode=TwoWay}"
                                      Margin="0,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <!-- Aktionen (brechen bei schmalem Fenster in mehrere Reihen um) -->
                <WrapPanel>
                    <StackPanel Margin="0,0,12,4"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding PdfExportProgress}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ProgressBar Width="180"
                                     Height="8"
                                     IsIndeterminate="True"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4"
                                MaxWidth="360"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ExportStateText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding LastExportedPdfPath}"/>
                        <TextBlock Text="{Binding LastResult}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LastResult}"/>
                    </StackPanel>
                    <Button Content="PDF öffnen"
                            Command="{Binding OpenLastExportedPdfCommand}"
                            Margin="0,0,8,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportInProgress}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="PDF ausdrucken"
                            Command="{Binding PrintPdfCommand}"
                            Margin="0,0,8,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportInProgress}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="PDF exportieren"
                            Command="{Binding ExportPdfCommand}"
                            Margin="0,0,8,4"
                            ToolTip="Kostenzusammenstellung über alle (gefilterten) Haltungen. Für eine einzelne Haltung: Rechtsklick auf die Zeile in der Tabelle.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportInProgress}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Content" Value="PDF wird erstellt..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Die drei NPK-Ausgaben gehören zusammen und werden seltener gebraucht
                         als der PDF-Ausdruck — darum gebündelt statt drei Knöpfe nebeneinander. -->
                    <Menu Margin="0,0,0,4"
                          Background="Transparent"
                          VerticalAlignment="Center">
                        <MenuItem Padding="12,6"
                                  FontWeight="SemiBold"
                                  ToolTip="Projektweite NPK-135-Ausgaben: immer Haltungen UND Schächte im Eigentum AWU, unabhängig vom gewählten Bereich.">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE8F1;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="NPK-Leistungsverzeichnis" VerticalAlignment="Center"/>
                                    <ui:FluentIcon Glyph="&#xE70D;" FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource MutedBrush}" Margin="8,1,0,0"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="NPK-Offerte (PDF)"
                                      Command="{Binding ExportNpkOfferPdfCommand}"
                                      ToolTip="Formatierte NPK-135-Offerte mit Deckblatt, Konditionen, Kapitelübersicht und Positionen.">
                                <MenuItem.Icon><ui:FluentIcon Glyph="&#xE749;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Leistungsverzeichnis (CSV)"
                                      Command="{Binding ExportNpkLeistungsverzeichnisCommand}"
                                      ToolTip="Eine NPK-Positionsliste über alle gefilterten Haltungen (Mengen zusammengezählt, ByDN je DN getrennt).">
                                <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8FD;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Leistungsverzeichnis (Excel)"
                                      Command="{Binding ExportNpkLeistungsverzeichnisExcelCommand}"
                                      ToolTip="Formatiertes Excel mit zwei Reitern: 'Zum Ausfüllen' (leere Preise für die Firma, Totale als Formeln) und 'Kalkulation (intern)' mit euren Schätzpreisen.">
                                <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>

