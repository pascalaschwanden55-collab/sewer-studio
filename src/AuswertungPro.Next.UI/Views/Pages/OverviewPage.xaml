<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Pages"
             AllowDrop="True"
             Drop="OverviewPage_Drop"
             DragOver="OverviewPage_DragOver">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:ProjectListWidthConverter x:Key="ProjectListWidth"/>
        <local:ProjectListGapWidthConverter x:Key="ProjectListGapWidth"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Projektübersicht" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding ProjectStatus}" Margin="0,4,0,0" Style="{StaticResource Caption}"/>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ToggleProjectListCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Width="34"
                        Padding="0"
                        Margin="0,0,6,0"
                        ToolTip="Projektliste ein- oder ausklappen">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Content="Neues Projekt"
                        Command="{Binding NewCommand}"
                        Style="{StaticResource ToolbarButtonAccent}"
                        Margin="0,0,6,0"/>
                <Button Content="Oeffnen"
                        Command="{Binding OpenCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Margin="0,0,6,0"/>
                <Button Content="Fortsetzen"
                        Command="{Binding ContinueCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Margin="0,0,6,0"/>
                <Button Content="Aktualisieren"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ToolbarButton}"/>
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsProjectListCollapsed, Converter={StaticResource ProjectListWidth}}"/>
                <ColumnDefinition Width="{Binding IsProjectListCollapsed, Converter={StaticResource ProjectListGapWidth}}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsProjectListCollapsed, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Projekte"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource AccentSubtleBrush}"
                                CornerRadius="8"
                                Padding="7,2">
                            <TextBlock Text="{Binding ProjectEntries.Count}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            Background="{DynamicResource BgLightBrush}"
                            Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Suchen"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding FilterText, Converter={x:Static local:StringToVisibilityConverter.Instance}, ConverterParameter=invert}"/>
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="12"
                                     Padding="8,6"
                                     Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding ProjectEntries}"
                             SelectedItem="{Binding SelectedProjectEntry, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ProjectListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                                    Background="{DynamicResource CardBrush}"
                                                    Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="5,0,0,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLastProject}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCorrupt}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,8">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border DockPanel.Dock="Right"
                                                    Background="{DynamicResource AccentSubtleBrush}"
                                                    CornerRadius="8"
                                                    Padding="6,2"
                                                    Margin="6,0,0,0">
                                                <TextBlock Text="{Binding StatsText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ModifiedAtDisplay, Mode=OneWay}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding FolderName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Oeffnen"
                                Command="{Binding OpenSelectedCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,6"/>
                        <Button Content="Ausblenden"
                                Command="{Binding DeleteSelectedCommand}"
                                Margin="8,0,0,0"
                                ToolTip="Projekt aus der Uebersicht ausblenden - Daten bleiben erhalten"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding ShowProjectChoice, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Projekt waehlen"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Keine Vorschau aktiv."
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding ShowDataEmptyState, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Noch keine Daten"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding DashboardProjectName}"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasActiveDashboard, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding DashboardTitle}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding DashboardProjectName}"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Oeffnen"
                                    Command="{Binding OpenSelectedCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    Visibility="{Binding ShowFullDashboard, Converter={StaticResource InverseBoolToVis}}"/>
                        </DockPanel>

                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.HoldingCount}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Haltungen" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.SchachtCount}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Schaechte" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.TotalLengthMeters, StringFormat={}{0:N0} m}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Gesamtlaenge" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardCostText}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="CHF Sanierung" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.ColumnSpan="2">
                                        <TextBlock Text="Zustand Haltungen"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <ctrl:DonutChart Grid.Column="0"
                                                     Margin="0,28,12,0"
                                                     Width="170"
                                                     Height="170"
                                                     ItemsSource="{Binding ActiveDashboard.Haltungen.Buckets}"
                                                     SegmentCommand="{Binding NavigateConditionCommand}"/>
                                    <ItemsControl Grid.Column="1"
                                                  Margin="0,34,0,0"
                                                  ItemsSource="{Binding ActiveDashboard.Haltungen.Buckets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                                    <ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding Percent}"
                                                                 BorderThickness="0" Background="{DynamicResource BorderBrush}"
                                                                 Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Count}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.ColumnSpan="2">
                                        <TextBlock Text="Zustand Schaechte"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <ctrl:DonutChart Grid.Column="0"
                                                     Margin="0,28,12,0"
                                                     Width="170"
                                                     Height="170"
                                                     ItemsSource="{Binding ActiveDashboard.Schaechte.Buckets}"
                                                     IsHitTestVisible="False"/>
                                    <ItemsControl Grid.Column="1"
                                                  Margin="0,34,0,0"
                                                  ItemsSource="{Binding ActiveDashboard.Schaechte.Buckets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                                    <ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding Percent}"
                                                                 BorderThickness="0" Background="{DynamicResource BorderBrush}"
                                                                 Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Count}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Haeufigste Schaeden"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,8"/>
                                    <ctrl:CategoryBars ItemsSource="{Binding ActiveDashboard.TopSchaeden}"
                                                       BarCommand="{Binding NavigateDamageCommand}"
                                                       ValuePath="Percent"
                                                       Orientation="Horizontal"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Haltungskosten nach DN"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,8"/>
                                    <ctrl:CategoryBars ItemsSource="{Binding ActiveDashboard.HaltungDnCosts}"
                                                       BarCommand="{Binding NavigateDnCommand}"
                                                       ValuePath="Cost"
                                                       Orientation="Vertical"
                                                       Height="155"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{Binding ActiveDashboard.SanierenHaltungen}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding ActiveDashboard.HaltungenGesamt}"/>
                                    </TextBlock>
                                    <TextBlock Text="Haltungen sanieren" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.SchaechteMitMassnahmen}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Schaechte mit Massnahmen" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.DringendCount}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="Z0/Z1" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.OhneZustandCount}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="ohne Zustand" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
