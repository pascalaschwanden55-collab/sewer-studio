<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:anim="clr-namespace:AuswertungPro.Next.UI.Controls.Animations"
             xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Pages"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             AllowDrop="True"
             Drop="OverviewPage_Drop"
             DragOver="OverviewPage_DragOver">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:ProjectListWidthConverter x:Key="ProjectListWidth"/>
        <local:ProjectListGapWidthConverter x:Key="ProjectListGapWidth"/>
        <local:ZustandsklasseToBrushConverter x:Key="ZustandsklasseBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left"
                       Text="Projektübersicht"
                       Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center"/>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ToggleProjectListCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Width="34"
                        Padding="0"
                        Margin="0,0,6,0"
                        ToolTip="Projektliste ein- oder ausklappen">
                    <TextBlock Text="&#xE76B;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextL}"/>
                </Button>
                <Button Content="Neues Projekt"
                        Command="{Binding NewCommand}"
                        Style="{StaticResource ToolbarButtonAccent}"
                        Margin="0"/>
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsProjectListCollapsed, Converter={StaticResource ProjectListWidth}}"/>
                <ColumnDefinition Width="{Binding IsProjectListCollapsed, Converter={StaticResource ProjectListGapWidth}}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsProjectListCollapsed, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Projekte"
                                       FontSize="{DynamicResource TextL}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Projektvorschauen"
                                       Margin="0,3,0,0"
                                       FontSize="{DynamicResource TextXS}"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                MinWidth="34"
                                Height="24"
                                Background="{DynamicResource AccentSubtleBrush}"
                                CornerRadius="{DynamicResource RadiusM}"
                                Padding="8,2"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding ProjectEntries.Count}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource TextXS}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            CornerRadius="{DynamicResource RadiusM}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            Background="{DynamicResource BgLightBrush}"
                            Height="38"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{DynamicResource FontIcon}"
                                       FontSize="{DynamicResource TextS}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Grid.Column="1"
                                       Text="Suchen"
                                       FontSize="{DynamicResource TextS}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding FilterText, Converter={x:Static local:StringToVisibilityConverter.Instance}, ConverterParameter=invert}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="{DynamicResource TextS}"
                                     Padding="0,6"
                                     Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="2"
                                    Command="{Binding ClearFilterCommand}"
                                    Visibility="{Binding FilterText, Converter={x:Static local:StringToVisibilityConverter.Instance}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    ToolTip="Suche löschen">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="{DynamicResource FontIcon}"
                                           FontSize="{DynamicResource TextXS}"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding ProjectEntries}"
                             SelectedItem="{Binding SelectedProjectEntry, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ProjectListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <!-- Projektkarte: Doppelklick oeffnet das Projekt — hier ist der
                                                 Lift beim Zeigen ein Versprechen, das eingeloest wird. -->
                                            <Border x:Name="ItemBorder"
                                                    CornerRadius="{DynamicResource RadiusM}"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                                    Background="{DynamicResource CardBrush}"
                                                    MinHeight="74"
                                                    Cursor="Hand"
                                                    ui:HoverFx.Lift="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="6,0,0,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLastProject}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCorrupt}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="11,9,10,9">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{DynamicResource TextM}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Grid Grid.Row="1" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border HorizontalAlignment="Left"
                                                    MaxWidth="178"
                                                    Background="{DynamicResource AccentSubtleBrush}"
                                                    CornerRadius="{DynamicResource RadiusM}"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding StatsText}"
                                                           FontSize="{DynamicResource TextXS}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ModifiedAtDisplay, Mode=OneWay}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource TextXS}"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding FolderName, Mode=OneWay}"
                                                   FontSize="{DynamicResource TextXS}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,12,-8,0">
                        <Button Content="Öffnen"
                                Command="{Binding OpenSelectedCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0"
                                Padding="0,6"/>
                        <Button Content="Entfernen"
                                Command="{Binding DeleteSelectedCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Projekt nur aus der Übersicht entfernen – Daten bleiben erhalten"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,6"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <!-- Die Cockpit-Karten kommen nacheinander an. Feste Karten mit Sichtbarkeits-
                     Bindung — kein virtualisiertes Listenpanel, darum hier unbedenklich. -->
                <StackPanel ui:EntranceFx.Stagger="True">
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding ShowProjectChoice, Converter={StaticResource BoolToVis}}">
                        <Grid MinHeight="240">
                            <!-- Pseudo-3D-Rohrfahrt als Hero hinter dem Leer-Hinweis -->
                            <ctrl:PipeFlightControl Opacity="0.9"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                            <TextBlock Text="Projekt wählen"
                                       FontSize="{DynamicResource TextXL}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Projekt links wählen - oder Projektordner hierher ziehen."
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Vorschau wird geladen..."
                                       FontSize="{DynamicResource TextXL}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <ProgressBar IsIndeterminate="True"
                                         Height="4"
                                         Margin="0,12,0,0"
                                         Background="{DynamicResource BorderLightBrush}"
                                         Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding ShowDataEmptyState, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" TextBlock.TextAlignment="Center">
                            <TextBlock Text="&#xE9D9;"
                                       FontFamily="{DynamicResource FontIcon}"
                                       FontSize="{DynamicResource IconHero}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Noch keine Daten"
                                       FontSize="{DynamicResource TextXL}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding DashboardProjectName}"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="Daten importieren unter 'Import', dann erscheint hier die Auswertung."
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasActiveDashboard, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,10" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding DashboardTitle}"
                                           FontSize="{DynamicResource TextXL}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding DashboardProjectName}"
                                           Margin="0,3,0,0"
                                           FontSize="{DynamicResource TextS}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Command="{Binding PrintPreviewPdfCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        Margin="0,0,6,0"
                                        ToolTip="Projektvorschau als PDF speichern">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;"
                                                   FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="{DynamicResource TextM}"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="PDF"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Projekt öffnen"
                                        Command="{Binding OpenSelectedCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        Visibility="{Binding ShowFullDashboard, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Card}"
                                Margin="0,0,0,12"
                                Visibility="{Binding ShowPreviewMetadata, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Stammdaten"
                                           FontSize="{DynamicResource TextL}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding PreviewMetadataItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,18,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="{DynamicResource TextXS}"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Value}"
                                                           FontSize="{DynamicResource TextM}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- KPI-Kacheln: Zahlen zaehlen beim Laden hoch, Kacheln heben sich beim Hover -->
                        <UniformGrid Columns="4" Margin="0,0,-8,12">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" anim:HoverLift.IsEnabled="True">
                                <StackPanel>
                                    <anim:AnimatedCounter Value="{Binding ActiveDashboard.HoldingCount, Mode=OneWay}"
                                                          StringFormat="N0"
                                                          FontSize="{DynamicResource TextTitle}"
                                                          FontWeight="Bold"
                                                          Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Haltungen" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" anim:HoverLift.IsEnabled="True">
                                <StackPanel>
                                    <anim:AnimatedCounter Value="{Binding ActiveDashboard.SchachtCount, Mode=OneWay}"
                                                          StringFormat="N0"
                                                          FontSize="{DynamicResource TextTitle}"
                                                          FontWeight="Bold"
                                                          Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Schächte" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" anim:HoverLift.IsEnabled="True">
                                <StackPanel>
                                    <anim:AnimatedCounter Value="{Binding ActiveDashboard.TotalLengthMeters, Mode=OneWay}"
                                                          StringFormat="{}{0:N0} m"
                                                          FontSize="{DynamicResource TextTitle}"
                                                          FontWeight="Bold"
                                                          Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Gesamtlänge" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" anim:HoverLift.IsEnabled="True">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardCostText}"
                                               FontSize="{DynamicResource TextTitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Sanierungskosten gesamt (CHF, ohne MWST)" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.ColumnSpan="2">
                                        <TextBlock Text="Zustand Haltungen"
                                                   FontSize="{DynamicResource TextL}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <ctrl:DonutChart Grid.Column="0"
                                                     Margin="0,28,12,0"
                                                     Width="170"
                                                     Height="170"
                                                     ItemsSource="{Binding ActiveDashboard.Haltungen.Buckets}"
                                                     CenterText="{Binding ActiveDashboard.Haltungen.Total}"
                                                     CenterLabel="Haltungen"
                                                     SegmentCommand="{Binding NavigateConditionCommand}"/>
                                    <ItemsControl Grid.Column="1"
                                                  Margin="0,34,0,0"
                                                  ItemsSource="{Binding ActiveDashboard.Haltungen.Buckets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="10"
                                                            Height="10"
                                                            CornerRadius="{DynamicResource RadiusM}"
                                                            Background="{Binding Key, Converter={StaticResource ZustandsklasseBrush}}"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="{DynamicResource TextS}" Foreground="{DynamicResource TextBrush}"/>
                                                    <ProgressBar Grid.Column="2" Height="6" Maximum="100" Value="{Binding Percent}"
                                                                 BorderThickness="0" Background="{DynamicResource BorderBrush}"
                                                                 Foreground="{Binding Key, Converter={StaticResource ZustandsklasseBrush}}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Count}"
                                                               FontSize="{DynamicResource TextS}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.ColumnSpan="2">
                                        <TextBlock Text="Zustand Schächte"
                                                   FontSize="{DynamicResource TextL}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <ctrl:DonutChart Grid.Column="0"
                                                     Margin="0,28,12,0"
                                                     Width="170"
                                                     Height="170"
                                                     ItemsSource="{Binding ActiveDashboard.Schaechte.Buckets}"
                                                     CenterText="{Binding ActiveDashboard.Schaechte.Total}"
                                                     CenterLabel="Schächte"
                                                     SegmentCommand="{Binding NavigateSchachtConditionCommand}"/>
                                    <ItemsControl Grid.Column="1"
                                                  Margin="0,34,0,0"
                                                  ItemsSource="{Binding ActiveDashboard.Schaechte.Buckets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="10"
                                                            Height="10"
                                                            CornerRadius="{DynamicResource RadiusM}"
                                                            Background="{Binding Key, Converter={StaticResource ZustandsklasseBrush}}"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="{DynamicResource TextS}" Foreground="{DynamicResource TextBrush}"/>
                                                    <ProgressBar Grid.Column="2" Height="6" Maximum="100" Value="{Binding Percent}"
                                                                 BorderThickness="0" Background="{DynamicResource BorderBrush}"
                                                                 Foreground="{Binding Key, Converter={StaticResource ZustandsklasseBrush}}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Count}"
                                                               FontSize="{DynamicResource TextS}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Häufigste Schäden"
                                               FontSize="{DynamicResource TextL}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,8"/>
                                    <ctrl:CategoryBars ItemsSource="{Binding ActiveDashboard.TopSchaeden}"
                                                       BarCommand="{Binding NavigateDamageCommand}"
                                                       ValuePath="Percent"
                                                       Orientation="Horizontal"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Haltungskosten nach DN (ohne MWST)"
                                               FontSize="{DynamicResource TextL}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,8"/>
                                    <ctrl:CategoryBars ItemsSource="{Binding ActiveDashboard.HaltungDnCosts}"
                                                       BarCommand="{Binding NavigateDnCommand}"
                                                       ValuePath="Cost"
                                                       Orientation="Vertical"
                                                       Height="155"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Columns="3" Margin="0,0,-8,0">
                            <!-- Zeile 1: Haltungen -->
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{Binding ActiveDashboard.SanierenHaltungen, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding ActiveDashboard.HaltungenGesamt, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="Haltungen sanieren" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.HaltungSanierungsKostenText}"
                                               FontSize="{DynamicResource TextTitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Kosten Haltungssanierung (CHF, ohne MWST)" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.DringendCount}"
                                               FontSize="{DynamicResource TextTitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="Dringend (Z0/Z1)" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Zeile 2: Schächte -->
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{Binding ActiveDashboard.SchaechteSanierenJa, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding ActiveDashboard.SchaechteGesamt, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="Schächte sanieren" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.SchachtSanierungsKostenText}"
                                               FontSize="{DynamicResource TextTitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Kosten Schachtsanierung (CHF, ohne MWST)" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboard.OhneZustandCount}"
                                               FontSize="{DynamicResource TextTitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="Zustand unbekannt (ZU)" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Mengen der Sanierungsverfahren (nur Haltungen) -->
                        <Border Style="{StaticResource Card}"
                                Margin="0,12,0,0"
                                Visibility="{Binding ActiveDashboard.HasVerfahren, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Sanierungsverfahren"
                                           FontSize="{DynamicResource TextL}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ActiveDashboard.Sanierungsverfahren}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding QtyText}"
                                                           MinWidth="90"
                                                           TextAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding NetText}"
                                                           MinWidth="90"
                                                           TextAlignment="Right"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Mengen aus den ausgewählten Kostenzeilen der Haltungen (CHF ohne MWST)."
                                           FontSize="{DynamicResource TextXS}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
