<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.MediaConflictsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             x:Name="MediaConflictsRoot">
    <UserControl.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource CardGlassBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Medienkonflikte" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Fehlende oder mehrdeutige Videozuordnungen zentral prüfen, öffnen und direkt auflösen."
                               Margin="0,4,0,0"
                               Style="{StaticResource Body}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SummaryText}"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           Margin="20,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Offen" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding OpenConflictCount}" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Fehlend" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding MissingConflictCount}" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Mehrdeutig" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding AmbiguousConflictCount}" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Gelernt" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding LearnedMappingCount}" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="8"
                CornerRadius="10"
                Margin="0,0,0,8">
            <WrapPanel>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonAccent}" Margin="0,0,4,4"
                        ToolTip="Medienkonflikte neu scannen und Liste aktualisieren.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Aktualisieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ResolveFromCandidateCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,4,4"
                        ToolTip="Ausgewaehlten Kandidaten der markierten Haltung zuordnen.">
                    <StackPanel Orientation="Horizontal">
                        <ui:FluentIcon Glyph="&#xE73E;" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Kandidat zuordnen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ResolveManualCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,4,4"
                        ToolTip="Videodatei manuell auswaehlen und zuordnen.">
                    <StackPanel Orientation="Horizontal">
                        <ui:FluentIcon Glyph="&#xE8E5;" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Video wählen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Menu Margin="0,0,4,4"
                      VerticalAlignment="Center"
                      Background="Transparent">
                    <MenuItem Background="{DynamicResource SurfaceSubtleBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,5">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:FluentIcon Glyph="&#xE712;" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Weitere" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="Gelernte Quelle zuordnen"
                                  Command="{Binding DataContext.ResolveSuggestedCommand, ElementName=MediaConflictsRoot}"/>
                        <MenuItem Header="Auto-Resolve (gelernt)"
                                  Command="{Binding DataContext.AutoResolveLearnedCommand, ElementName=MediaConflictsRoot}"/>
                        <Separator/>
                        <MenuItem Header="Mappings löschen"
                                  Command="{Binding DataContext.ClearLearnedMappingsCommand, ElementName=MediaConflictsRoot}"/>
                    </MenuItem>
                </Menu>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Offene Fälle" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Links siehst du alle Konflikte. Rechts kannst du Quellen öffnen, Videos prüfen und die Zuordnung direkt speichern."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid>
                        <DataGrid x:Name="ConflictsGrid"
                                  ItemsSource="{Binding Conflicts}"
                                  SelectedItem="{Binding SelectedConflict}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Konflikt" Binding="{Binding TypeText}" Width="120"/>
                                <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="110"/>
                                <DataGridTextColumn Header="Haltung" Binding="{Binding HoldingText}" Width="*"/>
                                <DataGridTextColumn Header="Film aus PDF" Binding="{Binding ExpectedVideoText}" Width="*"/>
                                <DataGridTextColumn Header="Kandidaten" Binding="{Binding CandidateCount}" Width="95"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding ResolutionState}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateControl Icon="&#xE8A5;"
                                                    Title="Keine offenen Medienkonflikte"
                                                    Message="Der letzte Scan hat keine fehlenden oder mehrdeutigen Medienzuordnungen gefunden."
                                                    ActionText="Aktualisieren"
                                                    ActionCommand="{Binding RefreshCommand}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                            <controls:EmptyStateControl.Style>
                                <Style TargetType="controls:EmptyStateControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ConflictsGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:EmptyStateControl.Style>
                        </controls:EmptyStateControl>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Konfliktdetails" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Path=SelectedConflict.TypeHint, TargetNullValue='Waehle links einen Konflikt aus, um Details und Aktionen zu sehen.'}"
                                   Margin="0,4,0,12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Konflikttyp" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{Binding SelectedConflict.TypeText, TargetNullValue=-}" Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="Datum" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{Binding SelectedConflict.DateText, TargetNullValue=-}" Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="Haltung" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{Binding SelectedConflict.HoldingText, TargetNullValue=-}" Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="Film aus PDF" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{Binding SelectedConflict.ExpectedVideoText, TargetNullValue=-}" Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="PDF-Protokoll" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{Binding SelectedConflict.SourcePdfText, TargetNullValue=-}" Style="{StaticResource DetailValueStyle}"/>

                        <Border Background="{DynamicResource HeaderBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Gelernte Quelle" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedConflict.SuggestedSourceFileName, TargetNullValue=Keine Auswahl}"
                                           Margin="0,6,0,2"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedConflict.SuggestedSourcePathText, TargetNullValue=-}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Kandidaten" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedConflict.CandidateSummaryText, TargetNullValue=Keine Auswahl}"
                                   Margin="0,4,0,8"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <ListBox ItemsSource="{Binding SelectedConflict.Candidates}"
                                 SelectedItem="{Binding SelectedConflict.SelectedCandidate, Mode=TwoWay}"
                                 MinHeight="180"
                                 Margin="0,0,0,12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DirectoryName}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Aktionen" FontSize="14" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding PlaySelectedCandidateCommand}" Style="{StaticResource ActionCardButton}" Margin="0,0,6,6"
                                    ToolTip="Ausgewaehlten Videokandidaten im Player pruefen.">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE768;" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kandidat abspielen"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ResolveFromCandidateCommand}" Style="{StaticResource ActionCardButton}" Margin="0,0,6,6"
                                    ToolTip="Diesen Kandidaten als richtige Videodatei uebernehmen.">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE73E;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kandidat übernehmen"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ResolveManualCommand}" Style="{StaticResource ActionCardButton}" Margin="0,0,6,6"
                                    ToolTip="Andere Videodatei manuell suchen und zuordnen.">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE8E5;" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Video manuell wählen"/>
                                </StackPanel>
                            </Button>

                            <Menu Margin="0,0,6,6"
                                  VerticalAlignment="Center"
                                  Background="Transparent">
                                <MenuItem Background="{DynamicResource SurfaceSubtleBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,5">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FluentIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Öffnen"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem Header="Gelernte Quelle abspielen"
                                              Command="{Binding DataContext.PlaySuggestedSourceCommand, ElementName=MediaConflictsRoot}"/>
                                    <MenuItem Header="PDF öffnen"
                                              Command="{Binding DataContext.OpenPdfCommand, ElementName=MediaConflictsRoot}"/>
                                    <MenuItem Header="Kandidat im Explorer"
                                              Command="{Binding DataContext.OpenSelectedCandidateCommand, ElementName=MediaConflictsRoot}"/>
                                    <MenuItem Header="Gelernte Quelle im Explorer"
                                              Command="{Binding DataContext.OpenSuggestedSourceCommand, ElementName=MediaConflictsRoot}"/>
                                    <MenuItem Header="Info-Datei"
                                              Command="{Binding DataContext.OpenInfoCommand, ElementName=MediaConflictsRoot}"/>
                                    <MenuItem Header="Haltungsordner"
                                              Command="{Binding DataContext.OpenHoldingFolderCommand, ElementName=MediaConflictsRoot}"/>
                                    <Separator/>
                                    <MenuItem Header="Gelernte Quelle übernehmen"
                                              Command="{Binding DataContext.ResolveSuggestedCommand, ElementName=MediaConflictsRoot}"/>
                                </MenuItem>
                            </Menu>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBox Grid.Row="3"
                 Margin="0,8,0,0"
                 MinHeight="70"
                 Text="{Binding LastResult}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource MutedBrush}"/>
    </Grid>
</UserControl>
