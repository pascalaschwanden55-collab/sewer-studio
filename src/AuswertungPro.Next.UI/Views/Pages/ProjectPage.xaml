<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.ProjectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Eingebauter Converter: bool -> Visibility (True=Visible, False=Collapsed) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <!-- Im Draft-Modus: Projekt anlegen; sonst: Speichern unter -->
                <Button Content="Projekt anlegen"
                        Command="{Binding AnlegenCommand}"
                        Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}"
                        ToolTip="Neues Projekt mit den eingetragenen Stammdaten erstellen."/>
                <Button Content="Abbrechen"
                        Command="{Binding AbbrechenCommand}"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}"
                        ToolTip="Projektanlage abbrechen und zur Übersicht zurückkehren."/>
                <Button Content="Speichern unter" Command="{Binding SaveAsCommand}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                        Visibility="{Binding IsNotDraft, Converter={StaticResource BoolToVis}}"
                        ToolTip="Projekt unter einem neuen Pfad speichern."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Projekt speichern" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" Width="200" MinWidth="180" Margin="0,0,8,0"
                        Visibility="{Binding IsNotDraft, Converter={StaticResource BoolToVis}}"
                        ToolTip="Alle Projektdaten speichern." />
                <Button Content="Programm schließen" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" Width="200" MinWidth="180"
                        ToolTip="SewerStudio beenden. Ungespeicherte Änderungen werden vorher abgefragt." />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource CardBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Projekt-Infos" FontSize="{DynamicResource TextL}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Name" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Beschreibung" Margin="0,12,0,4" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox Text="{Binding Project.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120"/>

                    <TextBlock Text="Projektdaten" Margin="0,16,0,6" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Auftraggeber" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Project.Metadata[Auftraggeber], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Auftrag Nr." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Project.Metadata[AuftragNr], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Gemeinde" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding Project.Metadata[Gemeinde], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Zone" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Project.Metadata[Zone], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Straße" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding Project.Metadata[Strasse], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Bearbeiter" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Project.Metadata[Bearbeiter], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Inspektionsdatum" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="7" Grid.Column="0" Text="{Binding Project.Metadata[InspektionsDatum], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Firma" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding Project.Metadata[FirmaName], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>


                    <TextBlock Text="{Binding Project.Data.Count, StringFormat=Records: {0}}" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
