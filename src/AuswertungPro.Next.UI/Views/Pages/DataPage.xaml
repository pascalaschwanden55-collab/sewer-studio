<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AuswertungPro.Next.UI.Behaviors"
             xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Pages"
             xmlns:uc="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:haltung="clr-namespace:AuswertungPro.Next.UI.Views.Pages.Haltungsansicht"
             xmlns:dp="clr-namespace:AuswertungPro.Next.UI.DataPage">
    <UserControl.Resources>
        <local:CountToMarkConverter x:Key="Foto1Mark" MinCount="1"/>
        <local:CountToMarkConverter x:Key="Foto2Mark" MinCount="2"/>
        <local:StringNotEmptyToMarkConverter x:Key="FilmMark"/>
        <local:PhotoIndexToPathConverter x:Key="PhotoIndexPath"/>
        <local:PhotoIndexToVisibilityConverter x:Key="PhotoIndexVisible"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyVisible"/>
        <local:AnyValueToVisibilityConverter x:Key="AnyValueVisible"/>
        <Style x:Key="SecondaryToggleButton" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="{DynamicResource TextL}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="{DynamicResource TextS}"/>
        </Style>
        <Style x:Key="CompactToggleButton" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="{DynamicResource TextS}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="0,0,0,4">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="8" Margin="0,0,0,8" CornerRadius="{DynamicResource RadiusM}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSaveStatusVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource TextBrush}" />
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="8" Margin="0,0,0,8" CornerRadius="{DynamicResource RadiusM}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProjectReady}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="Bitte zuerst Projekt speichern (Datei anlegen), dann ist Bearbeitung möglich."
                           Foreground="{DynamicResource TextBrush}" />
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="8" Margin="0,0,0,8" CornerRadius="{DynamicResource RadiusM}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLearningInfoVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding LearningTrafficLightColor}" Margin="0,0,8,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"/>
                    <TextBlock Text="{Binding LearningTrafficLightText}" Foreground="{DynamicResource TextBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding LearningInfo}" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="4,3" CornerRadius="{DynamicResource RadiusL}">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="HaltungsansichtToggle"
                                  Style="{StaticResource CompactToggleButton}"
                                  Margin="0,0,6,0"
                                  Checked="HaltungsansichtToggle_Changed"
                                  Unchecked="HaltungsansichtToggle_Changed"
                                  ToolTip="Zwischen Tabelle und Haltungsansicht umschalten">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Haltungsansicht" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4"/>

                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource ToolbarButtonAccent}" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Speichern" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddCommand}" IsEnabled="{Binding IsProjectReady}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Neu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveCommand}" IsEnabled="{Binding IsProjectReady}"
                            Style="{StaticResource ToolbarButtonDanger}" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Löschen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4"/>

                    <!-- Nova-Etappe 1: direkt sichtbar bleiben Speichern, Neu, Loeschen, Video pruefen.
                         Alles Seltene liegt unveraendert (gleiche Handler, gleiche Commands) unter "Weitere Aktionen". -->
                    <Button Command="{Binding PlayVideoCommand}" CommandParameter="{Binding Selected}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,2,0"
                            ToolTip="Video der gewählten Haltung im Player prüfen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Video prüfen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4"/>

                    <Button x:Name="WeitereAktionenDropdown" Click="DropdownButton_Click"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,2,0"
                            ToolTip="Weitere Aktionen: Daten, Fachlich, Ansicht"
                            AutomationProperties.Name="Weitere Aktionen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE712;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Weitere Aktionen" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextXS}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Medien suchen" Click="MediaSearchMenu_Click"
                                          ToolTip="Videos und PDFs automatisch suchen und mit Haltungen verlinken">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xED25;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Leere Felder aus QGIS" Command="{Binding QgisFelderErgaenzenCommand}" IsEnabled="{Binding IsProjectReady}"
                                          ToolTip="Leere Felder aus dem QGIS-Bestand ergänzen. Gefüllte Felder bleiben unberührt; vorher erscheint ein Bericht.">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE896;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Katasterkennungen" Command="{Binding KatasterKennungenErgaenzenCommand}" IsEnabled="{Binding IsProjectReady}"
                                          ToolTip="GEONIS-Kennungen aus der Kennungstabelle übernehmen. Nur Kennungen, keine Fachwerte; vorher erscheint ein Bericht.">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Strassen" Click="StrassenStapel_Click"
                                          ToolTip="Leere Strassenfelder aus den zugehörigen Schächten füllen, mit Vorschau, nichts wird überschrieben">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE71B;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Sanierungsmaßnahme bearbeiten" Click="CostsMenu_Click">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE70F;" Foreground="{DynamicResource MutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Direkt zur KI-Optimierung"
                                          Command="{Binding PlacementTarget.DataContext.OptimizeSanierungKiCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.Selected, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xEA80;" Foreground="{DynamicResource AccentBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Vorschlag für diese Haltung erstellen" Click="SuggestMeasuresMenu_Click">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xEA80;" Foreground="{DynamicResource AccentBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            
                                <MenuItem Header="Hydraulik berechnen" Click="HydraulikMenu_Click">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE8EF;" Foreground="{DynamicResource AccentBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Hydraulik PDF" Click="HydraulikPrint_Click">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE749;" Foreground="{DynamicResource AccentBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            
                                <MenuItem Header="Dossier" Click="DossierPrint_Click" ToolTip="Haltungsdossier als PDF drucken (Sektionen auswählbar)">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE7C3;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="UndockButton" Header="Abdocken" Click="UndockGrid_Click"
                                          ToolTip="Tabelle in separatem Fenster öffnen (Multi-Monitor)">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A7;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Nach oben" Command="{Binding MoveUpCommand}">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE74A;" Foreground="{DynamicResource MutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Nach unten" Command="{Binding MoveDownCommand}">
                                    <MenuItem.Icon>
                                        <ui:FluentIcon Glyph="&#xE74B;" Foreground="{DynamicResource MutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Spalten anordnen" IsCheckable="True" IsChecked="{Binding IsColumnReorderEnabled}"/>
                                <MenuItem x:Name="ClearColumnMenuItem" Header="Spalte leeren" IsCheckable="True"
                                          ToolTip="Aktivieren, dann auf Spaltentitel rechtsklicken"/>
                                <Separator/>
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Zeilenhöhe:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="92"/>
                                            <Slider Width="130"
                                                    Minimum="24"
                                                    Maximum="240"
                                                    Value="{Binding GridMinRowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SmallChange="2"
                                                    LargeChange="10"
                                                    IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding GridMinRowHeight, StringFormat={}{0:0}px}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       MinWidth="36"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Zoom:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="92"/>
                                            <Slider Width="130"
                                                    Minimum="0.5"
                                                    Maximum="2.0"
                                                    Value="{Binding GridZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SmallChange="0.05"
                                                    LargeChange="0.1"
                                                    IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding GridZoom, StringFormat={}{0:0%}}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       MinWidth="36"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Ausrichtung:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="92"/>
                                            <StackPanel Orientation="Vertical">
                                                <StackPanel Orientation="Horizontal">
                                                    <ToggleButton x:Name="AlignLeftButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                  ToolTip="Horizontal links" Click="AlignLeftButton_Click">
                                                        <StackPanel Width="14" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Border Height="1.6" Width="12" HorizontalAlignment="Left" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="1.6" Width="9" HorizontalAlignment="Left" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="1.6" Width="11" HorizontalAlignment="Left" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ToggleButton x:Name="AlignCenterButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                  ToolTip="Horizontal zentriert" Click="AlignCenterButton_Click">
                                                        <StackPanel Width="14" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Border Height="1.6" Width="12" HorizontalAlignment="Center" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="1.6" Width="9" HorizontalAlignment="Center" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="1.6" Width="11" HorizontalAlignment="Center" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ToggleButton x:Name="AlignRightButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                  ToolTip="Horizontal rechts" Click="AlignRightButton_Click">
                                                        <StackPanel Width="14" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Border Height="1.6" Width="12" HorizontalAlignment="Right" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="1.6" Width="9" HorizontalAlignment="Right" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="1.6" Width="11" HorizontalAlignment="Right" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <ToggleButton x:Name="AlignTopButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                  ToolTip="Vertikal oben" Click="AlignTopButton_Click">
                                                        <Grid Width="14" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border BorderThickness="1" CornerRadius="{DynamicResource RadiusS}"
                                                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="2" Width="8" VerticalAlignment="Top" Margin="0,2,0,0"
                                                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton x:Name="AlignMiddleButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                  ToolTip="Vertikal mitte" Click="AlignMiddleButton_Click">
                                                        <Grid Width="14" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border BorderThickness="1" CornerRadius="{DynamicResource RadiusS}"
                                                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="2" Width="8" VerticalAlignment="Center"
                                                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton x:Name="AlignBottomButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                  ToolTip="Vertikal unten" Click="AlignBottomButton_Click">
                                                        <Grid Width="14" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border BorderThickness="1" CornerRadius="{DynamicResource RadiusS}"
                                                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            <Border Height="2" Width="8" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                        </Grid>
                                                    </ToggleButton>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Zelle oder Spaltenkopf auswählen"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Fokusmodus (F11)" IsCheckable="True"
                                          IsChecked="{Binding PlacementTarget.Tag.IsFocusMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}"/>
                            
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="4" Margin="0,4,0,0" CornerRadius="{DynamicResource RadiusS}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Suche Haltung:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Width="200" VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Button Margin="4,0,0,0" Style="{StaticResource IconButton}"
                                Command="{Binding ClearSearchCommand}" ToolTip="Suche zurücksetzen">
                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextS}"/>
                        </Button>
                        <TextBlock Text="{Binding SearchResultInfo}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                        <TextBlock Text="Verschieben auf Pos.:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="20,0,6,0"/>
                        <TextBox x:Name="MoveToPositionBox" Width="60" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center" Padding="4,2"
                                 ToolTip="Zielposition eingeben (1-basiert) und Enter drücken"
                                 KeyDown="MoveToPositionBox_KeyDown"/>
                        <Button Content="&#xE72A;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextS}"
                                Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                ToolTip="Selektierte Zeile an Position verschieben"
                                Click="MoveToPosition_Click"/>

                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,4"/>

                        <TextBlock Text="Gehe zu Zeile:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="GoToRowBox" Width="60" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center" Padding="4,2"
                                 ToolTip="Zeilennummer eingeben und Enter drücken"
                                 KeyDown="GoToRowBox_KeyDown"/>
                        <Button Content="&#xE72A;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextS}"
                                Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                ToolTip="Zu Zeile springen"
                                Click="GoToRow_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Nova-Etappe 1: Spaltenansichten. Nur Sichtbarkeit; Werte und Export bleiben unberuehrt. -->
        <ItemsControl x:Name="ColumnViewChips" Grid.Row="1" Margin="2,0,2,6"
                      ItemsSource="{Binding Source={x:Static dp:DataPageColumnViewCatalog.Views}}"
                      AutomationProperties.Name="Spaltenansicht">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Style="{StaticResource CompactToggleButton}" Margin="0,0,6,0" Tag="{Binding Key}"
                                  Click="ColumnViewChip_Click"
                                  ToolTip="{Binding Titel}" AutomationProperties.Name="{Binding Titel}">
                        <TextBlock Text="{Binding Titel}"/>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- GridHost: Container fuer DataGrid oder Platzhalter wenn abgedockt -->
        <Grid x:Name="GridHost" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter-Chips: reiner View-Filter (NR bleibt Position; Verschieben gesperrt bei aktivem Filter) -->
            <uc:FilterChipBar x:Name="FilterChips" Grid.Row="0" Margin="2,0,2,6"/>

            <!-- Platzhalter (sichtbar wenn DataGrid abgedockt) -->
            <Border x:Name="UndockedPlaceholder" Visibility="Collapsed" Grid.Row="1"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusL}" Margin="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="40,30">
                    <TextBlock Text="&#xE8A7;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource IconHero}"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Die Ansicht ist in einem separaten Fenster geöffnet"
                               Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource TextL}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Ziehen Sie das Fenster auf einen anderen Monitor für Multi-Monitor-Betrieb."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextS}"
                               HorizontalAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button x:Name="DockBackPlaceholderButton" Click="DockBackFromPlaceholder_Click"
                            Style="{StaticResource ToolbarButtonAccent}" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE89F;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Andocken" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        <DataGrid x:Name="Grid"
                      Grid.Row="1"
                      ItemsSource="{Binding Records}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      behaviors:PhotoHoverPreviewBehavior.IsEnabled="True"
                      SelectionMode="Extended"
                      AutoGenerateColumns="False"
                      IsReadOnly="{Binding IsDataGridReadOnly}"
                      CanUserResizeRows="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="{Binding IsColumnReorderEnabled}"
                      HeadersVisibility="All"
                      GridLinesVisibility="All"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      FrozenColumnCount="2"
                      RowHeaderWidth="24"
                      MinRowHeight="{Binding GridMinRowHeight}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      SelectionUnit="CellOrRowHeader"
                      CanUserSortColumns="False"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="Grayscale"
                      CellEditEnding="Grid_CellEditEnding"
                      PreparingCellForEdit="Grid_PreparingCellForEdit"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                      PreviewMouseMove="Grid_PreviewMouseMove"
                      AllowDrop="True"
                      Drop="Grid_Drop"
                      SelectedCellsChanged="Grid_SelectedCellsChanged"
                      CurrentCellChanged="Grid_CurrentCellChanged"
                      PreviewMouseWheel="Grid_PreviewMouseWheel"
                      PreviewMouseDoubleClick="Grid_PreviewMouseDoubleClick"
                      PreviewKeyDown="Grid_PreviewKeyDown"
                      LoadingRow="Grid_LoadingRow">
                <DataGrid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding GridZoom}" ScaleY="{Binding GridZoom}"/>
                </DataGrid.LayoutTransform>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Position nach oben" Click="MoveRecordUpMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74A;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Position nach unten" Click="MoveRecordDownMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74B;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Beobachtungen..." Click="BeobachtungenMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE890;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="KI-Videoanalyse..."
                                  AutomationProperties.Name="KI-Videoanalyse fuer die gewaehlte Haltung starten"
                                  Command="{Binding PlacementTarget.DataContext.OpenVideoAiPipelineCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xEA80;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Play" Click="PlayMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE768;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Play (Gegeninspektion)" Click="PlayGegenMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE768;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Haltungsprotokoll AWU drucken..." Click="PrintAwuHaltungsprotokollMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE749;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Haltungsprotokoll Original (PDF) öffnen..." Click="OpenOriginalPdfMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Dichtheitsprüfung (PDF) öffnen..." Click="OpenDichtheitPdfMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Gehe zu Ordner" Click="OpenContainingFolderMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Sanierungsmaßnahmen..." Click="CostsMenu_Click">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE90F;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Markierte Zeilen löschen" Click="DeleteSelectedRows_Click"
                                  InputGestureText="Del" Foreground="{DynamicResource DangerBrush}">
                            <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74D;" Foreground="{DynamicResource DangerBrush}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <uc:EmptyStateControl x:Name="EmptyTablePlaceholder"
                                  IsHitTestVisible="False"
                                  Icon="&#xE8A5;"
                                  Title="Noch keine Haltungen"
                                  Message="Importiere Inspektionsdaten, damit die Haltungen hier als Tabelle erscheinen."
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                <uc:EmptyStateControl.Style>
                    <Style TargetType="uc:EmptyStateControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasItems, ElementName=Grid}" Value="False"/>
                                    <Condition Binding="{Binding Visibility, ElementName=Grid}" Value="Visible"/>
                                    <Condition Binding="{Binding Visibility, ElementName=UndockedPlaceholder}" Value="Collapsed"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </uc:EmptyStateControl.Style>
            </uc:EmptyStateControl>

            <!-- Haltungsansicht: alternative Sicht zur Tabelle, anfangs ausgeblendet -->
            <haltung:HaltungsansichtView x:Name="HaltungsansichtView" Grid.Row="1" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
