<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Export Toolbar Card -->
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="6,4" CornerRadius="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ExportCommand}"
                        Style="{StaticResource ToolbarButtonAccent}" Margin="0,0,4,0"
                        ToolTip="Haltungsdaten in die Excel-Vorlage Haltungen.xlsx exportieren.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Export Haltungen.xlsx" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportSchaechteCommand}"
                        Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                        ToolTip="Schachtdaten in die Excel-Vorlage Schaechte.xlsx exportieren.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Export Schächte.xlsx" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Verteilungs-Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="6,4" CornerRadius="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Click="DropdownButton_Click"
                        Style="{StaticResource ToolbarButton}" Margin="0,0,2,0"
                        ToolTip="Haltungen und Schächte in Ordner verteilen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Verteilen" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding DistributeHoldingsCommand}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Haltungen verteilen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding DistributeShaftsCommand}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Schächte verteilen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Command="{Binding DistributeDichtheitCommand}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Dichtheitsprüfung verteilen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Border>

        <!-- Fortschrittsanzeige -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="10" Margin="0,0,0,8" CornerRadius="8"
                Visibility="{Binding IsDistributionInProgress, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DistributionProgress}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding DistributionPercent, StringFormat=Fortschritt: {0:0}%}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <ProgressBar Height="6" Margin="0,2,0,0"
                             Minimum="0" Maximum="100"
                             Value="{Binding DistributionPercent}"
                             IsIndeterminate="{Binding IsDistributionIndeterminate}"/>
            </StackPanel>
        </Border>

        <!-- Ziel-/Namensvorlagen-Konfiguration + Ergebnis der letzten Verteilung -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="Zielverzeichnisse &amp; Namensvorlagen"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextBrush}" Margin="2,0,0,2"/>
                    <TextBlock Text="Ziel-Wurzel je Typ festlegen. Excel-Dateinamen mit Bausteinen zusammenstellen; Verteilnamen bleiben sicher fest."
                               FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="2,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding DistributionTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" Padding="12" CornerRadius="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titel}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Untertitel}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>

                                        <!-- Ziel-Wurzel -->
                                        <TextBlock Text="Ziel-Wurzel" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,2,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Basis-Ordner. Leer = beim Verteilen per Dialog fragen."/>
                                            <Button Grid.Column="1" Content="…" Command="{Binding BrowseRootCommand}"
                                                    Margin="4,0,0,0" Padding="10,0"
                                                    ToolTip="Ziel-Wurzel waehlen"/>
                                        </Grid>

                                        <!-- Grafischer Datei-Editor (nur Excel; die Verteilung bleibt sicher fest) -->
                                        <StackPanel Visibility="{Binding ShowFilePattern, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Dateiname zusammenstellen" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Bausteine anklicken. Die Reihenfolge ergibt den Dateinamen."
                                                       FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,1,0,5"/>

                                            <ItemsControl ItemsSource="{Binding AvailablePatternBlocks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Label}"
                                                                Command="{Binding DataContext.AddPatternBlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Description}"
                                                                Padding="9,3" Margin="0,0,5,5"
                                                                MinWidth="34"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <Button Content="Letzten Baustein entfernen"
                                                        Command="{Binding RemoveLastPatternBlockCommand}"
                                                        Padding="8,3" Margin="0,0,5,0"/>
                                                <Button Content="Leeren"
                                                        Command="{Binding ClearPatternCommand}"
                                                        Padding="8,3"/>
                                            </StackPanel>

                                            <TextBlock Text="Feinbearbeitung (optional)" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBox Text="{Binding DateiPattern, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,2,0,6"/>
                                        </StackPanel>

                                        <!-- Sichtbare Reihenfolge: editierbar bei Excel, fest bei der Verteilung -->
                                        <TextBlock Text="Zusammengesetzte Benennung" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="6,5" MinHeight="34" Margin="0,2,0,6">
                                            <ItemsControl ItemsSource="{Binding DateiPatternParts}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="7,3" Margin="0,0,4,3"
                                                                CornerRadius="9" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Text}" FontSize="10"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       ToolTip="{Binding RawValue}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <TextBlock Text="{Binding Hinweis}" FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <!-- Live-Vorschau (Excel: Datei; Verteilung: Ziel-Ordner) -->
                                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="Vorschau" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Vorschau}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Ergebnis der letzten Verteilung -->
            <TextBox Grid.Row="1" Text="{Binding LastResult}" AcceptsReturn="True" TextWrapping="Wrap"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" MaxHeight="140" Margin="0,8,0,0"
                     Foreground="{DynamicResource MutedBrush}"/>
        </Grid>

        <!-- Lade-Overlay fuer den xlsx-Export (deckt alle Zeilen ab) -->
        <ctrl:BusyOverlay Grid.RowSpan="4"
                          IsActive="{Binding Busy.IsActive}"
                          Message="{Binding Busy.Message}"/>
    </Grid>
</UserControl>
