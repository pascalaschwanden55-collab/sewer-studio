<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:pages="clr-namespace:AuswertungPro.Next.UI.Views.Pages"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <pages:DistributionVariantToBoolConverter x:Key="VariantToBool"/>
        <DataTemplate x:Key="PatternPartTemplate">
            <Border Padding="7,3" Margin="0,0,4,3" CornerRadius="9" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}" FontSize="10"
                           Foreground="{DynamicResource TextBrush}"
                           ToolTip="{Binding RawValue}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Export Toolbar Card -->
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="6,4" CornerRadius="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ExportCommand}"
                        Style="{StaticResource ToolbarButtonAccent}" Margin="0,0,4,0"
                        ToolTip="Haltungsdaten in die Excel-Vorlage Haltungen.xlsx exportieren.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE78C;" FontFamily="{DynamicResource FontIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Export Haltungen.xlsx" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportSchaechteCommand}"
                        Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                        ToolTip="Schachtdaten in die Excel-Vorlage Schaechte.xlsx exportieren.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE78C;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Export Schächte.xlsx" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Verteilungs-Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="6,4" CornerRadius="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Click="DropdownButton_Click"
                        Style="{StaticResource ToolbarButton}" Margin="0,0,2,0"
                        ToolTip="Haltungen und Schächte in Ordner verteilen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" FontFamily="{DynamicResource FontIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Verteilen" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource FontIcon}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Haltungen – Normal" Command="{Binding DistributeHoldingsNormalCommand}">
                                <MenuItem.Icon>
                                    <ui:FluentIcon Glyph="&#xE8B7;" Foreground="{DynamicResource MutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Haltungen – Sanierung" Command="{Binding DistributeHoldingsSanierungCommand}">
                                <MenuItem.Icon>
                                    <ui:FluentIcon Glyph="&#xE90F;" Foreground="{DynamicResource AccentBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Schächte – Normal" Command="{Binding DistributeShaftsNormalCommand}">
                                <MenuItem.Icon>
                                    <ui:FluentIcon Glyph="&#xE8B7;" Foreground="{DynamicResource MutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Schächte – Sanierung" Command="{Binding DistributeShaftsSanierungCommand}">
                                <MenuItem.Icon>
                                    <ui:FluentIcon Glyph="&#xE90F;" Foreground="{DynamicResource AccentBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Dichtheitsprüfung verteilen" Command="{Binding DistributeDichtheitCommand}">
                                <MenuItem.Icon>
                                    <ui:FluentIcon Glyph="&#xE9CE;" Foreground="{DynamicResource MutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Border>

        <!-- Fortschrittsanzeige -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="10" Margin="0,0,0,8" CornerRadius="8"
                Visibility="{Binding IsDistributionInProgress, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE895;" FontFamily="{DynamicResource FontIcon}" FontSize="14" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DistributionProgress}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding DistributionPercent, StringFormat=Fortschritt: {0:0}%}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <ProgressBar Height="6" Margin="0,2,0,0"
                             Minimum="0" Maximum="100"
                             Value="{Binding DistributionPercent}"
                             IsIndeterminate="{Binding IsDistributionIndeterminate}"/>
            </StackPanel>
        </Border>

        <!-- Ziel-/Namensvorlagen-Konfiguration + Ergebnis der letzten Verteilung -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="Zielordner &amp; Verzeichnisbaum"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextBrush}" Margin="2,0,0,2"/>
                    <TextBlock Text="Excel nutzt nur einen gemeinsamen Zielordner. Den Verzeichnisbaum stellst du getrennt für Haltungen, Schächte und DP zusammen."
                               FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="2,0,0,8"/>

                    <!-- Excel: bewusst nur ein gemeinsamer Zielordner, keine Namens- oder Baum-Muster -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Padding="12" CornerRadius="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Excel-Export" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Ein gemeinsamer Zielordner für Haltungen.xlsx und Schaechte.xlsx"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Zielordner" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ExcelExportRoot, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Dieser Ordner gilt für beide Excel-Dateien."/>
                                <Button Grid.Column="1" Command="{Binding BrowseExcelExportRootCommand}"
                                        Margin="4,0,0,0" Padding="10,0"
                                        ToolTip="Gemeinsamen Excel-Zielordner wählen">
                                    <ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="Feste Dateien: Haltungen.xlsx · Schaechte.xlsx"
                                       FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Verzeichnisbaum für die Verteilung"
                               FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" Margin="2,2,0,6"/>

                    <ItemsControl ItemsSource="{Binding DistributionTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" Padding="12" CornerRadius="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titel}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Untertitel}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>

                                        <!-- Eigene Ziel-Wurzel nur fuer die drei Verteilungen -->
                                        <StackPanel Visibility="{Binding ShowRootEditor, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Ziel-Wurzel" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <Grid Margin="0,2,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Basis-Ordner. Leer = beim Verteilen per Dialog fragen."/>
                                                <Button Grid.Column="1" Command="{Binding BrowseRootCommand}"
                                                        Margin="4,0,0,0" Padding="10,0"
                                                        ToolTip="Ziel-Wurzel waehlen">
                                                    <ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Normal/Sanierung-Umschalter (nur Haltung/Schacht) + grafische Ordnerbaum-Vorschau; Bausteine in "Erweitert" -->
                                        <StackPanel Visibility="{Binding ShowDirectoryTree, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,8"
                                                        Visibility="{Binding SupportsSanierung, Converter={StaticResource BoolToVis}}">
                                                <RadioButton Content="Normal" GroupName="Variant" Margin="0,0,6,0" Padding="14,4"
                                                             IsChecked="{Binding PreviewVariant, Converter={StaticResource VariantToBool}, ConverterParameter=Normal, Mode=TwoWay}"/>
                                                <RadioButton Content="Sanierung" GroupName="Variant" Padding="14,4"
                                                             IsChecked="{Binding PreviewVariant, Converter={StaticResource VariantToBool}, ConverterParameter=Sanierung, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <ctrl:DistributionTreePreviewControl Nodes="{Binding TreeNodes}" Margin="0,0,0,8"/>
                                            <Expander Header="Erweitert (Ordner-Bausteine)" IsExpanded="{Binding IsAdvancedExpanded}">
                                                <StackPanel Margin="0,6,0,0">
                                                    <TextBlock Text="Verzeichnisbaum" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="Bausteine anklicken. Leere Ebenen werden weggelassen."
                                                               FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,1,0,5"/>

                                            <!-- Erste freie Ebene -->
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}">
                                                    <Run Text="&#x251C;&#x2500; "/><Run Text="1. Ordner (optional)"/>
                                                </TextBlock>
                                                <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Padding="6,5" MinHeight="34" Margin="14,2,0,5">
                                                    <ItemsControl ItemsSource="{Binding OrdnerPatternParts}"
                                                                  ItemTemplate="{StaticResource PatternPartTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding AvailableDirectoryBlocks}" Margin="14,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Label}"
                                                                    Command="{Binding DataContext.AddOrdnerPatternBlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="{Binding Description}"
                                                                    Padding="9,3" Margin="0,0,5,5" MinWidth="34"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Margin="14,0,0,4">
                                                    <Button Content="Zurück" Command="{Binding RemoveLastOrdnerPatternBlockCommand}"
                                                            Padding="8,3" Margin="0,0,5,0"/>
                                                    <Button Content="Leeren" Command="{Binding ClearOrdnerPatternCommand}" Padding="8,3"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding OrdnerPattern, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="14,0,0,0" ToolTip="Optionale Feinbearbeitung des ersten Ordners"/>
                                            </StackPanel>

                                            <!-- Zweite freie Ebene -->
                                            <StackPanel Margin="14,0,0,8">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}">
                                                    <Run Text="&#x251C;&#x2500; "/><Run Text="2. Unterordner (optional)"/>
                                                </TextBlock>
                                                <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Padding="6,5" MinHeight="34" Margin="14,2,0,5">
                                                    <ItemsControl ItemsSource="{Binding UnterordnerPatternParts}"
                                                                  ItemTemplate="{StaticResource PatternPartTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding AvailableDirectoryBlocks}" Margin="14,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Label}"
                                                                    Command="{Binding DataContext.AddUnterordnerPatternBlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="{Binding Description}"
                                                                    Padding="9,3" Margin="0,0,5,5" MinWidth="34"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Margin="14,0,0,4">
                                                    <Button Content="Zurück" Command="{Binding RemoveLastUnterordnerPatternBlockCommand}"
                                                            Padding="8,3" Margin="0,0,5,0"/>
                                                    <Button Content="Leeren" Command="{Binding ClearUnterordnerPatternCommand}" Padding="8,3"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding UnterordnerPattern, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="14,0,0,0" ToolTip="Optionale Feinbearbeitung des zweiten Ordners"/>
                                            </StackPanel>

                                            <!-- Letzte Objekt-Ebene bleibt absichtlich fest -->
                                            <StackPanel Margin="28,0,0,8">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}">
                                                    <Run Text="&#x2514;&#x2500; "/><Run Text="Objektordner (fest)"/>
                                                </TextBlock>
                                                <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Padding="6,5" MinHeight="34" Margin="14,2,0,0">
                                                    <ItemsControl ItemsSource="{Binding ObjectFolderPatternParts}"
                                                                  ItemTemplate="{StaticResource PatternPartTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>

                                        <!-- Sichtbare Reihenfolge: editierbar bei Excel, fest bei der Verteilung -->
                                        <TextBlock Text="Dateiname" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="6,5" MinHeight="34" Margin="0,2,0,6">
                                            <ItemsControl ItemsSource="{Binding DateiPatternParts}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="7,3" Margin="0,0,4,3"
                                                                CornerRadius="9" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Text}" FontSize="10"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       ToolTip="{Binding RawValue}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <TextBlock Text="{Binding Hinweis}" FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <!-- Live-Vorschau des vollstaendigen Zielpfads -->
                                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="Vorschau" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Vorschau}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Ergebnis der letzten Verteilung -->
            <TextBox Grid.Row="1" Text="{Binding LastResult}" AcceptsReturn="True" TextWrapping="Wrap"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" MaxHeight="140" Margin="0,8,0,0"
                     Foreground="{DynamicResource MutedBrush}"/>
        </Grid>

        <!-- Lade-Overlay fuer den xlsx-Export (deckt alle Zeilen ab) -->
        <ctrl:BusyOverlay Grid.RowSpan="4"
                          IsActive="{Binding Busy.IsActive}"
                          Message="{Binding Busy.Message}"/>
    </Grid>
</UserControl>
