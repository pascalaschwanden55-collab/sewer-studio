<UserControl x:Class="AuswertungPro.Next.UI.Views.Pages.SchaechtePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:dp="clr-namespace:AuswertungPro.Next.UI.DataPage"
             xmlns:schachtansicht="clr-namespace:AuswertungPro.Next.UI.Views.Pages.Schachtansicht"
             Loaded="ColumnViews_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nova-Etappe 2: Werkzeugleiste zeigt nur die Hauptaktionen; alles Seltene liegt
             unveraendert (gleiche Handler, gleiche Commands) unter "Weitere Aktionen". -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="4,3" Margin="0,0,0,8" CornerRadius="{DynamicResource RadiusL}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource ToolbarButtonAccent}" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Speichern" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImportProtocolCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,2,0"
                            ToolTip="Einzelne PDF oder ganzen Ordner einschliesslich Unterordner importieren">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Protokoll importieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Neu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveCommand}" Style="{StaticResource ToolbarButtonDanger}" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Löschen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4"/>

                    <Button x:Name="WeitereAktionenDropdown" Click="DropdownButton_Click"
                            Style="{StaticResource ToolbarButton}" Margin="0,0,2,0"
                            ToolTip="Weitere Aktionen: Daten, Reihenfolge, Fachlich, Ansicht"
                            AutomationProperties.Name="Weitere Aktionen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE712;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextM}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Weitere Aktionen" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextXS}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="PDF-Daten" Command="{Binding ErgaenzeStammdatenAusPdfsCommand}"
                                          ToolTip="Fehlende Schachtform, Dimension und Schachttiefe aus vorhandenen PDFs ergänzen">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Aktualisieren" Command="{Binding RefreshProtocolCommand}"
                                          ToolTip="Verknüpftes Protokoll neu einlesen (Schacht wird neu aufgebaut)">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE72C;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Leere Felder aus QGIS" Command="{Binding QgisFelderErgaenzenCommand}" IsEnabled="{Binding CanMutateShaftData}"
                                          ToolTip="Leere Felder aus dem QGIS-Bestand ergänzen. Gefüllte Felder bleiben unberührt; vorher erscheint ein Bericht.">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE896;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Katasterkennungen" Command="{Binding KatasterKennungenErgaenzenCommand}" IsEnabled="{Binding CanMutateShaftData}"
                                          ToolTip="GEONIS-Kennungen aus der Kennungstabelle übernehmen, damit der XTF-Export dieselben Objekte wie der Kataster trägt. Nur Kennungen, keine Fachwerte; vorher erscheint ein Bericht.">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Feldnamen aufräumen" Command="{Binding FeldnamenAufraeumenCommand}" IsEnabled="{Binding CanMutateShaftData}"
                                          ToolTip="Doppelte Schreibweisen desselben Feldes zusammenführen (Zeichensalat aus alten Importen). Zeigt vorher einen Bericht.">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8FD;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Strassen" Click="StrassenStapel_Click" IsEnabled="{Binding CanMutateShaftData}"
                                          ToolTip="Leere Strassenfelder aus den angrenzenden Haltungen füllen - mit Vorschau, nichts wird überschrieben">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE71B;" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Hoch" Command="{Binding MoveUpCommand}">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74A;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Runter" Command="{Binding MoveDownCommand}">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74B;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Sanierungsmassnahmen..." Click="SanierungsmassnahmenMenu_Click">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE90F;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Protokoll (PDF)..." Click="ProtokollMenu_Click">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Gehe zu Ordner" Click="OpenContainingFolderMenu_Click">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Ansicht anpassen" ToolTip="Position, Zeile, Zeilenhöhe, Zoom und Ausrichtung">
                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE713;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                    <MenuItem StaysOpenOnClick="True">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Verschieben auf Pos.:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="120"/>
                                                <TextBox x:Name="MoveToPositionBox" Width="60" VerticalAlignment="Center"
                                                         VerticalContentAlignment="Center" Padding="4,2"
                                                         IsEnabled="{Binding CanMutateShaftData}"
                                                         ToolTip="Zielposition eingeben (1-basiert) und Enter drücken"
                                                         KeyDown="MoveToPositionBox_KeyDown"/>
                                                <Button Content="&#xE72A;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextS}"
                                                        Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                                        IsEnabled="{Binding CanMutateShaftData}"
                                                        ToolTip="Selektierten Schacht an Position verschieben"
                                                        Click="MoveToPosition_Click"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem StaysOpenOnClick="True">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Gehe zu Zeile:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="120"/>
                                                <TextBox x:Name="GoToRowBox" Width="60" VerticalAlignment="Center"
                                                         VerticalContentAlignment="Center" Padding="4,2"
                                                         ToolTip="Zeilennummer eingeben und Enter drücken"
                                                         KeyDown="GoToRowBox_KeyDown"/>
                                                <Button Content="&#xE72A;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextS}"
                                                        Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                                        ToolTip="Zu Zeile springen"
                                                        Click="GoToRow_Click"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem StaysOpenOnClick="True">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Zeilenhöhe:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="92"/>
                                                <Slider Width="130"
                                                        Minimum="24"
                                                        Maximum="240"
                                                        Value="{Binding GridMinRowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SmallChange="2"
                                                        LargeChange="10"
                                                        IsSnapToTickEnabled="False"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding GridMinRowHeight, StringFormat={}{0:0}px}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           MinWidth="36"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem StaysOpenOnClick="True">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Zoom:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="92"/>
                                                <Slider Width="130"
                                                        Minimum="0.5"
                                                        Maximum="2.0"
                                                        Value="{Binding GridZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SmallChange="0.05"
                                                        LargeChange="0.1"
                                                        IsSnapToTickEnabled="False"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding GridZoom, StringFormat={}{0:0%}}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           MinWidth="36"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem StaysOpenOnClick="True">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Ausrichtung:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="92"/>
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ToggleButton x:Name="AlignLeftButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                      ToolTip="Horizontal links" Click="AlignLeftButton_Click">
                                                            <StackPanel Width="14" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Height="1.6" Width="12" HorizontalAlignment="Left" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="1.6" Width="9" HorizontalAlignment="Left" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="1.6" Width="11" HorizontalAlignment="Left" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <ToggleButton x:Name="AlignCenterButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                      ToolTip="Horizontal zentriert" Click="AlignCenterButton_Click">
                                                            <StackPanel Width="14" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Height="1.6" Width="12" HorizontalAlignment="Center" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="1.6" Width="9" HorizontalAlignment="Center" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="1.6" Width="11" HorizontalAlignment="Center" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <ToggleButton x:Name="AlignRightButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                      ToolTip="Horizontal rechts" Click="AlignRightButton_Click">
                                                            <StackPanel Width="14" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Height="1.6" Width="12" HorizontalAlignment="Right" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="1.6" Width="9" HorizontalAlignment="Right" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="1.6" Width="11" HorizontalAlignment="Right" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <ToggleButton x:Name="AlignTopButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                      ToolTip="Vertikal oben" Click="AlignTopButton_Click">
                                                            <Grid Width="14" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Border BorderThickness="1" CornerRadius="{DynamicResource RadiusS}" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="2" Width="8" VerticalAlignment="Top" Margin="0,2,0,0" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            </Grid>
                                                        </ToggleButton>
                                                        <ToggleButton x:Name="AlignMiddleButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                      ToolTip="Vertikal mitte" Click="AlignMiddleButton_Click">
                                                            <Grid Width="14" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Border BorderThickness="1" CornerRadius="{DynamicResource RadiusS}" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="2" Width="8" VerticalAlignment="Center" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            </Grid>
                                                        </ToggleButton>
                                                        <ToggleButton x:Name="AlignBottomButton" Style="{StaticResource AlignToggleButtonStyle}"
                                                                      ToolTip="Vertikal unten" Click="AlignBottomButton_Click">
                                                            <Grid Width="14" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Border BorderThickness="1" CornerRadius="{DynamicResource RadiusS}" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                                <Border Height="2" Width="8" VerticalAlignment="Bottom" Margin="0,0,0,2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                            </Grid>
                                                        </ToggleButton>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="(Zelle oder Spaltenkopf auswählen)"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="Spalten anordnen" IsCheckable="True" IsChecked="{Binding IsColumnReorderEnabled}"/>
                                <MenuItem x:Name="ClearColumnModeButton" Header="Spalte leeren" IsCheckable="True"
                                          IsEnabled="{Binding CanMutateShaftData}"
                                          ToolTip="Aktivieren, dann auf Spaltentitel klicken um Spalte zu leeren"/>
                                <MenuItem x:Name="SchachtansichtToggle" Header="Alte Schachtansicht" IsCheckable="True"
                                          Checked="SchachtansichtToggle_Changed" Unchecked="SchachtansichtToggle_Changed"
                                          ToolTip="Zwischen Tabelle und Schachtansicht umschalten"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Suche Schacht:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox"
                             Width="200"
                             VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button Margin="4,0,0,0" Style="{StaticResource IconButton}"
                            Command="{Binding ClearSearchCommand}" ToolTip="Suche zurücksetzen">
                        <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextS}"/>
                    </Button>
                    <TextBlock Text="{Binding SearchResultInfo}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nova-Etappe 2: Spaltenansichten. Nur Sichtbarkeit; Werte und Export bleiben unberuehrt. -->
        <ItemsControl x:Name="ColumnViewChips" Grid.Row="1" Margin="2,0,2,6"
                      ItemsSource="{Binding Source={x:Static dp:SchaechteColumnViewCatalog.Views}}"
                      AutomationProperties.Name="Spaltenansicht">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Style="{StaticResource CompactToggleButton}" Margin="0,0,6,0" Tag="{Binding Key}"
                                  Click="ColumnViewChip_Click" ToolTip="{Binding Titel}" AutomationProperties.Name="{Binding Titel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Titel}"/>
                            <TextBlock x:Name="ChipZaehler" Margin="6,0,0,0" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DataGrid x:Name="Grid"
                  Grid.Row="2"
                  ItemsSource="{Binding Records}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserResizeRows="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="{Binding IsColumnReorderEnabled}"
                  HeadersVisibility="All"
                  GridLinesVisibility="All"
                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  FrozenColumnCount="2"
                  RowHeaderWidth="24"
                  MinRowHeight="{Binding GridMinRowHeight}"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  CanUserSortColumns="False"
                  IsReadOnly="{Binding IsShaftDataReadOnly}"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True"
                  TextOptions.TextFormattingMode="Display"
                  TextOptions.TextRenderingMode="Grayscale"
                  BeginningEdit="Grid_BeginningEdit"
                  CellEditEnding="Grid_CellEditEnding"
                  SelectedCellsChanged="Grid_SelectedCellsChanged"
                  CurrentCellChanged="Grid_CurrentCellChanged"
                  PreviewMouseWheel="Grid_PreviewMouseWheel"
                  PreviewMouseDoubleClick="Grid_PreviewMouseDoubleClick"
                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                  PreviewMouseLeftButtonDown="Grid_QgisReselectOnClick">
            <DataGrid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding GridZoom}" ScaleY="{Binding GridZoom}"/>
            </DataGrid.LayoutTransform>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Details anzeigen..." Click="DetailsMenu_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE946;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sanierungsmassnahmen..." Click="SanierungsmassnahmenMenu_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE90F;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Protokoll (PDF)..." Click="ProtokollMenu_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8A5;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Gehe zu Ordner" Click="OpenContainingFolderMenu_Click">
                        <MenuItem.Icon><ui:FluentIcon Glyph="&#xE838;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <schachtansicht:SchachtansichtView x:Name="SchachtansichtView"
                                           Grid.Row="2"
                                           IsEnabled="{Binding CanMutateShaftData}"
                                           Visibility="Collapsed"/>

        <uc:EmptyStateControl Grid.Row="2"
                              IsHitTestVisible="False"
                              Icon="&#xE8A5;"
                              Title="Noch keine Schächte"
                              Message="Importiere Schachtinspektionen, damit sie hier bearbeitbar erscheinen."
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
            <uc:EmptyStateControl.Style>
                <Style TargetType="uc:EmptyStateControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasItems, ElementName=Grid}" Value="False"/>
                                <Condition Binding="{Binding Visibility, ElementName=Grid}" Value="Visible"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </uc:EmptyStateControl.Style>
        </uc:EmptyStateControl>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding LastResult}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStammdatenErgaenzungInProgress}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding StammdatenErgaenzungText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="12,0,8,0"/>
                <ProgressBar Width="220" Height="10"
                             Minimum="0" Maximum="100"
                             Value="{Binding StammdatenErgaenzungProgress}"/>
                <Button Content="Abbrechen"
                        Command="{Binding CancelStammdatenErgaenzungCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
