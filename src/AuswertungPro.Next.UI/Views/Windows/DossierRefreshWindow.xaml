<Window x:Class="AuswertungPro.Next.UI.Views.Windows.DossierRefreshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="Dossier nachführen"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}"
                   FontSize="{DynamicResource TextS}"
                   Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ItemPanel"/>
        </ScrollViewer>

        <TextBlock x:Name="FootText"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}"
                   FontSize="{DynamicResource TextS}"
                   Margin="0,12,0,0"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="AcceptButton"
                    Content="Übernehmen"
                        ToolTip="Ergänzt das Dossier um die angehakten Einträge. Nicht Angehaktes wird als abgelehnt gemerkt und beim nächsten Nachführen nicht erneut angeboten."
                    Padding="16,7"
                    Margin="0,0,8,0"
                    Click="OnAccept"/>
            <Button Content="Abbrechen"
                        ToolTip="Schliesst das Fenster. Das Dossier bleibt unverändert, und nichts gilt als abgelehnt."
                    Padding="16,7"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
