<Window x:Class="AuswertungPro.Next.UI.Views.Windows.DossierShaftPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Schächte der Liegenschaft wählen"
        Width="760" Height="640"
        MinWidth="530" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Alle Schächte des Projekts. Ankreuzen, was zu dieser Liegenschaft gehört — ein Schacht darf auch in mehreren Dossiers stehen."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}"
                   FontSize="{DynamicResource TextS}"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Background="{DynamicResource HeaderBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="{DynamicResource TextM}"
                     TextChanged="OnSearchChanged"/>

            <ComboBox x:Name="GroupBox"
                      Grid.Column="1"
                      Width="180" Margin="8,0,0,0"
                      SelectionChanged="OnGroupChanged">
                <ComboBoxItem Content="Gruppieren: keine" IsSelected="True"/>
                <ComboBoxItem Content="Gruppieren: Strasse"/>
                <ComboBoxItem Content="Gruppieren: Funktion"/>
            </ComboBox>

            <Button Grid.Column="2" Content="Sichtbare wählen" Margin="8,0,0,0"
                    ToolTip="Hakt alle Schächte an, die gerade in der Liste zu sehen sind. Bei gesetztem Suchbegriff also nur die Treffer."
                    Padding="10,6" Click="OnSelectVisible"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource CardGlassBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusXL}">
            <ListBox x:Name="ShaftList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsChosen, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="4,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding ShaftNumber}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding Funktion}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="CountText"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Auswahl leeren" Width="130" Height="32" Margin="0,0,8,0"
                        ToolTip="Entfernt alle Haken. Das Dossier ändert sich erst mit Übernehmen."
                        Click="OnClear"/>
                <Button Content="Abbrechen" Width="110" Height="32" Margin="0,0,8,0"
                        ToolTip="Schliesst das Fenster. Die Zuordnung des Dossiers bleibt unverändert."
                        IsCancel="True" Click="OnCancel"/>
                <Button Content="Übernehmen" Width="120" Height="32"
                        ToolTip="Speichert die angehakten Schächte als Zuordnung dieser Liegenschaft."
                        IsDefault="True" Click="OnApply"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
