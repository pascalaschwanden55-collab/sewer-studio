<Window x:Class="AuswertungPro.Next.UI.Views.Windows.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls"
        xmlns:win="clr-namespace:AuswertungPro.Next.UI.Views.Windows"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        Title="Video"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SewerStudio;component/Views/Windows/PlayerWindow.Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PlayerCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="PlayerPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonAccent}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="MarkToolPopupButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="MinWidth" Value="150"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    TextBlock.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="TextElement.Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- RootContentHost: dezentes, professionelles Einblenden beim Oeffnen.
         Kurzes Fade (Deckkraft 0->1) mit minimalem Aufziehen (98%->100%) — ruhig,
         nicht verspielt. Laeuft ueber den Compositor und ist dadurch fluessig. -->
    <Grid x:Name="RootContentHost" Margin="16" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="OpenScaleTransform" ScaleX="0.98" ScaleY="0.98"/>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootContentHost"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.16">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="OpenScaleTransform"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.98" To="1" Duration="0:0:0.16">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="OpenScaleTransform"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.98" To="1" Duration="0:0:0.16">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>      <!-- Header -->
            <RowDefinition Height="*"/>         <!-- Video + Seitenpanel -->
            <RowDefinition Height="Auto"/>      <!-- Coding-Werkzeuge (nur im Codier-Modus) -->
            <RowDefinition Height="Auto"/>      <!-- Pipe Graph Timeline (Codier-Modus) -->
            <RowDefinition Height="Auto"/>      <!-- Timeline -->
            <RowDefinition Height="Auto"/>      <!-- Controls -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PlayerCard}"
                Margin="0,0,0,12"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,2,14,2"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="999"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Videoplayer"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="VideoNameText"
                               Margin="0,4,0,0"
                               Text="Video"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="VideoPathText"
                               Margin="0,4,0,0"
                               Style="{StaticResource PlayerLabelText}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Margin="16,0,0,0"
                        Style="{StaticResource PlayerMetaCard}"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Hotkeys"
                                   Style="{StaticResource PlayerLabelText}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="Space Pause, Pfeile +/-5s, +/- Geschwindigkeit"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="12"
                                   TextAlignment="Right"/>
                        <Button HorizontalAlignment="Right"
                                Width="28"
                                Height="24"
                                MinWidth="28"
                                Padding="0"
                                Margin="0,6,0,0"
                                Style="{StaticResource ToolbarButton}"
                                Click="ShowShortcutOverlay_Click"
                                ToolTip="Tastenkürzel anzeigen">
                            <ui:FluentIcon Glyph="&#xE897;" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Video-Bereich: Grid mit optionalem Seitenpanel -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Coding-Seitenpanel (nur sichtbar im Codier-Modus) -->
                <ColumnDefinition x:Name="CodingSidePanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Video + Overlays: Geschwister-Pattern (wie CodingModeWindow) -->
            <Grid Grid.Column="0">
                <!-- Video-Layer -->
                <vlc:VideoView x:Name="VideoView"
                               Background="{DynamicResource VideoBackgroundBrush}"
                               IsHitTestVisible="False"
                               Panel.ZIndex="0"/>

                <!-- Coding Overlay als Popup:
                     eigenes Top-Level-Window, damit Zeichnung trotz VLC-HwndHost sichtbar bleibt -->
                <Popup x:Name="CodingOverlayPopup"
                       PlacementTarget="{Binding ElementName=VideoView}"
                       Placement="Relative"
                       HorizontalOffset="0"
                       VerticalOffset="0"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       IsOpen="False">
                    <Canvas x:Name="CodingOverlayCanvas"
                            Width="1"
                            Height="1"
                            Background="#01000000"
                            ClipToBounds="True"
                            IsHitTestVisible="True"
                            Cursor="Arrow"
                            MouseLeftButtonDown="CodingCanvas_MouseLeftButtonDown"
                            MouseMove="CodingCanvas_MouseMove"
                            MouseLeftButtonUp="CodingCanvas_MouseLeftButtonUp"
                            MouseWheel="CodingCanvas_MouseWheel"/>
                </Popup>

                <!-- Detection overlay layer (hidden by default) -->
                <Grid x:Name="DetectionOverlayGrid"
                      Visibility="Collapsed"
                      Panel.ZIndex="20"
                      IsHitTestVisible="False">
                    <Canvas x:Name="DetectionCanvas"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            ClipToBounds="True"/>

                    <!-- EingabemarkerPopup wurde in die Toolbar verschoben (VLC Airspace) -->

                    <Border x:Name="AiStatusBadge"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="12" CornerRadius="8" Padding="10,5"
                            Background="{DynamicResource VideoScrimBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AiStatusDot" Width="8" Height="8"
                                     Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AiStatusText" Text="KI aktiv"
                                       Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FindingSummaryPanel"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Background="{DynamicResource VideoScrimSoftBrush}" Padding="12,8" Visibility="Collapsed">
                        <TextBlock x:Name="FindingSummaryText"
                                   Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <!-- Kalibrierungs-Hinweis -->
                <Border x:Name="CodingCalibrationHint"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,8,0,0" Background="{DynamicResource VideoScrimBlackStrongBrush}" CornerRadius="8"
                        Padding="16,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="KALIBRIERUNG" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtCodingCalibHint" FontSize="12" Foreground="White"
                                   TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                </Border>

                <!-- KI-Bestaetigungs-Panel (bei Gelb/Rot: Video angehalten, User entscheidet) -->
                <Border x:Name="CodingConfirmationPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource VideoScrimStrongBrush}" CornerRadius="12" Padding="20,16"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel MaxWidth="420">
                        <!-- Ampel-Farbe + KI-Vorschlag -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="ConfirmAmpel" Width="16" Height="16" Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtConfirmCode" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtConfirmConfidence" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtConfirmDescription" Foreground="White" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtConfirmDetail" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Fehler beim Goldspeichern: Panel bleibt offen, Retry moeglich -->
                        <StackPanel x:Name="ConfirmSaveErrorPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtConfirmSaveError" Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Button Click="ConfirmSaveRetry_Click"
                                    Style="{StaticResource PlayerButton}" Padding="12,6" HorizontalAlignment="Left"
                                    Foreground="{DynamicResource WarningBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE72C;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Erneut speichern"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Aktionen -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Click="ConfirmAccept_Click"
                                    Style="{StaticResource PlayerPrimaryButton}" Padding="12,6" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE73E;" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Übernehmen"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ConfirmEdit_Click"
                                    Style="{StaticResource PlayerButton}" Padding="12,6" Margin="0,0,6,0"
                                    Foreground="{DynamicResource AccentBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE70F;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Code ändern"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ConfirmReject_Click"
                                    Style="{StaticResource PlayerButton}" Padding="12,6"
                                    Foreground="{DynamicResource DangerBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE711;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Verwerfen"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- LiveDetection-Bestaetigungs-Panel (bei Befund: Video angehalten, User entscheidet) -->
                <Border x:Name="DetectionConfirmationPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,24" Background="{DynamicResource VideoScrimStrongBrush}" CornerRadius="12"
                        Padding="20,12" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5"
                        Panel.ZIndex="30">
                    <StackPanel MaxWidth="480">
                        <TextBlock x:Name="TxtDetectionFinding" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtDetectionDetail" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Click="DetectionAccept_Click"
                                    Style="{StaticResource PlayerPrimaryButton}" Padding="12,6" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE73E;" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Akzeptieren"/>
                                </StackPanel>
                            </Button>
                            <Button Click="DetectionCorrect_Click"
                                    Style="{StaticResource PlayerButton}" Padding="12,6" Margin="0,0,6,0"
                                    Foreground="{DynamicResource WarningBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE70F;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Korrigieren"/>
                                </StackPanel>
                            </Button>
                            <Button Click="DetectionSkip_Click"
                                    Style="{StaticResource PlayerButton}" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE76C;" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Weiter"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Mess-Anzeige -->
                <Border x:Name="CodingMeasurementPanel"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,8" Background="{DynamicResource VideoScrimBlackBrush}" CornerRadius="8"
                        Padding="12,6" Visibility="Collapsed">
                    <TextBlock x:Name="TxtCodingMeasurement"
                               Foreground="White" FontSize="13"
                               FontFamily="Consolas, Cascadia Mono" HorizontalAlignment="Center"/>
                </Border>

                <!-- KI-Scan-Overlay: wandernde Linie + Rahmen waehrend Analyse -->
                <Border x:Name="CodingScanOverlay" Visibility="Collapsed"
                        IsHitTestVisible="False"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="2"
                        CornerRadius="0" Opacity="0.6">
                    <Grid>
                        <!-- Wandernde Scan-Linie -->
                        <Rectangle x:Name="CodingScanLine" Width="2" Height="Auto"
                                   Fill="{DynamicResource WarningBrush}" HorizontalAlignment="Left"
                                   VerticalAlignment="Stretch" Opacity="0.8"/>
                        <!-- Analyse-Badge oben rechts -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="8" Padding="8,4" CornerRadius="6"
                                Background="{DynamicResource VideoScrimBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}" Margin="0,0,5,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtScanStatus" Text="KI scannt..."
                                           Foreground="{DynamicResource WarningBrush}" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Flash-Effekt bei Fund (kurzes gruenes/gelbes Aufblitzen) -->
                <Border x:Name="CodingFlashOverlay" Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Background="{DynamicResource SuccessBrush}" Opacity="0"/>

                <!-- OSD-Meter Anzeige (KI-gelesener Meterstand, immer sichtbar im Codier-Modus) -->
                <Border x:Name="OsdMeterBadge"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12" Padding="10,5"
                        Background="{DynamicResource VideoScrimBrush}" CornerRadius="8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtOsdMeter"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Consolas, Cascadia Mono"
                               FontSize="14" FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- CODING SEITENPANEL (Mockup-Design) -->
            <win:PlayerCodingSidePanel x:Name="CodingSidePanelControl" Grid.Column="1"/>
        </Grid>
        <!-- CODING-WERKZEUGE (nur im Codier-Modus sichtbar) -->
        <Border x:Name="CodingToolbar" Grid.Row="2"
                Visibility="Collapsed"
                Style="{StaticResource PlayerCard}"
                Margin="0,0,0,8" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Meter-Anzeige -->
                    <ColumnDefinition Width="Auto"/>   <!-- Werkzeuge -->
                    <ColumnDefinition Width="Auto"/>   <!-- KI-Status + Analyse -->
                    <ColumnDefinition Width="Auto"/>   <!-- Overlay -->
                    <ColumnDefinition Width="*"/>      <!-- Findings -->
                    <ColumnDefinition Width="Auto"/>   <!-- Beenden -->
                </Grid.ColumnDefinitions>

                <!-- Meter-Navigation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource PlayerButton}" Padding="8,6"
                            Click="CodingPrevious_Click" ToolTip="Zurück (Step)">
                        <ui:FluentIcon Glyph="&#xE76B;" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                    <TextBlock x:Name="TxtCodingMeter"
                               FontFamily="Consolas, Cascadia Mono" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="8,0"
                               Text="0.00m"/>
                    <Button Style="{StaticResource PlayerButton}" Padding="8,6"
                            Click="CodingNext_Click" ToolTip="Weiter (Step)">
                        <ui:FluentIcon Glyph="&#xE76C;" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                    <TextBlock x:Name="TxtCodingRange"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Werkzeuge: Ein Dropdown-Button fuer alle Tools -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="1" Height="28" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>

                    <!-- Aktives Werkzeug Label -->
                    <TextBlock x:Name="TxtActiveToolLabel" Text="" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <!-- Werkzeuge-Dropdown -->
                    <Button x:Name="BtnToolsDropdown"
                            Style="{StaticResource PlayerButton}" Padding="8,5"
                            Click="ToolsDropdown_Click"
                            ToolTip="Werkzeuge (Messen, Markieren, Vermessen)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource FontIcon}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Werkzeuge" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource FontIcon}" FontSize="10"
                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="ToolsDropdownPopup" StaysOpen="False" Placement="Top"
                           PlacementTarget="{Binding ElementName=BtnToolsDropdown}">
                        <Border Background="{DynamicResource BgLightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="8">
                            <StackPanel>
                                <!-- Kalibrieren -->
                                <Button x:Name="BtnCodingCalibrate" Style="{StaticResource MarkToolPopupButton}"
                                        Click="CodingCalibrate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FluentIcon Glyph="&#xECC8;" Foreground="{DynamicResource AccentBrush}" Width="22" Margin="0,0,6,0"/>
                                        <TextBlock Text="Rohr kalibrieren (DN)"/>
                                    </StackPanel>
                                </Button>
                                <!-- Markieren fuer KI -->
                                <Button x:Name="BtnCodingRect" Style="{StaticResource MarkToolPopupButton}"
                                        Click="CodingToolRect_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FluentIcon Glyph="&#xE739;" Foreground="{DynamicResource AccentBrush}" Width="22" Margin="0,0,6,0"/>
                                        <TextBlock Text="Bereich markieren"/>
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,6"/>
                                <!-- Hinweis -->
                                <TextBlock Text="Alle Messwerkzeuge im PhotoAssistant"
                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="12,2" FontStyle="Italic"/>
                                <TextBlock Text="(Foto aufnehmen → Foto vermessen)"
                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="12,0,12,4" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <!-- Altes CodingMarkToolPopup entfernt, Markieren ist jetzt im Dropdown -->
                    <Popup x:Name="CodingMarkToolPopup" StaysOpen="False" Placement="Top"
                           PlacementTarget="{Binding ElementName=BtnToolsDropdown}" IsOpen="False"/>
                </StackPanel>

                <!-- KI-Status + Analyse -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="1" Height="28" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>
                    <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                        <!-- Puls-Ring (sichtbar waehrend Analyse) -->
                        <Ellipse x:Name="CodingAiPulseRing" Width="10" Height="10"
                                 Stroke="{DynamicResource WarningBrush}" StrokeThickness="2" Fill="Transparent"
                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="CodingAiDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}"/>
                    </Grid>
                    <!-- Breite begrenzt und abgeschnitten: Die Meldung bei
                         eingeschraenkter KI ist mehrere Zeilen lang und schob
                         sonst alle Knoepfe rechts davon aus dem Fenster
                         (gemeldet 2026-08-11). Der volle Text bleibt ueber den
                         Mauszeiger und ueber "Details" erreichbar. -->
                    <TextBlock x:Name="TxtCodingAiStatus" FontSize="11"
                               Foreground="{DynamicResource TextBrush}"
                               MaxWidth="190" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Text="Künstliche Intelligenz bereit" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtCodingAiStage" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               MaxWidth="240" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Text="" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Pipeline-Kontrollsicherung: ausklappbare Detailanzeige -->
                    <ToggleButton x:Name="CodingHealthToggle" Content="Details"
                                  Style="{StaticResource SpeedToggleButton}"
                                  FontSize="11"
                                  Margin="0,0,8,0" Padding="6,2" VerticalAlignment="Center"
                                  ToolTip="Zeigt, welche Teile der KI-Pipeline aktiv sind"/>
                    <Popup PlacementTarget="{Binding ElementName=CodingHealthToggle}" Placement="Bottom"
                           IsOpen="{Binding IsChecked, ElementName=CodingHealthToggle}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,4,0,0">
                            <StackPanel MinWidth="220">
                                <TextBlock Text="KI-Pipeline" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="Hd_Sidecar" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="Sidecar: -"/>
                                <TextBlock x:Name="Hd_Token"   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="Token: -"/>
                                <TextBlock x:Name="Hd_Yolo"    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="YOLO: -"/>
                                <TextBlock x:Name="Hd_Dino"    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="DINO: -"/>
                                <TextBlock x:Name="Hd_Sam"     Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="SAM: -"/>
                                <TextBlock x:Name="Hd_Mode"    Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           Margin="0,4,0,0" Text="Modus: -"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ToggleButton x:Name="BtnCodingLiveAi" Style="{StaticResource SpeedToggleButton}"
                                  IsChecked="False" Margin="0,0,6,0"
                                  ToolTip="Automatische KI-Analyse im Codiermodus an/aus (alle 5s)" Click="CodingLiveAi_Click">
                        <TextBlock Text="Automatische KI-Analyse" FontSize="11"/>
                    </ToggleButton>
                    <Button x:Name="BtnCodingAnalyze"
                            Style="{StaticResource PlayerPrimaryButton}"
                            Padding="10,5" FontSize="11"
                            Click="CodingAnalyzeFrame_Click"
                            ToolTip="Aktuellen Frame einmalig per KI analysieren">
                        <TextBlock Text="Aktuellen Frame analysieren"/>
                    </Button>
                    <Button x:Name="BtnCodingClearOverlays"
                            Style="{StaticResource PlayerButton}"
                            Padding="8,5" FontSize="11" Margin="6,0,0,0"
                            Click="CodingClearOverlays_Click"
                            ToolTip="Alle Einblendungen/Markierungen vom Video entfernen">
                        <StackPanel Orientation="Horizontal">
                            <ui:FluentIcon Glyph="&#xED1A;" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Overlays aus" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- Eingabemarker: Klick auf Stelle + Stichwort → KI analysiert -->
                    <ToggleButton x:Name="BtnEingabemarker" Style="{StaticResource SpeedToggleButton}"
                                  IsChecked="False" Margin="6,0,0,0"
                                  ToolTip="Eingabemarker: Video pausiert, Stelle markieren, Stichwort eingeben → KI bestimmt Code"
                                  Click="Eingabemarker_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FluentIcon Glyph="&#xE707;" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="Eingabemarker" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Eingabemarker: Freitext + Schnellauswahl -->
                    <Border x:Name="EingabemarkerPopup" Visibility="Collapsed"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource HeaderBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                            Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <!-- Freitext-Eingabe (primaer) -->
                            <TextBox x:Name="TxtEingabemarker"
                                     FontSize="12" Width="220"
                                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                     Padding="4,3" VerticalContentAlignment="Center"
                                     KeyDown="CmbEingabemarker_KeyDown">
                                <TextBox.ToolTip>
                                    <TextBlock>
                                        Freitext: z.B. "Beule unten", "Riss bei 3 Uhr", "Anschluss offen 9h"
                                        <LineBreak/>Oder Stichwort aus der Liste wählen.
                                        <LineBreak/>Enter = Bestätigen | Esc = Abbrechen
                                    </TextBlock>
                                </TextBox.ToolTip>
                            </TextBox>
                            <!-- Schnellauswahl (Dropdown) -->
                            <ComboBox x:Name="CmbEingabemarker"
                                      FontSize="11" Width="130" Margin="4,0,0,0"
                                      Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      SelectionChanged="CmbEingabemarker_SelectionChanged">
                                <ComboBox.ToolTip>Schnellauswahl: Häufigste Codes</ComboBox.ToolTip>
                                <ComboBoxItem Content="Rohranfang" FontWeight="SemiBold"/>
                                <ComboBoxItem Content="Rohrende" FontWeight="SemiBold"/>
                                <ComboBoxItem Content="Anschluss" FontWeight="SemiBold"/>
                                <ComboBoxItem Content="Bogen" FontWeight="SemiBold"/>
                                <Separator/>
                                <ComboBoxItem Content="Riss"/>
                                <ComboBoxItem Content="Bruch"/>
                                <ComboBoxItem Content="Verformung"/>
                                <ComboBoxItem Content="Versatz"/>
                                <ComboBoxItem Content="Wurzeln"/>
                                <ComboBoxItem Content="Ablagerung"/>
                                <ComboBoxItem Content="Inkrustation"/>
                                <ComboBoxItem Content="Wasserstand"/>
                                <ComboBoxItem Content="Abbruch"/>
                            </ComboBox>
                            <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Enter" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{DynamicResource FontMono}" FontSize="10"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Overlay-Deckkraft -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="1" Height="28" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Overlay"
                               Style="{StaticResource PlayerLabelText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="OverlayOpacitySlider"
                            Width="92"
                            Minimum="0.35"
                            Maximum="1"
                            Value="1"
                            TickFrequency="0.05"
                            IsMoveToPointEnabled="True"
                            ValueChanged="OverlayOpacitySlider_ValueChanged"
                            ToolTip="Deckkraft der Codier-Overlays einstellen"/>
                    <TextBlock x:Name="OverlayOpacityText"
                               Width="38"
                               Text="100%"
                               FontFamily="Consolas, Cascadia Mono"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"/>
                </StackPanel>

                <!-- Aktuelle Position: Code am Zeitstempel (aus DataGrid) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Naechster Code am aktuellen Meter -->
                    <Border x:Name="CodingCurrentCodeBadge"
                            Background="{DynamicResource HeaderBrush}" CornerRadius="8"
                            Padding="8,3" Margin="0,0,8,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtCodingCurrentCode"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <!-- KI-Findings: Vollstaendige Anzeige mit Code + Klartext + Details -->
                    <ItemsControl x:Name="CodingFindingsList" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource HeaderBrush}" CornerRadius="8"
                                        Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center"
                                        ToolTip="{Binding FullTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SeverityBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <!-- VSA-Code fett -->
                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding VsaCode, Mode=OneWay}"/>
                                        <!-- Klartext-Beschreibung -->
                                        <TextBlock FontSize="11" FontWeight="Normal"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Text="{Binding Description, Mode=OneWay}"/>
                                        <!-- Meter + Uhr (wenn vorhanden) -->
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Text="{Binding PositionText, Mode=OneWay}"/>
                                        <!-- Confidence -->
                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding ConfidenceBrush}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Text="{Binding ConfidenceText, Mode=OneWay}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Uebernehmen + Beenden -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource PlayerPrimaryButton}"
                            Padding="10,5"
                            Click="CodingApply_Click"
                            ToolTip="Codierung in Primäre Schäden übernehmen">
                        <TextBlock Text="Übernehmen" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button Style="{StaticResource PlayerButton}"
                            Foreground="{DynamicResource DangerBrush}" Margin="6,0,0,0"
                            Click="CodingModeExit_Click"
                            ToolTip="Codier-Modus beenden ohne Übernahme">
                        <TextBlock Text="Beenden" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PIPE GRAPH TIMELINE (nur im Codier-Modus sichtbar) -->
        <StackPanel Grid.Row="3" x:Name="CodingTimelinePanel" Visibility="Collapsed">
            <ctrl:PipeGraphTimeline x:Name="PipeTimeline" Visibility="Collapsed" Height="0"/>

            <!-- YOLO-Statusanzeige -->
            <Border x:Name="YoloStatusBar" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="4"
                    Padding="10,4" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="YoloDot" Width="8" Height="8"
                             Fill="{DynamicResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtYoloStatus" Text="YOLO: Bereit"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtYoloModel" Text=""
                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="4"
                Style="{StaticResource PlayerCard}"
                Margin="0,0,0,12"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource PlayerTimeText}"
                           Text="00:00"/>

                <Grid Grid.Column="1">
                    <!-- Quick-Scan heatmap overlay, below slider -->
                    <Canvas x:Name="HeatmapCanvas"
                            IsHitTestVisible="True"
                            VerticalAlignment="Center"
                            Height="6"
                            Margin="0,12,0,0"
                            ClipToBounds="True"/>
                    <Slider x:Name="PositionSlider"
                            Minimum="0"
                            Maximum="1000"
                            Margin="0,1"
                            IsMoveToPointEnabled="True"
                            ValueChanged="PositionSlider_ValueChanged"
                            ToolTip="Videoposition - ziehen für Live-Vorschau, klicken zum Springen"/>
                    <!-- Damage code marker overlay, positioned dynamically to match slider track -->
                    <Canvas x:Name="DamageMarkerCanvas"
                            IsHitTestVisible="True"
                            VerticalAlignment="Center"
                            Height="28"
                            ClipToBounds="False"/>
                </Grid>

                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource PlayerTimeText}"
                           Text="00:00"/>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Style="{StaticResource PlayerCard}"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlayerPrimaryButton}" Margin="0,0,6,0" Click="Play_Click"
                            ToolTip="Video abspielen (Leertaste)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Play" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlayerButton}" Margin="0,0,6,0" Click="Pause_Click"
                            ToolTip="Video pausieren (Leertaste)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE769;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Pause" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlayerButton}" Click="Stop_Click"
                            ToolTip="Wiedergabe stoppen und zum Anfang zurücksetzen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="24" Margin="8,0"
                            Background="{DynamicResource BorderBrush}"/>

                    <ToggleButton x:Name="QuickScanButton"
                                  Style="{StaticResource SpeedToggleButton}"
                                  Margin="0,0,6,0"
                                  Click="QuickScan_Click"
                                  ToolTip="Schnell-Scan: KI-Heatmap auf der Timeline erzeugen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Schnell-Scan" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <TextBlock x:Name="QuickScanStatusText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="Collapsed"/>

                    <Border Width="1" Height="24" Margin="8,0"
                            Background="{DynamicResource BorderBrush}"/>

                    <ToggleButton x:Name="LiveDetectionButton"
                                  Style="{StaticResource SpeedToggleButton}"
                                  Margin="0,0,6,0"
                                  Click="LiveDetection_Click"
                                  ToolTip="Live-KI: Echtzeit-Schadenserkennung während Wiedergabe (D)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Live-KI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <Button x:Name="ManualMarkButton"
                                Style="{StaticResource PlayerButton}"
                                Click="ManualMark_Click"
                                ToolTip="Markieren: Werkzeug wählen (M)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtMarkToolName" Text="Markieren" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="MarkToolPopup" StaysOpen="False" Placement="Top"
                               PlacementTarget="{Binding ElementName=ManualMarkButton}">
                            <Border Background="{DynamicResource BgLightBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="6">
                                <StackPanel>
                                    <Button Click="MarkTool_Punkt_Click" Padding="12,6"
                                            Style="{StaticResource MarkToolPopupButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,14,0"/>
                                            <TextBlock Text="Punkt (Klick)"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MarkTool_Ellipse_Click" Padding="12,6"
                                            Style="{StaticResource MarkToolPopupButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="16" Height="10" Stroke="{DynamicResource AccentBrush}"
                                                     StrokeThickness="1.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="Ellipse"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MarkTool_Freihand_Click" Padding="12,6"
                                            Style="{StaticResource MarkToolPopupButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FluentIcon Glyph="&#xE70F;" Foreground="{DynamicResource AccentBrush}" Width="22" Margin="0,0,6,0"/>
                                            <TextBlock Text="Freihand"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MarkTool_Rechteck_Click" Padding="12,6"
                                            Style="{StaticResource MarkToolPopupButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FluentIcon Glyph="&#xE739;" Foreground="{DynamicResource AccentBrush}" Width="22" Margin="0,0,6,0"/>
                                            <TextBlock Text="Rechteck"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Button x:Name="CodingModeButton"
                            Style="{StaticResource PlayerPrimaryButton}"
                            Margin="6,0,0,0"
                            Click="CodingMode_Click"
                            ToolTip="Codier-Modus: Haltung komplett durchcodieren mit Overlay-Werkzeugen (C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Codier-Modus" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CodingScreenshotButton"
                            Style="{StaticResource PlayerButton}"
                            Margin="6,0,0,0"
                            Click="CodingScreenshot_Click"
                            ToolTip="Screen: ganzes Fenster (mit Boxen) in die Zwischenablage kopieren">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Screen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="LiveDetectionStatusText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="Collapsed"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Wiedergabegeschwindigkeit"
                               Style="{StaticResource PlayerLabelText}"
                               Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Width="260">
                        <ToggleButton x:Name="SpeedPresetButton"
                                      DockPanel.Dock="Right"
                                      Style="{StaticResource SpeedToggleButton}"
                                      MinHeight="28"
                                      Padding="8,3"
                                      Margin="8,0,0,0"
                                      ToolTip="Geschwindigkeitsstufen anzeigen">
                            <TextBlock Text="&#xE712;" FontFamily="{DynamicResource FontIcon}" FontSize="12"/>
                        </ToggleButton>
                        <Slider x:Name="SpeedSlider"
                                Minimum="0.25"
                                Maximum="8"
                                Value="1"
                                Ticks="0.25,0.5,1,1.5,2,4,8"
                                TickPlacement="BottomRight"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"
                                ValueChanged="SpeedSlider_ValueChanged"
                                ToolTip="Wiedergabegeschwindigkeit als Slider setzen"/>
                    </DockPanel>
                    <Popup PlacementTarget="{Binding ElementName=SpeedPresetButton}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=SpeedPresetButton, Mode=TwoWay}">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <WrapPanel>
                                <ToggleButton x:Name="Speed05Button" Style="{StaticResource SpeedToggleButton}" Content="0.5x" Click="Speed05_Click"
                                              ToolTip="Halbe Geschwindigkeit - für detaillierte Inspektion"/>
                                <ToggleButton x:Name="Speed1Button" Style="{StaticResource SpeedToggleButton}" Content="1x" Click="Speed1_Click"
                                              ToolTip="Normale Wiedergabegeschwindigkeit"/>
                                <ToggleButton x:Name="Speed15Button" Style="{StaticResource SpeedToggleButton}" Content="1.5x" Click="Speed15_Click"
                                              ToolTip="1.5-fache Geschwindigkeit"/>
                                <ToggleButton x:Name="Speed2Button" Style="{StaticResource SpeedToggleButton}" Content="2x" Click="Speed2_Click"
                                              ToolTip="Doppelte Geschwindigkeit"/>
                                <ToggleButton x:Name="Speed4Button" Style="{StaticResource SpeedToggleButton}" Content="4x" Click="Speed4_Click"
                                              ToolTip="4-fache Geschwindigkeit - schneller Überblick"/>
                                <ToggleButton x:Name="Speed8Button" Style="{StaticResource SpeedToggleButton}" Content="8x" Margin="0" Click="Speed8_Click"
                                              ToolTip="8-fache Geschwindigkeit - maximaler Schnellvorlauf"/>
                            </WrapPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="170" Margin="0,0,18,0">
                    <TextBlock Text="Lautstärke"
                               Style="{StaticResource PlayerLabelText}"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="MuteButton"
                                      Grid.Column="0"
                                      Style="{StaticResource SpeedToggleButton}"
                                      Width="32"
                                      MinHeight="28"
                                      Padding="0"
                                      Margin="0,0,8,0"
                                      Click="MuteButton_Click"
                                      ToolTip="Ton stummschalten">
                            <TextBlock x:Name="MuteIconText"
                                       Text="&#xE767;"
                                       FontFamily="{DynamicResource FontIcon}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </ToggleButton>
                        <Slider x:Name="VolumeSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                Value="80"
                                TickFrequency="10"
                                IsMoveToPointEnabled="True"
                                ValueChanged="VolumeSlider_ValueChanged"
                                ToolTip="Lautstärke 0 bis 100 Prozent"/>
                        <TextBlock x:Name="VolumeText"
                                   Grid.Column="2"
                                   Text="80%"
                                   FontFamily="Consolas, Cascadia Mono"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="3"
                        Style="{StaticResource PlayerMetaCard}"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Aktuelle Rate"
                                   Style="{StaticResource PlayerLabelText}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="RateText"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Text="1.00x"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="ShortcutOverlay"
                Grid.RowSpan="6"
                Visibility="Collapsed"
                Background="{DynamicResource VideoScrimBlackSoftBrush}"
                CornerRadius="8"
                MouseDown="CloseShortcutOverlay_Click">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="620"
                    MaxWidth="760"
                    Style="{StaticResource PlayerCard}"
                    MouseDown="ShortcutOverlayCard_MouseDown">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right"
                                Width="30"
                                Height="28"
                                MinWidth="30"
                                Padding="0"
                                Style="{StaticResource ToolbarButton}"
                                Click="CloseShortcutOverlay_Click"
                                ToolTip="Schliessen">
                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontIcon}" FontSize="11"/>
                        </Button>
                        <TextBlock Text="Tastenkürzel"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </DockPanel>

                    <UniformGrid Columns="2" Rows="4" Margin="0,0,0,4">
                        <StackPanel Margin="0,0,18,12">
                            <TextBlock Text="Wiedergabe" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Space  Play/Pause" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                            <TextBlock Text="S      Stop" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                            <TextBlock Text="P / R  Pause / Weiter" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Navigation" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="← / →  5 Sekunden springen" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                            <TextBlock Text="+ / -  Geschwindigkeit" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12">
                            <TextBlock Text="Codierung" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="D      Live-Erkennung" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                            <TextBlock Text="M      Markierwerkzeug" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                            <TextBlock Text="Esc    Overlay abbrechen" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Hilfe" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="F1 / ? Diese Übersicht" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                            <TextBlock Text="Esc    Übersicht schliessen" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas, Cascadia Mono"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
