<Window x:Class="AuswertungPro.Next.UI.Views.Windows.VerteilenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Verteilen"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SchrittNummer" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusChip}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SchrittTitel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource TextS}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SchrittKarte" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:NovaDialogHeader Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12"
                                    Title="Verteilen"
                                    Subtitle="Links wählen, rechts prüfen. Die Vorschau schreibt nichts – erst «Jetzt verteilen» legt ab."/>

        <!-- Schritte -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1 WAS -->
                <Border Style="{StaticResource SchrittKarte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SchrittNummer}">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                            <TextBlock Text="WAS" Style="{StaticResource SchrittTitel}"/>
                        </StackPanel>
                        <WrapPanel>
                            <RadioButton x:Name="ArtHaltungen" GroupName="Art" Content="Haltungen" Margin="0,0,14,0"
                                         IsChecked="{Binding IstHaltungen, Mode=TwoWay}"/>
                            <RadioButton x:Name="ArtSchaechte" GroupName="Art" Content="Schächte" Margin="0,0,14,0"
                                         IsChecked="{Binding IstSchaechte, Mode=TwoWay}"/>
                            <RadioButton x:Name="ArtDichtheit" GroupName="Art" Content="Dichtheit"
                                         IsChecked="{Binding IstDichtheit, Mode=TwoWay}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 2 ABLAGE -->
                <Border Style="{StaticResource SchrittKarte}"
                        Visibility="{Binding ZeigeAblage, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SchrittNummer}">
                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                            <TextBlock Text="ABLAGE" Style="{StaticResource SchrittTitel}"/>
                        </StackPanel>
                        <WrapPanel>
                            <RadioButton GroupName="Ablage" Content="Normal" Margin="0,0,14,0"
                                         IsChecked="{Binding IstNormal, Mode=TwoWay}"/>
                            <RadioButton GroupName="Ablage" Content="Sanierung"
                                         IsChecked="{Binding IstSanierung, Mode=TwoWay}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding SanierungHinweis}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding ZeigeSanierungHinweis, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- 3 QUELLE -->
                <Border Style="{StaticResource SchrittKarte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SchrittNummer}">
                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                            <TextBlock Text="QUELLE" Style="{StaticResource SchrittTitel}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding QuelleTitel}" FontSize="{DynamicResource TextXS}"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding QuelleAnzeige}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding QuelleAnzeige}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" x:Name="QuelleWaehlen" Content="Wählen…" Margin="8,0,0,0"
                                    Style="{StaticResource ToolbarButton}"
                                    ToolTip="Ordner mit den Protokollen wählen"
                                    Command="{Binding QuelleOrdnerWaehlenCommand}"/>
                        </Grid>
                        <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="{DynamicResource TextXS}" Content="{Binding EinzelnLinkText}"
                                Command="{Binding EinzelneDateienWaehlenCommand}"/>
                        <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="{DynamicResource TextXS}" Content="{Binding TxtLinkText}"
                                Command="{Binding TxtUmschaltenCommand}"
                                Visibility="{Binding ZeigeTxtUmschalter, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- 4 FILME -->
                <Border Style="{StaticResource SchrittKarte}"
                        Visibility="{Binding ZeigeFilme, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SchrittNummer}">
                                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                            <TextBlock Text="FILME" Style="{StaticResource SchrittTitel}"/>
                        </StackPanel>
                        <TextBlock Text="Ordner mit den Rohvideos" FontSize="{DynamicResource TextXS}"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FilmAnzeige}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FilmAnzeige}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" Content="Wählen…" Margin="8,0,0,0"
                                    Style="{StaticResource ToolbarButton}"
                                    ToolTip="Ordner mit den Rohvideos wählen"
                                    Command="{Binding FilmOrdnerWaehlenCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5 ZIEL -->
                <Border Style="{StaticResource SchrittKarte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource SchrittNummer}">
                                <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                            <TextBlock Text="ZIEL" Style="{StaticResource SchrittTitel}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ZielAnzeige}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="{DynamicResource TextXS}" Content="Ordnerbausteine auf der Export-Seite einstellen"
                                ToolTip="Schliesst dieses Fenster und zeigt die Einstellungen «Verzeichnisbaum für die Verteilung»."
                                Command="{Binding EinstellungenOeffnenCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Vorschau -->
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusL}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:FluentIcon Glyph="&#xE7B3;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="VORSCHAU" Style="{StaticResource SchrittTitel}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Kopfzeile}" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <ProgressBar Style="{StaticResource ProgressBarThin}" IsIndeterminate="True" Margin="0,6,0,0"
                                 Visibility="{Binding IstBerechnung, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Grid Grid.Row="2">
                <DataGrid x:Name="VorschauGrid" ItemsSource="{Binding Zeilen}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single" CanUserResizeRows="False"
                          FontSize="{DynamicResource TextS}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Protokoll" Binding="{Binding Protokoll}" Width="1.6*"/>
                        <DataGridTextColumn Header="Wird abgelegt in" Binding="{Binding Zielordner}" Width="1.6*"/>
                        <DataGridTextColumn x:Name="FilmSpalte" Header="Film" Binding="{Binding Film}" Width="1.3*"/>
                        <DataGridTemplateColumn Header="Zustand" Width="Auto" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,2" Margin="0,2" CornerRadius="{DynamicResource RadiusChip}"
                                            HorizontalAlignment="Left" ToolTip="{Binding Hinweis}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusArt}" Value="Gut">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusArt}" Value="Warnung">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusArt}" Value="Fehler">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusArt}" Value="Gut">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusArt}" Value="Warnung">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusArt}" Value="Fehler">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Hinweis" Binding="{Binding Hinweis}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyStateControl IsHitTestVisible="False"
                                            Icon="&#xE7B3;"
                                            Title="Noch keine Vorschau"
                                            Message="Quelle und Ziel wählen — die Vorschau erscheint automatisch.">
                    <controls:EmptyStateControl.Style>
                        <Style TargetType="controls:EmptyStateControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasItems, ElementName=VorschauGrid}" Value="False"/>
                                        <Condition Binding="{Binding IstBerechnung}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyStateControl.Style>
                </controls:EmptyStateControl>
                </Grid>

                <ItemsControl Grid.Row="3" ItemsSource="{Binding Hinweise}" Margin="0,8,0,0"
                              Visibility="{Binding HatHinweise, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <ui:FluentIcon Glyph="&#xE946;" FontSize="{DynamicResource TextXS}"
                                               Foreground="{DynamicResource InfoTextBrush}" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}"
                                           FontSize="{DynamicResource TextXS}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Aktionen -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource DialogButtonBar}" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Padding="16,6" Margin="0,0,8,0" IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Schliesst das Fenster. Es wird nichts verteilt."
                    Command="{Binding AbbrechenCommand}"/>
            <Button x:Name="VerteilenButton" Style="{StaticResource PrimaryButton}" Padding="18,6" IsDefault="True"
                    ToolTip="Verteilt genau die gewählte Quelle über den bisherigen Verteilweg."
                    Command="{Binding VerteilenCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:FluentIcon Glyph="&#xE72D;" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding VerteilenText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        </Border>
    </Grid>
</Window>
