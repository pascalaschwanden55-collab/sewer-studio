<Window x:Class="AuswertungPro.Next.UI.Views.Windows.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        Title="SewerStudio"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="True"
        Opacity="0">
    <Grid Background="#05060A">
        <!-- Dunkler Vollbild-Hintergrund: laesst die farbigen und goldenen Impulse hervortreten. -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#141821" Offset="0"/>
                    <GradientStop Color="#05060A" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Width="1000" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border CornerRadius="18" Background="#0B0E15" BorderBrush="#1E2430" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#FFB020" Opacity="0.16"/>
                </Border.Effect>
            </Border>

            <Canvas x:Name="NeuralCanvas" ClipToBounds="True" Margin="20"/>

            <StackPanel HorizontalAlignment="Left" Margin="440,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="S&#x200A;E&#x200A;W&#x200A;E&#x200A;R  S&#x200A;T&#x200A;U&#x200A;D&#x200A;I&#x200A;O"
                           FontSize="50"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Opacity="0"
                           RenderTransformOrigin="0,0.5">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F8FBFF" Offset="0"/>
                            <GradientStop Color="#EDF2F9" Offset="0.55"/>
                            <GradientStop Color="#CFC6B2" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleSlide" X="30"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="SubText"
                           Text="3D Neural Inspection Core"
                           FontSize="18"
                           Margin="2,6,0,0"
                           Foreground="#A7B5CB"
                           Opacity="0"/>

                <TextBlock x:Name="VersionText"
                           Foreground="#E9B24C"
                           FontSize="12"
                           FontWeight="SemiBold"
                           FontFamily="Consolas"
                           Margin="2,4,0,0"
                           Opacity="0">
                    <Run Text="{x:Static ui:AppIdentity.DisplayVersion}"/>
                    <Run Text="  |  Neural Network Core  |  VSA-KEK 2020  |  Local AI"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="#E9B24C" Margin="0,3,8,0" Opacity="0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Initialisiere Anwendung..."
                               Foreground="#93A2B8"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               Opacity="0"/>
                </StackPanel>
            </StackPanel>

            <Border Height="2" VerticalAlignment="Bottom" Margin="40,0,40,30"
                    CornerRadius="1" Background="#1A1F2A" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#E9B24C" Opacity="0.28"/>
                </Border.Effect>
                <Grid>
                    <Border x:Name="ProgressBar"
                            Height="2" HorizontalAlignment="Left" Width="0"
                            VerticalAlignment="Center"
                            CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C6892A" Offset="0"/>
                                <GradientStop Color="#F5C24B" Offset="0.55"/>
                                <GradientStop Color="#E8A63C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse x:Name="ProgressSheen" Width="70" Height="10"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Opacity="0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFE9B0" Offset="0"/>
                                <GradientStop Color="#73FFE9B0" Offset="0.5"/>
                                <GradientStop Color="#00FFE9B0" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="ProgressSheenSlide" X="-80"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Border>

        </Grid>

        <!-- Vignette: dunkelt die Raender leicht ab und gibt dem dunklen Bild mehr Buehne. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                    <GradientStop Color="#00000000" Offset="0.55"/>
                    <GradientStop Color="#59000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</Window>
