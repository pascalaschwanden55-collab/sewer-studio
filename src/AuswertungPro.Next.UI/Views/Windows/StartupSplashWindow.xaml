<Window x:Class="AuswertungPro.Next.UI.Views.Windows.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SewerStudio"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="True"
        Opacity="0">
    <!--
        Startbildschirm ueber den ganzen Bildschirm. Die Farben sind bewusst fest
        eingetragen und spiegeln ThemeLight.xaml (Flaechen F0F3F8..E5EBF4, Akzent 2563EB,
        Text 0A0F1A, Rahmen CDD6E4): Der Splash hat eine eigene Choreografie und darf
        nie von einem fehlenden Theme-Eintrag abhaengen.
    -->
    <Grid>
        <!-- Heller Grundverlauf wie der Programmhintergrund (BgBrush). -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF4F6FA" Offset="0"/>
                    <GradientStop Color="#FFEAEFF6" Offset="0.55"/>
                    <GradientStop Color="#FFE3E9F3" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Feines Ingenieur-Raster: gibt der Flaeche Struktur, ohne aufzufallen. -->
        <Border IsHitTestVisible="False" Opacity="0.55">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Geometry="M0,0 L48,0 L48,48 L0,48 Z" Brush="Transparent"/>
                            <GeometryDrawing Geometry="M0,0 L48,0">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#FFD5DCE8" Thickness="0.8"/>
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                            <GeometryDrawing Geometry="M0,0 L0,48">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#FFD5DCE8" Thickness="0.8"/>
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>

        <!-- Weiche Aufhellung hinter der Kugel, damit das Netz auf ruhigem Grund steht. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.28,0.5" GradientOrigin="0.28,0.5" RadiusX="0.42" RadiusY="0.62">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#A0FFFFFF" Offset="0.45"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Schmale Akzentkante oben: dieselbe Blaulinie wie in den Programmkopfzeilen. -->
        <Border Height="4" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF1D4ED8" Offset="0"/>
                    <GradientStop Color="#FF3B82F6" Offset="0.6"/>
                    <GradientStop Color="#FF0EA5E9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="47*"/>
                <ColumnDefinition Width="53*"/>
            </Grid.ColumnDefinitions>

            <!-- Linke Haelfte: das 3D-Neuralnetz, Groesse folgt der Bildschirmflaeche. -->
            <Canvas x:Name="NeuralCanvas" Grid.Row="0" Grid.Column="0"
                    ClipToBounds="True" Margin="48,48,0,24"/>

            <!-- Rechte Haelfte: Wortmarke und Fachkennzeichen. -->
            <StackPanel Grid.Row="0" Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="32,0,96,0">

                <StackPanel Orientation="Horizontal" x:Name="OverlineRow" Opacity="0">
                    <Border Width="34" Height="3" Background="#FF2563EB" CornerRadius="1.5"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="KI-GESTUETZTE KANALINSPEKTION"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF3D4D63"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="TitleText"
                           Text="SewerStudio"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="76"
                           FontWeight="SemiBold"
                           Foreground="#FF0A0F1A"
                           Margin="-3,10,0,0"
                           Opacity="0"
                           RenderTransformOrigin="0,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleSlide" X="30"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="SubText"
                           Text="Zustandserfassung, Codierung und Auswertung von Kanalnetzen"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="21"
                           Foreground="#FF3D4D63"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="640"
                           Opacity="0"/>

                <!-- Fachliche Kennzeichen als ruhige Chips, keine Versionsangabe. -->
                <StackPanel x:Name="TagRow" Orientation="Horizontal" Margin="0,26,0,0" Opacity="0">
                    <Border Background="#FFFCFDFF" BorderBrush="#FFCDD6E4" BorderThickness="1"
                            CornerRadius="4" Padding="12,5" Margin="0,0,10,0">
                        <TextBlock Text="VSA-KEK 2020" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FF1C2536"/>
                    </Border>
                    <Border Background="#FFFCFDFF" BorderBrush="#FFCDD6E4" BorderThickness="1"
                            CornerRadius="4" Padding="12,5" Margin="0,0,10,0">
                        <TextBlock Text="EN 13508-2" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FF1C2536"/>
                    </Border>
                    <Border Background="#FFFCFDFF" BorderBrush="#FFCDD6E4" BorderThickness="1"
                            CornerRadius="4" Padding="12,5">
                        <TextBlock Text="Lokale KI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FF1C2536"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,40,0,0">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9"
                             Fill="#FF2563EB" Margin="0,1,10,0" Opacity="0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText"
                               Text="Anwendung wird gestartet…"
                               Foreground="#FF1C2536"
                               FontSize="15"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               VerticalAlignment="Center"
                               Opacity="0"/>
                </StackPanel>
            </StackPanel>

            <!-- Fussbereich: Fortschritt ueber die ganze Breite plus Hinweis zum Ueberspringen. -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="64,0,64,44">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SkipHint"
                           Grid.Row="0"
                           Text="Klicken oder Taste drücken zum Überspringen"
                           FontSize="12"
                           Foreground="#FF6B7A90"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,10"
                           Opacity="0"/>

                <Border x:Name="ProgressTrack" Grid.Row="1" Height="3"
                        CornerRadius="1.5" Background="#FFD5DCE8" ClipToBounds="True">
                    <Grid>
                        <Border x:Name="ProgressBar"
                                Height="3" HorizontalAlignment="Left" Width="0"
                                VerticalAlignment="Center"
                                CornerRadius="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF1D4ED8" Offset="0"/>
                                    <GradientStop Color="#FF2563EB" Offset="0.6"/>
                                    <GradientStop Color="#FF0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Ellipse x:Name="ProgressSheen" Width="90" Height="12"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Opacity="0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ProgressSheenSlide" X="-100"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
