<Window x:Class="AuswertungPro.Next.UI.Views.Windows.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        Title="SewerStudio"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="True"
        Opacity="0">
    <Grid Background="{DynamicResource BgLightBrush}">
        <!-- Full-screen background with subtle vignette. -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="{DynamicResource ColorCard}" Offset="0"/>
                    <GradientStop Color="{DynamicResource ColorBgLight}" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Width="1000" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border CornerRadius="18" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="{DynamicResource ColorAccent}" Opacity="0.14"/>
                </Border.Effect>
            </Border>

            <Canvas x:Name="NeuralCanvas" ClipToBounds="True" Margin="20"/>

            <StackPanel HorizontalAlignment="Left" Margin="440,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="SEWER STUDIO"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="50"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Opacity="0"
                           RenderTransformOrigin="0,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleSlide" X="30"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="SubText"
                           Text="3D Neural Inspection Core"
                           FontSize="17"
                           Margin="2,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Opacity="0"/>

                <TextBlock x:Name="VersionText"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           FontFamily="Consolas"
                           Margin="2,4,0,0"
                           Opacity="0">
                    <Run Text="{x:Static ui:AppIdentity.DisplayVersion}"/>
                    <Run Text="  |  Neural Network Core  |  VSA-KEK 2020  |  Local AI"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{DynamicResource AccentBrush}" Margin="0,3,8,0" Opacity="0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Initialisiere Anwendung..."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               Opacity="0"/>
                </StackPanel>
            </StackPanel>

            <Border Height="2" VerticalAlignment="Bottom" Margin="40,0,40,30"
                    CornerRadius="1" Background="{DynamicResource AccentSubtleBrush}">
                <Border x:Name="ProgressBar"
                        Height="2" HorizontalAlignment="Left" Width="0"
                        CornerRadius="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource ColorAccent}" Offset="0"/>
                            <GradientStop Color="{DynamicResource ColorAccentLight}" Offset="0.55"/>
                            <GradientStop Color="{DynamicResource ColorAccentHover}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>

        </Grid>
    </Grid>
</Window>
