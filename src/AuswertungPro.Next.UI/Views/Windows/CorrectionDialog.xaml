<Window x:Class="AuswertungPro.Next.UI.Views.Windows.CorrectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Korrektur"
        Width="420" Height="520" MinWidth="420" MinHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <!-- Einheitlicher Stil fuer Eingabefelder -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- ListBox-Eintrag-Stil -->
        <Style x:Key="CodeListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Richtigen VSA-Code w&#228;hlen"
                       Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Suche oder w&#228;hle den korrekten Code aus dem Katalog."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Suche -->
        <TextBox x:Name="SearchBox" Grid.Row="1"
                 Style="{StaticResource DarkTextBox}"
                 Margin="0,0,0,8"
                 VerticalAlignment="Center"
                 Tag="Suche (Code oder Bezeichnung)..."
                 TextChanged="SearchBox_TextChanged">
            <TextBox.Resources>
                <!-- Platzhalter-Text wenn leer -->
                <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="Suche (Code oder Bezeichnung)..."
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                                       Margin="6,4"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Code-Liste -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,12">
            <ListBox x:Name="CodeListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource CodeListItem}"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="CodeListBox_SelectionChanged"
                     MouseDoubleClick="CodeListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   FontSize="12"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Aktionsleiste -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAbbrechen"
                    Content="Abbrechen"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button x:Name="BtnOk"
                    Content="OK"
                    IsDefault="True"
                    IsEnabled="False"
                    Style="{StaticResource SuccessButton}"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
