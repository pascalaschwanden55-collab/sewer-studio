<Window x:Class="AuswertungPro.Next.UI.Views.Windows.HydraulikPrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        Title="SewerStudio — Hydraulik-PDF drucken"
        Width="380" Height="380"
        MinWidth="380" MinHeight="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource TextM}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Bd" Width="18" Height="18"
                                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusS}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="CheckMark" Text="&#x2713;"
                                           FontSize="{DynamicResource TextM}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:NovaDialogHeader Grid.Row="0" Title="Abschnitte für den Druck auswählen"/>

        <StackPanel Grid.Row="1" Margin="8,0,0,0">
            <CheckBox x:Name="ChkTeilfuellung" Content="Teilfüllung (v, Q, A, Lu, Rhy, Bsp)"
                      IsChecked="True"/>
            <CheckBox x:Name="ChkVollfuellung" Content="Vollfüllung (v_V, Q_V)"
                      IsChecked="True"/>
            <CheckBox x:Name="ChkKennzahlen" Content="Kennzahlen (Re, Fr, Lambda, Ny, Tau)"
                      IsChecked="True"/>
            <CheckBox x:Name="ChkAblagerung" Content="Ablagerungsgefahr (v_c, I_c, Tau_c)"
                      IsChecked="True"/>
            <CheckBox x:Name="ChkAuslastung" Content="Auslastung (h/D)"
                      IsChecked="True"/>
            <CheckBox x:Name="ChkBewertung" Content="Bewertung (Ampel-Übersicht)"
                      IsChecked="True"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource DialogButtonBar}" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Width="90" Height="30" Margin="0,0,8,0"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Content="PDF erstellen" Width="110" Height="30"
                        Click="Ok_Click"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
