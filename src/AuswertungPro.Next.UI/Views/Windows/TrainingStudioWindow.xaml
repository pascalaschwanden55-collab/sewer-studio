<Window x:Class="AuswertungPro.Next.UI.Views.Windows.TrainingStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls"
        ui:WindowFx.Entrance="True"
        xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Windows"
        Title="SewerStudio — Training Studio (Prüfplatz)"
        Height="900"
        MinWidth="1050" MinHeight="630" Width="1500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="TrainingStudioWindow_PreviewKeyDown">
    <Window.Resources>
        <local:FileToImageConverter x:Key="FileToImage"/>
        <local:PersonalGoldMainCodeToTextConverter x:Key="PersonalGoldMainCodeToText"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Titelzeile: Fenstertitel, KI-Bereitschaftschip, Schliessen ──────── -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="{DynamicResource RadiusM}"
                Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Training Studio (Prüfplatz)"
                           FontWeight="Bold" FontSize="{DynamicResource TextL}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{DynamicResource KiSubtleBrush}"
                        CornerRadius="{DynamicResource RadiusChip}" Padding="8,3"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:NeuralPulseDot Width="10" Height="10"
                                             IsActive="{Binding IstKiBereit}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding KiBereitschaftText}"
                                   Foreground="{DynamicResource KiTextBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Content="Schliessen" Style="{StaticResource ToolbarButton}"
                        Click="Close_Click" Margin="12,0,0,0" VerticalAlignment="Center"
                        ToolTip="Fenster schliessen" AutomationProperties.Name="Schliessen"/>
            </Grid>
        </Border>

        <!-- ── Arbeitsfläche: 210 | * | 330, jede Spalte scrollt selbst ────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- B4: Prototypmass 210 bleibt die Mindestbreite; die Werkzeugspalte darf auf
                     hoechstens 240 wachsen, damit Knopfbeschriftungen und Hinweise vollstaendig
                     stehen. Mehr Platz gehoert dem Bild in der Mitte. -->
                <ColumnDefinition Width="240" MinWidth="210" MaxWidth="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Links: Quellen, Werkzeuge, Rohr-DN, Fortschritt, Bogen-Vorschläge ──
                 Eigener Name, weil ein laufender PDF-Import ausschliesslich diese
                 Werkzeugspalte sperrt (SetPdfImportUiBusy). -->
            <ScrollViewer x:Name="PdfSourceToolbar" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <StackPanel>
                    <Button Content="Fotos laden…" Style="{StaticResource ToolbarButton}"
                            Click="LoadPhotos_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="PDF laden…" Style="{StaticResource ToolbarButton}"
                            Click="LoadPdfProtocol_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Extrahiert nur eindeutig zugeordnete Operateur-Fotos und Codes. Gold entsteht erst nach Box, Segmentierung und Bestätigung."/>
                    <Button Content="PDF-Ordner laden…" Style="{StaticResource ToolbarButton}"
                            Click="LoadPdfFolders_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Mehrere Ordner wählen. PDFs werden rekursiv gesucht und ihre eindeutig zugeordneten Fotos gemeinsam geladen."/>
                    <Button Content="Eingang laden" Style="{StaticResource ToolbarButton}"
                            Click="LoadGoldInbox_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Lädt alle Bilder aus dem Gold-Eingang in die Trainingsvorschau."/>
                    <Button Content="Segmentierung abarbeiten" Style="{StaticResource ToolbarButton}"
                            Click="LoadIncompleteGoldQueue_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Lädt alle lesbaren persönlichen Bilder mit fehlender oder ungültiger Maske. Vorhandene Boxen werden automatisch erneut mit SAM segmentiert."/>
                    <Button Content="Goldprüfung (90)" Style="{StaticResource ToolbarButton}"
                            Command="{Binding LoadGoldQualityReviewCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                            ToolTip="Prüft je 15 freigegebene Goldbilder für BAB, BAF, BAI, BAJ, BBC und BBF. Die Sitzung wird sicher fortgesetzt."/>

                    <Grid Margin="0,0,0,10">
                        <Button x:Name="StudioWeitereButton" Content="Weitere"
                                Style="{StaticResource ToolbarButton}" Click="StudioWeitereButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                ToolTip="Weitere Werkzeuge: Gold-Eingang, Warteschlange, Reparaturfälle, Goldalbum, KI starten"
                                AutomationProperties.Name="Weitere Werkzeuge"/>
                        <Popup x:Name="StudioWeiterePopup" StaysOpen="False" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=StudioWeitereButton}">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusM}" Padding="10">
                                <StackPanel Width="190">
                                    <Button Content="Gold-Eingang öffnen" Style="{StaticResource ToolbarButton}"
                                            Click="OpenGoldInbox_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                            ToolTip="Öffnet die Hauptcode-Ordner für neue, noch nicht gelabelte Bilder."/>
                                    <Button Content="Warteschlange laden" Style="{StaticResource ToolbarButton}"
                                            Click="LoadReviewQueue_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                                    <Button Content="Alle Gold-Reparaturfälle" Style="{StaticResource ToolbarButton}"
                                            Click="LoadAllIncompleteGoldQueue_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                            ToolTip="Diagnoseliste aller persönlichen Entwürfe und Reparaturfälle, auch wenn die Bilddatei fehlt oder nicht geöffnet werden kann."/>
                                    <Button Content="Goldalbum" Style="{StaticResource ToolbarButton}"
                                            Click="OpenGoldAlbum_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                            ToolTip="Zeigt alle persönlich bestätigten Beispiele nach Hauptcode."/>
                                    <Button Content="KI starten" Style="{StaticResource ToolbarButton}"
                                            Command="{Binding StartAiCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            ToolTip="Lokale Vision-KI starten oder erneut prüfen."/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border Background="{DynamicResource BorderLightBrush}" Height="1" Margin="0,0,0,10"/>

                    <TextBlock Text="Rohr-DN (leer = 300)" Foreground="{DynamicResource MutedBrush}"
                               FontSize="{DynamicResource TextS}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PipeDiameterInput, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Left" Width="80" VerticalContentAlignment="Center" Margin="0,0,0,10"
                             ToolTip="Optionaler Rohrdurchmesser in mm (leer = 300 mm Standard)."/>

                    <StackPanel x:Name="PdfImportProgressPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <ProgressBar Height="8" IsIndeterminate="True" Margin="0,0,0,6"/>
                        <Button x:Name="PdfImportCancelButton"
                                Content="PDF-Import abbrechen"
                                Style="{StaticResource ToolbarButtonDanger}"
                                Click="CancelPdfImport_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Geprüft:" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding QueueDoneCount}" Margin="4,0,0,0" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text=" / " Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding QueueTotalCount}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- ── Bogen-Vorschläge (Video-Durchlauf, Auftrag Paket 3) ────────── -->
                    <Expander x:Name="BendSuggestionSection"
                              IsExpanded="True"
                              Background="{DynamicResource CardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <Expander.Header>
                            <TextBlock FontWeight="Bold" TextWrapping="Wrap"
                                       Text="Vorschläge aus dem Video-Durchlauf (Rohranfang, Rohrende, Bögen)"/>
                        </Expander.Header>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusM}" Padding="10" MaxHeight="560">
                            <StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Content="Video wählen…" Style="{StaticResource ToolbarButton}"
                                            Click="ChooseBendSuggestionVideo_Click"/>
                                    <Button Content="Durchgang starten" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding StartScanCommand}" Margin="6,0,0,0"/>
                                    <Button Content="Abbrechen" Style="{StaticResource ToolbarButtonDanger}"
                                            Command="{Binding CancelScanCommand}"
                                            IsEnabled="{Binding IsBusy}" Margin="6,0,0,0"/>
                                </WrapPanel>
                                <!-- B4: In der schmalen Werkzeugspalte steht die Haltung unter den
                                     Knoepfen, sonst draengt sie sich neben "Abbrechen". -->
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Haltung:"/>
                                    <Run Text="{Binding Haltung, TargetNullValue='—'}"/>
                                    <Run Text="{Binding VideoPath, StringFormat=' · {0}', TargetNullValue=''}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <!-- Grenzen, die sichtbar ins Fenster gehören (Auftrag) — konstant, kein Tooltip -->
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="{DynamicResource TextXS}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Text="Rohranfang und Rohrende: genau ein Vorschlag je Video, Abnahme 85 bzw. 89 % (Sekunde statt Meter). Bögen: eine leere Liste ist ein gültiges Ergebnis, jeder zweite schwache Vorschlag ist falsch. Auf HD-Material gibt es keine Meterangabe."/>
                                <TextBlock Text="{Binding HeaderText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ResultInfoText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <!-- B4: In der schmalen Werkzeugspalte stehen Liste und Vorschau
                                     untereinander. Die Tabelle bringt ihren eigenen waagrechten
                                     Bildlauf mit; nichts wird abgeschnitten. -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid Grid.Row="0"
                                              ItemsSource="{Binding Suggestions}"
                                              SelectedItem="{Binding SelectedSuggestion}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              SelectionMode="Single" SelectionUnit="FullRow"
                                              MouseDoubleClick="BendSuggestionGrid_MouseDoubleClick"
                                              ToolTip="Doppelklick öffnet die Grossansicht mit Bild und Clip."
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              Background="Transparent" MaxHeight="220" Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Art" Binding="{Binding ArtText}" Width="130"/>
                                            <DataGridTextColumn Header="Ort" Binding="{Binding OrtText}" Width="*"/>
                                            <DataGridTextColumn Header="Stufe" Binding="{Binding StufeText}" Width="70">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <!-- stark war in der Messung 6/6 richtig, schwach 7/9 —
                                                                 der Unterschied muss sichtbar sein -->
                                                            <DataTrigger Binding="{Binding Strength}" Value="Strong">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Strength}" Value="Weak">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Konfidenz" Binding="{Binding KonfidenzText}" Width="80"/>
                                            <DataGridTextColumn Header="Bilder" Binding="{Binding FrameCount}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource RadiusS}" Padding="4">
                                        <StackPanel>
                                            <Image Source="{Binding PeakImage}" MaxHeight="240" Stretch="Uniform"/>
                                            <MediaElement Source="{Binding ClipPath}" MaxHeight="200" Stretch="Uniform"
                                                          LoadedBehavior="Play" UnloadedBehavior="Play" Margin="0,6,0,0"/>
                                            <Button Content="Gross anzeigen…" Style="{StaticResource ToolbarButton}"
                                                    Click="OpenBendSuggestionPreview_Click" Margin="0,6,0,0"
                                                    ToolTip="Öffnet Spitzenbild und Clip in Fenstergrösse."/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Mitte + rechts zusammen — eigener Name, weil ein laufender PDF-Import
                 genau diesen Bereich sperrt (SetPdfImportUiBusy), waehrend die linke
                 Werkzeugspalte (PdfSourceToolbar) unabhaengig davon gesperrt wird. -->
            <Grid x:Name="PdfReviewArea" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

            <!-- ── Mitte: Bild + Overlay, Warteschlange, Modelltest am Foto ──────────
                 Zeilen Auto (Pfad) / * (Bild) / Auto (Thumbnails) / Auto (Modelltest) — direkt im
                 Grid statt in einem ScrollViewer, sonst haette die "*"-Bildzeile keine Hoehe
                 (ein ScrollViewer bietet seinem Inhalt unbegrenzte Hoehe an). So passt sich das
                 Bild wie im Prototyp der verfuegbaren Hoehe an; Thumbnails und Modelltest bleiben
                 immer sichtbar. -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="0,0,0,6"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding CurrentImagePath, TargetNullValue='Keine Warteschlange geladen'}"/>

                <!-- Bild + Box/Masken-Overlay -->
                <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="6" Margin="0,0,0,8">
                    <Grid>
                        <Image x:Name="FrameImage" Stretch="Uniform"
                               Source="{Binding CurrentImagePath, Converter={StaticResource FileToImage}, ConverterParameter=Original}"/>
                        <!-- Overlay: Box-Zeichnen + Maskenkontur (Code-behind, reine Geometrie) -->
                        <Canvas x:Name="OverlayCanvas" Background="Transparent"
                                IsHitTestVisible="{Binding IsAnnotationEntryEnabled}"
                                MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                                MouseMove="OverlayCanvas_MouseMove"
                                MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp"/>
                        <TextBlock Text="Ziehe mit der Maus eine Box um den Schaden."
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                   Foreground="{DynamicResource MutedBrush}" FontStyle="Italic"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- ── Warteschlange (Thumbnails) ─────────────────────────────── -->
                <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                        Padding="8" Margin="0,0,0,8" MaxHeight="96">
                    <ListBox x:Name="PdfThumbnailQueue"
                             ItemsSource="{Binding Items}"
                             SelectedIndex="{Binding CurrentIndex, Mode=OneWay}"
                             SelectionChanged="PdfThumbnailQueue_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="110" Height="72" Margin="0,0,6,0" CornerRadius="{DynamicResource RadiusS}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding FramePath, Converter={StaticResource FileToImage}, ConverterParameter=160}"
                                               Stretch="UniformToFill"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Reiner Modelltest: automatische Treffer werden nie als Gold gespeichert. -->
                <Border Grid.Row="3" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="12,10"
                        IsEnabled="{Binding IsAnnotationEntryEnabled}">
                    <StackPanel>
                        <TextBlock Text="Modelltest am Foto" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PreviewModelBox"
                                  ItemsSource="{Binding PreviewModelOptions}"
                                  SelectedItem="{Binding SelectedPreviewModel}"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="PreviewModelBox_SelectionChanged"
                                  Margin="0,0,0,6"/>
                        <Button Content="Modellliste aktualisieren"
                                Command="{Binding RefreshPreviewModelsCommand}"
                                Style="{StaticResource ToolbarButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,6"
                                ToolTip="Liest die verfügbaren BCC-Testmodelle erneut ein."/>
                        <Button Content="Foto mit gewähltem Modell prüfen"
                                Command="{Binding RunPreviewDetectionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding PreviewDetectionSummary}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding PreviewDetections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                   Foreground="DeepSkyBlue"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Confidence, StringFormat={}{0:P0}}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Blaue Boxen sind nur Vorschau. Als Gold wird nur die rote, von Hand gezogene Box gespeichert."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextXS}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Rechts: 1 · KI-Vorschlag / 2 · Fachliche Codierung / 3 · Freigabe ── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1 · KI-Vorschlag -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,8"
                            IsEnabled="{Binding IsAnnotationEntryEnabled}">
                        <StackPanel>
                            <TextBlock Text="1 · KI-Vorschlag" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Button Content="Foto allgemein mit KI prüfen"
                                    Command="{Binding FotoMitKiPruefenCommand}"
                                    ToolTip="Prüft das ganze Foto und zeigt allgemeine VSA-Vorschläge. Deine Handdaten werden nicht verändert oder gespeichert."
                                    HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource WarningBrush}" CornerRadius="{DynamicResource RadiusS}" Padding="8,4"
                                    Margin="0,0,0,6"
                                    Visibility="{Binding ShowQualityWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding QualityWarning}" Foreground="White" TextWrapping="Wrap"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding SuggestionCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,2" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectCodeCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding VsaCode}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding VsaCode}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Klartext}" FontSize="{DynamicResource TextXS}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Confidence, StringFormat={}{0:P0}}"
                                                           VerticalAlignment="Center" Margin="8,0"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <Border Grid.Column="2" Background="{DynamicResource AccentSubtleBrush}"
                                                        CornerRadius="{DynamicResource RadiusS}" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Quelle}" FontSize="{DynamicResource TextXS}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Vorschlag anklicken zum Übernehmen. Gespeichert wird erst mit deiner persönlichen Bestätigung."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextXS}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Bereits vom Operateur codierte PDF-Quelle; noch kein Gold. -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,8"
                            Visibility="{Binding HasSourceSuggestion, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="PDF-Operateurvorgabe — noch nicht bestätigt"
                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SourceReferenceDetails}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Erst deine Box, die sichtbare SAM-Maske und Akzeptieren machen daraus Gold."
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{DynamicResource TextXS}"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2 · Fachliche Codierung (Codierung + Akzeptieren/Korrektur/Verwerfen/Nächstes verschmolzen) -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2 · Fachliche Codierung" FontWeight="Bold" Margin="0,0,0,6"/>

                            <StackPanel IsEnabled="{Binding IsAnnotationEntryEnabled}">
                                <TextBlock Text="VSA-Code (Pflicht)" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SelectedCode, UpdateSourceTrigger=PropertyChanged}"
                                             CharacterCasing="Upper"
                                             FontWeight="Bold" VerticalContentAlignment="Center"
                                             ToolTip="Code direkt korrigieren oder über den VSA-Katalog wählen."/>
                                    <Button Grid.Column="1" Content="Codieren… (Katalog)" Style="{StaticResource PrimaryButton}"
                                            Click="OpenCodeExplorer_Click" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedCodeLabel}" FontSize="{DynamicResource TextXS}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,-5,0,8"/>

                                <TextBlock Text="Uhrlage (optional)" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}"/>
                                <TextBox Text="{Binding ClockPosition, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Margin="0,2,0,8"/>

                                <TextBlock Text="Schadensstufe (optional)" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                    <Button Content="1" Width="40" Margin="0,0,4,0" Background="{DynamicResource Severity1Brush}"
                                            Foreground="White" FontWeight="Bold"
                                            Command="{Binding SetSeverityCommand}" CommandParameter="1"/>
                                    <Button Content="2" Width="40" Margin="0,0,4,0" Background="{DynamicResource Severity2Brush}"
                                            Foreground="White" FontWeight="Bold"
                                            Command="{Binding SetSeverityCommand}" CommandParameter="2"/>
                                    <Button Content="3" Width="40" Margin="0,0,4,0" Background="{DynamicResource Severity3Brush}"
                                            Foreground="White" FontWeight="Bold"
                                            Command="{Binding SetSeverityCommand}" CommandParameter="3"/>
                                    <Button Content="4" Width="40" Margin="0,0,4,0" Background="{DynamicResource Severity4Brush}"
                                            Foreground="White" FontWeight="Bold"
                                            Command="{Binding SetSeverityCommand}" CommandParameter="4"/>
                                    <Button Content="5" Width="40" Background="{DynamicResource Severity5Brush}"
                                            Foreground="White" FontWeight="Bold"
                                            Command="{Binding SetSeverityCommand}" CommandParameter="5"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Severity, StringFormat='Gewählt: Stufe {0}', TargetNullValue='Keine Stufe gewählt'}"
                                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>

                                <TextBlock Text="Beschreibung (mind. 10 Zeichen)" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}"/>
                                <TextBox Text="{Binding Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" Margin="0,2,0,10"/>

                                <Button Content="Akzeptieren (A)" Style="{StaticResource SuccessButton}"
                                        Command="{Binding AcceptCommand}" Margin="0,0,0,6"/>
                                <Button Content="Korrektur speichern (K)" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CorrectCommand}" Margin="0,0,0,6"/>
                                <TextBlock Text="Ein geänderter Code wird als Lernkorrektur zurückgegeben."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextXS}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Verwerfen (V)" Style="{StaticResource ToolbarButtonDanger}"
                                            Command="{Binding DiscardCommand}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="Nächstes (→)" Style="{StaticResource ToolbarButton}"
                                            Command="{Binding NextItemCommand}" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <Border Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusM}" Padding="9"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsAwaitingImageCompletion, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Ereignis gespeichert — wie weiter?"
                                               FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ImageCompletionPrompt}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource TextXS}" Margin="0,0,0,8"/>
                                    <Button Content="Weiteres Ereignis auf diesem Bild"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding AddAnotherEventCommand}"
                                            Margin="0,0,0,6"/>
                                    <Button Content="Bild fertig"
                                            Style="{StaticResource SuccessButton}"
                                            Command="{Binding FinishImageCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3 · Freigabe für Training -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="3 · Freigabe für Training" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="Getrennter Schritt. Nur persönlich bestätigte Goldsamples mit Box und Maske gelangen in den Export. Die Freigabe läuft über das Export-Register im Training Center."
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="Training Center öffnen" Style="{StaticResource ToolbarButton}"
                                    Click="OpenTrainingCenter_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Persönlicher Goldstand -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusM}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="12,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Goldstandard je Hauptcode"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Aktualisieren"
                                        Command="{Binding RefreshGoldProgressCommand}"
                                        Style="{StaticResource ToolbarButton}"/>
                            </Grid>
                            <TextBlock Text="{Binding GoldProgressSummary}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="Nur persönlich bestätigte Handlabels mit Box und Segmentierung zählen."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextXS}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GoldProgressItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                           Text="{Binding MainCode, Converter={StaticResource PersonalGoldMainCodeToText}}"
                                                           FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="{Binding UniqueGoldFrames, StringFormat={}{0} / 30 vollständige Frames}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding NeededForMinimum, StringFormat={}{0} fehlen}"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Statuszeile ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" CornerRadius="{DynamicResource RadiusM}"
                Padding="12,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           ToolTip="{Binding StatusText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Arbeitet…" Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
