<Window x:Class="AuswertungPro.Next.UI.Views.Windows.DossierEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="Liegenschaft"
        Width="620" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <!-- Erbt den globalen Feldstil, damit der Dunkelmodus greift. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <TextBlock Text="Liegenschaft" Style="{StaticResource SectionStyle}" Margin="0,0,0,4"/>

                <TextBlock Text="Name (erscheint in der Liste und als Ordnername)"/>
                <TextBox x:Name="NameBox"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Parzellen-Nr."/>
                        <TextBox x:Name="ParcelBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Haus-Nr."/>
                        <TextBox x:Name="HouseBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Strasse"/>
                <TextBox x:Name="AddressBox"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PLZ"/>
                        <TextBox x:Name="ZipBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ort"/>
                        <TextBox x:Name="TownBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Eigentümer" Style="{StaticResource SectionStyle}"/>

                <TextBlock Text="Name / Firma"/>
                <TextBox x:Name="OwnerBox"/>

                <TextBlock Text="Adresse des Eigentümers"/>
                <TextBox x:Name="OwnerAddressBox" AcceptsReturn="True" MinHeight="46"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Zuständige Person"/>
                        <TextBox x:Name="ContactBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Telefon"/>
                        <TextBox x:Name="PhoneBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="E-Mail"/>
                <TextBox x:Name="MailBox"/>

                <TextBlock Text="Objektbewohner (z.B. Mehrfamilienhaus)"/>
                <TextBox x:Name="OccupancyBox"/>

                <TextBlock Text="Eigentumsverhältnisse (Tabelle im Dossier)"
                           Style="{StaticResource SectionStyle}"/>
                <TextBlock Text="Eine Zeile je Eigentümer bzw. Hausnummer. Diese Zeilen erscheinen in Kapitel 2."/>

                <DataGrid x:Name="OwnersGrid"
                          Height="150"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Haus Nr." Width="70"
                                            Binding="{Binding HouseNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Pz. Nr." Width="70"
                                            Binding="{Binding ParcelNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Name" Width="*"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Telefon" Width="110"
                                            Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Mail" Width="140"
                                            Binding="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Objektbewohner" Width="130"
                                            Binding="{Binding Occupancy, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ Zeile" Padding="10,4"
                            ToolTip="Fügt der Tabelle Eigentumsverhältnisse eine Zeile an — eine je Eigentümer bzw. Hausnummer. Bei Stockwerkeigentum steht jede Partei in einer eigenen Zeile."
                            Click="OnAddOwner"/>
                    <Button Content="Zeile entfernen" Padding="10,4" Margin="8,0,0,0"
                            ToolTip="Entfernt die gewählte Eigentümerzeile. Das Deckblatt zieht seine Angaben weiterhin aus den Einzelfeldern oben."
                            Click="OnRemoveOwner"/>
                </StackPanel>

                <TextBlock Text="Werkleitungsplan (JPG oder PNG für Kapitel 1)"
                           Style="{StaticResource SectionStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Bild wählen…" Padding="10,4"
                            ToolTip="Wählt ein JPG- oder PNG-Bild als Werkleitungsplan für Kapitel 1. Die Quelldatei bleibt unberührt."
                            Click="OnChoosePlan"/>
                    <Button Content="Entfernen" Padding="10,4" Margin="8,0,0,0"
                            ToolTip="Nimmt den Werkleitungsplan aus dem Dossier. Eine bereits erzeugte Bildkopie bleibt im Ordner liegen."
                            Click="OnClearPlan"/>
                </StackPanel>
                <TextBlock x:Name="PlanPathText" TextWrapping="Wrap"/>

                <TextBlock Text="Themen dieses Dossiers" Style="{StaticResource SectionStyle}"/>

                <TextBlock Text="Nur Abweichungen zum Gebiet: derselbe Titel ersetzt den Gebietstext, ein neuer Titel kommt hinten dran."
                           TextWrapping="Wrap"/>

                <DataGrid x:Name="TopicsGrid"
                          Height="170"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Thema" Width="230"
                                            Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTemplateColumn Header="Text" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <!-- Mehrzeilig bearbeitbar: Ausgangslage und
                                 Sanierungskonzept sind ganze Absaetze. -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="120" VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ Zeile" Padding="10,4"
                            ToolTip="Fügt diesem Dossier ein eigenes Thema an. Gleicher Titel wie ein Gebietsthema heisst: dessen Text wird hier ersetzt."
                            Click="OnAddTopic"/>
                    <Button Content="Zeile entfernen" Padding="10,4" Margin="8,0,0,0"
                            ToolTip="Entfernt das gewählte eigene Thema. Ein gleichnamiges Gebietsthema gilt danach wieder."
                            Click="OnRemoveTopic"/>
                </StackPanel>

                <TextBlock Text="Änderungswesen" Style="{StaticResource SectionStyle}"/>

                <DataGrid x:Name="ChangesGrid"
                          Height="110"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Version" Width="70"
                                            Binding="{Binding Version, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Datum" Width="100"
                                            Binding="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Visum" Width="70"
                                            Binding="{Binding Visum, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Art der Änderung" Width="*"
                                            Binding="{Binding Change, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ Zeile" Padding="10,4"
                            ToolTip="Fügt der Tabelle Änderungswesen eine Zeile an — Version, Datum, Visum und was geändert wurde."
                            Click="OnAddChange"/>
                    <Button Content="Zeile entfernen" Padding="10,4" Margin="8,0,0,0"
                            ToolTip="Entfernt die gewählte Zeile aus dem Änderungswesen."
                            Click="OnRemoveChange"/>
                </StackPanel>

                <TextBlock Text="Für die Aktennotiz (letzte Zeile der Informationstabelle)"/>
                <TextBox x:Name="FileNoteBox" AcceptsReturn="True" MinHeight="46"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Revision"/>
                <TextBox x:Name="RevisionBox" Width="80" HorizontalAlignment="Left"/>

                <Expander Header="Gebietsangaben für diese Liegenschaft abweichend"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,18,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Leer lassen heisst: es gilt die Angabe des Gebiets."
                                   FontStyle="Italic" Margin="0,0,0,6"/>

                        <TextBlock Text="Rückmeldefrist"/>
                        <TextBox x:Name="DeadlineOverrideBox"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock x:Name="HintText" Text="" Foreground="{DynamicResource DangerBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Abbrechen" Width="110" Height="32" Margin="0,0,8,0"
                    ToolTip="Schliesst das Fenster. Die Stammdaten bleiben so, wie sie beim Öffnen waren."
                    IsCancel="True" Click="OnCancel"/>
            <Button Content="Speichern" Width="110" Height="32"
                    ToolTip="Übernimmt die Stammdaten und schreibt sie auf die Platte."
                    IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
