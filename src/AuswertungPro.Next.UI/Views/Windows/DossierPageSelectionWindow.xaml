<Window x:Class="AuswertungPro.Next.UI.Views.Windows.DossierPageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Blätter für das Gesamt-PDF"
        Width="1080"
        Height="820"
        MinWidth="760" MinHeight="570"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Welche Blätter kommen ins Gesamt-PDF?"
                       FontSize="{DynamicResource TextL}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Alle Blätter sind gewählt. Ein abgewähltes Blatt fehlt nur in dieser PDF-Datei — die Word-Datei und die Original-Protokolle bleiben unverändert."/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10">
                <WrapPanel x:Name="Blaetter" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="BtnAlle"
                    Content="Alle wählen"
                    Padding="12,5"
                    Margin="0,0,8,0"
                    DockPanel.Dock="Left"
                    Click="OnAlle"/>
            <Button x:Name="BtnKeine"
                    Content="Keine"
                    Padding="12,5"
                    DockPanel.Dock="Left"
                    Click="OnKeine"/>

            <Button x:Name="BtnErzeugen"
                    Content="Gesamt-PDF erstellen"
                    Padding="16,5"
                    IsDefault="True"
                    DockPanel.Dock="Right"
                    Click="OnErzeugen"/>
            <Button Content="Abbrechen"
                    Padding="12,5"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    DockPanel.Dock="Right"/>
            <TextBlock x:Name="Zusammenfassung"
                       DockPanel.Dock="Right"
                       Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
        </DockPanel>
    </Grid>
</Window>
