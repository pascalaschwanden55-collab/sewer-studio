<Window x:Class="AuswertungPro.Next.UI.Views.Windows.DossierPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="Werkleitungsplan anpassen"
        Width="1100" Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Mit gedrückter Maustaste einen Rahmen aufziehen und „Zuschneiden“ drücken. Das Bild wird proportional in die originale Planfläche eingepasst. Das Original bleibt unverändert — bearbeitet wird eine temporäre Kopie."/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="LeftButton" Content="⟲" Width="40" Height="30" Margin="0,0,6,0"
                    ToolTip="90° nach links" Click="OnRotateLeft"/>
            <Button x:Name="RightButton" Content="⟳" Width="40" Height="30" Margin="0,0,6,0"
                    ToolTip="90° nach rechts" Click="OnRotateRight"/>
            <Button x:Name="HalfButton" Content="180°" Width="52" Height="30" Margin="0,0,14,0"
                    ToolTip="Auf den Kopf stellen" Click="OnRotateHalf"/>

            <Button x:Name="CropButton" Content="Zuschneiden" Height="30" Padding="12,0"
                    ToolTip="Schneidet die temporäre Kopie auf den gezogenen Rahmen zu. Die ursprüngliche Quelldatei bleibt unberührt."
                    Margin="0,0,14,0" IsEnabled="False" Click="OnCrop"/>

            <TextBlock Text="Zoom" Margin="0,0,6,0"/>
            <Slider x:Name="ZoomSlider" Width="150" Minimum="0.05" Maximum="2.0" Value="0.3"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" Margin="0,0,6,0"
                    ValueChanged="OnZoomChanged"/>
            <TextBlock x:Name="ZoomText" Margin="0,0,14,0"/>

            <TextBlock Text="Breite im Dossier" Margin="0,0,6,0"/>
            <TextBox x:Name="WidthBox" Width="60" Height="26" Padding="6,2"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="cm" Margin="6,0,0,0"/>
        </WrapPanel>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Padding="12">
                <Grid x:Name="Bühne" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="White"
                      MouseLeftButtonDown="OnStageDown"
                      MouseMove="OnStageMove"
                      MouseLeftButtonUp="OnStageUp">
                    <Image x:Name="PlanImage" Stretch="Fill"/>
                    <Canvas x:Name="Auswahl" IsHitTestVisible="False"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Margin="0,0,14,0"/>
            <Button Content="Abbrechen"
                    ToolTip="Schliesst das Fenster, ohne diese Anpassung in die Dossiervorschau zu übernehmen." Width="110" Height="32" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancel"/>
            <Button Content="Übernehmen"
                    ToolTip="Übernimmt die Anpassung in die Dossiervorschau. Im Dossierordner wird sie erst beim Übernehmen des Dossiers gespeichert." Width="130" Height="32"
                    IsDefault="True" Click="OnAccept"/>
        </StackPanel>
    </Grid>
</Window>
