<Window x:Class="AuswertungPro.Next.UI.Views.Windows.SchachtMassnahmenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ui:WindowFx.Entrance="True"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:domain="clr-namespace:AuswertungPro.Next.Domain.Models;assembly=AuswertungPro.Next.Domain"
        Title="{Binding Titel}"
        Width="920" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding Titel}" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource HeaderTextBrush}"/>
                <TextBlock Text="{Binding Kontext}" FontSize="12" Margin="0,3,0,0"
                           Foreground="{StaticResource HeaderTextBrush}" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- Inhalt: links Liste, rechts Auswahl -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.3*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Deine Liste (klickbar) -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="DEINE LISTE"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="2,0,0,8"/>
                    <ListBox x:Name="KatalogList" ItemsSource="{Binding Katalog}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="KatalogList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:SchachtMassnahmeKatalogEintrag}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0"
                                               Text="{Binding Preis, StringFormat={}{0:N2}}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button Grid.Column="2" Width="26" Height="24" Padding="0"
                                            ToolTip="In Auswahl übernehmen"
                                            Command="{Binding DataContext.HinzufuegenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <ui:FluentIcon Glyph="&#xE710;" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Gewaehlte Positionen -->
            <Border Grid.Column="2" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="GEWÄHLT FÜR DIESEN SCHACHT"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="2,0,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0" FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Menge und Preis kannst du pro Schacht anpassen — die Liste bleibt unverändert."
                               TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding Positionen}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Massnahme" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Menge" Binding="{Binding Menge, UpdateSourceTrigger=LostFocus}" Width="64"/>
                            <DataGridTextColumn Header="Preis" Binding="{Binding Preis, UpdateSourceTrigger=LostFocus}" Width="82"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding ZeilenTotal, StringFormat={}{0:N2}}" IsReadOnly="True" Width="92"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="24" Height="24" Padding="0" Margin="2,0"
                                                ToolTip="Entfernen" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.EntfernenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <ui:FluentIcon Glyph="&#xE74D;" FontSize="12" Foreground="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Liste bearbeiten…" Padding="12,6"
                        Command="{Binding ListeBearbeitenCommand}"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalText}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,16,0"
                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Übernehmen" Padding="16,6" FontWeight="SemiBold"
                            Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                            Command="{Binding UebernehmenCommand}" IsDefault="True"/>
                    <Button Content="Abbrechen" Padding="12,6" Margin="8,0,0,0"
                            Command="{Binding AbbrechenCommand}" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
