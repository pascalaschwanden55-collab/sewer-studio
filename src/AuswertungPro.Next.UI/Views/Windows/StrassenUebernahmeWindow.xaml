<Window x:Class="AuswertungPro.Next.UI.Views.Windows.StrassenUebernahmeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="Strasse übernehmen"
        Width="620"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgLightBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="KopfText"
                   Grid.Row="0"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                CornerRadius="4"
                Padding="8">
            <ListView x:Name="Liste"
                      BorderThickness="0"
                      Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Uebernehmen, Mode=TwoWay}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="NummerSpalte" Width="150"
                                        DisplayMemberBinding="{Binding Nummer}"/>
                        <GridViewColumn Header="Strasse" Width="180"
                                        DisplayMemberBinding="{Binding Wert}"/>
                        <GridViewColumn Header="Herkunft" Width="200"
                                        DisplayMemberBinding="{Binding Herkunft}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Widerspruechliche Nachbarn: sichtbar lassen, aber nicht entscheiden -->
        <TextBlock x:Name="OffeneText"
                   Grid.Row="2"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="AlleKnopf"
                    Content="Alle"
                    MinWidth="80"
                    Margin="0,0,10,0"
                    Click="Alle_Click"/>
            <Button x:Name="KeineKnopf"
                    Content="Keine"
                    MinWidth="80"
                    Margin="0,0,20,0"
                    Click="Keine_Click"/>
            <Button x:Name="UebernehmenKnopf"
                    Content="Übernehmen"
                    MinWidth="120"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Uebernehmen_Click"/>
            <Button Content="Abbrechen"
                    MinWidth="100"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
