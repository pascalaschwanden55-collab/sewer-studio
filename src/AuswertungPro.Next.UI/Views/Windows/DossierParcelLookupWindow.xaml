<Window x:Class="AuswertungPro.Next.UI.Views.Windows.DossierParcelLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Neue Liegenschaft"
        Width="820" Height="700"
        MinWidth="570" MinHeight="490"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Gemeinde und Parzelle eingeben — das Programm holt Eigentümer, Adresse und die Leitungen auf der Parzelle beim Kanton. Alles bleibt danach von Hand änderbar."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Gemeinde"/>
                <ComboBox x:Name="MunicipalityBox" DisplayMemberPath="Name"
                          Padding="6,4" FontSize="{DynamicResource TextM}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Parzelle"/>
                <TextBox x:Name="ParcelBox"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button x:Name="LookupButton" Content="Daten holen" Width="130" Height="32"
                        ToolTip="Fragt Grundbuch und Abwassernetz zur gewählten Gemeinde und Parzelle ab und füllt daraus vor: Eigentümer, Adresse und die Leitungen auf der Parzelle."
                        IsDefault="True" Click="OnLookup"/>
                <CheckBox x:Name="DirectoryBox" Content="Telefon und Mail suchen"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusS}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultPanel">
                    <TextBlock Text="Noch nichts abgefragt." FontStyle="Italic"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Ohne Abfrage anlegen" Width="170" Height="32" Margin="0,0,8,0"
                    ToolTip="Legt eine leere Liegenschaft an, ohne den Kanton zu fragen. Alle Angaben tragen Sie danach von Hand ein."
                    Click="OnSkip"/>
            <Button Content="Abbrechen" Width="110" Height="32" Margin="0,0,8,0"
                    ToolTip="Schliesst das Fenster. Es wird keine Liegenschaft angelegt."
                    IsCancel="True" Click="OnCancel"/>
            <Button x:Name="AcceptButton" Content="Übernehmen" Width="130" Height="32"
                    ToolTip="Legt die Liegenschaft mit den abgefragten Angaben und den angehakten Leitungen an. Danach öffnen sich die Stammdaten zum Prüfen."
                    IsEnabled="False" Click="OnAccept"/>
        </StackPanel>
    </Grid>
</Window>
