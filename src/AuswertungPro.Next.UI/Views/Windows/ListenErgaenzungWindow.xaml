<Window x:Class="AuswertungPro.Next.UI.Views.Windows.ListenErgaenzungWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:vm="clr-namespace:AuswertungPro.Next.UI.ViewModels"
        Title="SewerStudio — Liste bearbeiten"
        Width="680" Height="560" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ui:WindowFx.Entrance="True"
        d:DataContext="{d:DesignInstance Type=vm:ListenErgaenzungViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="NurMitText" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel Margin="16" Background="{DynamicResource CardBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Titel}" FontSize="{DynamicResource TextXL}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Untertitel}" FontSize="{DynamicResource TextS}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Fusszeile: eigener Eintrag anlegen, Meldung, Speichern/Abbrechen -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusM}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NeuText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Text des eigenen Eintrags" AutomationProperties.Name="Text des eigenen Eintrags"/>
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding NeuCode, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Code (optional). Ohne Code geht der Eintrag nie in eine XTF."
                             AutomationProperties.Name="Code des eigenen Eintrags"/>
                    <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding HinzufuegenCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Eigenen Eintrag in diese Liste aufnehmen" AutomationProperties.Name="Eigenen Eintrag aufnehmen">
                        <StackPanel Orientation="Horizontal">
                            <ui:FluentIcon Glyph="&#xE710;" Margin="0,0,6,0"/>
                            <TextBlock Text="Hinzufügen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Fehler}" Style="{StaticResource NurMitText}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="{DynamicResource TextS}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Command="{Binding AbbrechenCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0"
                        ToolTip="Fenster schliessen, nichts speichern" AutomationProperties.Name="Abbrechen">
                    <TextBlock Text="Abbrechen"/>
                </Button>
                <Button Command="{Binding SpeichernCommand}" Style="{StaticResource ToolbarButtonAccent}"
                        ToolTip="Ergänzungen dieser Liste programmweit speichern" AutomationProperties.Name="Speichern">
                    <StackPanel Orientation="Horizontal">
                        <ui:FluentIcon Glyph="&#xE74E;" Margin="0,0,6,0"/>
                        <TextBlock Text="Speichern" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Die Einträge der Liste -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusM}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Zeilen}" Margin="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                             IsReadOnly="{Binding Eigen}"
                                             ToolTip="Anzeigetext. Bei WebGIS-Einträgen bleibt der Code erhalten; der Originaltext stellt zurück."
                                             AutomationProperties.Name="{Binding Originaltext}"/>
                                    <TextBlock Text="{Binding Herkunft}" FontSize="{DynamicResource TextXS}"
                                               Foreground="{DynamicResource MutedBrush}" Margin="2,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                          Content="Ausblenden" IsChecked="{Binding Ausgeblendet}"
                                          Visibility="{Binding IstWebGis, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Aus der Liste nehmen. Bereits gespeicherte Werte bleiben lesbar."/>
                                <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding EntfernenCommand}" Style="{StaticResource ToolbarButton}"
                                        Visibility="{Binding Eigen, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Eigenen Eintrag entfernen" AutomationProperties.Name="Eigenen Eintrag entfernen">
                                    <ui:FluentIcon Glyph="&#xE74D;"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
