<Window x:Class="AuswertungPro.Next.UI.Views.Windows.FloatingGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        Title="SewerStudio — Haltungen"
        Height="700" Width="1200"
        MinWidth="600" MinHeight="350"
        Background="{DynamicResource CardBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <controls:NovaDialogHeader x:Name="TitleText" Grid.Row="0" Title="Haltungen (abgedockt)"
                                    Margin="12,10,12,10">
            <Button x:Name="DockBackButton" Click="DockBack_Click"
                    Style="{DynamicResource ToolbarButton}"
                    ToolTip="Zurück ins Hauptfenster andocken"
                    AutomationProperties.Name="Andocken">
                <StackPanel Orientation="Horizontal">
                    <ui:FluentIcon Glyph="&#xE89F;" FontSize="{DynamicResource TextM}"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Andocken" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </controls:NovaDialogHeader>

        <!-- Grid-Host: hier wird das DataGrid zur Laufzeit eingesetzt -->
        <Border x:Name="GridHost" Grid.Row="1" Margin="0"/>

        <!-- Statusleiste -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" Padding="8,4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="RecordCountText"
                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" x:Name="SelectedInfoText"
                           FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
