<Window x:Class="AuswertungPro.Next.UI.Views.Windows.AufklappLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Views.Controls"
        Title="SewerStudio — Ansicht anpassen" Width="1440" Height="850" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CardBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Deine Eingabefelder" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Felder an der Beschriftung ziehen, auch in eine andere Spalte. Spalten an der Überschrift ziehen. Mit × ausblenden; unten wieder einblenden."/>
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="Die Anordnung gilt für alle Einträge dieser Liste. Feldwerte und Exporte bleiben erhalten. Erst Speichern übernimmt die Anpassung."/>
        </StackPanel>
        <AdornerDecorator Grid.Row="1">
            <controls:RecordDetailsView x:Name="Details" IsCompactLayout="True"
                IsHeaderVisible="False" CanCustomize="True" IsCustomizing="True"/>
        </AdornerDecorator>
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Standard wiederherstellen" Click="Standard_Click"/>
            <Button DockPanel.Dock="Right" Content="Speichern" Click="Speichern_Click"
                    Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Abbrechen" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
