<Window x:Class="AuswertungPro.Next.UI.Views.Windows.AufklappLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Views.Controls"
        xmlns:nova="clr-namespace:AuswertungPro.Next.UI.Controls"
        Title="SewerStudio — Ansicht anpassen" Width="1440" Height="850" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CardBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <nova:NovaDialogHeader Grid.Row="0"
                   Title="Deine Eingabefelder"
                   Subtitle="Felder an der Beschriftung ziehen, auch in eine andere Spalte. Spalten an der Überschrift ziehen. Mit × ausblenden; unten wieder einblenden. Die Anordnung gilt für alle Einträge dieser Liste. Feldwerte und Exporte bleiben erhalten. Erst Speichern übernimmt die Anpassung."/>
        <AdornerDecorator Grid.Row="1">
            <controls:RecordDetailsView x:Name="Details" IsCompactLayout="True"
                IsHeaderVisible="False" CanCustomize="True" IsCustomizing="True"/>
        </AdornerDecorator>
        <Border Grid.Row="2" Style="{StaticResource DialogButtonBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Standard wiederherstellen" Click="Standard_Click"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Abbrechen" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Speichern" Click="Speichern_Click"
                        Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
