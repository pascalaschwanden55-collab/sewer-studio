<Window x:Class="AuswertungPro.Next.UI.Views.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Über das Programm"
        Width="560" Height="600"
        MinWidth="480" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:NovaDialogHeader x:Name="Kopf" Grid.Row="0" Title="Über SewerStudio"/>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Programmsymbol, Name, Version, Build-Datum -->
                <Border Padding="16" CornerRadius="{DynamicResource RadiusM}"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="ProgrammIcon" Width="56" Height="56" Stretch="Uniform"
                               VerticalAlignment="Top" Margin="0,0,14,0"
                               AutomationProperties.Name="Programmsymbol SewerStudio"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" FontSize="{DynamicResource TextXL}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="VersionText" FontSize="{DynamicResource TextM}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="BuildText" FontSize="{DynamicResource TextS}"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Systeminfo (Windows, .NET, optional GPU) -->
                <Border Padding="16" CornerRadius="{DynamicResource RadiusM}"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="System" FontSize="{DynamicResource TextS}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="OsText" FontSize="{DynamicResource TextS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DotNetText" FontSize="{DynamicResource TextS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="GpuText" FontSize="{DynamicResource TextS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Ordner: Daten, Protokolle, Einstellungen -->
                <Border Padding="16" CornerRadius="{DynamicResource RadiusM}"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ordner" FontSize="{DynamicResource TextS}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DataFolderBox" Grid.Column="0" IsReadOnly="True"
                                     FontSize="{DynamicResource TextXS}" VerticalAlignment="Center"
                                     Background="{DynamicResource CardBrush}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                     Padding="6,4" Margin="0,0,8,0"
                                     AutomationProperties.Name="Datenordner"
                                     ToolTip="Lokaler SewerStudio-Datenordner"/>
                            <Button x:Name="OpenDataFolderButton" Grid.Column="1" Content="Öffnen"
                                    Style="{StaticResource SecondaryButton}" Click="OnOpenDataFolder"
                                    AutomationProperties.Name="Datenordner öffnen"
                                    ToolTip="Datenordner im Explorer öffnen"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LogsFolderBox" Grid.Column="0" IsReadOnly="True"
                                     FontSize="{DynamicResource TextXS}" VerticalAlignment="Center"
                                     Background="{DynamicResource CardBrush}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                     Padding="6,4" Margin="0,0,8,0"
                                     AutomationProperties.Name="Protokollordner"
                                     ToolTip="Ordner mit den Programmprotokollen (Logs)"/>
                            <Button x:Name="OpenLogsFolderButton" Grid.Column="1" Content="Öffnen"
                                    Style="{StaticResource SecondaryButton}" Click="OnOpenLogsFolder"
                                    AutomationProperties.Name="Protokollordner öffnen"
                                    ToolTip="Protokollordner im Explorer öffnen"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SettingsFolderBox" Grid.Column="0" IsReadOnly="True"
                                     FontSize="{DynamicResource TextXS}" VerticalAlignment="Center"
                                     Background="{DynamicResource CardBrush}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                     Padding="6,4" Margin="0,0,8,0"
                                     AutomationProperties.Name="Ordner der Einstellungen"
                                     ToolTip="Ordner mit settings.json"/>
                            <Button x:Name="OpenSettingsFolderButton" Grid.Column="1" Content="Öffnen"
                                    Style="{StaticResource SecondaryButton}" Click="OnOpenSettingsFolder"
                                    AutomationProperties.Name="Einstellungsordner öffnen"
                                    ToolTip="Einstellungsordner im Explorer öffnen"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogButtonBar}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopySystemInfoButton" Content="Systeminfo kopieren"
                        Style="{StaticResource SecondaryButton}" Click="OnCopySystemInfo"
                        Margin="0,0,8,0"
                        ToolTip="Programmversion, Windows-, .NET- und Grafikkarteninfo in die Zwischenablage kopieren"/>
                <Button x:Name="CloseButton" Content="Schliessen"
                        Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
