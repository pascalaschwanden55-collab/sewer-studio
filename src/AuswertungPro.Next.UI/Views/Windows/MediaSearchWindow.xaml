<Window x:Class="AuswertungPro.Next.UI.Views.Windows.MediaSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        xmlns:behaviors="clr-namespace:AuswertungPro.Next.UI.Behaviors"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        Title="SewerStudio — Medien suchen und verlinken" Height="760" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="800" MinHeight="540">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource TextM}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="Gefunden">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                </Trigger>
                <Trigger Property="Text" Value="Mehrdeutig">
                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                </Trigger>
                <Trigger Property="Text" Value="Nicht gefunden">
                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                </Trigger>
                <Trigger Property="Text" Value="Verlinkt">
                    <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:NovaDialogHeader Grid.Row="0" Title="Medien suchen und verlinken"/>

        <!-- Row 1: Options -->
        <Border Style="{DynamicResource Card}" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Suchordner:" Style="{StaticResource LabelText}" Width="90"/>
                    <TextBox x:Name="FolderBox" Width="600" Margin="0,0,8,0"
                             Padding="6,4" FontSize="{DynamicResource TextM}" VerticalContentAlignment="Center"/>
                    <Button x:Name="BrowseButton" Content="Durchsuchen..." Click="Browse_Click"
                            Style="{DynamicResource SecondaryButton}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="OverwriteCheck" Margin="90,0,20,0"
                              Content="Bereits verlinkte überschreiben" FontSize="{DynamicResource TextS}"/>
                    <CheckBox x:Name="PdfCheck" Margin="0,0,20,0"
                              Content="PDFs suchen" IsChecked="True" FontSize="{DynamicResource TextS}"/>
                    <CheckBox x:Name="FotoCheck" Margin="0,0,20,0"
                              Content="Fotos suchen" IsChecked="True" FontSize="{DynamicResource TextS}"/>
                    <CheckBox x:Name="RecursiveCheck" Margin="0,0,20,0"
                              Content="Rekursiv (Unterordner)" IsChecked="True" FontSize="{DynamicResource TextS}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="StartButton" Content="Suche starten" Click="Start_Click"
                            Style="{DynamicResource SecondaryButton}" Margin="90,0,10,0"/>
                    <Button x:Name="CancelSearchButton" Content="Abbrechen" Click="CancelSearch_Click"
                            Style="{DynamicResource SecondaryButton}" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Row 2: Progress -->
        <Border Style="{DynamicResource Card}" Grid.Row="2" Margin="0,0,0,10"
                x:Name="ProgressPanel" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProgressText" Grid.Row="0" Text="Suche läuft..."
                           Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ProgressBar x:Name="ProgressBar" Grid.Row="1" Style="{StaticResource ProgressBarStandard}" Minimum="0" Maximum="100"
                             HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- Row 3: Results DataGrid -->
        <Border Style="{DynamicResource Card}" Grid.Row="3" Margin="0,0,0,10" Padding="0">
            <Grid>
            <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserSortColumns="True" CanUserResizeColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" FontSize="{DynamicResource TextM}"
                      EnableRowVirtualization="True"
                      SelectionMode="Single"
                      behaviors:PhotoHoverPreviewBehavior.IsEnabled="True">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                    <DataGridTextColumn Header="Haltungsname" Binding="{Binding Haltungsname}" Width="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Video" Binding="{Binding VideoStatusText}" Width="90" IsReadOnly="True"
                                        ElementStyle="{StaticResource StatusTextStyle}"/>
                    <DataGridTextColumn Header="Video-Pfad" Binding="{Binding VideoPath}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="PDF" Binding="{Binding PdfStatusText}" Width="90" IsReadOnly="True"
                                        ElementStyle="{StaticResource StatusTextStyle}"/>
                    <DataGridTextColumn Header="PDF-Pfad" Binding="{Binding PdfPath}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Fotos" Binding="{Binding FotoStatusText}" Width="90" IsReadOnly="True"
                                        ElementStyle="{StaticResource StatusTextStyle}"/>
                    <DataGridTextColumn Header="Foto-Anzahl" Binding="{Binding FotoCount}" Width="80" IsReadOnly="True"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VideoStatusText}" Value="Gefunden">
                                <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VideoStatusText}" Value="Mehrdeutig">
                                <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VideoStatusText}" Value="Nicht gefunden">
                                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            <controls:EmptyStateControl IsHitTestVisible="False"
                                        Icon="&#xE721;"
                                        Title="Noch keine Treffer"
                                        Message="Starte die Mediensuche, um Videos, PDFs und Fotos den Haltungen zuzuordnen.">
                <controls:EmptyStateControl.Style>
                    <Style TargetType="controls:EmptyStateControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=ResultGrid}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyStateControl.Style>
            </controls:EmptyStateControl>
            </Grid>
        </Border>

        <!-- Row 4: Footer -->
        <Border Grid.Row="4" Style="{StaticResource DialogButtonBar}">
            <Grid>
                <TextBlock x:Name="SummaryText" Style="{StaticResource LabelText}"
                           Text="Starten Sie die Suche, um Ergebnisse anzuzeigen."
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton" Content="Schliessen" Click="Close_Click"
                            Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Content="Anwenden" Click="Apply_Click"
                            Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
