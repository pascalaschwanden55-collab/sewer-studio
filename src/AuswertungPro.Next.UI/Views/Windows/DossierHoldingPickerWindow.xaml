<Window x:Class="AuswertungPro.Next.UI.Views.Windows.DossierHoldingPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Leitungen der Liegenschaft wählen"
        Width="760" Height="640"
        MinWidth="530" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:NovaDialogHeader Grid.Row="0"
                   Title="Leitungen der Liegenschaft wählen"
                   Subtitle="Alle Haltungen des Projekts. Ankreuzen, was zu dieser Liegenschaft gehört — eine Haltung darf auch in mehreren Dossiers stehen."/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Background="{DynamicResource HeaderBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="{DynamicResource TextM}"
                     TextChanged="OnSearchChanged"/>

            <ComboBox x:Name="GroupBox"
                      Grid.Column="1"
                      Width="180" Margin="8,0,0,0"
                      SelectionChanged="OnGroupChanged">
                <ComboBoxItem Content="Gruppieren: keine" IsSelected="True"/>
                <ComboBoxItem Content="Gruppieren: Strasse"/>
                <ComboBoxItem Content="Gruppieren: Eigentümer"/>
            </ComboBox>

            <Button Grid.Column="2" Content="Sichtbare wählen" Margin="8,0,0,0"
                    ToolTip="Hakt alle Leitungen an, die gerade in der Liste zu sehen sind. Bei gesetztem Suchbegriff also nur die Treffer."
                    Padding="10,6" Click="OnSelectVisible"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource CardGlassBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusXL}">
            <Grid>
            <ListBox x:Name="HoldingList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsChosen, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="4,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoldingName}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding Length}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding Condition}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <controls:EmptyStateControl IsHitTestVisible="False"
                                        Icon="&#xE721;"
                                        Title="Keine Haltungen gefunden"
                                        Message="Suchbegriff prüfen oder leeren — oder das Projekt enthält noch keine Haltungen.">
                <controls:EmptyStateControl.Style>
                    <Style TargetType="controls:EmptyStateControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=HoldingList}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyStateControl.Style>
            </controls:EmptyStateControl>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DialogButtonBar}">
            <Grid>
                <TextBlock x:Name="CountText"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Auswahl leeren" Style="{StaticResource SecondaryButton}" Width="130" Height="32" Margin="0,0,8,0"
                            ToolTip="Entfernt alle Haken. Das Dossier ändert sich erst mit Übernehmen."
                            Click="OnClear"/>
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Width="110" Height="32" Margin="0,0,8,0"
                            ToolTip="Schliesst das Fenster. Die Zuordnung des Dossiers bleibt unverändert."
                            IsCancel="True" Click="OnCancel"/>
                    <Button Content="Übernehmen" Style="{StaticResource PrimaryButton}" Width="120" Height="32"
                            ToolTip="Speichert die angehakten Leitungen als Zuordnung dieser Liegenschaft."
                            IsDefault="True" Click="OnApply"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
