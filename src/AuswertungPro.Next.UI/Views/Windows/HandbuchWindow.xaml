<Window x:Class="AuswertungPro.Next.UI.Views.Windows.HandbuchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Handbuch"
        Width="900" Height="640"
        MinWidth="640" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:NovaDialogHeader x:Name="Kopf" Grid.Row="0" Title="Handbuch"
                                    Subtitle="Kurze Anleitung zu jeder Seite von SewerStudio.">
            <controls:NovaDialogHeader.Aktionen>
                <TextBox x:Name="SucheBox" Width="240" VerticalAlignment="Center"
                         TextChanged="SucheBox_TextChanged"
                         AutomationProperties.Name="Handbuch durchsuchen"
                         ToolTip="Abschnitte nach Stichwort durchsuchen"/>
            </controls:NovaDialogHeader.Aktionen>
        </controls:NovaDialogHeader>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="InhaltsverzeichnisListe" Grid.Column="0"
                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                     Background="{DynamicResource CardBrush}"
                     SelectionChanged="InhaltsverzeichnisListe_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Inhaltsverzeichnis">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="10,12,10,4"
                                           FontSize="{DynamicResource TextXS}" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Typography.Capitals="AllSmallCaps"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Titel}" Margin="8,6" TextWrapping="Wrap"
                                   FontSize="{DynamicResource TextS}"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="AbschnittTitelText"
                               FontSize="{DynamicResource TextXL}" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                    <ContentControl x:Name="AbschnittInhaltHost" Focusable="False"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource DialogButtonBar}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Schliessen"
                        Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
