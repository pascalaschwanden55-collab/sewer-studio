<UserControl x:Class="AuswertungPro.Next.UI.Views.Windows.PlayerCodingSidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls"
             xmlns:behaviors="clr-namespace:AuswertungPro.Next.UI.Behaviors"
             xmlns:conv="clr-namespace:AuswertungPro.Next.UI.Views.Windows">
    <UserControl.Resources>
        <ctrl:IntToVisibilityConverter x:Key="PositiveIntToVisibility"/>
        <!-- Streckenschaden schliessen nur bei einem wirklich offenen Anfang. -->
        <conv:CodingStretchDamageCanCloseConverter x:Key="StretchDamageCanClose"/>
    </UserControl.Resources>
            <Border x:Name="CodingSidePanel"
                    Visibility="Collapsed"
                    Margin="8,0,0,0"
                    Background="{DynamicResource CardGlassBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="10" Padding="6,4,6,4"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- == 1. Legende: Punkt = Pruef-Status, % = Konfidenz == -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Punkt:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MutedBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="offen" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="akzeptiert" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="bearbeitet" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource DangerBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="abgelehnt" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="%=Konfidenz:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#x2265;85" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="60-85" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&lt;60" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtQualityGateStatus" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </WrapPanel>

                        <Border Margin="0,0,0,6"
                                Padding="6,5"
                                Background="#16202D"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnRunCodingProtocolMatch"
                                        Grid.Column="0"
                                        Style="{DynamicResource PlayerButton}"
                                        Content="Abgleich"
                                        Padding="8,4"
                                        FontSize="11"
                                        Click="RunCodingProtocolMatch_Click"
                                        ToolTip="KI-Befunde mit Import-Protokoll vergleichen"/>
                                <Button x:Name="BtnAcceptGreenCodingMatches"
                                        Grid.Column="1"
                                        Style="{DynamicResource PlayerButton}"
                                        Content="Grüne als Training"
                                        Padding="8,4"
                                        FontSize="11"
                                        Margin="6,0,8,0"
                                        IsEnabled="False"
                                        Click="CodingAcceptGreenMatches_Click"
                                        ToolTip="Nur sichere grüne Abgleich-Treffer als Training übernehmen"/>
                                <TextBlock x:Name="TxtCodingProtocolMatchSummary"
                                           Grid.Column="2"
                                           Text="Abgleich: noch nicht ausgeführt"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- == 2. Drei-Spalten-Ansicht: KI-Befunde | Details | Import == -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="250"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition x:Name="ColDefectDetail" Width="0"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*" MinWidth="230"/>
                            </Grid.ColumnDefinitions>

                            <!-- Linke Spalte: KI-erkannte Befunde -->
                            <Border Grid.Column="0" Style="{DynamicResource PlayerCard}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <TextBlock Style="{DynamicResource SectionLabel}" Margin="0" FontSize="10">
                                            <Run Text="KI-BEFUNDE ("/>
                                            <Run x:Name="RunCodingDefectCount" Text="0"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run x:Name="RunCodingOpenCount" Text="0"/>
                                            <Run Text=" offen"/>
                                        </TextBlock>
                                    </DockPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Style="{DynamicResource PlayerButton}" Padding="4,2"
                                                FontSize="10"
                                                Click="CodingTakePhoto_Click"
                                                ToolTip="Foto vom aktuellen Frame für ausgewähltes Ereignis aufnehmen">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FluentIcon Glyph="&#xE722;" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0"/>
                                                <TextBlock Text="Foto"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <ListBox x:Name="LstCodingEvents"
                                             behaviors:PhotoHoverPreviewBehavior.IsEnabled="True"
                                             behaviors:CodingEventDragDropBehavior.Enabled="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="11"
                                             Foreground="{DynamicResource TextBrush}"
                                             MaxHeight="400"
                                             VirtualizingPanel.IsVirtualizing="False"
                                             ScrollViewer.CanContentScroll="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseRightButtonDown="CodingEvents_PreviewMouseRightButtonDown"
                                             MouseDoubleClick="CodingEvents_DoubleClick"
                                             SelectionChanged="CodingEvents_SelectionChanged">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Bearbeiten (Doppelklick)" Click="CodingEventEdit_Click">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE70F;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Fotos anzeigen" Click="CodingEventShowPhotos_Click">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8B9;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Streckenschaden schließen (Ende hier)"
                                                          Click="CodingEventCloseStretch_Click"
                                                          FontWeight="SemiBold"
                                                          ToolTip="Nur für eine Zeile mit der Marke OFFEN">
                                                    <MenuItem.IsEnabled>
                                                        <MultiBinding Converter="{StaticResource StretchDamageCanClose}">
                                                            <Binding Path="PlacementTarget.SelectedItem"
                                                                     RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                                            <Binding Path="PlacementTarget"
                                                                     RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                                        </MultiBinding>
                                                    </MenuItem.IsEnabled>
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE930;" Foreground="{DynamicResource SuccessBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Zum Zeitpunkt springen" Click="CodingEventSeek_Click">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE823;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Löschen" Click="CodingEventDelete_Click" Foreground="{DynamicResource DangerBrush}">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE74D;" Foreground="{DynamicResource DangerBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="Padding" Value="4,3"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Cursor="Hand">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="ZoneDot" Grid.Column="0"
                                                                 Width="7" Height="7"
                                                                 Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Entry.Code}"
                                                                   FontFamily="Consolas"
                                                                   FontWeight="Bold" FontSize="11"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Entry.Beschreibung}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   ToolTip="{Binding Entry.Beschreibung}"
                                                                   VerticalAlignment="Top"/>
                                                        <Border x:Name="CodingMatchBadge"
                                                                Grid.Column="3"
                                                                Visibility="Collapsed"
                                                                Background="#334155"
                                                                CornerRadius="4"
                                                                Padding="4,1"
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock x:Name="TxtCodingMatchBadge"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#F8FAFC"/>
                                                        </Border>
                                                        <!-- Offener Streckenschaden: der Anfang ist gesetzt, das Ende fehlt noch. -->
                                                        <Border x:Name="StretchOpenBadge"
                                                                Grid.Column="4"
                                                                Visibility="Collapsed"
                                                                Background="{DynamicResource WarningBrush}"
                                                                CornerRadius="4"
                                                                Padding="4,1"
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Streckenschaden ohne Ende - Rechtsklick: Streckenschaden schliessen">
                                                            <TextBlock FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0B1220"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="5" x:Name="TxtStatusIcon"
                                                                   FontFamily="{DynamicResource FontIcon}"
                                                                   FontSize="11" Margin="2,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Grid Margin="11,1,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                                            <ui:FluentIcon Glyph="&#xE707;" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                                            <TextBlock x:Name="TxtEventMeter"
                                                                       Text="{Binding MeterAtCapture, StringFormat='{}{0:F2}m', Mode=OneWay}"
                                                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0"
                                                                    Visibility="{Binding PhotoCount, Converter={StaticResource PositiveIntToVisibility}}">
                                                            <ui:FluentIcon Glyph="&#xE722;" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,3,0"/>
                                                            <TextBlock Text="{Binding PhotoCount}" FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" x:Name="TxtConfidence"
                                                                 FontSize="10" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Mittlere Spalte: Defekt-Details (bei Auswahl sichtbar) -->
                            <Border x:Name="CodingDefectDetailInline" Grid.Column="2"
                                    Style="{DynamicResource PlayerCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Kompakte Details: Code + Konfidenz -->
                                    <TextBlock x:Name="TxtInlineDetailCode"
                                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtInlineDetailDesc"
                                               FontSize="10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                                    <!-- Distanz + Position + Konfidenz -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Distanz" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtInlineDetailDistance"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Konfidenz" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtInlineDetailConfidence"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Status -->
                                    <TextBlock x:Name="TxtInlineDetailStatus" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                                    <!-- Markierte Vorschau des ausgewaehlten KI-Befunds -->
                                    <Border Height="172"
                                            Margin="0,0,0,8"
                                            Background="#05070A"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image x:Name="ImgInlineEvidencePreview"
                                                   Stretch="Uniform"
                                                   SnapsToDevicePixels="True"
                                                   Visibility="Collapsed"/>
                                            <TextBlock x:Name="TxtInlineEvidencePreviewStatus"
                                                       Text="Kein Bild"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Aktionsbuttons vertikal -->
                                    <StackPanel Margin="0,2,0,0">
                                        <Button x:Name="BtnInlineAccept"
                                                Style="{DynamicResource DefectActionBtn}"
                                                Background="#16A34A" Margin="0,0,0,4"
                                                Click="CodingAcceptDefect_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FluentIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" Margin="0,0,5,0"/>
                                                <TextBlock Text="Akzeptieren" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnInlineEdit"
                                                Style="{DynamicResource DefectActionBtn}"
                                                Background="#D97706" Margin="0,0,0,4"
                                                Click="CodingEditDefect_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FluentIcon Glyph="&#xE70F;" FontSize="11" Foreground="White" Margin="0,0,5,0"/>
                                                <TextBlock Text="Bearbeiten" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnInlineReject"
                                                Style="{DynamicResource DefectActionBtn}"
                                                Background="#DC2626"
                                                Click="CodingRejectDefect_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FluentIcon Glyph="&#xE711;" FontSize="11" Foreground="White" Margin="0,0,5,0"/>
                                                <TextBlock Text="Ablehnen" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Rechte Spalte: Import-Codierung (Referenz) -->
                            <Border Grid.Column="4" Style="{DynamicResource PlayerCard}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <TextBlock Style="{DynamicResource SectionLabel}" Margin="0" FontSize="10">
                                            <Run Text="IMPORT ("/>
                                            <Run x:Name="RunImportDefectCount" Text="0"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                    </DockPanel>

                                    <ListBox x:Name="LstImportEvents"
                                             behaviors:PhotoHoverPreviewBehavior.IsEnabled="True"
                                             behaviors:CodingEventDragDropBehavior.Enabled="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="11"
                                             Foreground="{DynamicResource TextBrush}"
                                             MaxHeight="400"
                                             VirtualizingPanel.IsVirtualizing="False"
                                             ScrollViewer.CanContentScroll="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             IsHitTestVisible="True"
                                             MouseDoubleClick="ImportEvents_DoubleClick">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Bestätigen → ins KI-Brain" Click="ImportConfirmToBrain_Click">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8FB;" Foreground="{DynamicResource SuccessBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Bestätigen (als Training übernehmen)" Click="ImportConfirm_Click">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8FB;" Foreground="{DynamicResource SuccessBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Fotos anzeigen" Click="ImportShowPhotos_Click">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE8B9;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Bearbeiten (Code / BBox ziehen)" Click="ImportEdit_Click">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE70F;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Zum Zeitpunkt springen" Click="ImportSeek_Click">
                                                    <MenuItem.Icon><ui:FluentIcon Glyph="&#xE823;" Foreground="{DynamicResource MutedBrush}"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="Padding" Value="4,3"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Cursor="Hand">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="7" Height="7"
                                                                CornerRadius="4"
                                                                Background="{DynamicResource AccentBrush}"
                                                                Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Entry.Code}"
                                                                   FontFamily="Consolas"
                                                                   FontWeight="Bold" FontSize="11"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Entry.Beschreibung}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   ToolTip="{Binding Entry.Beschreibung}"
                                                                   VerticalAlignment="Top"/>
                                                        <Border x:Name="CodingMatchBadge"
                                                                Grid.Column="3"
                                                                Visibility="Collapsed"
                                                                Background="#334155"
                                                                CornerRadius="4"
                                                                Padding="4,1"
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock x:Name="TxtCodingMatchBadge"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#F8FAFC"/>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="11,1,0,0">
                                                        <ui:FluentIcon Glyph="&#xE707;" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding MeterAtCapture, StringFormat='{}{0:F2}m', Mode=OneWay}"
                                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- == 4. Kalibrierung + Messung (kompakt) == -->
                        <Border Style="{DynamicResource PlayerCard}" Margin="0,0,0,4" Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="KALIB." FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtCodingCalibDn" FontSize="10" Foreground="{DynamicResource TextBrush}" Text="DN: &#x2014;"/>
                                    <TextBlock x:Name="TxtCodingCalibStatus" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="&#x2014;"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCodingQ1" FontSize="10" Foreground="{DynamicResource TextBrush}" Text="Q1:&#x2014;" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtCodingQ2" FontSize="10" Foreground="{DynamicResource TextBrush}" Text="Q2:&#x2014;" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtCodingClock" FontSize="10" Foreground="{DynamicResource TextBrush}" Text="Uhr:&#x2014;" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtCodingArc" FontSize="10" Foreground="{DynamicResource TextBrush}" Text="Bogen:&#x2014;"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- â"€â"€ 5. Codieren (manuell) â"€â"€ -->
                        <Border Style="{DynamicResource PlayerCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CODIEREN" Style="{DynamicResource SectionLabel}"/>
                                <Button x:Name="BtnCodingSelectCode"
                                        Style="{DynamicResource PlayerPrimaryButton}"
                                        Content="Neues Ereignis erfassen"
                                        Padding="8,6" FontSize="12"
                                        Click="CodingSelectCode_Click"
                                        ToolTip="Öffnet Editor mit Code-Auswahl, Fotos und VSA-Feldern"/>
                                <TextBlock x:Name="TxtCodingSelectedCode"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <!-- Unsichtbar aber vorhanden fuer Kompatibilitaet -->
                                <Button x:Name="BtnCodingCreateEvent"
                                        Visibility="Collapsed"
                                        Click="CodingCreateEvent_Click"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- â"€â"€ 6. Session-Statistik â"€â"€ -->
                        <Border Style="{DynamicResource PlayerCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="SESSION STATISTIK" Style="{DynamicResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource StatTile}">
                                        <StackPanel>
                                            <TextBlock Text="KI-Kriterien erfüllt" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtCodingStatAiCriteriaMet"
                                                       Text="0" FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2" Style="{DynamicResource StatTile}">
                                        <StackPanel>
                                            <TextBlock Text="Menschlich bestätigt" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtCodingStatHumanAccepted"
                                                       Text="0" FontSize="20" FontWeight="Bold"
                                                       Foreground="#2563EB"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource StatTile}">
                                        <StackPanel>
                                            <TextBlock Text="Korrigiert" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtCodingStatHumanCorrected"
                                                       Text="0" FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource StatTile}">
                                        <StackPanel>
                                            <TextBlock Text="Abgelehnt" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtCodingStatRejected"
                                                       Text="0" FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="0" Style="{DynamicResource StatTile}">
                                        <StackPanel>
                                            <TextBlock Text="Offen" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtCodingStatOpen"
                                                       Text="0" FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="2" Style="{DynamicResource StatTile}">
                                        <StackPanel>
                                            <TextBlock Text="Ø KI-Sicherheit" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtCodingStatAvgAiConfidence"
                                                       Text="&#x2014;" FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        

</UserControl>
