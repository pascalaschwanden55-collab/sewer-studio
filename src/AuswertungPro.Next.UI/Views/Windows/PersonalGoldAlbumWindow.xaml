<Window x:Class="AuswertungPro.Next.UI.Views.Windows.PersonalGoldAlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        xmlns:local="clr-namespace:AuswertungPro.Next.UI.Views.Windows"
        Title="Goldstandard-Fotoalbum"
        Width="1380" Height="850" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <local:FileToImageConverter x:Key="FileToImage"/>
        <local:VsaCodeToTextConverter x:Key="VsaCodeToText"/>
        <local:PersonalGoldMainCodeToTextConverter x:Key="PersonalGoldMainCodeToText"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,10" CornerRadius="7"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Goldstandard-Fotoalbum" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SummaryText}" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Aktualisieren"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource ToolbarButton}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="8" CornerRadius="7"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Hauptcodes"
                               FontWeight="Bold" Margin="5,3,5,8"/>
                    <ListBox ItemsSource="{Binding CodeFilters}"
                             SelectedItem="{Binding SelectedCodeFilter}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,4" MinWidth="175">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource PersonalGoldMainCodeToText}}"
                                                   FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}">
                                            <Run Text="{Binding FullGoldCount}"/>
                                            <Run Text=" vollständig"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="10" MinWidth="28"
                                            Padding="7,2" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSubtleBrush}">
                                        <TextBlock Text="{Binding TotalCount}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="7"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,8,0">
                    <Grid>
                        <ListBox x:Name="AlbumItems"
                                 ItemsSource="{Binding VisibleItems}"
                                 SelectedItem="{Binding SelectedItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="AlbumTile" Width="190" Margin="6"
                                            Padding="6" CornerRadius="6"
                                            Background="{DynamicResource HeaderBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <Border Height="118" CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource BgBrush}">
                                                <Image Source="{Binding FramePath, Converter={StaticResource FileToImage}, ConverterParameter=260}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <TextBlock Text="{Binding Code, Converter={StaticResource VsaCodeToText}}"
                                                       FontWeight="Bold" Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="GoldState"
                                                       Text="Vollständig"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFullGold}" Value="False">
                                            <Setter TargetName="GoldState" Property="Text" Value="Unvollständig"/>
                                            <Setter TargetName="GoldState" Property="Foreground"
                                                    Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FileExists}" Value="False">
                                            <Setter TargetName="GoldState" Property="Text" Value="Bilddatei fehlt"/>
                                            <Setter TargetName="GoldState" Property="Foreground"
                                                    Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Für diesen Hauptcode sind noch keine persönlichen Beispiele vorhanden."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=AlbumItems}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Padding="12" CornerRadius="7"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <TextBlock Text="Ausgewähltes Beispiel"
                                       FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                            <Border Height="245" CornerRadius="5" ClipToBounds="True"
                                    Background="{DynamicResource BgBrush}">
                                <Image Source="{Binding FramePath, Converter={StaticResource FileToImage}, ConverterParameter=900}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="{Binding Code, Converter={StaticResource VsaCodeToText}}"
                                       FontSize="18" FontWeight="Bold" Margin="0,12,0,4"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Beschreibung}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding GeometryStatus}" Margin="0,2"/>
                            <TextBlock Text="{Binding FileStatus}" Margin="0,2"/>
                            <TextBlock Text="{Binding ConfirmedAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding FramePath}" FontSize="10"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="10,6" CornerRadius="6" Margin="0,8,0,0"
                Background="{DynamicResource HeaderBrush}">
            <TextBlock Text="Das Album ist nur eine Ansicht. Es verändert keine Bilder oder Trainingsdaten."
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
