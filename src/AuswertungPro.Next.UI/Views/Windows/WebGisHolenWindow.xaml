<Window x:Class="AuswertungPro.Next.UI.Views.Windows.WebGisHolenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:wg="clr-namespace:AuswertungPro.Next.Application.WebGis;assembly=AuswertungPro.Next.Application"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Vom WebGIS holen"
        Width="920" Height="680"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <!-- Nicht-modal (Wunsch Pascal 23.09.2026): Doppelklick auf eine Zeile oeffnet Haltung oder Schacht,
         das Fenster bleibt offen. «Uebernehmen» traegt nur ein, was seit der Vorschau unveraendert ist. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vom WebGIS holen" FontSize="{DynamicResource TextXL}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>

        <!-- Gruen nur, wenn alles zugeordnet ist; sobald etwas gesperrt oder nicht zugeordnet ist, orange
             mit der Anzahl (Wunsch Pascal 23.09.2026: «die gesperrten muessen klar gekennzeichnet sein»). -->
        <Border Grid.Row="1" Padding="12,8" CornerRadius="{DynamicResource RadiusM}" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Warnung}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:FluentIcon Glyph="&#xE896;" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,0,8,0"
                               VerticalAlignment="Top"
                               Visibility="{Binding AllesZugeordnet, Converter={StaticResource BoolToVis}}"/>
                <ui:FluentIcon Glyph="&#xE7BA;" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,8,0"
                               VerticalAlignment="Top"
                               Visibility="{Binding Warnung, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Warntext}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,2"
                               Visibility="{Binding Warnung, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Zusammenfassung}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Warnung}" Value="True">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rote Liste, immer offen: ganze Objekte und Massnahmen zuerst, dann einzelne Werte ohne Zuordnung. -->
        <Border Grid.Row="2" Margin="0,0,0,10" Padding="10,8" CornerRadius="{DynamicResource RadiusM}"
                Background="{DynamicResource DangerSubtleBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                Visibility="{Binding HatNichtZugeordnet, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <ui:FluentIcon Glyph="&#xE783;" Foreground="{DynamicResource DangerTextBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding NichtZugeordnetTitel}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource DangerTextBrush}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding NichtZugeordnet}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single" CanUserResizeRows="False" MaxHeight="200"
                          FontSize="{DynamicResource TextS}" MouseDoubleClick="OnZeileDoppelklick"
                          ToolTip="Wird nicht übernommen. Doppelklick öffnet die Haltung oder den Schacht.">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Objekt" Binding="{Binding Objekt}" Width="170"/>
                        <DataGridTextColumn Header="Was" Binding="{Binding Feld}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Feld}" Value="{x:Static wg:WebGisImportBericht.ArtWertNichtUebernommen}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Grund" Binding="{Binding Neu}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Zeilen}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" SelectionMode="Single" CanUserResizeRows="False"
                  FontSize="{DynamicResource TextM}" MouseDoubleClick="OnZeileDoppelklick"
                  ToolTip="Doppelklick öffnet die Haltung oder den Schacht. Das Fenster bleibt offen.">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Objekt" Binding="{Binding Objekt}" Width="1.6*"/>
                <DataGridTextColumn Header="Feld" Binding="{Binding Feld}" Width="1.2*"/>
                <DataGridTextColumn Header="Bisher" Binding="{Binding Alt}" Width="1.2*"/>
                <DataGridTextColumn Header="Aus dem WebGIS" Binding="{Binding Neu}" Width="1.4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Expander Grid.Row="4" Header="Ganzer Bericht" Margin="0,8,0,0">
            <TextBox Text="{Binding Bericht, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource TextS}"
                     MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
        </Expander>

        <TextBlock Grid.Row="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"
                   FontSize="{DynamicResource TextS}" Foreground="{DynamicResource MutedBrush}"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Padding="14,6" Margin="0,0,8,0" Click="OnNeuPruefen" IsEnabled="{Binding Bereit}"
                    ToolTip="Liest den WebGIS-Stand nochmals und vergleicht mit dem aktuellen Projektstand.">
                <StackPanel Orientation="Horizontal">
                    <ui:FluentIcon Glyph="&#xE72C;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Neu prüfen" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Padding="18,6" Margin="0,0,8,0" Click="OnUebernehmen"
                    IsEnabled="{Binding KannUebernehmen}"
                    ToolTip="Trägt die Werte in SewerStudio ein. Ins WebGIS wird nichts geschrieben. Was seit der Vorschau von Hand geändert wurde, bleibt stehen.">
                <StackPanel Orientation="Horizontal">
                    <ui:FluentIcon Glyph="&#xE8FB;" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Übernehmen" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Content="Schliessen" Padding="16,6" Click="OnSchliessen" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
