<Window x:Class="AuswertungPro.Next.UI.Views.Windows.WebGisVorschauWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:webgis="clr-namespace:AuswertungPro.Next.Application.WebGis;assembly=AuswertungPro.Next.Application"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Vergleich mit dem WebGIS"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Abzeichen: Farbe nach Ton (Änderung blau, gleich grau, Vorschlag/Warnung gelb, gesperrt/Fehler rot, bestätigt grün). -->
        <Style x:Key="Abzeichen" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusChip}"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ton}" Value="{x:Static webgis:WebGisAnzeigeTon.Aenderung}">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Ton}" Value="{x:Static webgis:WebGisAnzeigeTon.Vorschlag}">
                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Ton}" Value="{x:Static webgis:WebGisAnzeigeTon.Warnung}">
                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Ton}" Value="{x:Static webgis:WebGisAnzeigeTon.Gesperrt}">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Ton}" Value="{x:Static webgis:WebGisAnzeigeTon.Fehler}">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Ton}" Value="{x:Static webgis:WebGisAnzeigeTon.Bestaetigt}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding GeprueftUm}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Alle neu prüfen" Style="{DynamicResource ToolbarButton}" Margin="0,0,8,0"
                        IsEnabled="{Binding Bereit}" Click="OnAlleNeuPruefen"
                        ToolTip="Alle Haltungen und Schächte nochmals im WebGIS lesen und vergleichen"/>
                <Button Content="Alle Änderungen schreiben …" Style="{DynamicResource ToolbarButton}"
                        Click="OnAlleSchreiben"
                        ToolTip="Alle Objekte mit Änderungen schreiben — vorher erscheint die ganze Liste zur Bestätigung" IsEnabled="{Binding AlleSchreibenAktiv}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Export / WebGIS" FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="Vergleich SewerStudio ↔ WebGIS" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
                <TextBlock Text="Links ein Objekt wählen, rechts jedes Feld nebeneinander. Geschrieben wird erst nach deiner Bestätigung."
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Objektliste -->
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusL}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                        <TextBlock Text="OBJEKTE" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBox x:Name="SucheFeld" Text="{Binding Suche, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,6"
                                 AutomationProperties.Name="Haltung oder Schacht suchen"
                                 ToolTip="Haltung oder Schacht suchen"/>
                        <TextBlock Text="{Binding Zaehler}" FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox x:Name="ObjektListe" ItemsSource="{Binding Objekte}" SelectedItem="{Binding Ausgewaehlt}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Objektliste"
                             MouseDoubleClick="OnObjektDoppelklick"
                             ToolTip="Doppelklick öffnet die Haltung bzw. den Schacht in SewerStudio — dieses Fenster bleibt offen">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type webgis:WebGisVergleichsObjekt}">
                                <DockPanel Margin="4,6">
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Abzeichen}">
                                        <TextBlock Text="{Binding Chip}" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ArtText}" FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Vergleich des gewählten Objekts -->
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusL}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,14,20,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="In SewerStudio öffnen" Style="{DynamicResource ToolbarButton}" Margin="0,0,12,0"
                                    Click="OnBearbeiten" IsEnabled="{Binding HatAuswahl}"
                                    ToolTip="Dieses Objekt in Haltungen bzw. Schächten öffnen, um es zu korrigieren"/>
                            <CheckBox Content="Nur Unterschiede zeigen" IsChecked="{Binding NurUnterschiede}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Titel}" FontSize="{DynamicResource TextXL}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Untertitel}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="20,10,20,12" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Nur dieses Objekt neu prüfen" Style="{DynamicResource ToolbarButton}" Margin="0,0,10,0"
                                    Click="OnEinzelnPruefen"
                                    ToolTip="Nur dieses Objekt nochmals im WebGIS lesen — nicht die ganze Liste" IsEnabled="{Binding EinzelnPruefenAktiv}"/>
                            <Button Content="{Binding SchreibKnopf}" Style="{DynamicResource ToolbarButtonAccent}"
                                    Click="OnEinzelnSchreiben"
                                    ToolTip="Vorher erscheinen genau die Änderungen dieses Objekts zur Bestätigung" IsEnabled="{Binding SchreibenAktiv}"/>
                        </StackPanel>
                        <TextBlock Text="Beim Schreiben wird nur dieses Objekt nochmals gelesen, nicht die ganze Liste."
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FELD" Margin="16,0" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="SEWERSTUDIO" Margin="16,0" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="WEBGIS JETZT" Margin="16,0" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="3" Text="WAS PASSIERT" Margin="16,0" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Zeilen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type webgis:WebGisVergleichsZeile}">
                                        <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Hervorheben}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="280"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Feld}" FontWeight="SemiBold" Margin="16,0" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SewerStudio}" Margin="16,0" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding WebGis}" Margin="16,0" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="3" Margin="16,0">
                                                    <Border Style="{StaticResource Abzeichen}">
                                                        <TextBlock Text="{Binding Aktion}" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Grund}" FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <CheckBox Content="mitschreiben" IsChecked="{Binding Mitschreiben}" Margin="0,4,0,0"
                                                              Visibility="{Binding IstVorschlag, Converter={StaticResource BoolToVis}}"
                                                              ToolTip="Wert der Kanalfirma beim Schreiben mitsenden"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status und Schliessen -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Schliessen" Style="{DynamicResource ToolbarButton}"
                    Click="OnSchliessen" IsEnabled="{Binding Bereit}" ToolTip="Fenster schliessen"/>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
