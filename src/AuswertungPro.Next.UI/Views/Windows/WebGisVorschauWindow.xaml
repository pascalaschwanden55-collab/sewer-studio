<Window x:Class="AuswertungPro.Next.UI.Views.Windows.WebGisVorschauWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — WebGIS-Übertragung"
        Width="1180" Height="880"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Eine Zeile unter einem Objekt: Feld | bisher → neu, bzw. Hinweis/Sperre im Klartext. -->
        <DataTemplate x:Key="ZeileTemplate">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Top" Margin="0,1,0,0" FontSize="{DynamicResource TextS}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="→"/>
                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IstHinweis}" Value="True">
                                    <Setter Property="Text" Value="!"/>
                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IstSperre}" Value="True">
                                    <Setter Property="Text" Value="×"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1" Text="{Binding Feld}" TextWrapping="Wrap" VerticalAlignment="Top"
                           Foreground="{DynamicResource MutedBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding Alt}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HatAlt, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="  →  " Foreground="{DynamicResource MutedBrush}"
                               Visibility="{Binding HatAlt, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Neu}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IstHinweis}" Value="True">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IstSperre}" Value="True">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Eine Karte je Objekt: Name links, darunter alles, was daran geschieht. -->
        <DataTemplate x:Key="ObjektTemplate">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusL}" Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Objekt}" FontWeight="SemiBold" FontSize="{DynamicResource TextM}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Border CornerRadius="{DynamicResource RadiusChip}" Padding="8,1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HatSperre}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NurHinweise}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Kurz}" FontSize="{DynamicResource TextXS}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Zeilen}" ItemTemplate="{StaticResource ZeileTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Nicht-modal: bleibt offen, waehrend in Haltungen/Schaechten korrigiert wird.
         "Neu pruefen" liest das WebGIS erneut und baut die Liste aus dem aktuellen Projektstand. -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titel}" FontSize="{DynamicResource TextXL}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

        <!-- Vier Zahlen statt eines Satzes -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Kacheln}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusL}" Padding="16,10" Margin="0,0,10,0"
                            MinWidth="150">
                        <StackPanel>
                            <TextBlock Text="{Binding Zahl}" FontSize="{DynamicResource TextXL}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Beschriftung}" FontSize="{DynamicResource TextXS}"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Je Objekt eine Karte -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Objekte}" ItemTemplate="{StaticResource ObjektTemplate}"/>
                <TextBlock Text="Keine Unterschiede zum WebGIS — es gibt nichts zu übertragen."
                           Foreground="{DynamicResource MutedBrush}" Margin="4,8,0,0"
                           Visibility="{Binding Leer, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Gleichartiges gebuendelt statt 43 Einzelmeldungen -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Sammelmeldungen}" Margin="2,12,0,0"
                      Visibility="{Binding HatSammelmeldungen, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="i" FontWeight="Bold" Margin="0,0,8,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Grid.Row="4" Header="Vollständiger Bericht (Textfassung)" Margin="0,12,0,0"
                  IsExpanded="{Binding BerichtOffen, Mode=TwoWay}">
            <TextBox Text="{Binding Bericht, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                     FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource TextS}"
                     MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Margin="0,6,0,0"/>
        </Expander>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="520"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NeuPruefenButton" Padding="16,6" Margin="0,0,8,0" Click="OnNeuPruefen"
                        IsEnabled="{Binding Bereit}"
                        ToolTip="Liest alle Objekte erneut aus dem WebGIS und baut die Liste aus dem aktuellen Projektstand. Nach Korrekturen in Haltungen/Schächten hier klicken.">
                    <StackPanel Orientation="Horizontal">
                        <ui:FluentIcon Glyph="&#xE72C;" Margin="0,0,8,0"/>
                        <TextBlock Text="Neu prüfen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SchreibenButton" Style="{StaticResource PrimaryButton}" Padding="18,6" Margin="0,0,8,0"
                        Click="OnSchreiben" IsEnabled="{Binding Bereit}"
                        ToolTip="Prüft zuerst nochmals frisch und schreibt dann genau diese Liste ins WebGIS.">
                    <StackPanel Orientation="Horizontal">
                        <ui:FluentIcon Glyph="&#xE74E;" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="Jetzt schreiben" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Schliessen" Padding="16,6" Click="OnSchliessen" IsEnabled="{Binding Bereit}"
                        ToolTip="Schliesst das Fenster. Es wird nichts geschrieben."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
