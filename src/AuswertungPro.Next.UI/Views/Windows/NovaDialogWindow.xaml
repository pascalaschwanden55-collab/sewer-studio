<Window x:Class="AuswertungPro.Next.UI.Views.Windows.NovaDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SewerStudio — Meldung"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource CardBrush}"
        ui:WindowFx.Entrance="True">
    <Window.Resources>
        <!-- Der Ja-Knopf einer warnenden Rueckfrage mit «Nein» als Standardknopf ist die riskante
             Aktion: nicht mehr PrimaryButton (die Hauptaktion gehoert an den STANDARDKNOPF, hier
             also «Nein»), aber sichtbar als Warnung markiert statt einer neutralen SecondaryButton-
             Optik. -->
        <Style x:Key="NovaDialogDangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf: Symbol je Art + Titel -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <ui:FluentIcon x:Name="ArtSymbol" FontSize="{DynamicResource TextTitle}" VerticalAlignment="Top" Margin="0,2,14,0"/>
            <TextBlock x:Name="TitelBlock" FontSize="{DynamicResource TextL}" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>

        <!-- Text: auswaehlbar/kopierbar, umbrechend, bei langem Text scrollbar -->
        <ScrollViewer x:Name="TextScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
            <TextBox x:Name="TextInhalt"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextM}"
                     Cursor="IBeam"
                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
        </ScrollViewer>

        <!-- Fuss: «Kopieren» (nur bei Fehlern) links, Knopfleiste rechts -->
        <DockPanel Grid.Row="2">
            <Button x:Name="KopierenButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Visibility="Collapsed" Click="OnKopieren"
                    ToolTip="Meldungstext in die Zwischenablage kopieren"
                    AutomationProperties.Name="Meldungstext kopieren">
                <ui:FluentIcon Glyph="&#xE8C8;"/>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AbbrechenButton" Style="{StaticResource SecondaryButton}" MinWidth="96"
                        Margin="0,0,8,0" Content="Abbrechen" Click="OnAbbrechen"
                        ToolTip="Abbrechen" AutomationProperties.Name="Abbrechen"/>
                <Button x:Name="NeinButton" Style="{StaticResource SecondaryButton}" MinWidth="96"
                        Margin="0,0,8,0" Content="Nein" Click="OnNein"
                        ToolTip="Nein" AutomationProperties.Name="Nein"/>
                <Button x:Name="HauptButton" Style="{StaticResource PrimaryButton}" MinWidth="96"
                        Click="OnHaupt"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
