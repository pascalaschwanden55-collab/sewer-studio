<Window x:Class="AuswertungPro.Next.UI.Views.Windows.XtfLieferungWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True" Title="SewerStudio — SIA405-Lieferung bearbeiten"
        Width="1240" Height="860" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgLightBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FeldHinweis" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource TextXS}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <controls:NovaPageHeader Title="SIA405-Lieferung" Subtitle="Objekte bearbeiten"/>
            <Border Style="{DynamicResource Card}" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding DateiZeile}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Command="{Binding OeffnenCommand}" Style="{DynamicResource ToolbarButton}" Margin="0,0,6,4" AutomationProperties.Name="Lieferung öffnen">
                            <StackPanel Orientation="Horizontal"><ui:FluentIcon Glyph="&#xE8E5;" Margin="0,0,6,0"/><TextBlock Text="Lieferung öffnen …"/></StackPanel>
                        </Button>
                        <Button Content="Lieferung prüfen" Command="{Binding PruefenCommand}" Style="{DynamicResource ToolbarButton}" Margin="0,0,6,4"/>
                        <Button Content="Neue XTF schreiben …" Command="{Binding ExportierenCommand}" Style="{DynamicResource ToolbarButtonAccent}" Margin="0,0,6,4"/>
                        <Button Content="Bericht speichern …" Command="{Binding BerichtSpeichernCommand}" Style="{DynamicResource ToolbarButton}" Margin="0,0,6,4"/>
                        <Button Content="Vorgang abbrechen" Command="{Binding AbbrechenCommand}" Style="{DynamicResource ToolbarButton}" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding Bereit}">
            <ComboBox ItemsSource="{Binding Klassen}" SelectedItem="{Binding Klasse}" Width="220" Margin="0,0,8,0" AutomationProperties.Name="Objektart wählen"/>
            <TextBox Text="{Binding Suche, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,8,0" ToolTip="Name, Beschriftung oder Originalkennung suchen" AutomationProperties.Name="Objekte suchen"/>
            <CheckBox Content="Nur Prüfprobleme" IsChecked="{Binding NurProbleme}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Suchen" Command="{Binding SuchenCommand}" Style="{DynamicResource ToolbarButton}"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="340"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*" MinWidth="380"/></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Card}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Objekte" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Zurück" Command="{Binding VorherigeCommand}" Style="{DynamicResource ToolbarButton}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SeitenZeile}" FontSize="{DynamicResource TextS}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Weiter" Command="{Binding NaechsteCommand}" Style="{DynamicResource ToolbarButton}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Zeilen}" SelectedItem="{Binding Auswahl, Mode=TwoWay}" IsEnabled="{Binding Bereit}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                          EnableRowVirtualization="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Objektart" Binding="{Binding Klasse}" Width="135"/>
                        <DataGridTextColumn Header="Name / Beschriftung" Binding="{Binding Bezeichnung}" Width="*" MinWidth="120"/>
                        <DataGridTextColumn Header="Originalkennung" Binding="{Binding Kennung}" Width="140"/>
                        <DataGridTextColumn Header="Prüfproblem" Binding="{Binding Problem}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" Width="4" Background="{DynamicResource BorderBrush}" Margin="0,12"/>
            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="14,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="{DynamicResource RadiusChip}" Padding="8,3" HorizontalAlignment="Right"
                                Visibility="{Binding HatEntwurf, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Ungespeichert" FontSize="{DynamicResource TextXS}" Foreground="{DynamicResource AccentTextBrush}"/>
                        </Border>
                        <TextBlock Text="Objektdaten" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ObjektZeile}" FontSize="{DynamicResource TextS}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Änderungen speichern" Command="{Binding SpeichernCommand}" Style="{DynamicResource ToolbarButtonAccent}" Margin="0,0,8,4"/>
                        <Button Content="Eingaben verwerfen" Command="{Binding VerwerfenCommand}" Style="{DynamicResource ToolbarButton}" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding Bereit}">
                    <ItemsControl ItemsSource="{Binding Felder}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,8,9">
                                    <TextBlock Text="{Binding Label}" Margin="0,0,0,4" FontSize="{DynamicResource TextS}" Foreground="{DynamicResource MutedBrush}"/>
                                    <Grid>
                                        <TextBox Text="{Binding Wert, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding NurLesen}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="28" MaxHeight="120" AutomationProperties.Name="{Binding Label}">
                                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers>
                                                <DataTrigger Binding="{Binding HatAuswahl}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers></Style></TextBox.Style>
                                        </TextBox>
                                        <ComboBox ItemsSource="{Binding Feld.Optionen}" SelectedItem="{Binding Wert, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding Feld.Bearbeitbar}" Visibility="{Binding HatAuswahl, Converter={StaticResource BoolToVis}}"
                                                  MaxDropDownHeight="280" AutomationProperties.Name="{Binding Label}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Hinweis}" Style="{StaticResource FeldHinweis}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Style="{DynamicResource Card}" Padding="10,6" Margin="0,12,0,0">
        <Expander Header="Prüfbericht">
            <TextBox Text="{Binding BerichtVorschau, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="180"/>
        </Expander>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding Arbeitet, Converter={StaticResource BoolToVis}}" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextS}"/>
        </StackPanel>
    </Grid>
</Window>
