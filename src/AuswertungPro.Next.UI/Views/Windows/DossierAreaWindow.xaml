<Window x:Class="AuswertungPro.Next.UI.Views.Windows.DossierAreaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        Title="Gebietsangaben"
        Width="900" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <!-- Erbt den globalen Feldstil, damit der Dunkelmodus greift. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Diese Angaben gelten für ALLE Dossiers dieses Projekts. Einzelne Liegenschaften können sie überschreiben."
                   TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <TabItem Header="Deckblatt">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,12,0">

                        <TextBlock Text="Gebietstitel (erscheint gross auf dem Deckblatt)"/>
                        <TextBox x:Name="TitleBox" AcceptsReturn="True" MinHeight="46"
                                 TextWrapping="Wrap"/>

                        <TextBlock Text="Zweite Deckblattzeile, z. B. „6472 Erstfeld“"/>
                        <TextBox x:Name="LocationBox"/>

                        <TextBlock Text="Projektnummer („Proj. Nr. AWU“)"/>
                        <TextBox x:Name="ProjectNumberBox"/>

                        <TextBlock Text="Gezeichnet („Gez.“) — Kürzel"/>
                        <TextBox x:Name="DrawnByBox"/>

                        <TextBlock Text="Autoren (erscheint auf Seite 2 unter „Autoren:“)"/>
                        <TextBox x:Name="AuthorsBox"/>

                        <TextBlock Text="Rückmeldefrist"/>
                        <TextBox x:Name="DeadlineBox"/>

                        <TextBlock Text="Fusszeile des Dokuments"/>
                        <TextBox x:Name="FooterBox"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Themen">
                <Grid Margin="4,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               Text="Die Zeilen der Tabelle „Informationen“ — in dieser Reihenfolge. Ein Dossier kann einzelne Texte überschreiben und eigene Zeilen ergänzen."/>

                    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    Margin="0,8,0,0">
                            <Button Content="Neu"
                        ToolTip="Fügt ein neues Thema an. Es erscheint bei allen Dossiers des Gebiets." Width="62" Height="28" Margin="0,0,6,0"
                                    Click="OnAddTopic"/>
                            <Button Content="Entfernen"
                        ToolTip="Entfernt das gewählte Thema aus dem Gebiet. Dossiers, die dafür einen eigenen Text führen, behalten ihn." Width="82" Height="28" Margin="0,0,6,0"
                                    Click="OnRemoveTopic"/>
                            <Button Width="34" Height="28" Margin="0,0,6,0"
                                    ToolTip="Nach oben" AutomationProperties.Name="Nach oben" Click="OnTopicUp">
                                <ui:FluentIcon Glyph="&#xE74A;"/>
                            </Button>
                            <Button Width="34" Height="28"
                                    ToolTip="Nach unten" AutomationProperties.Name="Nach unten" Click="OnTopicDown">
                                <ui:FluentIcon Glyph="&#xE74B;"/>
                            </Button>
                        </StackPanel>

                        <ListBox x:Name="TopicList" DisplayMemberPath="Title"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Grid.Column="1"
                          DataContext="{Binding SelectedItem, ElementName=TopicList}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Thema (Spalte links)" Margin="0,0,0,2"/>
                        <TextBox Grid.Row="1" x:Name="TopicTitleBox"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="Text (Spalte „Bemerkungen“)"/>
                        <TextBox Grid.Row="3" x:Name="TopicTextBox"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Abbrechen"
                    ToolTip="Schliesst das Fenster. Die Gebietsangaben bleiben unverändert." Width="110" Height="32" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancel"/>
            <Button Content="Speichern"
                    ToolTip="Speichert die Gebietsangaben. Sie gelten ab sofort für alle Dossiers dieses Projekts." Width="110" Height="32"
                    IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
