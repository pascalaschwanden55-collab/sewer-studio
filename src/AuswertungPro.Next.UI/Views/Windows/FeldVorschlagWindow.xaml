<Window x:Class="AuswertungPro.Next.UI.Views.Windows.FeldVorschlagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        ui:WindowFx.Entrance="True"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        Title="SewerStudio — Beim Kanton nachschlagen"
        Width="520"
        MinWidth="480" MinHeight="260"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgLightBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf: worum es geht -->
        <controls:NovaDialogHeader x:Name="KopfText" Grid.Row="0"/>

        <!-- Ein einzelner Treffer -->
        <Border x:Name="TrefferBereich"
                Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                CornerRadius="{DynamicResource RadiusS}"
                Padding="12"
                Margin="0,0,0,12">
            <TextBlock x:Name="TrefferText"
                       FontSize="{DynamicResource TextL}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Mehrere Kandidaten: der Mensch entscheidet -->
        <StackPanel x:Name="AuswahlBereich"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Margin="0,0,0,12">
            <TextBlock Text="Mehrere Treffer — bitte auswählen:"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource MutedBrush}"/>
            <ListBox x:Name="KandidatenListe"
                     MaxHeight="180"
                     DisplayMemberPath="Wert"
                     SelectionChanged="KandidatenListe_SelectionChanged"/>
        </StackPanel>

        <!-- Herkunft, immer sichtbar wenn es einen Treffer gibt -->
        <TextBlock x:Name="QuelleText"
                   Grid.Row="3"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <Border Grid.Row="4" Style="{StaticResource DialogButtonBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AbbrechenKnopf"
                        Content="Abbrechen"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button x:Name="UebernehmenKnopf"
                        Content="Übernehmen"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="120"
                        IsDefault="True"
                        Click="Uebernehmen_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
