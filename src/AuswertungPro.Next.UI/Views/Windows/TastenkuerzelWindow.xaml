<Window x:Class="AuswertungPro.Next.UI.Views.Windows.TastenkuerzelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        ui:WindowFx.Entrance="True"
        Title="SewerStudio — Tastenkürzel"
        Width="620" Height="640"
        MinWidth="480" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:NovaDialogHeader Grid.Row="0" Title="Tastenkürzel"
                                    Subtitle="Alle globalen Kürzel und die Kürzel des Videoplayers."/>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GruppenListe">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,12" CornerRadius="{DynamicResource RadiusM}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Titel}" FontSize="{DynamicResource TextL}"
                                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Kuerzel}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Taste}"
                                                           FontFamily="{DynamicResource FontMono}"
                                                           FontSize="{DynamicResource TextS}"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Beschreibung}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource TextS}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogButtonBar}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Schliessen"
                        Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
