<UserControl x:Class="AuswertungPro.Next.UI.Views.Controls.ClockPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="140" MinHeight="140">
    <Grid>
        <Canvas x:Name="FaceCanvas" Background="Transparent">
            <Ellipse x:Name="Face"
                     Stroke="{DynamicResource BorderLightBrush}"
                     StrokeThickness="1"
                     Fill="{DynamicResource CardBrush}"/>
            <Line x:Name="Hand"
                  Stroke="{DynamicResource WarningBrush}"
                  StrokeThickness="3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>
            <Ellipse x:Name="CenterDot"
                     Width="6"
                     Height="6"
                     Fill="{DynamicResource TextSecondaryBrush}"/>
        </Canvas>
    </Grid>
</UserControl>
