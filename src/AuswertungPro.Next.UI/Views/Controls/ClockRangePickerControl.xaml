<UserControl x:Class="AuswertungPro.Next.UI.Views.Controls.ClockRangePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="140" MinHeight="160">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Uhr: volle 240px Hoehe, keine Ueberlappung mit StatusText -->
        <Canvas x:Name="FaceCanvas" Grid.Row="0" Background="Transparent"
                ClipToBounds="False">
            <!-- Zifferblatt -->
            <Ellipse x:Name="Face"
                     Stroke="{DynamicResource BorderLightBrush}"
                     StrokeThickness="1.5"
                     Fill="{DynamicResource CardBrush}"/>
            <!-- Bereichs-Sektor (Von bis Bis, im Uhrzeigersinn) -->
            <Path x:Name="RangeArc"
                  Fill="{DynamicResource AccentSubtleBrush}"
                  Stroke="{DynamicResource WarningBrush}"
                  StrokeThickness="1.5"
                  Visibility="Collapsed"/>
            <!-- Zeiger Von -->
            <Line x:Name="HandVon"
                  Stroke="{DynamicResource WarningBrush}"
                  StrokeThickness="3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed"/>
            <!-- Zeiger Bis -->
            <Line x:Name="HandBis"
                  Stroke="{DynamicResource AccentBrush}"
                  StrokeThickness="3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed"/>
            <!-- Mittelpunkt -->
            <Ellipse x:Name="CenterDot"
                     Width="8"
                     Height="8"
                     Fill="{DynamicResource TextSecondaryBrush}"/>
        </Canvas>
        <!-- Status-Anzeige: UNTER der Uhr, nicht ueberlappend -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   HorizontalAlignment="Center"
                   FontSize="{DynamicResource TextXS}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,4,0,0"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
