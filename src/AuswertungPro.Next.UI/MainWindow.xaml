<Window x:Class="AuswertungPro.Next.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        x:Name="RootWindow"
        Title="{Binding Title}" Width="1200" Height="750" MinWidth="1000" MinHeight="650"
        ui:Fluent.Backdrop="Mica"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">
    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ToggleFocusModeCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
    </Window.InputBindings>
    <Grid>
    <DockPanel>
        <!-- Kopfzeile: Menue + Knopf "Projekt wechseln"; nur im Workspace sichtbar -->
        <DockPanel DockPanel.Dock="Top">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFocusMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <Button DockPanel.Dock="Right"
                    Content="Projekt wechseln"
                    Command="{Binding SwitchProjectCommand}"
                    Margin="8,2,8,2" Padding="12,2"
                    Style="{StaticResource SecondaryButton}">
                <Button.ToolTip>
                    <ToolTip>
                        <ui:RichToolTipContent Icon="&#xE8B7;"
                                               Title="Projekt wechseln"
                                               Description="Aktuelles Projekt verlassen und zur Projektuebersicht wechseln. Bei ungespeicherten Aenderungen wird vorher nachgefragt."/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>
            <Menu>
                <Menu.Style>
                    <Style TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}"/>
                </Menu.Style>
                <MenuItem Header="_Datei">
                    <MenuItem Header="Neues Projekt" Command="{Binding NewProjectCommand}" InputGestureText="Strg+N"
                              ToolTip="Neues Projekt anlegen."/>
                    <MenuItem Header="Projekt öffnen..." Command="{Binding OpenProjectCommand}" InputGestureText="Strg+O"
                              ToolTip="Bestehendes SewerStudio-Projekt auswaehlen und laden."/>
                    <MenuItem Header="Speichern" Command="{Binding SaveCommand}" InputGestureText="Strg+S"
                              ToolTip="Aktuelles Projekt speichern."/>
                    <MenuItem Header="Speichern unter..." Command="{Binding SaveAsProjectCommand}"
                              ToolTip="Aktuelles Projekt unter einem neuen Pfad speichern."/>
                    <Separator/>
                    <MenuItem Header="Beenden" Click="Exit_Click"
                              ToolTip="SewerStudio schliessen."/>
                </MenuItem>
                <MenuItem Header="_Werkzeuge">
                    <MenuItem Header="Code-Katalog..." Click="OpenCodeCatalog_Click"
                              ToolTip="VSA-Code-Katalog durchsuchen und pruefen."/>
                    <MenuItem Header="KI starten" Click="StartAi_Click"
                              ToolTip="Lokale KI-Dienste fuer Analyse und Codierung starten."/>
                    <Separator/>
                    <MenuItem Header="KI Videoanalyse – Training Center..." Click="OpenTrainingCenter_Click"
                              ToolTip="Training Center fuer KI-Review und Selbsttraining oeffnen."/>
                    <MenuItem Header="Karte..." Click="OpenKarte_Click"
                              ToolTip="Kartenansicht in einem eigenen Fenster oeffnen."/>
                </MenuItem>
                <MenuItem Header="_Ansicht">
                    <MenuItem Header="Fokusmodus (F11)" IsCheckable="True" IsChecked="{Binding IsFocusMode, Mode=TwoWay}"
                              ToolTip="Sidebar und Menue ausblenden, um mehr Arbeitsflaeche zu erhalten."/>
                    <Separator/>
                    <MenuItem Header="Karte abkoppeln" Click="OpenKarte_Click"
                              ToolTip="Kartenansicht in einem eigenen Fenster oeffnen."/>
                    <MenuItem Header="System-Monitor oeffnen" Click="OpenSystemMonitor_Click"
                              ToolTip="System-Monitor in einem eigenen Fenster oeffnen."/>
                </MenuItem>
            </Menu>
        </DockPanel>
        <!-- Statusleiste: links Status, rechts Projektname + Haltungszahl (bleibt auch in F11 sichtbar) -->
        <Border DockPanel.Dock="Bottom"
                Height="30"
                Padding="12,0"
                Background="{DynamicResource BgLightBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OpenSystemMonitor_Click"
                            MinHeight="0"
                            MinWidth="0"
                            Padding="8,3"
                            Margin="0,0,10,0"
                            ToolTip="System-Monitor oeffnen">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAiIndicatorVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,6,0"
                                     Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Opacity" Value="0.8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAiWorking}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="AiStatusPulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.45"
                                                                             To="1"
                                                                             Duration="0:0:0.7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="AiStatusPulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AiIndicatorTitle}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Project.Name}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    <Border Width="1"
                            Height="14"
                            Margin="10,0"
                            Background="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="&#xE8FD;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Project.Data.Count, StringFormat={}{0} Haltungen}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE7F4;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,4,0"/>
                    <TextBlock Text="{Binding Project.SchaechteData.Count, StringFormat={}{0} Schaechte}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="{Binding Project.Data.Count, StringFormat='  ·  {0} Haltungen'}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Project.SchaechteData.Count, StringFormat='  ·  {0} Schächte'}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="220"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsFocusMode, ElementName=RootWindow}" Value="True">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                            <!-- Sidebar ausblenden wenn nicht im Workspace -->
                            <DataTrigger Binding="{Binding DataContext.IsMenuVisible, ElementName=RootWindow}" Value="False">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource NavPanelBrush}" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource BorderBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsFocusMode, ElementName=RootWindow}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <!-- Sidebar ausblenden wenn nicht im Workspace -->
                        <DataTrigger Binding="{Binding IsMenuVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Height="20" CornerRadius="2" Margin="0,0,10,0"
                                Background="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="SEWER STUDIO" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Consolas, Segoe UI"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" Margin="14,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    <Border Height="2" Margin="0,12,0,0" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource ColorAccent}" Offset="0"/>
                                <GradientStop Color="{DynamicResource ColorAccentLight}" Offset="0.4"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- System Monitor -->
                <ctrl:SystemMonitorPanel DockPanel.Dock="Bottom"
                                         DataContext="{Binding Monitor}"
                                         Margin="12,4,12,12"/>


                <ListBox x:Name="SidebarNavList"
                         ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                         BorderThickness="0" Background="Transparent" Margin="8,4,8,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4">
                                <StackPanel.ToolTip>
                                    <ToolTip>
                                        <ui:RichToolTipContent Icon="{Binding Icon}"
                                                               Title="{Binding Title}"
                                                               Description="{Binding ToolTipDescription}"
                                                               Shortcut="{Binding ToolTipShortcut}"/>
                                    </ToolTip>
                                </StackPanel.ToolTip>
                                <Grid Width="24" Height="18" VerticalAlignment="Center">
                                    <TextBlock x:Name="DefaultNavIcon"
                                               Text="{Binding Icon}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="24"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- Haltung: zwei Schaechte (Ovale) mit Rohrverbindung dazwischen -->
                                    <Canvas x:Name="PipeNavIcon" Width="24" Height="18" Visibility="Collapsed">
                                        <Ellipse Canvas.Left="1" Canvas.Top="2" Width="6" Height="14"
                                                 Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"/>
                                        <Ellipse Canvas.Left="17" Canvas.Top="2" Width="6" Height="14"
                                                 Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"/>
                                        <Line X1="5" Y1="4.5" X2="19" Y2="4.5"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="5" Y1="13.5" X2="19" Y2="13.5"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>

                                    <!-- Schacht: Konus-Oeffnung oben, Koerper, Sohle, seitlicher Zu-/Ablauf -->
                                    <Canvas x:Name="ShaftNavIcon" Width="24" Height="18" Visibility="Collapsed">
                                        <Ellipse Canvas.Left="4" Canvas.Top="1.5" Width="16" Height="4"
                                                 Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"/>
                                        <Line X1="5" Y1="3.5" X2="6.5" Y2="12"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="19" Y1="3.5" X2="17.5" Y2="12"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="6.5" Canvas.Top="10" Width="11" Height="4"
                                                 Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"/>
                                        <Line X1="1" Y1="8.5" X2="6.5" Y2="8.5"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="17.5" Y1="8.5" X2="23" Y2="8.5"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>

                                    <!-- VSA: Punktwolke/Klassifizierung (auf einheitliche Icon-Groesse skaliert) -->
                                    <Canvas x:Name="VsaNavIcon" Width="28" Height="20" Visibility="Collapsed">
                                        <Canvas.LayoutTransform>
                                            <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                                        </Canvas.LayoutTransform>
                                        <Ellipse Canvas.Left="1" Canvas.Top="10.5" Width="7" Height="7"
                                                 Fill="{DynamicResource TextSecondaryBrush}"/>
                                        <Ellipse Canvas.Left="2.5" Canvas.Top="4.5" Width="5.5" Height="5.5"
                                                 Fill="{DynamicResource TextSecondaryBrush}"/>
                                        <Ellipse Canvas.Left="6.5" Canvas.Top="1.5" Width="4.5" Height="4.5"
                                                 Fill="{DynamicResource TextSecondaryBrush}"/>
                                        <Ellipse Canvas.Left="11.5" Canvas.Top="0.5" Width="3.8" Height="3.8"
                                                 Fill="{DynamicResource TextSecondaryBrush}"/>
                                        <Ellipse Canvas.Left="16.5" Canvas.Top="2.3" Width="3.2" Height="3.2"
                                                 Fill="{DynamicResource TextSecondaryBrush}"/>
                                        <Ellipse Canvas.Left="20.5" Canvas.Top="6" Width="2.8" Height="2.8"
                                                 Fill="{DynamicResource TextSecondaryBrush}"/>
                                        <Ellipse Canvas.Left="22.8" Canvas.Top="10.8" Width="2.2" Height="2.2"
                                                 Fill="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Canvas.Left="12.5" Canvas.Top="12.5" Text="V"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Canvas>
                                </Grid>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" FontSize="13.5"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Title}" Value="Haltungen">
                                    <Setter TargetName="DefaultNavIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PipeNavIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Title}" Value="Schaechte">
                                    <Setter TargetName="DefaultNavIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ShaftNavIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Title}" Value="VSA">
                                    <Setter TargetName="DefaultNavIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="VsaNavIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="IsEnabled" Value="True"/>
                            <Setter Property="IsHitTestVisible" Value="True"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentStrip" Grid.Column="0"
                                                    Background="{DynamicResource AccentBarBrush}"
                                                    CornerRadius="1.5" Margin="0,6" Opacity="0"/>
                                            <Border x:Name="bd" Grid.Column="1" Background="Transparent"
                                                    CornerRadius="6" Padding="2"
                                                    Margin="4,0,0,0">
                                                <ContentPresenter/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                <Setter TargetName="AccentStrip" Property="Opacity" Value="1"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="16"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsFocusMode, ElementName=RootWindow}" Value="True">
                            <Setter Property="Margin" Value="8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <ctrl:AnimatedContentControl Content="{Binding CurrentPage}"/>
                    <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavItem.IsAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="Bitte zuerst ein Projekt speichern (Datei anlegen)." FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
                            <TextBlock Text="Danach sind alle Funktionen freigeschaltet." Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    </DockPanel>

    <!-- Toast-Overlay: nicht-blockierende Erfolgsmeldungen unten rechts, ueber allem -->
    <ctrl:ToastHost x:Name="ToastHostControl"/>
    </Grid>
</Window>
