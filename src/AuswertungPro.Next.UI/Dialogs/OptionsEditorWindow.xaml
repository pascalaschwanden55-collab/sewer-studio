<Window x:Class="AuswertungPro.Next.UI.Dialogs.OptionsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ui:WindowFx.Entrance="True"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls"
        Title="SewerStudio — Listen bearbeiten" Height="380"
        MinWidth="360" MinHeight="320" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:NovaDialogHeader Grid.Row="0" Title="Listen bearbeiten"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <TextBox Width="200"
                     IsEnabled="{Binding IsEditingEnabled}"
                     Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button IsEnabled="{Binding IsEditingEnabled}"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource ToolbarButton}"
                    Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:FluentIcon Glyph="&#xE710;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="Hinzufügen"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"/>

        <Border Grid.Row="3" Style="{StaticResource DialogButtonBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsEnabled="{Binding IsEditingEnabled}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RemoveCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:FluentIcon Glyph="&#xE738;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Entfernen"/>
                    </StackPanel>
                </Button>
                <Button Content="Nach oben" Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding IsEditingEnabled}"
                        Command="{Binding MoveUpCommand}" Margin="0,0,8,0"/>
                <Button Content="Nach unten" Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding IsEditingEnabled}"
                        Command="{Binding MoveDownCommand}" Margin="0,0,8,0"/>
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Speichern" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding IsEditingEnabled}"
                        Command="{Binding SaveCommand}" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
