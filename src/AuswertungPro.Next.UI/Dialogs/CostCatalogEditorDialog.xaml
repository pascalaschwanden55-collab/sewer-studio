<Window x:Class="AuswertungPro.Next.UI.Dialogs.CostCatalogEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ui:WindowFx.Entrance="True"
        xmlns:ui="clr-namespace:AuswertungPro.Next.UI"
        Title="SewerStudio — Positionen bearbeiten"
        Width="1240" Height="720" MinWidth="980" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Positionen (Kostentabelle)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Hier kannst du Positionen hinzufügen, ändern oder löschen."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      x:Name="ItemsGrid"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      CellEditEnding="ItemsGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Einheit" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <!-- Typ: Fixed = ein Fixpreis; ByDN = Preis je Durchmesser (rechts bearbeitbar) -->
                    <DataGridComboBoxColumn Header="Typ" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="80">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                <sys:String>Fixed</sys:String>
                                <sys:String>ByDN</sys:String>
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>
                    <!-- Audit W13: NPK-Zuordnung war nur per JSON-Handarbeit pflegbar und im UI unsichtbar -->
                    <DataGridTextColumn Header="NPK" Binding="{Binding NpkCode, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    <DataGridTextColumn Header="Kapitel" Binding="{Binding Chapter, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                    <DataGridTextColumn Header="Preis" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="85"/>
                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Active, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- DN-Preis-Editor fuer die gewaehlte ByDN-Position (Liner/Manschette) -->
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedDnHeader}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Hinweis, wenn die Position KEIN ByDN ist -->
                    <TextBlock Visibility="{Binding DnHintVisibility}" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Wähle links eine Position vom Typ „ByDN&#x201C; (z. B. Schlauchliner GFK / Nadelfilz, Manschette), um die Preise je Durchmesser zu bearbeiten. Fixpreise trägst du in der Spalte „Preis&#x201C; ein."/>

                    <!-- DN-Preis-Tabelle, wenn ByDN -->
                    <StackPanel Visibility="{Binding DnEditorVisibility}">
                        <DataGrid ItemsSource="{Binding SelectedDnPrices}"
                                  SelectedItem="{Binding SelectedDnPrice}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  MinHeight="140" MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DN von" Binding="{Binding DnFrom, UpdateSourceTrigger=PropertyChanged}" Width="75" ElementStyle="{StaticResource MonoCellStyle}"/>
                                <DataGridTextColumn Header="DN bis" Binding="{Binding DnTo, UpdateSourceTrigger=PropertyChanged}" Width="75" ElementStyle="{StaticResource MonoCellStyle}"/>
                                <DataGridTextColumn Header="Preis" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Command="{Binding AddDnCommand}" Padding="12,6" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FluentIcon Glyph="&#xE710;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="DN"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveDnCommand}" Padding="12,6" Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0"/>
                                    <TextBlock Text="DN löschen"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Der Preis richtet sich nach der DN der Haltung. Fehlt eine DN in der Liste, wird automatisch die nächstgelegene genommen. „DN von/bis&#x201C; gleich = genau diese Nennweite."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Command="{Binding AddCommand}" Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:FluentIcon Glyph="&#xE710;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Position"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RemoveCommand}" Padding="12,6" Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource FontIcon}" Margin="0,0,6,0"/>
                        <TextBlock Text="Löschen"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Speichern" Command="{Binding SaveCommand}" Padding="18,6" Margin="0,0,6,0"
                        Style="{StaticResource PrimaryButton}"/>
                <Button Content="Schließen" Command="{Binding CloseCommand}" Padding="18,6"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
