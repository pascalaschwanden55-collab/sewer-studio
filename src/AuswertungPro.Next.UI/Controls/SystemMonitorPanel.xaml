<UserControl x:Class="AuswertungPro.Next.UI.Controls.SystemMonitorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:AuswertungPro.Next.UI.Controls">
    <UserControl.Resources>
        <ctrl:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <ctrl:PercentToColorConverter x:Key="PercentToColorConverter"/>

        <Style x:Key="MetricTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MetricDetailText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MetricTinyText" TargetType="TextBlock" BasedOn="{StaticResource MetricDetailText}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <Style x:Key="MetricPercentText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="MetricTrack" TargetType="Border">
            <Setter Property="Height" Value="5"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="Margin" Value="0,4,0,3"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Expander x:Name="PerformanceMonitorExpander"
              IsExpanded="True"
              Foreground="{DynamicResource TextBrush}"
              Background="Transparent"
              BorderThickness="0">
        <Expander.Header>
            <Grid MinWidth="0" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Systemleistung"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,1,0,0">
                    <Border CornerRadius="5"
                            Padding="5,1"
                            Background="{DynamicResource SuccessBrush}"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="LIVE"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="Live-Monitor"
                               FontSize="10"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="6,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Expander.Header>

        <Border Margin="0,5,0,0"
                Padding="6"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource HeaderBrush}"
                SnapsToDevicePixels="True">

            <StackPanel>
                <Border CornerRadius="6"
                        Padding="8,4"
                        Margin="0,0,0,5"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel LastChildFill="True">
                            <Border Width="7"
                                    Height="7"
                                    CornerRadius="4"
                                    Background="{DynamicResource SuccessBrush}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="Sensorstatus"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1"
                                   Margin="0,5,0,0"
                                   Text="{Binding CpuTempStatusText}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CPU Auslastung" Style="{StaticResource MetricTitleText}"/>
                            <TextBlock Text="{Binding CpuName, Mode=OneWay}"
                                       Style="{StaticResource MetricDetailText}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource MetricPercentText}"
                                   Foreground="{Binding CpuPercent, Converter={StaticResource PercentToColorConverter}}">
                            <Run Text="{Binding CpuPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource MetricTrack}">
                            <Border CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Background="{Binding CpuPercent, Converter={StaticResource PercentToColorConverter}}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="CpuPercent"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource MetricTinyText}">
                                <Run Text="Takt "/><Run Text="{Binding CpuClockMhz, Mode=OneWay, StringFormat=N0}"/><Run Text=" MHz"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricTinyText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCpuTempAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="Temp "/><Run Text="{Binding CpuTempC, Mode=OneWay}"/><Run Text=" C"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       Text="Temp n/a">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricTinyText}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCpuTempAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="RAM Arbeitsspeicher"
                                   Style="{StaticResource MetricTitleText}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource MetricPercentText}"
                                   Foreground="{Binding RamPercent, Converter={StaticResource PercentToColorConverter}}">
                            <Run Text="{Binding RamPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource MetricTrack}">
                            <Border CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Background="{Binding RamPercent, Converter={StaticResource PercentToColorConverter}}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="RamPercent"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource MetricTinyText}">
                                <Run Text="{Binding RamUsedMb, Mode=OneWay, StringFormat=N0}"/><Run Text=" / "/>
                                <Run Text="{Binding RamTotalMb, Mode=OneWay, StringFormat=N0}"/><Run Text=" MB"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource MetricTinyText}"
                                       Margin="8,0,0,0">
                                <Run Text="Takt "/><Run Text="{Binding RamClockMhz, Mode=OneWay, StringFormat=N0}"/><Run Text=" MHz"/>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="GPU Grafikprozessor" Style="{StaticResource MetricTitleText}"/>
                            <TextBlock Text="{Binding GpuName, Mode=OneWay}"
                                       Margin="0,1,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricDetailText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGpuAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="GPU nicht erkannt">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricDetailText}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGpuAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource MetricPercentText}"
                                   Foreground="{Binding GpuPercent, Converter={StaticResource PercentToColorConverter}}">
                            <Run Text="{Binding GpuPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource MetricTrack}">
                            <Border CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Background="{Binding GpuPercent, Converter={StaticResource PercentToColorConverter}}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="GpuPercent"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource MetricTinyText}">
                                <Run Text="Takt "/><Run Text="{Binding GpuClockMhz, Mode=OneWay, StringFormat=N0}"/><Run Text=" MHz"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource MetricTinyText}">
                                <Run Text="Temp "/><Run Text="{Binding GpuTempC, Mode=OneWay}"/><Run Text=" C"/>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="VRAM Videospeicher"
                                   Style="{StaticResource MetricTitleText}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource MetricPercentText}"
                                   Foreground="{Binding GpuMemPercent, Converter={StaticResource PercentToColorConverter}}">
                            <Run Text="{Binding GpuMemPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource MetricTrack}">
                            <Border CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Background="{Binding GpuMemPercent, Converter={StaticResource PercentToColorConverter}}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="GpuMemPercent"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Style="{StaticResource MetricTinyText}">
                            <Run Text="{Binding GpuMemUsedMb, Mode=OneWay, StringFormat=N0}"/><Run Text=" / "/>
                            <Run Text="{Binding GpuMemTotalMb, Mode=OneWay, StringFormat=N0}"/><Run Text=" MB"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Expander>
</UserControl>
