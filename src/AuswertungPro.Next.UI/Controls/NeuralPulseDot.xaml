<UserControl x:Class="AuswertungPro.Next.UI.Controls.NeuralPulseDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="14" Height="14">
    <!-- Ruhiger KI-Puls: gefuellter Punkt mit auslaufendem Ring. Der Ring laeuft nur, wenn
         wirklich gearbeitet wird (IsActive) — der Puls ist ein Arbeitsanzeiger, keine Deko.
         Viewbox: die Zeichnung ist auf 14x14 ausgelegt und skaliert auf jede gesetzte Groesse. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="14" Height="14">
            <!-- Auslaufender Ring: startet klein auf dem Punkt und verklingt nach aussen.
                 Stroke und Fill setzt der Code-Behind — je nach Zustand als Theme-Verweis. -->
            <Ellipse x:Name="PulseRing"
                     Width="14" Height="14"
                     StrokeThickness="1.5"
                     Opacity="0"
                     RenderTransformOrigin="0.5,0.5"
                     IsHitTestVisible="False">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="RingScale" ScaleX="0.5" ScaleY="0.5"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- Kern: bleibt immer ruhig stehen; die Farbe zeigt aktiv (Akzent) oder ruhend (grau). -->
            <Ellipse x:Name="Core"
                     Width="7" Height="7"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
</UserControl>
