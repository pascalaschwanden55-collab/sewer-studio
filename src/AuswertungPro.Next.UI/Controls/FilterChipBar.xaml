<UserControl x:Class="AuswertungPro.Next.UI.Controls.FilterChipBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FilterChipToggleButton" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZustandsklasseChipToggleButton" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}"/>
                            <Border x:Name="activeRing"
                                    BorderBrush="{DynamicResource TextBrush}"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="activeRing" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="activeRing" Property="Opacity" Value="1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChipResetButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Filter-Chips fuers Haltungen-Grid: reiner View-Filter (NR bleibt Position).
         Ein Zustandsklassen-Chip zur Zeit; Video/Schaeden kombinieren mit UND. -->
    <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Filter:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <TextBlock Text="ZK" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ToggleButton x:Name="Zk0" Content="0" Margin="0,0,3,0" Style="{StaticResource ZustandsklasseChipToggleButton}"
                      Checked="ZkChip_Changed" Unchecked="ZkChip_Changed" ToolTip="Nur Zustandsklasse 0"/>
        <ToggleButton x:Name="Zk1" Content="1" Margin="0,0,3,0" Style="{StaticResource ZustandsklasseChipToggleButton}"
                      Checked="ZkChip_Changed" Unchecked="ZkChip_Changed" ToolTip="Nur Zustandsklasse 1"/>
        <ToggleButton x:Name="Zk2" Content="2" Margin="0,0,3,0" Style="{StaticResource ZustandsklasseChipToggleButton}"
                      Checked="ZkChip_Changed" Unchecked="ZkChip_Changed" ToolTip="Nur Zustandsklasse 2"/>
        <ToggleButton x:Name="Zk3" Content="3" Margin="0,0,3,0" Style="{StaticResource ZustandsklasseChipToggleButton}"
                      Checked="ZkChip_Changed" Unchecked="ZkChip_Changed" ToolTip="Nur Zustandsklasse 3"/>
        <ToggleButton x:Name="Zk4" Content="4" Margin="0,0,10,0" Style="{StaticResource ZustandsklasseChipToggleButton}"
                      Checked="ZkChip_Changed" Unchecked="ZkChip_Changed" ToolTip="Nur Zustandsklasse 4"/>

        <ToggleButton x:Name="ChipVideo" Content="mit Video" Margin="0,0,4,0" Style="{StaticResource FilterChipToggleButton}"
                      Checked="Chip_Changed" Unchecked="Chip_Changed"/>
        <ToggleButton x:Name="ChipSchaeden" Content="mit Schäden" Margin="0,0,10,0" Style="{StaticResource FilterChipToggleButton}"
                      Checked="Chip_Changed" Unchecked="Chip_Changed"/>

        <Button x:Name="ResetButton" Content="Filter aus"
                Visibility="Collapsed" Click="Reset_Click"
                Style="{StaticResource FilterChipResetButton}"/>

        <TextBlock x:Name="TrefferText" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="SperrHinweis" Text="(Verschieben bei aktivem Filter gesperrt)"
                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource MutedBrush}"/>
    </WrapPanel>
</UserControl>
