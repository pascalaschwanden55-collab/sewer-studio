<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AuswertungPro.Next.UI.Controls">

    <!-- Nova-Etappe 2, Task 18: einheitlicher Seitenkopf. Lookless Control (wie StatusHost) statt
         UserControl, weil ein UserControl mit eigenem x:Class die WPF-Namescope fuer nachtraeglich
         (z. B. per x:Name) referenzierte Elemente im Aktionen-Inhalt sperrt (MC3093 beim Build). -->
    <Style TargetType="{x:Type controls:NovaPageHeader}">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <!-- Fix-Runde 1: Ein Control ist per Default fokussierbar/Tabstopp (anders als ein
             UserControl, das Focusable=False mitbringt). Der Seitenkopf zeigt nur Text und
             fremde Aktionen (die selbst fokussierbar bleiben) - er selbst darf keinen
             Tab-Stopp und keinen Fokusrahmen erzeugen. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NovaPageHeader}">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Aktionen}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Ruling (Fix-Runde 1): DynamicResource, nicht Static - der Style liegt in
                                 App.Resources und wuerde bei StaticResource die Theme-Farbe der Titel-
                                 Unterstreichung beim Hell/Dunkel-Wechsel einfrieren. -->
                            <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" Style="{DynamicResource PageTitle}"/>
                            <!-- Kollabiert bei leerem Untertitel (z. B. Einstellungen), damit kein leerer Rand bleibt. -->
                            <TextBlock x:Name="SubtitleText"
                                       Text="{TemplateBinding Subtitle}" Margin="10,0,0,3" VerticalAlignment="Bottom"
                                       FontSize="{DynamicResource TextS}" Foreground="{DynamicResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
