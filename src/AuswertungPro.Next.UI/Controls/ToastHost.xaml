<UserControl x:Class="AuswertungPro.Next.UI.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:AuswertungPro.Next.UI.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- Transparente Overlay-Ebene: nur die Toast-Karten fangen Klicks, der Rest der UI
         bleibt bedienbar (Grid ohne Background -> kein Hit-Test in leeren Bereichen). -->
    <Grid>
        <ItemsControl x:Name="ItemsHost"
                      VerticalAlignment="Bottom" HorizontalAlignment="Right"
                      Margin="0,0,20,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type services:ToastItem}">
                    <Border MinWidth="240" MaxWidth="360" Margin="0,6,0,0"
                            CornerRadius="{DynamicResource RadiusM}"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand"
                            Opacity="0"
                            RenderTransformOrigin="0.5,1"
                            Loaded="Toast_Loaded"
                            MouseLeftButtonUp="Toast_Click"
                            ToolTip="Klicken zum Schliessen">
                        <Border.RenderTransform>
                            <TranslateTransform Y="12"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Farbiger Akzentbalken je Schwere (Default = AccentBrush fuer Info) -->
                            <Border x:Name="AccentBar" Grid.Column="0"
                                    CornerRadius="6,0,0,6"
                                    Background="{DynamicResource AccentBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,10,14,10">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="{DynamicResource TextM}"/>
                                <!-- Optionaler Link zu dem Ergebnis, zum Beispiel zum Exportordner. -->
                                <Button Style="{StaticResource LinkButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Content="{Binding AktionText}"
                                        Click="ToastAktion_Click"
                                        FontSize="{DynamicResource TextS}"
                                        Visibility="{Binding HatAktion, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <!-- Lebenslinie: schrumpft ueber die Anzeigedauer des Toasts, damit man
                                 sieht, wie lange er noch bleibt. Fehler-Toasts bleiben bis zum Klick
                                 und bekommen darum keine (Code-Behind blendet sie dann aus). -->
                            <Border x:Name="LifeLine" Grid.Column="1"
                                    Height="2" VerticalAlignment="Bottom"
                                    CornerRadius="0,0,6,0"
                                    Background="{DynamicResource AccentBrush}"
                                    RenderTransformOrigin="0,0.5"
                                    Loaded="LifeLine_Loaded">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="LifeLineScale"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Success">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="LifeLine" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource WarningBrush}"/>
                            <Setter TargetName="LifeLine" Property="Background" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            <!-- Fehler bleibt bis zum Klick: keine ablaufende Linie zeigen. -->
                            <Setter TargetName="LifeLine" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
