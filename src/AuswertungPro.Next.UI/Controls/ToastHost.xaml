<UserControl x:Class="AuswertungPro.Next.UI.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:AuswertungPro.Next.UI.Services">
    <!-- Transparente Overlay-Ebene: nur die Toast-Karten fangen Klicks, der Rest der UI
         bleibt bedienbar (Grid ohne Background -> kein Hit-Test in leeren Bereichen). -->
    <Grid>
        <ItemsControl x:Name="ItemsHost"
                      VerticalAlignment="Bottom" HorizontalAlignment="Right"
                      Margin="0,0,20,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type services:ToastItem}">
                    <Border MinWidth="240" MaxWidth="360" Margin="0,6,0,0"
                            CornerRadius="{DynamicResource RadiusM}"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand"
                            Opacity="0"
                            RenderTransformOrigin="0.5,1"
                            Loaded="Toast_Loaded"
                            MouseLeftButtonUp="Toast_Click"
                            ToolTip="Klicken zum Schliessen">
                        <Border.RenderTransform>
                            <TranslateTransform Y="12"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Farbiger Akzentbalken je Schwere (Default = AccentBrush fuer Info) -->
                            <Border x:Name="AccentBar" Grid.Column="0"
                                    CornerRadius="6,0,0,6"
                                    Background="{DynamicResource AccentBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                       Margin="12,10,14,10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Success">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
