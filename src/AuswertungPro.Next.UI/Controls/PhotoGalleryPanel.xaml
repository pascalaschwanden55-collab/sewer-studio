<UserControl x:Class="AuswertungPro.Next.UI.Controls.PhotoGalleryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AuswertungPro.Next.UI.Behaviors"
             xmlns:local="clr-namespace:AuswertungPro.Next.UI.Controls">
    <UserControl.Resources>
        <local:GalerieThumbnailConverter x:Key="ThumbConv"/>
        <local:GalerieTileImageHeightConverter x:Key="TileHeightConv"/>
    </UserControl.Resources>

    <!-- Foto-Galerie der Haltung: Thumbnails im Raster, Klick oeffnet das Foto
         im Standard-Bildbetrachter. Beschriftung = Meter + VSA-Code. -->
    <DockPanel MaxHeight="284">
        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,6">
            <Button DockPanel.Dock="Right"
                    Width="28"
                    Height="24"
                    MinWidth="28"
                    Padding="0"
                    Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="Detach_Click"
                    ToolTip="In eigenem Fenster öffnen">
                <TextBlock Text="&#xE8A7;" FontFamily="{DynamicResource FontIcon}" FontSize="{DynamicResource TextS}"/>
            </Button>
            <TextBlock DockPanel.Dock="Left"
                       Text="Kacheln"
                       FontSize="{DynamicResource TextXS}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding TileSize, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGalleryPanel}}, StringFormat={}{0:0}px}"
                       FontSize="{DynamicResource TextXS}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
            <Slider Minimum="80"
                    Maximum="260"
                    TickFrequency="20"
                    IsSnapToTickEnabled="False"
                    Value="{Binding TileSize, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGalleryPanel}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Kachelgrösse der Fotogalerie anpassen"/>
        </DockPanel>

        <Grid>
            <ListBox x:Name="FotoListe"
                     Background="Transparent" BorderThickness="0"
                     behaviors:PhotoHoverPreviewBehavior.IsEnabled="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" Padding="4" CornerRadius="{DynamicResource RadiusM}" Cursor="Hand"
                                Background="{DynamicResource HeaderBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                MouseLeftButtonUp="Foto_Click">
                            <StackPanel Width="{Binding TileSize, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGalleryPanel}}}">
                                <Border CornerRadius="{DynamicResource RadiusS}" ClipToBounds="True"
                                        Height="{Binding TileSize, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGalleryPanel}}, Converter={StaticResource TileHeightConv}}">
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding Pfad, Converter={StaticResource ThumbConv}}"/>
                                </Border>
                                <TextBlock Text="{Binding Beschriftung}" FontSize="{DynamicResource TextXS}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <local:EmptyStateControl IsHitTestVisible="False"
                                     Icon="&#xE722;"
                                     Title="Keine Fotos"
                                     Message="Zu dieser Haltung sind noch keine Schadensfotos hinterlegt."
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                <local:EmptyStateControl.Style>
                    <Style TargetType="local:EmptyStateControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=FotoListe}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:EmptyStateControl.Style>
            </local:EmptyStateControl>
        </Grid>
    </DockPanel>
</UserControl>
