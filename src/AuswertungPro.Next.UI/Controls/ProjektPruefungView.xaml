<UserControl x:Class="AuswertungPro.Next.UI.Controls.ProjektPruefungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Projekt prüfen" Command="{Binding PruefenCommand}" Style="{StaticResource ToolbarButtonAccent}"
                            ToolTip="Dateiverweise, offene KI-Befunde, Meterangaben, Schachthöhen und Eingabefelder prüfen"/>
                    <Button Content="Abbrechen" Command="{Binding AbbrechenCommand}" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0"
                            ToolTip="Laufende Projektprüfung abbrechen"/>
                </StackPanel>
                <TextBlock Text="Projektprüfung" FontSize="{DynamicResource TextL}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Dateiverweise · KI-Befunde der Haltungen · Meterangaben · Schachthöhen · Eingabefelder"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextS}"/>
            <TextBlock Text="{Binding Meldung}" TextWrapping="Wrap" Margin="0,8,0,6"/>
            <TextBlock Text="Hinweise zur Bearbeitung. Die vollständige XTF-Normprüfung erfolgt weiterhin beim Export."
                       FontSize="{DynamicResource TextS}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <DataGrid ItemsSource="{Binding Punkte}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      MaxHeight="320" Margin="0,10,0,0" HeadersVisibility="Column" IsEnabled="{Binding IstAktuell}"
                      RowHeight="NaN" MinRowHeight="34"
                      AlternatingRowBackground="{DynamicResource HeaderBrush}"
                      EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True" SelectionMode="Single">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Style.Triggers><DataTrigger Binding="{Binding Punkte.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bereich" Binding="{Binding BereichText}" Width="150"/>
                    <DataGridTextColumn Header="Objekt" Binding="{Binding ObjektText}" Width="160"/>
                    <DataGridTextColumn Header="Hinweis" Binding="{Binding Meldung}" Width="*" MinWidth="200">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Aktion" Width="110">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button Content="Zur Stelle" Style="{StaticResource ToolbarButton}" Margin="2"
                                    Command="{Binding DataContext.OeffnenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" ToolTip="Das betroffene Feld oder den Befund öffnen"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
