root = true

[*.cs]
# Analyzer-Einstiegsbaseline vom 2026-07-13:
# Diese Regeln treffen den gewachsenen Bestand bereits tausendfach (vor allem den festen
# Namespace "AuswertungPro.Next" und lesbare Testnamen mit Unterstrichen). Sie laufen weiter,
# erscheinen vorerst aber als IDE-Hinweise statt als 8.886 Build-Warnungen. Neue Regelarten
# aus "latest-recommended" bleiben Warnungen. Ein eigenes Paket kann die Eintraege spaeter
# einzeln entfernen, sobald die jeweilige Altlast behoben ist.
