<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NovaBin>C:/Sewer-Studio_KI_4.5-nova/src/AuswertungPro.Next.UI/bin/Debug/net10.0-windows10.0.19041</NovaBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NovaBin)/SewerStudio.dll" Private="false" />
    <Reference Include="$(NovaBin)/AuswertungPro.Next.Domain.dll" Private="false" />
    <Reference Include="$(NovaBin)/AuswertungPro.Next.Application.dll" Private="false" />
    <Reference Include="$(NovaBin)/AuswertungPro.Next.Infrastructure.dll" Private="false" />
    <Reference Include="$(NovaBin)/Microsoft.Extensions.Logging.Abstractions.dll" Private="false" />
    <Reference Include="$(NovaBin)/CommunityToolkit.Mvvm.dll" Private="false" />
    <Content Include="$(NovaBin)/runtimes/win-x64/native/e_sqlite3.dll" Link="e_sqlite3.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- Die Schachtseite liest ihre Spalten aus der ausgelieferten Excel-Vorlage neben dem Programm.
         Ohne diese Kopie meldet sie im Pruefhost "Schaechte-Vorlage nicht gefunden". -->
    <Content Include="$(NovaBin)/Export_Vorlage/**/*"
             Link="Export_Vorlage/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
